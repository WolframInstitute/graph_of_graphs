Cell["\<\
Blue fill is the exact rational distribution after t quotient steps.  The \
orange trail is one independently sampled path.  Change N, the clock, the \
starting class, or the seed and then play the time control.\
\>", "Text",
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGDiffusionText"|>|>,
