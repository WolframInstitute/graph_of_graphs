Cell[TextData[{
 "Choose one labelled connected cubic graph ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"11f2e740-832b-de57-fcd2-7188ffaf325b"],
 " and a spanning tree\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", "*"], "\[Subset]", 
    SuperscriptBox["G", "*"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "T^\\ast\\subset G^\\ast"|>|>,
  ExpressionUUID->"e34f4648-dc23-4710-3219-5fca446f5b1e"],
 ".  Since the labelled chain is finite and irreducible,\nfrom any state ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "x"|>|>,ExpressionUUID->
  "84516272-3c64-da45-24ab-bfc9eca1a443"],
 " there is a path of Whitehead moves leading to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"c7d7c8d3-53c7-3e94-eb68-991670a82e15"],
 ".  By\nfiniteness, the length of such a path can be chosen at most ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "D"|>|>,ExpressionUUID->
  "7aefd6ff-d44c-3581-df11-6f37ebd91e3f"],
 " uniformly in\n",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "x"|>|>,ExpressionUUID->
  "4f8408a3-7abf-241c-8fc4-f78e65b05b5f"],
 ", after padding if necessary.  Once at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"34fd738b-ccc7-81c1-97f1-e872cbbfe05c"],
 ", for each edge of\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T^\\ast"|>|>,
  ExpressionUUID->"aad3f6ff-0e1d-45eb-3af5-19f7260f1dea"],
 " perform a chosen Whitehead move and immediately perform its inverse.\nThis \
averages every tree edge and returns the labelled carrier to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"1b861947-59e7-4613-fe66-04a68ba48f18"],
 "\nafter each pair.  Let ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "9360273a-4a02-d4da-9b3e-d2b394a749b6"],
 " be a\ncommon upper bound for the total length of this ``success block''."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
