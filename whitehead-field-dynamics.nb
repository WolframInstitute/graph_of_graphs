Cell["\<\
For concrete Rule A, the preceding stationary law is not abstract: it is the
cubic configuration model conditioned on connectedness.  Spectral typicality
can therefore be imported from the matching model itself rather than posed as
a new property of an unknown stationary law.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"505ea4df-42d7-c4e9-794a-04cc104c3037"],

Cell["\<\
This corollary is not the only route.  Stationarity is convenient, but the
Lyapunov theorem only needs a pathwise lower frequency of good graphs.  A
statement such as ``the graph is an expander on average'' is not by itself
enough unless it implies such a frequency or a comparable supermartingale
inequality.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"628bcbf1-2f46-9828-ad65-bea9172fbb5b"],

Cell[TextData[{
 "The Jensen/log heuristic is consistent with the supermartingale proof.  \
Whenever\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", 
     SubscriptBox["f", "t"], ")"}], ">", "0"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\V(f_t)>0"|>|>,
  ExpressionUUID->"1bd44d82-a184-8935-f016-d9ef8f4a5dd5"],
 ","
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a2550366-1467-4b20-8e43-23a1c5742cb7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], "[", 
    RowBox[{
     RowBox[{"log", 
      FractionBox[
       RowBox[{
        StyleBox["V", "TI"], "(", 
        SubscriptBox[
         StyleBox["f", "TI"], 
         RowBox[{
          StyleBox["t", "TI"], "+", "1"}]], ")"}], 
       RowBox[{
        StyleBox["V", "TI"], "(", 
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["t", "TI"]], ")"}]]}], " ", "|", " ", 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["t", "TI"]]}], "]"}], "\[LessEqual]", 
   RowBox[{"log", 
    RowBox[{
     RowBox[{
      StyleBox["E",
       FontSlant->"Plain"], "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         StyleBox["V", "TI"], "(", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          RowBox[{
           StyleBox["t", "TI"], "+", "1"}]], ")"}], 
        RowBox[{
         StyleBox["V", "TI"], "(", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["t", "TI"]], ")"}]], " ", "|", " ", 
       SubscriptBox[
        StyleBox["F", "TI"], 
        StyleBox["t", "TI"]]}], "]"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\E\\left[\n        \\log\\frac{\\V(f_{t+1})}{\\V(f_t)}\n      \
  \\,\\middle|\\,\\mathcal F_t\n    \\right]\n    \\le\n    \\log\n    \
\\E\\left[\n        \\frac{\\V(f_{t+1})}{\\V(f_t)}\n        \
\\,\\middle|\\,\\mathcal F_t\n    \\right].\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"b5263287-cc59-adb7-3c5a-b42c9004833d"],

Cell[TextData[{
 "On a good graph this is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", "(", 
    RowBox[{"1", "-", 
     FractionBox[
      SubscriptBox["c", "0"], 
      RowBox[{"3", " ", "N"}]]}], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\log(1-c_0/(3N))"|>|>,
  ExpressionUUID->"2cf70f3f-e88d-6f9e-bb43-158449dd01ff"],
 ".  The supermartingale\nargument is stronger because it converts \
conditional expected contraction into\nan almost-sure pathwise upper bound."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"1a6d9617-8114-7a2e-4bab-81de9d7dc138"],

