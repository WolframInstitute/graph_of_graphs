Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"pA", "=", 
   RowBox[{"GogFieldDynamics`GogTransitionMatrix", "[", 
    RowBox[{"4", ",", "\"\<A\>\""}], "]"}]}], ";", 
  RowBox[{"pB", "=", 
   RowBox[{"GogFieldDynamics`GogTransitionMatrix", "[", 
    RowBox[{"4", ",", "\"\<B\>\""}], "]"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<RuleASymmetric\>\"", "\[Rule]", 
     RowBox[{"SymmetricMatrixQ", "[", "pA", "]"}]}], ",", 
    RowBox[{"\"\<RuleBSymmetric\>\"", "\[Rule]", 
     RowBox[{"SymmetricMatrixQ", "[", "pB", "]"}]}], ",", 
    RowBox[{"\"\<RuleBUniformStationary\>\"", "\[Rule]", 
     RowBox[{
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         FractionBox["1", "5"], ",", "5"}], "]"}], ".", "pB"}], "===", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        FractionBox["1", "5"], ",", "5"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellFrame->True,
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGClockChecksInput"|>|>,
