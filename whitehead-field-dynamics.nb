     "\n"|>|>,ExpressionUUID->"14e1496d-dce9-2c90-7e7f-104f2092f90b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "(", "n", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "a(n)"|>|>,
  ExpressionUUID->"a447e1f2-9490-5679-343d-050a06b5bca4"],
 " is OEIS A005967, the number of isomorphism classes of connected\n3-regular \
multigraphs of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "n"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2n"|>|>,ExpressionUUID->
  "650a0dae-a3ff-b904-f3cc-15c2b9f2a2c1"],
 ", loops allowed ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"oeis-a005967"],
 ButtonBox["oeis-a005967",
  BaseStyle->"Citation",
  ButtonData->"oeis-a005967"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"oeis-a005967"],
 ".  The\nfirst values are"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"a977c26f-5285-cc89-0f9a-0f883be231a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
  "2", ",", "5", ",", "17", ",", "71", ",", "388", ",", "2592", ",", "21096", 
   ",", "\[Ellipsis]"}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
