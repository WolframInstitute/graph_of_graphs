Cell[TextData[{
 "Expose an oriented uniform stub.  Conditional on its vertex being ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "i"|>|>,ExpressionUUID->
