Cell[TextData[{
 "Under the slot law, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["L", "TI"], ",", 
     StyleBox["D", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(L,D)"|>|>,
  ExpressionUUID->"d5014831-ed49-dc3e-ad3b-8fd70180f2f7"],
 " tends to two independent\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "Pois"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\operatorname{Pois}(1)"|>|>,
  ExpressionUUID->"b7a36a02-7a7b-8645-5ba5-5d14222edc3d"],
 " variables; exponential tilting shows that under the\nuniform adjacency law \
it tends to two independent\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "Pois"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\operatorname{Pois}(2)"|>|>,
  ExpressionUUID->"b36f93a0-a179-5d05-c82a-f75ceeca4148"],
 " variables.  Hence"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"c9f708aa-018f-cf61-20ad-110571608a14"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{
      SubscriptBox["\[Pi]", "slot"], "-", 
      SubscriptBox[
       StyleBox["U", "TI"], 
       StyleBox["N", "TI"]]}], "TV"], "\[LongRightArrow]", 
    SubscriptBox[
     RowBox[{
      RowBox[{
       StyleBox[
        RowBox[{"P", "o", "i", "s"}], "TI"], 
       SuperscriptBox[
        RowBox[{"(", "1", ")"}], 
        RowBox[{"\[CircleTimes]", "2"}]]}], "-", 
      RowBox[{
       StyleBox[
        RowBox[{"P", "o", "i", "s"}], "TI"], 
       SuperscriptBox[
        RowBox[{"(", "2", ")"}], 
        RowBox[{"\[CircleTimes]", "2"}]]}]}], "TV"]}], "\[LongEqual]", 
   RowBox[{"0.4385731106", 
    RowBox[{"\[Ellipsis]", "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\norm{\\pi_{\\rm slot}-U_N}_{\\rm TV}\n \\longrightarrow\n \
\\norm{\\operatorname{Pois}(1)^{\\otimes2}\n       -\\operatorname{Pois}(2)^{\
\\otimes2}}_{\\rm TV}\n =0.4385731106\\ldots.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"4b45c9ee-232b-344a-df0f-0d280c4c02c4"],

Cell[TextData[{
 "Li's good-edge estimate gives the stronger statement\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["E",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["U", "TI"], 
       StyleBox["N", "TI"]]], "\[Delta]"}], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", "1", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E_{U_N}\\delta=O(1)"|>|>,
  ExpressionUUID->"9c17af48-5e9a-0f2b-f814-73527200d138"],
 ", and therefore the simple-neighbour stationary law is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"a31bc11c-99f5-8a62-ad0d-20e0aa86428e"],
 " in total variation from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "U_N"|>|>,ExpressionUUID->
  "6b24b974-cbb7-99a6-83c9-acbcf80d16e3"],
 ".  Thus the two natural labelled\nwalks remain order-one apart even though \
their rows are typically\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"64816783-35c3-5731-cc09-10a343400751"],
 " apart."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"b656020d-2021-d4dc-895f-3b00594809f2"],

Cell[TextData[{
 "More precisely, let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["U", "TI"]], "\[LongEqual]", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     RowBox[{
      RowBox[{
       StyleBox["L", "TI"], "(", 
       SubscriptBox["\[CapitalGamma]", "lab"], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"6", 
        StyleBox["N", "TI"]}], ")"}]}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "P_U=I-L(\\Gamma_{\\rm lab})/(6N)"|>|>,
  ExpressionUUID->"5b55c226-41a6-1241-6f7b-a4b387c3537f"],
 ", let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "simp"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "P_{\\rm simp}"|>|>,
  ExpressionUUID->"466d3d5a-1c5c-f8fd-da19-caf22eda5230"],
 " be\nthe simple-neighbour kernel, and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "[", 
    RowBox[{"G", ",", "H"}], "]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "K(G,H)"|>|>,
  ExpressionUUID->"72cd7eca-6aeb-c674-ebcd-bd12e4e0531c"],
 " be the multiplicity among the\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "bf366e3f-01c4-d1af-ddc2-1ed7b3d1fca2"],
 " labelled slots.  Put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "slot"], "(", 
     RowBox[{"G", ",", "H"}], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{"K", "[", 
      RowBox[{"G", ",", "H"}], "]"}], 
     RowBox[{"6", " ", "N"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "P_{\\rm slot}(G,H)=K(G,H)/(6N)"|>|>,
  ExpressionUUID->"6cc5804e-43ec-773b-a41e-93134130c0c3"],
 ".  With\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["k", "0"], "(", "G", ")"}], "\[LongEqual]", 
    RowBox[{"K", "[", 
     RowBox[{"G", ",", "G"}], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k_0(G)=K(G,G)"|>|>,
  ExpressionUUID->"14a92711-1751-84ba-3125-d6db24fcbb1d"],
 ","
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"c0e7bd72-40d1-06a5-80ef-3ef431f22040"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]", "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["k", "TI"], "0"], "(", 
      StyleBox["G", "TI"], ")"}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["H", "TI"], "\[NotEqual]", 
        RowBox[{
         StyleBox["G", "TI"], ":", 
         RowBox[{
          RowBox[{
           StyleBox["K", "TI"], "(", 
           RowBox[{
            StyleBox["G", "TI"], ",", 
            StyleBox["H", "TI"]}], ")"}], ">", "0"}]}]}],
       LimitsPositioning->True], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         StyleBox["K", "TI"], "(", 
         RowBox[{
          StyleBox["G", "TI"], ",", 
          StyleBox["H", "TI"]}], ")"}], "-", "1"}], ")"}]}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\delta(G)=k_0(G)+\\sum_{H\\ne G:K(G,H)>0}(K(G,H)-1),\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"97c10ee9-0842-6aac-fa14-cb4df5f93b10"],

Cell["and direct summation gives", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"926dd4c0-c01c-96b0-adfe-ba3875059878"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], "simp"], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}], "-", 
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["U", "TI"]], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}]}], "TV"], "\[LongEqual]", 
    FractionBox[
     RowBox[{"\[Delta]", "(", 
      StyleBox["G", "TI"], ")"}], 
     RowBox[{"6", 
      StyleBox["N", "TI"]}]]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], "slot"], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}], "-", 
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["U", "TI"]], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}]}], "TV"], "\[LessEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Delta]", "(", 
       StyleBox["G", "TI"], ")"}], 
      RowBox[{"6", 
       StyleBox["N", "TI"]}]], "."}]}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\norm{P_{\\rm simp}(G,\\cdot)-P_U(G,\\cdot)}_{\\rm TV}\n   \
=\\frac{\\delta(G)}{6N},\\qquad\n \\norm{P_{\\rm \
slot}(G,\\cdot)-P_U(G,\\cdot)}_{\\rm TV}\n   \\le\\frac{\\delta(G)}{6N}.\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"61999f4d-5f0a-d631-4424-0a090541796e"],

