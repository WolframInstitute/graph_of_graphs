  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"15103735-6d76-848a-00d4-dae68e9d5e8c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"|", 
