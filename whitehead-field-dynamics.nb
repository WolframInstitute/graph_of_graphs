 FontSlant->Plain,ExpressionUUID->"a11d26ec-bf91-24e9-1ba1-29362abc4410"],

Cell["\<\
This is the reason the one-step Lyapunov identity is clean: settlement \
choices
are orthogonal gauge changes, not hidden dissipation.  They are nevertheless
pathwise dynamical data, because cumulative settlements conjugate the \
endpoint
pairs averaged at later times.  The exact pullback formula below separates
these two statements.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"36d93312-08cb-4f86-aa55-e3ecc7cd4b9d"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "s"], "\[LongEqual]", 
    RowBox[{
     SubscriptBox["P", "s"], " ", 
     SubscriptBox["A", 
      SubscriptBox["e", "s"]]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T_s=P_sA_{e_s}"|>|>,
  ExpressionUUID->"6eab8c95-9953-4619-fdf8-5f3a95ab7165"],
 ", where ",
 Cell[BoxData[
  FormBox[
