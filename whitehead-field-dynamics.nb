           StyleBox["G", "TI"], ")"}]}]},
      "Abs"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox[
      RowBox[{"G", "H"}], "TI"]]}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["c", "TI"], "(", 
      StyleBox["H", "TI"], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          RowBox[{
            StyleBox["A", "TI"], 
