Cell["\<\
Complete unlabelled class and Rule-A slot counts through N=14.  The \
logarithmic axis makes the computational growth visible without turning \
finite evidence into an asymptotic claim.\
\>", "Caption",
 ShowCellBracket->False,
 CellMargins->{{84, 84}, {2, 18}},
 TaggingRules-><|
  "MathNotebook" -> <|"Suppressed" -> "True"|>, 
   "GoGNotebook" -> <|
    "PresentationOnly" -> True, "ID" -> "GoGEnumerationGrowthCaption"|>|>,
 FontSlant->Plain,
 FontColor->RGBColor[0.37, 0.42, 0.49],
 CellTags->{
  "GoGNotebookVisual", 
   "GoGEnumerationGrowthCaption"},ExpressionUUID->"28e68a4e-28d4-f07f-0a31-\
b3b1fe0bbb26"],

Cell[TextData[{
 "The finite statements in this section are computational evidence, not\n\
asymptotic theorems.  Cubic multigraphs were encoded by coloured incidence\n\
graphs and canonically labelled with nauty/Traces ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"mckay-nauty"],
 ButtonBox["mckay-nauty",
  BaseStyle->"Citation",
  ButtonData->"mckay-nauty"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"mckay-nauty"],
 ".\nEnumeration is complete through ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "14"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=14"|>|>,
  ExpressionUUID->"c5b7801d-f9c2-abf1-91d8-6de36fde13dc"],
 ": the class counts agree with\nA005967, and every source has exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "73fbbf88-c180-a2c0-bbdb-b6f2b0509e8d"],
 " compressed resolution slots."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"acae0016-a735-6eb5-6988-b6784322d221"],

