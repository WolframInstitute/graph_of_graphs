Cell["\<\
This gives precise meaning to saying that the current graph is an expander on
average.  What is needed is not stationarity itself, but a pathwise lower
bound on the time average of the cubic-graph spectral gap seen by the moving
field.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"b37b864b-4767-3775-e789-65873908b55b"],

Cell[TextData[{
 "Suppose the graph component is a finite irreducible Markov chain with\n\
stationary law ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\pi_N"|>|>,
  ExpressionUUID->"a7078fa2-16e3-6d9d-3cfd-256ba9d1c576"],
 ".  If"
}], "Corollary",
 CellDingbat->Cell[
   TextData[{"Corollary ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "corollary", "EnvironmentOpen" -> 
     "\\begin{corollary}[Stationary law as one source of good frequency]", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->
  "Theorem",ExpressionUUID->"9e8321fc-ddde-8593-e442-8a4cec805ad0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Pi]", 
      StyleBox["N", "TI"]], 
     RowBox[{"{", 
      RowBox[{
       StyleBox["G", "TI"], ":", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Lambda]", "2"], "(", 
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["G", "TI"]], ")"}], "\[GreaterEqual]", 
        SubscriptBox[
         StyleBox["c", "TI"], "0"]}]}], "}"}]}], "\[GreaterEqual]", 
    RowBox[{"1", "-", 
     SubscriptBox["\[Epsilon]", 
      StyleBox["N", "TI"]]}]}], ","}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\pi_N\\{G:\\lambda_2(L_G)\\ge c_0\\}\\ge 1-\\varepsilon_N,\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"59258ee9-0775-57b3-9a81-b31514414f7a"],

Cell[TextData[{
 "then the theorem applies with ",
 Cell[BoxData[
