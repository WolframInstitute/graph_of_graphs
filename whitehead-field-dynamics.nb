Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pairAverage", "[", 
    RowBox[{"n_", ",", 
     RowBox[{"{", 
      RowBox[{"i_", ",", "j_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "i"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"j", ",", "i"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"j", ",", "j"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"matching", "[", 
    RowBox[{"n_", ",", "edges_"}], "]"}], ":=", 
   RowBox[{"Dot", "@@", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"pairAverage", "[", 
        RowBox[{"n", ",", "#1"}], "]"}], "&"}], ")"}], "/@", "edges"}]}]}], ";", 
  RowBox[{"k4", "=", 
   RowBox[{
    RowBox[{"matching", "[", 
     RowBox[{"4", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"matching", "[", 
     RowBox[{"4", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{"q3", "=", 
   RowBox[{
    RowBox[{"matching", "[", 
     RowBox[{"8", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "8"}], "}"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"matching", "[", 
     RowBox[{"8", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"matching", "[", 
     RowBox[{"8", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}]}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"k4", "===", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       FractionBox["1", "4"], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"q3", "===", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       FractionBox["1", "8"], ",", 
       RowBox[{"{", 
        RowBox[{"8", ",", "8"}], "}"}]}], "]"}]}]}], "}"}]}]], "Input",
 CellFrame->True,
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGConsensusInput"|>|>,
 CellFrameMargins->{{8, 8}, {7, 7}},
 CellFrameStyle->Directive[
   RGBColor[0.82, 0.85, 0.88], 
   AbsoluteThickness[1]],
 FontSize->11,
 FontSlant->Plain,
 Background->RGBColor[0.965, 0.975, 0.985],
 CellTags->{
  "GoGCompanion", 
   "GoGConsensusInput"},ExpressionUUID->"c749c642-2c79-4f0b-7b6d-\
a470becb9742"],

