       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], "}"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], "-", 
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["j", "TI"]]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["i", "TI"]], "-", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["j", "TI"]]}], ")"}], 
      StyleBox["T", "TI"]]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    L_{G,\\mu}\n    =\n    \\sum_{\\{i,j\\}\\in E(G),\\,i\\neq j}\n\
    \\mu(\\{i,j\\})(e_i-e_j)(e_i-e_j)^T\n\\]", "Separator" -> 
