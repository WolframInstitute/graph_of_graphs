  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_e=e_i-e_j"|>|>,
  ExpressionUUID->"6e860b67-b1e7-d65d-2d2c-90bffa3a068c"],
 " (and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "e"], "\[LongEqual]", "0"}], TraditionalForm]], 
