Cell["\<\
The unlabelled graph-of-graphs has no canonical coordinates in its fibres.  The
right object is the bundle\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"5f8dc400-1a44-c665-b995-86aa4afb7c7a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", "\[LongEqual]", 
     RowBox[{"[", 
      StyleBox["G", "TI"], "]"}]}], "\[Element]", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["N", "TI"]]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     StyleBox["F", "TI"], "\[Gamma]"], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
