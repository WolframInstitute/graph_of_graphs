       StyleBox["d", "TI"], 
       StyleBox["s", "TI"], "2"], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n D=\\V(x^0)-\\V(x^m)=\\frac12\\sum_s d_s^2.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"610eacaa-2729-1e3b-2332-5454e2d097f5"],

Cell["The total displacement before any step is at most", "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
