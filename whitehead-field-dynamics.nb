Cell["\<\
Complete unlabelled enumeration grows rapidly.  The plot separates class \
counts from Rule-A slot records and uses a logarithmic vertical scale.  These \
are finite checks, not asymptotic evidence by themselves.\
\>", "Text",
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGEnumerationText"|>|>,
 LineSpacing->{1.15, 2},
