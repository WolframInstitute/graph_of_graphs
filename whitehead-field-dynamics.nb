       StyleBox["t", "TI"], "\[Rule]", "\[Infinity]"}],
      LimitsPositioning->True], 
     FractionBox["1", 
      StyleBox["t", "TI"]], "log", 
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["t", "TI"]]}], "-", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["f", "TI"], "_"], "0"], 
     StyleBox["1",
      FontSlant->"Bold"]}]}], "\[LessEqual]", 
   RowBox[{
    FractionBox[
     StyleBox["p", "TI"], "2"], 
    RowBox[{"log", "(", 
     RowBox[{"1", "-", 
      SubscriptBox["\[Alpha]", 
       StyleBox["N", "TI"]]}], ")"}]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       StyleBox["p", "TI"], 
       SubscriptBox[
        StyleBox["c", "TI"], "0"]}], 
      RowBox[{"6", 
       StyleBox["N", "TI"]}]]}], "+", 
    RowBox[{
     RowBox[{
      StyleBox["O", "TI"], "(", 
