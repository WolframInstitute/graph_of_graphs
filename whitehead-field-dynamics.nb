Cell[TextData[{
 "These maps are not invertible: every nonloop ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "m"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T_m"|>|>,ExpressionUUID->
  "2568a7c1-48c7-1d34-dd85-5dd8ab077565"],
 " has rank ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "-", "1"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N-1"|>|>,ExpressionUUID->
  "c7bd3b76-a484-91a1-55df-ed11f35dc039"],
 ".  They\ntherefore form a dissipative semigroup cocycle rather than \
parallel transport\nfor a vector-bundle connection in the standard sense.  \
Comparing two paths\nwith the same endpoints is still meaningful, and squares \
give a useful local\ncomparison, but they are not the first obstruction to \
path independence."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"9883dc2d-e8c2-e64b-1d0e-d2b8d3fddf30"],

