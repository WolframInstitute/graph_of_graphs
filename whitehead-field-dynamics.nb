Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     UnderscriptBox[
      RowBox[{"lim", " ", "sup"}], 
      RowBox[{
       StyleBox["t", "TI"], "\[Rule]", "\[Infinity]"}],
      LimitsPositioning->True], 
     FractionBox["1", 
