    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["N", "TI"]], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox["2", 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        StyleBox["o", "TI"], "(", "1", ")"}]}], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\Phi_A(B_N)=\\frac{2}{3N}(1+o(1)).\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"1537dd52-abdd-0aa1-cc3e-dc22524d1c16"],

Cell[TextData[{
 "In particular the Rule-A gap is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"a48febf5-ca8b-25ea-ee98-e15fd5ea020a"],
 " and the relaxation time is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "(", "N", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Omega(N)"|>|>,
  ExpressionUUID->"430d521f-d65e-87ac-6454-5d7f7bdfa199"],
 "."
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"f541442a-e427-5d58-0fde-f001dd60c5fe"],

Cell[TextData[{
 "A move can cross from the bridged to the bridgeless side only by acting on \
the\nunique bridge.  Conversely, let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", "uv"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=uv"|>|>,
  ExpressionUUID->"bd47026d-3bd2-4082-f437-81e02e326c7e"],
 " be the unique bridge and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A,C"|>|>,ExpressionUUID->
  "a48abbfe-e9a5-c937-07d2-7ce0bf8ef0c4"],
 " be\nthe two components of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "-", "e"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G-e"|>|>,ExpressionUUID->
  "68451b98-858c-2bff-0c87-a7a2d6cbf3c5"],
 ".  Neither component has an internal bridge.  In\neither resolution, one \
side edge at ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "u"|>|>,ExpressionUUID->
  "5220031d-fea9-e9df-c68e-a1d23570d319"],
 " and one side edge at ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "v"|>|>,ExpressionUUID->
  "51558750-207a-00c6-a259-bce0107f7dcf"],
 " change\nendpoint, and the two connected sides are then joined by those two \
edges and\n",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "7b88346d-7347-196b-5118-b5400f881ae3"],
 ".  Each of these three cross edges lies on a cycle using the other two and\n\
paths inside ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A,C"|>|>,ExpressionUUID->
  "c1e3ed1f-0dac-cf01-a324-440cd3c136bf"],
 "; cycles internal to either side are unchanged or repaired\nthrough ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "3b73c881-e104-a247-ef70-2622734428b0"],
 ".  Thus both compressed resolutions are bridgeless.  A class in\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "1"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_1"|>|>,ExpressionUUID->
  "a9446be8-4124-57a5-7cc3-0cda12f9af07"],
 " has exactly two exiting slots, while a class with more than one bridge\n\
has none.  Averaging under ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "A"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\pi_A"|>|>,
  ExpressionUUID->"cad1f586-c39b-044b-821f-af1c249ac3cb"],
 " proves the exact flow formula."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"ecc6b6bc-2e03-4956-ba71-40d198db9d3e"],

Cell[TextData[{
 "It remains to determine the masses.  In the unconditioned configuration\n\
model, the loop count has mean ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"3", " ", "N"}], 
    RowBox[{
     RowBox[{"3", " ", "N"}], "-", "1"}]], TraditionalForm]], "InlineFormula",
  
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N/(3N-1)"|>|>,
  ExpressionUUID->"cf273abb-0638-f998-46ca-f599f045fa48"],
 " and converges by factorial moments\nto ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "Pois"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\operatorname{Pois}(1)"|>|>,
  ExpressionUUID->"615885a9-1ca4-5a64-9bfa-ce7f2b6dc406"],
 ".  If a bridge cuts off a smaller vertex set of\nsize ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "57851492-82ed-dc93-7417-7c30883afac6"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"3", 
      StyleBox["k", "TI"]}], "\[LongEqual]", "2"}], "|", 
    RowBox[{
     StyleBox["E", "TI"], "(", 
     StyleBox["S", "TI"], ")"}], "|", 
    RowBox[{"+", "1"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3k=2|E(S)|+1"|>|>,
  ExpressionUUID->"acbf1908-0ece-41dd-989d-01739458c4d5"],
 ", so ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "f5a35cb0-dea2-fac7-a39b-5f20e40845a5"],
 " is odd.  The expected number of\n",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "277932a5-2f8a-9e42-de7f-62cb81bb7ccf"],
 "-sets with exactly one crossing matched pair is"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"c2c20e8a-3c6a-ceb0-5e5a-e11727d7531a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["N", "TI"], ",", 
     StyleBox["k", "TI"]}]], "\[LongEqual]", 
   RowBox[{
    TemplateBox[{
      StyleBox["N", "TI"], 
      StyleBox["k", "TI"]},
     "Binomial"], 
    RowBox[{"(", 
     RowBox[{"3", 
      StyleBox["k", "TI"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", 
       StyleBox["N", "TI"]}], "-", 
      RowBox[{"3", 
       StyleBox["k", "TI"]}]}], ")"}], 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", 
           StyleBox["k", "TI"]}], "-", "2"}], ")"}], "!!"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", 
           StyleBox["N", "TI"]}], "-", 
          RowBox[{"3", 
           StyleBox["k", "TI"]}], "-", "2"}], ")"}], "!!"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", 
          StyleBox["N", "TI"]}], "-", "1"}], ")"}], "!!"}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n A_{N,k}=\\binom Nk(3k)(3N-3k)\n \
\\frac{(3k-2)!!(3N-3k-2)!!}{(3N-1)!!}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"6c49cc57-61ef-88e3-52c9-e0ee608c105b"],

Cell["\<\
This is a first-moment upper bound because the two internally paired pieces
need not be connected.  The first term is\
\>", "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"c646d0c5-23b2-1f74-4f5c-14eb2f36ea7e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["N", "TI"], ",", "3"}]], "\[LongEqual]", 
   RowBox[{
    FractionBox["35", 
     RowBox[{"18", 
      StyleBox["N", "TI"]}]], "+", 
    RowBox[{
     RowBox[{
      StyleBox["O", "TI"], "(", 
      SuperscriptBox[
       StyleBox["N", "TI"], 
       RowBox[{"-", "2"}]], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n A_{N,3}=\\frac{35}{18N}+O(N^{-2}).\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"b4fb2f02-a707-a489-402d-df11aa365ab3"],

Cell[TextData[{
 "Exact double-factorial ratios give\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", 
     RowBox[{"N", ",", "k"}]], "\[LongEqual]", 
    RowBox[{"O", "(", 
     SuperscriptBox["N", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], " ", 
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}]}]], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "A_{N,k}=O(N^{-(k-1)/2})"|>|>,
  ExpressionUUID->"e8507148-4748-0150-d8f3-8c9727c4c0d4"],
 " for each fixed odd ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "1bdd6bf3-0934-8443-44aa-8ad643675434"],
 ", and a uniform Stirling bound\nmakes the middle range exponentially small. \
 Consequently"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"f87ca4f6-8850-c9c4-f3e4-2b6767ddbbaa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      RowBox[{"3", "\[LessEqual]", 
       StyleBox["k", "TI"], "\[LessEqual]", 
       RowBox[{
        StyleBox["N", "TI"], "/", "2"}]}], "\n", 
      RowBox[{
       StyleBox["k", "TI"], " ", "odd"}]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{
      StyleBox["N", "TI"], ",", 
      StyleBox["k", "TI"]}]]}], "\[LongEqual]", 
   RowBox[{
    FractionBox["35", 
     RowBox[{"18", 
      StyleBox["N", "TI"]}]], "+", 
    RowBox[{
     StyleBox["O", "TI"], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{"-", "2"}]], ")"}]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     StyleBox["O", "TI"], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{"-", "1"}]], ")"}], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\sum_{\\substack{3\\le k\\le N/2\\\\k\\ {\\rm odd}}}A_{N,k}\n \
=\\frac{35}{18N}+O(N^{-2})=O(N^{-1}).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"4e7356a3-b1aa-f5d4-bead-3a234e2e211d"],

Cell[TextData[{
 "Conditioning on connectedness changes these estimates by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"O", "(", 
     FractionBox["1", "N"], ")"}], "+", "1"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1+O(N^{-1})"|>|>,
  ExpressionUUID->"e5af3a76-f5b4-b0cf-4903-576c3918a446"],
 ".\nIndeed, the analogous expected count of an isolated even ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "4e96c06c-669a-a05f-8ec0-bb2b12e830eb"],
 "-set is"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"c814f6a0-b10e-90a5-35ba-85232f42cb4d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["D", 
     RowBox[{"N", ",", "k"}]], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", "k"}], "-", "1"}], ")"}], "!!"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"3", " ", "k"}]}], "+", 
           RowBox[{"3", " ", "N"}], "-", "1"}], ")"}], "!!"}]}], ")"}], " ", 
      TemplateBox[{"N", "k"},
       "Binomial"]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "N"}], "-", "1"}], ")"}], "!!"}]]}], ";"}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n D_{N,k}=\\binom Nk\n \\frac{(3k-1)!!(3N-3k-1)!!}{(3N-1)!!};\n\\]",
      "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e10d06be-4bcd-b7f7-beb0-27fafd2be666"],

Cell[TextData[{
 "its ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[LongEqual]", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k=2"|>|>,ExpressionUUID->
  "5c200dd9-9441-e7da-4350-528bf83c66cd"],
 " term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"O", "(", 
     FractionBox["1", 
      SuperscriptBox["N", "2"]], ")"}], "+", 
    FractionBox["5", 
     RowBox[{"18", " ", "N"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "5/(18N)+O(N^{-2})"|>|>,
  ExpressionUUID->"99ce5c71-e495-ab1e-f570-6fe1c60ffd9b"],
 ", and the same ratio and Stirling\nestimates give total disconnection \
probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"6e155f22-8905-d171-aa19-f22657d551ca"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"54426fb8-a001-1768-a5c8-1cfa482bcc0f"],

Cell[TextData[{
 "A loop vertex has one remaining incident edge, which is a singleton-side\n\
bridge.  Up to an event of probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"d22dea03-3590-536d-a82a-c18e073a501a"],
 ", all bridges are of this\nform.  Hence ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_0"|>|>,ExpressionUUID->
  "858bca4b-7647-a86b-656a-6096d30b48a1"],
 " differs from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"L", "\[LongEqual]", "0"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\{L=0\\}"|>|>,
  ExpressionUUID->"da6ab561-d566-c9f4-234f-1d1bd590f1e1"],
 " by probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"85aaf981-cce1-8369-7006-c0cb51f857c6"],
 " and\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "1"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_1"|>|>,ExpressionUUID->
  "bb2acadb-c5c1-d320-0908-01a1507aeab2"],
 " differs from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"L", "\[LongEqual]", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\{L=1\\}"|>|>,
  ExpressionUUID->"9dbee54f-96cf-2948-ef7f-85c4990ef74e"],
 " by probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"b22b8edd-426d-b87d-c839-0115323ee059"],
 ".  The Poisson limit\ngives the three stationary-mass limits, and \
substitution in the exact flow\nformula gives the conductance asymptotic."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"25c0eb93-65b8-5533-070f-fdfeb9874c9c"],

Cell[TextData[{
 "Starting from stationarity conditioned on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_0"|>|>,ExpressionUUID->
  "bd45e7dd-db9b-9b10-23b3-947973870fd6"],
 " and testing total variation on\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_0"|>|>,ExpressionUUID->
  "19e682da-1aac-c8a2-16e4-77859b8be08f"],
 " gives, for fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "<", 
    RowBox[{"1", "-", 
     FractionBox["1", "e"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\varepsilon<1-e^{-1}"|>|>,
  ExpressionUUID->"73527436-4ce9-af21-f70d-c804a816b913"],
 ","
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"2aea6647-30ea-f78f-e160-24ab16d72be5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], "mix"], "(", "\[Epsilon]", ")"}], "\[GreaterEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{"3", 
      StyleBox["N", "TI"]}], "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", "1"}]], "-", "\[Epsilon]"}], ")"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        StyleBox["o", "TI"], "(", "1", ")"}]}], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n t_{\\rm mix}(\\varepsilon)\n \\ge \
\\frac{3N}{2}(1-e^{-1}-\\varepsilon)(1+o(1)).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"f5c85142-8b6b-a0b1-8b54-56c1e814dd8d"],

Cell[TextData[{
 "by the standard bottleneck argument ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"levin-peres-wilmer"],
 ButtonBox["levin-peres-wilmer",
  BaseStyle->"Citation",
  ButtonData->"levin-peres-wilmer"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"levin-peres-wilmer"],
 ".\nThus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["t", "mix"], "(", 
     FractionBox["1", "4"], ")"}], "\[GreaterEqual]", 
    RowBox[{"0.57318`", " ", "\[Ellipsis]", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"o", "(", "1", ")"}], "+", "1"}], "]"}]}]}], TraditionalForm]],
   "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "t_{\\rm mix}(1/4)\\ge0.57318\\ldots N(1+o(1))"|>|>,
  ExpressionUUID->"9ce6869c-a847-3d9d-1c26-eb78d67c0d12"],
 ".  The stationary mean\nbridgeless and bridged run lengths are \
respectively"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"7205194b-bd7e-f543-764f-8ddef8525cb4"],

Cell[BoxData[
