         Blank[Integer]], NonNegative]] := 
     Module[{GogFieldDynamics`Private`model = 
        GogFieldDynamics`GogSmallModel[GogFieldDynamics`Private`n], 
        GogFieldDynamics`Private`matrix}, If[
         FailureQ[GogFieldDynamics`Private`model], 
         Return[GogFieldDynamics`Private`model]]; If[
         Not[
          GogFieldDynamics`Private`validStartQ[
          GogFieldDynamics`Private`model, GogFieldDynamics`Private`start]], 
         Return[
          GogFieldDynamics`Private`failure[
          "InvalidStart", 
           "The starting class index is outside the bundled quotient.", <|
           "N" -> GogFieldDynamics`Private`n, "Start" -> 
            GogFieldDynamics`Private`start|>]]]; 
       GogFieldDynamics`Private`matrix = 
        GogFieldDynamics`GogTransitionMatrix[
         GogFieldDynamics`Private`n, GogFieldDynamics`Private`rule]; If[
         FailureQ[GogFieldDynamics`Private`matrix], 
         Return[GogFieldDynamics`Private`matrix]]; 
       Nest[Dot[#, GogFieldDynamics`Private`matrix]& , 
         UnitVector[
          GogFieldDynamics`Private`model["NodeCount"], 
          GogFieldDynamics`Private`start], GogFieldDynamics`Private`steps]], 
     GogFieldDynamics`GogDiffusionState[
       Pattern[GogFieldDynamics`Private`n, 
        Blank[]], 
       Pattern[GogFieldDynamics`Private`rule, 
        Blank[]], 
       Pattern[GogFieldDynamics`Private`start, 
        Blank[]], 
       Pattern[GogFieldDynamics`Private`steps, 
        Blank[]]] := 
     GogFieldDynamics`Private`failure[
      "InvalidDiffusionArguments", 
       "Use an available size, an integer class index, and nonnegative \
steps.", <|
       "N" -> GogFieldDynamics`Private`n, "Rule" -> 
        GogFieldDynamics`Private`rule, "Start" -> 
        GogFieldDynamics`Private`start, "Steps" -> 
        GogFieldDynamics`Private`steps|>], 
     TagSet[GogFieldDynamics`GogDiffusionState, 
      MessageName[GogFieldDynamics`GogDiffusionState, "usage"], 
      "GogDiffusionState[n, rule, start, steps] returns the exact \
distribution after the requested number of quotient-chain steps."], 
     GogFieldDynamics`Private`$labBlue = RGBColor[0., 0.45, 0.7], 
     GogFieldDynamics`Private`$labMuted = RGBColor[0.37, 0.42, 0.49], 
     GogFieldDynamics`Private`$labOrange = RGBColor[0.9, 0.62, 0.], 
     GogFieldDynamics`Private`labGraph[
       Pattern[GogFieldDynamics`Private`n, 
        Blank[Integer]], 
       Pattern[GogFieldDynamics`Private`rule, 
        Blank[String]], 
       Pattern[GogFieldDynamics`Private`probability, 
        Blank[List]], 
       Pattern[GogFieldDynamics`Private`path, 
        Blank[List]], 
       Pattern[GogFieldDynamics`Private`step, 
        Blank[Integer]]] := 
     Module[{GogFieldDynamics`Private`model = 
        GogFieldDynamics`GogSmallModel[GogFieldDynamics`Private`n], 
        GogFieldDynamics`Private`matrix, GogFieldDynamics`Private`coordinates,
         GogFieldDynamics`Private`edges, GogFieldDynamics`Private`size, 
        GogFieldDynamics`Private`maximum, GogFieldDynamics`Private`sampled, 
        GogFieldDynamics`Private`previous, 
        GogFieldDynamics`Private`prefixPairs, 
        GogFieldDynamics`Private`visitedPairs, 
        GogFieldDynamics`Private`activePair, 
        GogFieldDynamics`Private`baseRadius, 
        GogFieldDynamics`Private`edgeLayer, 
        GogFieldDynamics`Private`trailLayer, 
        GogFieldDynamics`Private`activeLayer, 
        GogFieldDynamics`Private`nodeLayer}, 
       GogFieldDynamics`Private`matrix = 
        GogFieldDynamics`GogTransitionMatrix[
         GogFieldDynamics`Private`n, GogFieldDynamics`Private`rule]; 
       GogFieldDynamics`Private`coordinates = 
        GogFieldDynamics`Private`labCoordinates[GogFieldDynamics`Private`n]; 
       GogFieldDynamics`Private`edges = 
        GogFieldDynamics`Private`model["Edges"]; 
       GogFieldDynamics`Private`size = 
        GogFieldDynamics`Private`model["NodeCount"]; 
       GogFieldDynamics`Private`maximum = 
        Max[GogFieldDynamics`Private`probability]; 
       GogFieldDynamics`Private`sampled = 
        Part[GogFieldDynamics`Private`path, 
          Min[GogFieldDynamics`Private`step + 1, 
           Length[GogFieldDynamics`Private`path]]]; 
       GogFieldDynamics`Private`previous = 
        If[GogFieldDynamics`Private`step > 0, 
          Part[GogFieldDynamics`Private`path, 
           Min[GogFieldDynamics`Private`step, 
            Length[GogFieldDynamics`Private`path]]], 
          GogFieldDynamics`Private`sampled]; 
       GogFieldDynamics`Private`prefixPairs = 
        If[GogFieldDynamics`Private`step > 0, 
          Partition[
           Take[GogFieldDynamics`Private`path, 
            Min[GogFieldDynamics`Private`step + 1, 
             Length[GogFieldDynamics`Private`path]]], 2, 1], {}]; 
       GogFieldDynamics`Private`visitedPairs = DeleteDuplicates[
          Map[Sort, 
           Select[
           GogFieldDynamics`Private`prefixPairs, Apply[Unequal, #]& ]]]; 
       GogFieldDynamics`Private`activePair = 
        If[GogFieldDynamics`Private`previous =!= 
          GogFieldDynamics`Private`sampled, 
          
          Sort[{GogFieldDynamics`Private`previous, 
            GogFieldDynamics`Private`sampled}], None]; 
       GogFieldDynamics`Private`baseRadius = 
        If[GogFieldDynamics`Private`size <= 5, 0.17, 0.105]; 
       GogFieldDynamics`Private`edgeLayer = {
          Directive[GogFieldDynamics`Private`$labLine, 
           AbsoluteThickness[1.5]], 
          Map[Line[
            Part[GogFieldDynamics`Private`coordinates, #]]& , 
           GogFieldDynamics`Private`edges]}; 
       GogFieldDynamics`Private`trailLayer = {
          Directive[GogFieldDynamics`Private`$labOrange, 
           Opacity[0.42], 
           AbsoluteThickness[3]], 
          Map[Line[
            Part[GogFieldDynamics`Private`coordinates, #]]& , 
           GogFieldDynamics`Private`visitedPairs]}; 
       GogFieldDynamics`Private`activeLayer = If[
          ListQ[GogFieldDynamics`Private`activePair], {
           Directive[GogFieldDynamics`Private`$labOrange, 
            AbsoluteThickness[4.5]], 
           Line[
            Part[
            GogFieldDynamics`Private`coordinates, 
             GogFieldDynamics`Private`activePair]]}, {}]; 
       GogFieldDynamics`Private`nodeLayer = Table[
          
          With[{GogFieldDynamics`Private`mass = 
            Part[GogFieldDynamics`Private`probability, 
              GogFieldDynamics`Private`index], GogFieldDynamics`Private`hold = 
            Part[GogFieldDynamics`Private`matrix, 
              GogFieldDynamics`Private`index, GogFieldDynamics`Private`index],
             GogFieldDynamics`Private`code = Part[
              GogFieldDynamics`Private`model["Nodes"], 
              GogFieldDynamics`Private`index], GogFieldDynamics`Private`point = 
            Part[GogFieldDynamics`Private`coordinates, 
              GogFieldDynamics`Private`index], 
            GogFieldDynamics`Private`radius = 
            GogFieldDynamics`Private`baseRadius (0.78 + 0.42 Sqrt[
                 N[
                 Part[GogFieldDynamics`Private`probability, 
                    GogFieldDynamics`Private`index]/
                  GogFieldDynamics`Private`maximum]]), 
            GogFieldDynamics`Private`selected = 
            GogFieldDynamics`Private`index === 
             GogFieldDynamics`Private`sampled}, 
           Tooltip[{
             If[GogFieldDynamics`Private`selected, {
               Directive[GogFieldDynamics`Private`$labOrange, 
                AbsoluteThickness[3]], 
               Circle[
               GogFieldDynamics`Private`point, 
                GogFieldDynamics`Private`radius 1.22]}, Nothing], 
             EdgeForm[
              Directive[GogFieldDynamics`Private`$labLine, 
               AbsoluteThickness[1.6]]], 
             GogFieldDynamics`Private`labProbabilityColor[
             GogFieldDynamics`Private`mass, GogFieldDynamics`Private`maximum], 
             Disk[
             GogFieldDynamics`Private`point, GogFieldDynamics`Private`radius], 
             Text[
              Style[
               GogFieldDynamics`Private`labLabel[
               GogFieldDynamics`Private`index], 
               If[GogFieldDynamics`Private`size <= 5, 9, 6.5], Bold, 
               If[
               N[GogFieldDynamics`Private`mass/
                  GogFieldDynamics`Private`maximum] > 0.34, White, 
                GogFieldDynamics`Private`$labNavy], FontFamily -> 
               "Helvetica"], GogFieldDynamics`Private`point]}, 
            Grid[{{
               Style["class", Bold], 
               GogFieldDynamics`Private`labLabel[
               GogFieldDynamics`Private`index]}, {"exact mass", 
               NumberForm[
                N[GogFieldDynamics`Private`mass], {4, 3}]}, {
              "holding probability", 
               NumberForm[
                N[GogFieldDynamics`Private`hold], {4, 3}]}, {"canonical code", 
               Style[
               GogFieldDynamics`Private`code, 8, FontFamily -> "Courier"]}}, 
             Alignment -> Left, Spacings -> {0.8, 0.35}]]], {
          GogFieldDynamics`Private`index, GogFieldDynamics`Private`size}]; 
       Graphics[{
         GogFieldDynamics`Private`edgeLayer, 
          GogFieldDynamics`Private`trailLayer, 
          GogFieldDynamics`Private`activeLayer, 
          GogFieldDynamics`Private`nodeLayer}, 
         PlotRange -> {{-2.05, 2.05}, {-1.62, 1.62}}, PlotRangePadding -> 
         Scaled[0.03], ImageSize -> {248, 190}, Background -> White]], 
     GogFieldDynamics`Private`labCoordinates[2] := {{-1.15, 0}, {1.15, 0}}, 
     GogFieldDynamics`Private`labCoordinates[4] := {{-0.8, 
      0.45}, {-1.6, -0.5}, {0., 0.}, {1.6, -0.4}, {0.8, 0.5}}, 
     GogFieldDynamics`Private`labCoordinates[
       Pattern[GogFieldDynamics`Private`n, 
        Blank[Integer]]] := (
      GogFieldDynamics`Private`labCoordinates[GogFieldDynamics`Private`n] = 
      Module[{GogFieldDynamics`Private`model = 
         GogFieldDynamics`GogSmallModel[GogFieldDynamics`Private`n], 
         GogFieldDynamics`Private`graph, GogFieldDynamics`Private`points, 
         GogFieldDynamics`Private`centered, GogFieldDynamics`Private`scale}, 
        GogFieldDynamics`Private`graph = Graph[
           Range[
            GogFieldDynamics`Private`model["NodeCount"]], 
           MapApply[UndirectedEdge, 
            GogFieldDynamics`Private`model["Edges"]], GraphLayout -> 
           "SpringElectricalEmbedding"]; GogFieldDynamics`Private`points = N[
           GraphEmbedding[GogFieldDynamics`Private`graph]]; 
        GogFieldDynamics`Private`centered = 
         Map[# - Mean[GogFieldDynamics`Private`points]& , 
           GogFieldDynamics`Private`points]; 
        GogFieldDynamics`Private`scale = Max[
           Map[Norm, GogFieldDynamics`Private`centered]]; If[
          Or[
           Not[
            NumericQ[GogFieldDynamics`Private`scale]], 
           GogFieldDynamics`Private`scale == 0], 
          GogFieldDynamics`Private`scale = 1.]; 
        Map[{1.72, 1.34} (#/GogFieldDynamics`Private`scale)& , 
          GogFieldDynamics`Private`centered]]), 
     GogFieldDynamics`Private`$labLine = RGBColor[0.82, 0.85, 0.88], 
     GogFieldDynamics`Private`labProbabilityColor[
       Pattern[GogFieldDynamics`Private`mass, 
        Blank[]], 
       Pattern[GogFieldDynamics`Private`maximum, 
        Blank[]]] := 
     Blend[{GogFieldDynamics`Private`$labWash, 
        GogFieldDynamics`Private`$labSky, GogFieldDynamics`Private`$labBlue}, 
       
       Clip[
        If[GogFieldDynamics`Private`maximum > 0, 
         Sqrt[
          N[GogFieldDynamics`Private`mass/GogFieldDynamics`Private`maximum]], 
         0], {0, 1}]], GogFieldDynamics`Private`$labWash = 
     RGBColor[0.965, 0.975, 0.985], GogFieldDynamics`Private`$labSky = 
     RGBColor[0.34, 0.71, 0.91], GogFieldDynamics`Private`$labNavy = 
     RGBColor[0.075, 0.13, 0.22], GogFieldDynamics`Private`labMassBars[
       Pattern[GogFieldDynamics`Private`probability, 
        Blank[List]]] := 
     Module[{GogFieldDynamics`Private`indices, 
        GogFieldDynamics`Private`maximum, GogFieldDynamics`Private`count, 
        GogFieldDynamics`Private`rows}, 
       GogFieldDynamics`Private`count = Min[5, 
          Length[GogFieldDynamics`Private`probability]]; 
       GogFieldDynamics`Private`indices = TakeLargestBy[
          Range[
           Length[GogFieldDynamics`Private`probability]], Part[
          GogFieldDynamics`Private`probability, #]& , 
          GogFieldDynamics`Private`count]; 
       GogFieldDynamics`Private`maximum = Max[
          Part[
          GogFieldDynamics`Private`probability, 
           GogFieldDynamics`Private`indices]]; 
       GogFieldDynamics`Private`rows = MapIndexed[
          
          Function[{
           GogFieldDynamics`Private`index, GogFieldDynamics`Private`position}, 
           
           With[{GogFieldDynamics`Private`y = 
             GogFieldDynamics`Private`count - First[
              GogFieldDynamics`Private`position] + 1, 
             GogFieldDynamics`Private`mass = 
             Part[GogFieldDynamics`Private`probability, 
               GogFieldDynamics`Private`index], 
             GogFieldDynamics`Private`width = 
             If[GogFieldDynamics`Private`maximum > 0, 
               N[
               Part[GogFieldDynamics`Private`probability, 
                  GogFieldDynamics`Private`index]/
                GogFieldDynamics`Private`maximum], 0]}, {
             Text[
              Style[
               GogFieldDynamics`Private`labLabel[
               GogFieldDynamics`Private`index], 8, Bold, 
               GogFieldDynamics`Private`$labNavy, FontFamily -> 
               "Helvetica"], {-0.05, GogFieldDynamics`Private`y}, {1, 0}], {
             GogFieldDynamics`Private`$labWash, 
              
              Rectangle[{0, GogFieldDynamics`Private`y - 0.22}, {
               1, GogFieldDynamics`Private`y + 0.22}]}, {
              GogFieldDynamics`Private`labProbabilityColor[
              GogFieldDynamics`Private`mass, 
               GogFieldDynamics`Private`maximum], 
              
              Rectangle[{0, GogFieldDynamics`Private`y - 0.22}, {
               GogFieldDynamics`Private`width, GogFieldDynamics`Private`y + 
                0.22}]}, 
             Text[
              Style[
               ToString[
                NumberForm[
                 N[GogFieldDynamics`Private`mass], {3, 2}]], 8, 
               GogFieldDynamics`Private`$labMuted, FontFamily -> 
               "Helvetica"], {1.06, GogFieldDynamics`Private`y}, {-1, 0}]}]], 
          GogFieldDynamics`Private`indices]; 
       Graphics[
        GogFieldDynamics`Private`rows, 
         PlotRange -> {{-0.33, 1.34}, {
           0.45, GogFieldDynamics`Private`count + 0.55}}, 
         ImageSize -> {116, 105}, Background -> White]], 
     GogFieldDynamics`Private`labMetric[
       Pattern[GogFieldDynamics`Private`label, 
        Blank[String]], 
       Pattern[GogFieldDynamics`Private`value, 
        Blank[]], 
       Pattern[GogFieldDynamics`Private`color, 
        Blank[]]] := Framed[
       Column[{
         Style[
         GogFieldDynamics`Private`label, 6.5, Bold, 
          GogFieldDynamics`Private`$labMuted, FontFamily -> "Helvetica"], 
         Style[
         GogFieldDynamics`Private`value, 9, Bold, 
          GogFieldDynamics`Private`color, FontFamily -> "Helvetica"]}, 
        Alignment -> Left, Spacings -> 0.1], Background -> 
       Blend[{White, GogFieldDynamics`Private`color}, 0.06], FrameStyle -> 
       Directive[
         Opacity[0.28], GogFieldDynamics`Private`color], 
       FrameMargins -> {{6, 6}, {4, 4}}, ImageSize -> {56, 39}], 
     GogFieldDynamics`Private`$labGreen = RGBColor[0., 0.62, 0.45], 
     GogFieldDynamics`Private`$labPurple = RGBColor[0.57, 0.38, 0.74], 
     GogFieldDynamics`Private`labEngineLabel[
       Pattern[GogFieldDynamics`Private`trajectory, 
        Blank[Association]]] := 
     Module[{GogFieldDynamics`Private`engine = 
        Lookup[GogFieldDynamics`Private`trajectory, "Engine", "unknown"], 
        GogFieldDynamics`Private`version}, 
       GogFieldDynamics`Private`version = 
        Lookup[GogFieldDynamics`Private`trajectory, "SetReplaceVersion", 
          Missing[]]; If[
         And[GogFieldDynamics`Private`engine === "SetReplace", 
          StringQ[GogFieldDynamics`Private`version]], "SETREPLACE " <> 
         GogFieldDynamics`Private`version <> " PATH", 
         ToUpperCase[GogFieldDynamics`Private`engine] <> " PATH"]], 
     GogFieldDynamics`Private`labPathRibbon[
       Pattern[GogFieldDynamics`Private`path, 
        Blank[List]], 
       Pattern[GogFieldDynamics`Private`step, 
        Blank[Integer]]] := 
     Module[{GogFieldDynamics`Private`prefix, 
        GogFieldDynamics`Private`visible, GogFieldDynamics`Private`labels}, 
       GogFieldDynamics`Private`prefix = Take[GogFieldDynamics`Private`path, 
          Min[GogFieldDynamics`Private`step + 1, 
           Length[GogFieldDynamics`Private`path]]]; 
       GogFieldDynamics`Private`visible = 
        Take[GogFieldDynamics`Private`prefix, -Min[7, 
            Length[GogFieldDynamics`Private`prefix]]]; 
       GogFieldDynamics`Private`labels = 
        Map[GogFieldDynamics`Private`labLabel, 
          GogFieldDynamics`Private`visible]; 
       If[Length[GogFieldDynamics`Private`prefix] > 
         Length[GogFieldDynamics`Private`visible], 
         GogFieldDynamics`Private`labels = 
         Prepend[GogFieldDynamics`Private`labels, "\[Ellipsis]"]]; Row[
         Riffle[
          Map[
          Style[#, 8, Bold, GogFieldDynamics`Private`$labNavy, FontFamily -> 
            "Helvetica"]& , GogFieldDynamics`Private`labels], 
          Style[
          "  \[RightArrow]  ", 9, Bold, 
           GogFieldDynamics`Private`$labOrange]]]]}; Quiet[
     Check[
      Module[{
       GogFieldDynamics`Private`directory, 
        GogFieldDynamics`Private`localKernel}, 
       GogFieldDynamics`Private`directory = Quiet[
          Check[
           NotebookDirectory[], $Failed]]; If[
         StringQ[GogFieldDynamics`Private`directory], 
         GogFieldDynamics`Private`localKernel = 
          FileNameJoin[{
            GogFieldDynamics`Private`directory, "Wolfram", "GogFieldDynamics",
              "Kernel", "init.wl"}]; If[
           FileExistsQ[GogFieldDynamics`Private`localKernel], 
           Get[GogFieldDynamics`Private`localKernel]]; Null]; If[
         Not[
          NameQ["GogFieldDynamics`GogDiffusionState"]], 
         Needs["GogFieldDynamics`"]]; Null], Null]]),
  SynchronousInitialization->True]], "Output",
 ShowCellBracket->False,
 CellMargins->{{12, 12}, {12, 8}},
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGDiffusionLab"|>|>,
 TextAlignment->Center,
 FontSlant->Plain,
 Background->GrayLevel[1],
 CellTags->{
