    "SourceTeX" -> 
     "\\[\n \\frac1{2m}\\log\\left(\n 1-\\frac{a_N}{2(N-1)(1+\\sqrt \
m)^2}\\right)<0.\n\\]", "EnvironmentClose" -> "\n\\end{proposition}", 
     "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"aad3f6ff-0e1d-45eb-3af5-19f7260f1dea"],

Cell[TextData[{
