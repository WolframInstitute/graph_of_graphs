Cell[TextData[{
 "We study scalar averaging while a connected cubic multigraph changes by\n\
Whitehead moves.  When an edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\{i,j\\}"|>|>,
  ExpressionUUID->"30fbf617-dfc5-cd4e-1a2c-896e84343178"],
 " is selected, its endpoint values are\nboth replaced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["f", "i"], "+", 
      SubscriptBox["f", "j"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(f_i+f_j)/2"|>|>,
  ExpressionUUID->"0b84ae95-54a2-05df-3017-65708269d669"],
 ".  The field variance"
}], "Abstract",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "abstract", "EnvironmentOpen" -> "\\begin{abstract}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"50e750a5-1a7e-eab6-e5bd-a284620572e1"],

