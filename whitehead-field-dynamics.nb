Cell[TextData[{
 "A loop vertex has one remaining incident edge, which is a singleton-side\n\
bridge.  Up to an event of probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"713ca3f5-ef6c-aecb-a612-339eac92196c"],
 ", all bridges are of this\nform.  Hence ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_0"|>|>,ExpressionUUID->
  "1ec3f05b-d893-ef0c-9371-ea94ad20b562"],
 " differs from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"L", "\[LongEqual]", "0"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\{L=0\\}"|>|>,
  ExpressionUUID->"defe069d-ab34-1ecf-07cf-5745bee30c97"],
 " by probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"2b276c2f-e1cb-19eb-c9cd-7033df64b44d"],
 " and\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "1"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_1"|>|>,ExpressionUUID->
  "c80bab30-b967-34d5-94f1-0605a8ae2378"],
 " differs from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"L", "\[LongEqual]", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\{L=1\\}"|>|>,
  ExpressionUUID->"461459f5-fdd0-79f3-6f30-bf48c002e5d2"],
 " by probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"fab6a865-8d85-c504-a634-29cc20850bbe"],
 ".  The Poisson limit\ngives the three stationary-mass limits, and \
substitution in the exact flow\nformula gives the conductance asymptotic."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"91ad853f-40ea-2a4c-20fa-b611e8791806"],

