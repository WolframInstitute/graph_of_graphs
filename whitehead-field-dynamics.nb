Cell[TextData[{
 "These maps are not invertible: every nonloop ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "m"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T_m"|>|>,ExpressionUUID->
  "9505e991-2bb0-c86e-2afa-2a38ce4b7895"],
