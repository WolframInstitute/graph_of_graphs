Cell[TextData[{
 "The sizes shown are not yet in the asymptotic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"6", " ", "N"}], "-", 
    RowBox[{"O", "(", "1", ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N-O(1)"|>|>,
  ExpressionUUID->"77e35435-9c04-cfb2-1ce8-7a8c82ef5a7d"],
 " regime, but the\nratios increase monotonically over this range.  Exact \
rational arithmetic\nalso verifies the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "4"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "K_4"|>|>,ExpressionUUID->
  "2ccda343-a1e4-fd21-5d85-d4d76b8f50c3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "3"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "Q_3"|>|>,ExpressionUUID->
  "8db765fd-bf9c-1b3f-9ab6-e0b7f37ef0da"],
 " consensus products, and direct evaluation\nof the resolution-independent \
energy identity on sampled transitions agrees\nto machine precision."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"d74baff9-b4dd-ee95-d4fa-eccc209d2b64"],

Cell[TextData[{
 StyleBox["Reproducibility.",
  FontWeight->"Bold"],
 "\n",
 "The script gog_generate.py constructs the canonical class and\ntransition \
tables.  The reported multiplicity/support spectra and bridge\nstatistics are \
produced by gog_edge_model_experiments.py;\ngog_support_feature_analysis.py \
evaluates short-cycle and Rule-B\ndiagnostics, and gog_ball_growth.py samples \
support balls.\nLabelled-degree and automorphism checks are implemented in\n\
gog_degree_diagnostics.py.  Exact commands, conventions, and\nnumerical \
limitations are recorded in docs/computation.rst."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> "\n\n", "BibliographyTeX" -> 
     "\\paragraph{Reproducibility.}\nThe script \\path{gog\\_generate.py} \
constructs the canonical class and\ntransition tables.  The reported \
multiplicity/support spectra and bridge\nstatistics are produced by \
\\path{gog\\_edge\\_model\\_experiments.py};\n\
\\path{gog\\_support\\_feature\\_analysis.py} evaluates short-cycle and \
Rule-B\ndiagnostics, and \\path{gog\\_ball\\_growth.py} samples support \
balls.\nLabelled-degree and automorphism checks are implemented in\n\
\\path{gog\\_degree\\_diagnostics.py}.  Exact commands, conventions, and\n\
numerical limitations are recorded in \\path{docs/computation.rst}."|>|>,
 FontSlant->Plain,ExpressionUUID->"1448d95f-4cd9-462c-7b81-9d1d23721a08"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Lean Verification Boundary", "Section",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"f2946c5c-d83d-596a-47f8-c7a1cc32307c"],

Cell["\<\
A self-contained Lean\[NonBreakingSpace]4 project in lean/ kernel-checks the \
exact
finite algebra that is actually formalized.  It uses exact rational \
arithmetic
and the standard library only; the project source contains no sorry,
admit, or project-declared axiom.  Representative
#print axioms checks report only Lean's foundational principles
propext, Classical.choice, and Quot.sound.  The
checked declarations include:\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> "\n", "BibliographyTeX" -> 
     "A self-contained Lean~4 project in \\texttt{lean/} kernel-checks the \
exact\nfinite algebra that is actually formalized.  It uses exact rational \
arithmetic\nand the standard library only; the project source contains no \
\\texttt{sorry},\n\\texttt{admit}, or project-declared \\texttt{axiom}.  \
Representative\n\\texttt{\\#print axioms} checks report only Lean's \
foundational principles\n\\texttt{propext}, \\texttt{Classical.choice}, and \
\\texttt{Quot.sound}.  The\nchecked declarations include:"|>|>,
 FontSlant->Plain,ExpressionUUID->"f5330c86-7b45-a6bf-364f-114dd5dd6409"],

Cell[TextData[{
 "the coordinate definition of pair averaging, symmetry, affine and\n    \
centering covariance, preservation of the selected-pair sum, idempotence,\n   \
 and the exact squared-norm/variance drop ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "i"], "-", 
       SubscriptBox["x", "j"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(x_i-x_j)^2/2"|>|>,
  ExpressionUUID->"84f411b3-ba5d-e6ef-0970-1fa50c7b5577"],
 " with an arbitrary\n    unchanged remainder;"
}], "Item",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "\\begin{itemize}[leftmargin=*]\n    \\item ", 
     "Separator" -> "\n"|>|>,
 CounterAssignments->{{"Item", 0}},
 FontSlant->Plain,ExpressionUUID->"11774c1a-1582-25c3-a3be-d02543233d9f"],

Cell["commutation of averages on disjoint pairs;", "Item",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c7d012d2-2824-c5d4-057a-392f5cc1c9ee"],

Cell["\<\
identity, composition, and inverse laws for pullback by an explicit
    coordinate permutation, including exact conjugacy between relabelling and
    pair averaging;\
\>", "Item",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"2b04900c-988f-b2f4-2191-3dc6c4e26235"],

Cell[TextData[{
 "preservation of total mass, commutation and idempotence of the block\n    \
schedules, and exact consensus for the two transverse ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "4"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "K_4"|>|>,ExpressionUUID->
  "c96e4517-0277-9d22-5aa6-542891f1dcd8"],
 " matchings and\n    the three coordinate matchings of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "3"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "Q_3"|>|>,ExpressionUUID->
  "c2766c2a-eb97-f0cb-69ab-d5332a7d3441"],
 ";"
}], "Item",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"3b455521-d7d6-95c7-184b-63b8627ad8dc"],

Cell[TextData[{
 "a common-denominator proof that no finite pair-average schedule sends\n    \
the three-state datum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0", ",", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(0,0,1)"|>|>,
  ExpressionUUID->"1f996a04-5380-b06b-6ac0-df389c4abedb"],
 " to exact consensus;"
}], "Item",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"458708fe-28de-76cf-0312-8ade7be94529"],

Cell[TextData[{
 "concrete ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2\\times2"|>|>,
  ExpressionUUID->"1287e1f4-790e-d4da-0ac3-62b6338991e8"],
 " identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "2"], "\[LongEqual]", "A"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A^2=A"|>|>,
  ExpressionUUID->"425f7b4b-0d87-e024-afb8-a6d90c3c57c0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", " ", "A"}], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A\\one=\\one"|>|>,
  ExpressionUUID->"c9a0fe6f-45bc-33c9-6e51-94f8a9f51f9c"],
 ", and agreement\n    between matrix and coordinate pair averaging."
}], "Item",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "EnvironmentClose" -> 
     "\n\\end{itemize}", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"19f7b56a-e3d6-6e50-dfa8-d6754559b412"],

Cell["\<\
From the lean/ directory, lake build checks the project.
The theorem map is in lean/README.md.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> "\n\n", "BibliographyTeX" -> 
     "From the \\texttt{lean/} directory, \\texttt{lake build} checks the \
project.\nThe theorem map is in \\path{lean/README.md}."|>|>,
 FontSlant->Plain,ExpressionUUID->"bdd7a1dc-2030-2407-04ce-f2b08dde9562"],

Cell["\<\
This is deliberately not advertised as a formalization of the whole paper.
Lean does not presently check the Whitehead graph or its quotient, construct
settlements, prove their coherence, or address stabilizer holonomy.  Nor does
it check the configuration counts, the representation-theoretic argument,
random-graph inputs, asymptotics, or Lyapunov and mixing theorems.  The \
dyadic
result is a concrete three-state obstruction rather than a classification of
finite consensus protocols.  The formal layer certifies only the finite
averaging identities on which several of those arguments rely.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"6e886c02-61dd-4cfc-1693-008582d050c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Open Problems", "Section",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"18d5b31e-f96a-5cd6-0123-ae697f9df39c"],

Cell[TextData[{
 "After fixing a settlement cocycle and excluding sizes with finite killing\n\
words, is the top Lyapunov exponent asymptotic to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["\[Theta]", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "-\\theta/N"|>|>,
  ExpressionUUID->"cb9ee5ef-f586-9b31-186c-16c4b137d386"],
 "?  If yes, is\n",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\theta"|>|>,
  ExpressionUUID->"dc98b5b6-d30f-7ff6-3103-9f20cbc8e752"],
 " determined only by typical cubic expansion, or does it remember\n\
carrier--field alignment and projection noncommutativity?"
}], "Question",
 CellDingbat->Cell[
   TextData[{"Question ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "question", "EnvironmentOpen" -> "\\begin{question}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{question}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"c8a6af18-5914-a0fb-6ff5-e542f24e0641"],

Cell["\<\
Can the square-defect curvature be related to GoG eigenvectors with small
Laplacian eigenvalues?  The plausible mechanism is that local motifs
responsible for bottleneck eigenvectors
also create high curvature density for incident Whitehead moves, but this is \
a
testable statement rather than a theorem.\
\>", "Question",
 CellDingbat->Cell[
   TextData[{"Question ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "question", "EnvironmentOpen" -> "\\begin{question}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{question}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"f3177b7d-2e68-ed42-9a8e-eef4c8e5d280"],

Cell[TextData[{
 "Does the finite bridge identity\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["C", "1"], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", "N"}], "2"], "-", "1"}], ")"}]}], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SubscriptBox["C", "0"], " ", 
     RowBox[{"(", 
      RowBox[{"3", " ", "N"}], ")"}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "(3N/2-1)C_1=(3N/2)C_0"|>|>,
  ExpressionUUID->"3089639b-f724-7384-429e-e218b16be520"],
 " hold for all even ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "4488177e-87ba-f59c-8595-711feb4a7ce0"],
 ", and can one prove a matching\n",
 Cell[BoxData[
  FormBox[
   FractionBox["c", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c/N"|>|>,ExpressionUUID->
  "6c477707-8dc1-7b5a-03a4-6f94de5aa8ab"],
 " Poincar\\'e lower bound for the labelled local Johnson-update lift?"
}], "Question",
 CellDingbat->Cell[
   TextData[{"Question ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "question", "EnvironmentOpen" -> "\\begin{question}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{question}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"7810eae7-789f-7585-39b3-dcb698281739"],

Cell[TextData[{
 "Under the uniform law on unlabelled classes, does every fixed short-cycle\n\
property used above occupy a positive limiting fraction of the classes, and \
do\nfinite families of their centered membership functions have a nonsingular\
\nlimiting Gram matrix?  These statements would make the fixed-clock Rule-B\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"6fbecd80-485f-14d5-a8ce-2c26a0e0105c"],
 " eigenvalue bounds unconditional without any support-degree\nestimate.  In \
the other direction, can one prove\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Lambda]", "2"], "(", 
     SubscriptBox["L", "supp"], ")"}], "\[GreaterEqual]", "c", ">", "0"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\lambda_2(L_{\\rm supp})\\ge c>0"|>|>,
  ExpressionUUID->"54f8008c-df50-e97c-2de3-c960329d96c6"],
 ", which together with\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]]}], "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["L", "TI"], "supp"], "/", 
     RowBox[{"(", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}], ")"}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "I-P_B=L_{\\rm supp}/(3N)"|>|>,
  ExpressionUUID->"de453bc7-738d-5751-4f94-4f96b9013262"],
 " would give a matching ",
 Cell[BoxData[
  FormBox[
   FractionBox["c", 
    RowBox[{"3", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c/(3N)"|>|>,
  ExpressionUUID->"80875bbe-a3eb-0e9c-7b36-24db8f0a502f"],
 " lower bound?"
}], "Question",
 CellDingbat->Cell[
   TextData[{"Question ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "question", "EnvironmentOpen" -> "\\begin{question}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{question}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"aed38051-ccc7-c31a-185b-95b6342a50ac"],

Cell[TextData[{
 "Is there a useful Hodge-like theory for the covariant difference ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "D"|>|>,ExpressionUUID->
  "445c9d5a-94d5-f5b2-52f9-d24791af4f69"],
 " on the\nfield bundle over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"b481bc27-09c4-2e2b-4765-4f0ca0829407"],
 "?  Such a theory must first specify edge-to-two-cell\ndifferentials for a \
noninvertible semigroup cocycle and treat automorphism\ngroups as finite \
gauge stabilizers."
}], "Question",
 CellDingbat->Cell[
   TextData[{"Question ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "question", "EnvironmentOpen" -> "\\begin{question}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{question}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"a45f2d6a-7960-11cc-c5a9-46c196326225"]
}, Open  ]],

