Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Kappa]", 
     StyleBox["e", "TI"]], "\[LongEqual]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["e", "TI"], 
      StyleBox["T", "TI"]], 
     SubscriptBox[
      StyleBox["L", "TI"], 
