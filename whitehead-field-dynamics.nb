   FractionBox[
    RowBox[{"3", " ", "N"}], "2"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N/2"|>|>,
  ExpressionUUID->"46bed33f-d22f-0233-47be-0ad2771dd19c"],
 " edge objects of ",
 Cell[BoxData[
