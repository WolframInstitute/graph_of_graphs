 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\E L_G=\\frac{9N}{3N-1}\n       \\left(I-\\frac1N\\one\\one^T\
\\right).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e2bbc215-ada9-807b-be94-54f339c01b10"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptL]", 
