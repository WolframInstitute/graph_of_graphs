Cell[TextData[{
 "At every enumerated ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[GreaterEqual]", "4"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\ge4"|>|>,
  ExpressionUUID->"6b4c5fb5-04c4-1d66-bdcb-05a78951cd8c"],
 ", the minimizer is the alternating\nsingle/double-edge path with endpoint \
loops used in the proof of the\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", 
     SuperscriptBox["N", "2"]], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-2})"|>|>,
  ExpressionUUID->"ca0729b4-b709-c791-b72a-61eb6598bd69"],
 " extremal upper bound."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
