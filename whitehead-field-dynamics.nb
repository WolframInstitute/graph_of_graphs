     "\n\n"|>|>,ExpressionUUID->"efa43738-8f75-8a4a-58a0-36e0986d5e93"],

Cell[TextData[{
 "Detailed balance symmetrizes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "A"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "P_A"|>|>,ExpressionUUID->
  "2e3bcb39-1ef1-7cb4-3889-d9238911f2bd"],
 ".  Upstairs, freeze a central nonloop edge\nand the four surrounding \
labelled stubs.  Their six two--two assignments form\nthe Johnson graph ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "(", 
    RowBox[{"4", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J(4,2)"|>|>,
  ExpressionUUID->"e362c818-ed04-aae8-5607-d2e2be415b7b"],
 ", whose normalized adjacency spectrum is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}]}], "}"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\{1,0,-1/2\\}"|>|>,
  ExpressionUUID->"c8a2ff3a-f3d3-c2a3-a19f-a155d4a8094b"],
 ".  A loop gives the identity.  Averaging these local kernels and\n\
restricting to class-invariant functions proves the spectral interval.  The\n\
row sum of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M_N"|>|>,ExpressionUUID->
  "17e5715f-5e07-b0e7-44bc-51bd3d1cdfee"],
 " is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "639ad37c-0516-6532-a1fb-005f43e4f31a"],
 ", proving the Perron and history claims.  The\nentropy formula follows by \
expanding the entropy of the row probabilities\n",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["m", "GH"], 
    RowBox[{"3", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{GH}/(3N)"|>|>,
  ExpressionUUID->"8691d46c-4154-d8de-6d68-efd69030ff00"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Delta_N"|>|>,
  ExpressionUUID->"62fac88e-e702-cbf2-97f0-3bc710c54e14"],
 " is precisely the conditional entropy of the chosen\nslot given source and \
target classes.  Finally,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"m", " ", "m", " ", "log"}], "\[LessEqual]", 
    RowBox[{"m", "(", 
     RowBox[{"m", "-", "1"}], ")"}], "\[LongEqual]", 
    RowBox[{"2", " ", 
     TemplateBox[{"m", "2"},
      "Binomial"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "m\\log m\\le m(m-1)=2\\binom m2"|>|>,
  ExpressionUUID->"3b16cd57-4e02-58d3-9779-ba8224fc95d0"],
 " for every positive integer ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m"|>|>,ExpressionUUID->
  "cf8d814a-358a-1360-bd5b-f96d7e0f9bf4"],
 ", which proves\nthe collision bound."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"2357785e-31ee-ff89-e2ac-8ff9958d4aee"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[GreaterEqual]", "4"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\ge4"|>|>,
  ExpressionUUID->"faa57932-f335-a33e-ae06-98a86ef3d037"],
 ", let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L(G)"|>|>,
  ExpressionUUID->"bc366331-ada1-30f1-16e6-12c48c056beb"],
 " be the number of carrier loops and\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Mu]", "N"], "(", "k", ")"}], "\[LongEqual]", 
    RowBox[{
     SubscriptBox["\[Pi]", "A"], " ", 
     RowBox[{"{", 
      RowBox[{"L", "\[LongEqual]", "k"}], "}"}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\mu_N(k)=\\pi_A\\{L=k\\}"|>|>,
  ExpressionUUID->"84392aac-48b8-632b-fab4-6b0b15b5ab94"],
 ".  Then for every function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f"|>|>,ExpressionUUID->
  "23e82e91-4eb6-845e-b2f4-48f41eb0c3b3"],
 " on the nonnegative\nintegers,"
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[Exact loop-count Dirichlet form]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->
  "Theorem",ExpressionUUID->"9f2945c1-f639-1efe-876f-84c0e284700a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["A", "TI"]], "(", 
    RowBox[{
     RowBox[{
      StyleBox["f", "TI"], "(", 
      StyleBox["L", "TI"], ")"}], ",", 
     RowBox[{
      StyleBox["f", "TI"], "(", 
      StyleBox["L", "TI"], ")"}]}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox["2", 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "TI"], "\[GreaterEqual]", "1"}],
      LimitsPositioning->True], 
     RowBox[{
      StyleBox["k", "TI"], 
      RowBox[{
       SubscriptBox["\[Mu]", 
        StyleBox["N", "TI"]], "(", 
       StyleBox["k", "TI"], ")"}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           StyleBox["f", "TI"], "(", 
           StyleBox["k", "TI"], ")"}], "-", 
          RowBox[{
           StyleBox["f", "TI"], "(", 
           RowBox[{
            StyleBox["k", "TI"], "-", "1"}], ")"}]}], ")"}], "2"], 
       "."}]}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\mathcal E_A(f(L),f(L))\n =\\frac{2}{3N}\\sum_{k\\ge1}k\\mu_N(k)\
\n       \\bigl(f(k)-f(k-1)\\bigr)^2.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"4b64c8e6-054d-77be-9aac-69f9361bb9d3"],

Cell[TextData[{
 "Consequently, for every fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[GreaterEqual]", "1"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "r\\ge1"|>|>,
  ExpressionUUID->"1ddca5cf-f30b-2245-f6e7-30291547c151"],
 ","
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"6b4417c2-6265-d166-ca8d-2d82113233e2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", 
     RowBox[{
      StyleBox["r", "TI"], "+", "1"}]], "(", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["A", "TI"]]}], ")"}], "\[LessEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{"2", 
      StyleBox["r", "TI"]}], 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], "+", 
    RowBox[{
     RowBox[{
      StyleBox["o", "TI"], "(", 
      SuperscriptBox[
       StyleBox["N", "TI"], 
       RowBox[{"-", "1"}]], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\lambda_{r+1}(I-P_A)\\le\\frac{2r}{3N}+o(N^{-1}).\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"fd96ec39-5806-a3d0-c1f3-576f6aa75268"],

Cell[TextData[{
 "With the convention\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "LS"], "\[LongEqual]", 
    RowBox[{"inf", 
     RowBox[{
      RowBox[{
       StyleBox["E", "TI"], "(", 
       RowBox[{
        StyleBox["F", "TI"], ",", 
        StyleBox["F", "TI"]}], ")"}], "/", 
      SubscriptBox[
       StyleBox[
        RowBox[{"E", "n", "t"}], "TI"], 
       SubscriptBox["\[Pi]", 
        StyleBox["A", "TI"]]]}], 
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["F", "TI"], "2"], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> 
      "\\alpha_{\\rm LS}=\\inf\\mathcal \
E(F,F)/\\operatorname{Ent}_{\\pi_A}(F^2)"|>|>,ExpressionUUID->
  "b256fa6d-d8cc-398a-0395-586a219222e1"],
 ",\nalso ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "LS"], "\[LessEqual]", 
    RowBox[{
     RowBox[{"o", "(", 
      FractionBox["1", "N"], ")"}], "+", 
     FractionBox["2", 
      RowBox[{"3", " ", "N"}]]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "\\alpha_{\\rm LS}\\le2/(3N)+o(N^{-1})"|>|>,
  ExpressionUUID->"2ffe8fec-70f8-d0b3-b46c-05e171a64b61"],
 "."
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"85d6caae-1b75-33ea-6c8e-2a3d01af5d01"],

Cell[TextData[{
 "A state with ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "4abc6299-10e9-f0be-f8b5-8cef86ff6f30"],
 " loops has exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "k"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2k"|>|>,ExpressionUUID->
  "ef2af0e5-f7f4-bb34-9a39-d9238b9c06e4"],
 " compressed slots that destroy one\nloop.  No move changes loop count by \
more than one when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[GreaterEqual]", "4"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\ge4"|>|>,
  ExpressionUUID->"6b9fd29f-696a-2812-8239-ac71569fada3"],
 ".  Detailed\nbalance supplies the reverse aggregate flow and gives the \
displayed form.\nUnder ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "A"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\pi_A"|>|>,
  ExpressionUUID->"4f2b7563-67d8-8aaa-3ca7-b8894791be4f"],
 ", ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L"|>|>,ExpressionUUID->
  "7c879d8a-cdce-3717-84ae-db29b1d55ee8"],
 " tends to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "Pois"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\operatorname{Pois}(1)"|>|>,
  ExpressionUUID->"fccd1e02-301f-a4c6-6eb1-a6c93b28bef9"],
 ".  Applying min--max to\nthe first ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "r"|>|>,ExpressionUUID->
  "b11d5dcd-9ea3-5530-9893-84ec2609f34c"],
 " Charlier polynomials, whose limiting immigration--death\nRayleigh \
quotients are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "\[Ellipsis]", ",", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1,\\ldots,r"|>|>,
  ExpressionUUID->"b6457b53-a010-7e58-f028-ceb1ff92652b"],
 ", proves the eigenvalue bound.  The\nindicator of ",
 Cell[BoxData[
  FormBox[
