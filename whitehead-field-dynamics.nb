Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["D", "TI"], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], "(", 
     SuperscriptBox[
      StyleBox["x", "TI"], "0"], ")"}], "-", 
    RowBox[{
     StyleBox["V", "TI"], "(", 
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["m", "TI"]], ")"}]}], "\[LongEqual]", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["s", "TI"],
      LimitsPositioning->True], 
     RowBox[{
