Cell[BoxData[
 FormBox[
  RowBox[{"|", 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["i", "TI"], "0"], "-", 
    SubsuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["j", "TI"], "0"]}], "|", 
   RowBox[{"\[LessEqual]", 
    RowBox[{"|", 
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["s", "TI"]], "|", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         SqrtBox["2"]}], 
        SuperscriptBox[
         StyleBox["x", "TI"], 
         RowBox[{
          StyleBox["s", "TI"], "-", "1"}]]}], "-", 
       SuperscriptBox[
        StyleBox["x", "TI"], "0"]}], "\[LessEqual]", 
      RowBox[{
       SqrtBox[
        RowBox[{"2", 
         StyleBox["D", "TI"]}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox[
           StyleBox["m", "TI"]]}], ")"}], "."}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n |x_i^0-x_j^0|\n \\le |d_s|+\\sqrt2\\norm{x^{s-1}-x^0}\n \
\\le\\sqrt{2D}(1+\\sqrt m).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"362522d0-8a9b-e4cd-b41f-c8d523256613"],

Cell["\<\
The spanning-tree Poincar\\'e inequality and the path-minimality of algebraic
connectivity give\
\>", "Proof",
 CellDingbat->None,
