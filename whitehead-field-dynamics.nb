Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "0"], "\[LongEqual]", 
   SuperscriptBox[
    StyleBox["1",
     FontSlant->"Bold"], "\[Perpendicular]"], "\[LongEqual]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["f", "TI"], "\[Element]", 
