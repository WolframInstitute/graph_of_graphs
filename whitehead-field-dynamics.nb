Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]], ")"}], ":", 
       RowBox[{
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"j", "i"}], "TI"]]}]}], ",", " ", 
      RowBox[{
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox[
         RowBox[{"i", "i"}], "TI"]], "\[LongEqual]", "0"}], ",", " ", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{
          StyleBox["j", "TI"], "\[NotEqual]", 
          StyleBox["i", "TI"]}],
         LimitsPositioning->True], 
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]]}], "\[LongEqual]", "0"}]}], "}"}]}], ",",
    "    ", 
   RowBox[{
    RowBox[{"dim", 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["N", "TI"]]}], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      StyleBox["N", "TI"], "(", 
      RowBox[{
       StyleBox["N", "TI"], "-", "3"}], ")"}], "2"]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n W_N=\\left\\{(a_{ij}):a_{ij}=a_{ji},\\ a_{ii}=0,\\\n              \
   \\sum_{j\\ne i}a_{ij}=0\\right\\},\n \\qquad \\dim W_N=\\frac{N(N-3)}2,\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"d95fea4f-0876-f2db-9b8e-3597d965c363"],

Cell[TextData[{
 "put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["F", "a"], "(", "G", ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "<", "j"}]], 
     RowBox[{
      SubscriptBox["a", "ij"], " ", 
      RowBox[{
       SubscriptBox["m", "ij"], "(", "G", ")"}]}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "F_a(G)=\\sum_{i<j}a_{ij}m_{ij}(G)"|>|>,
  ExpressionUUID->"45308566-b1c2-ba63-c850-450f8e3e2173"],
 ".  There is an absolute ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "C"|>|>,ExpressionUUID->
  "a907bf74-3336-c377-9f17-a676c4ddb881"],
 " such that,\nfor all sufficiently large even ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "424bd225-a8f8-21b7-5172-f64ec58d42d2"],
 ","
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"f2ca2f65-b3b3-d556-2fda-b9b890237c46"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", 
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["N", "TI"], "(", 
        RowBox[{
         StyleBox["N", "TI"], "-", "3"}], ")"}], "/", "2"}], "+", "1"}]], "(", 
    RowBox[{
     StyleBox["L", "TI"], "(", 
     RowBox[{
      SubscriptBox["\[CapitalGamma]", "lab"], "(", 
      StyleBox["N", "TI"], ")"}], ")"}], ")"}], "\[LessEqual]", 
   RowBox[{
    StyleBox["C", "TI"], "."}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\lambda_{N(N-3)/2+1}\\bigl(L(\\Gamma_{\\rm lab}(N))\\bigr)\\le \
C.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"84483d0e-f0fc-4356-7a46-e243a8cd18f4"],

Cell[TextData[{
 "The same number of nonconstant modes have eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"bf62c892-409d-fad2-1d99-7bc138b3077c"],
 " for the\nuniform-clock and normalized simple-neighbour operators."
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"32aa96f6-6724-ee9d-b2a4-a55c7ac86ea0"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "ecb196fa-d796-cf8b-db3d-298f2e96706a"],
 " row-sum equations have full rank, which gives the displayed dimension,\n\
and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "6386ad49-5bf0-391e-46ad-028bc60ac800"],
 " is the irreducible ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      StyleBox["N", "TI"], "-", "2"}], ",", "2"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[N-2,2]"|>|>,
  ExpressionUUID->"b2e921a4-cb55-f8bd-5d55-e08b3cfd7af6"],
 " representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S_N"|>|>,ExpressionUUID->
  "4a963957-30dc-dce8-22f9-f560b8bf682d"],
 ".  Both the\nuniform covariance of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "a"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "F_a"|>|>,ExpressionUUID->
  "1895db01-b5fe-8ae5-afd1-328eb005b174"],
 " and its simple-edge Dirichlet form are\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S_N"|>|>,ExpressionUUID->
  "8a9e61e9-83a6-cd21-b448-e13b4fc1f214"],
 "-invariant, so Schur's lemma makes each a scalar form on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "2502ffcd-f281-1365-8d01-d71fac992bd7"],
 "."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {
   None, None}},ExpressionUUID->"2a34deaf-dbb9-4cb7-dda9-74fe19242e9b"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "(", "G", ")"}], "\[LongEqual]", 
    SubscriptBox[
     RowBox[{
      SubscriptBox["m", "ij"], "(", "G", ")"}], 
     RowBox[{"i", "<", "j"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "x(G)=(m_{ij}(G))_{i<j}"|>|>,
  ExpressionUUID->"6ac69437-64c4-5a8c-73cc-948ac47778df"],
 ".  The trace of the covariance form on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "66da3afc-debf-4bbd-c99d-c5f52ab31e2c"],
 " is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], "\[DoubleVerticalBar]", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{"P", "r", "o", "j"}], "TI"], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["N", "TI"]]], 
     RowBox[{
      StyleBox["x", "TI"], "(", 
      StyleBox["G", "TI"], ")"}]}], 
    SuperscriptBox["\[DoubleVerticalBar]", "2"]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "\\E_{U_N}\\|\\operatorname{Proj}_{W_N}x(G)\\|^2"|>|>,
  ExpressionUUID->"69b70220-edd0-a9e1-75d7-54189e520308"],
 ".  Since\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "<", "j"}]], 
     SubsuperscriptBox["m", "ij", "2"]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"O", "(", 
      RowBox[{"D", "+", "L"}], ")"}], "+", 
     FractionBox[
      RowBox[{"3", " ", "N"}], "2"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\sum_{i<j}m_{ij}^2=3N/2+O(L+D)"|>|>,
  ExpressionUUID->"e458f4b5-9431-36f6-1e4a-42d8c049f54d"],
 " in expectation, while the trivial and\nstandard projections have bounded \
expected squared norm, division by\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["W", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\dim W_N"|>|>,
  ExpressionUUID->"307d17e2-9361-dcde-136c-8e6a8d59a018"],
 " gives"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"fd83b3ae-e1c1-761c-ab3f-76302e9e89bc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], 
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["a", "TI"], "2"]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["3", 
       StyleBox["N", "TI"]], "+", 
      RowBox[{
       StyleBox["O", "TI"], "(", 
       SuperscriptBox[
        StyleBox["N", "TI"], 
        RowBox[{"-", "2"}]], ")"}]}], ")"}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\E_{U_N}F_a^2=\\left(\\frac3N+O(N^{-2})\\right)\\norm{a}^2.\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"008035f9-237b-10b6-ce4b-1cfbcb2f1d0b"],

Cell[TextData[{
 "Each raw move changes only four pair coordinates.  Summing the resulting\n\
squared increments over slots and taking the trace on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "93eb0d94-0c56-2c21-295f-64843e435200"],
 " gives simple-edge\nDirichlet energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "2"], " ", 
    RowBox[{"O", "(", 
     FractionBox["1", "N"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})\\norm{a}^2"|>|>,
  ExpressionUUID->"d8edb4a5-39ed-4593-4c8d-e5e0f571cf8e"],
 "; invariance again makes the same bound\nuniform over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[Element]", 
    SubscriptBox["W", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "a\\in W_N"|>|>,
  ExpressionUUID->"c642bdbe-1c44-200e-91b3-3f9d3b1cb815"],
 ".  Its quotient by the covariance is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(1)"|>|>,
  ExpressionUUID->"4cf42350-d2c4-784c-a871-c9e99dd45d58"],
 ", while the\nuniform-clock normalization contributes an additional factor \
",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"6", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(6N)^{-1}"|>|>,
  ExpressionUUID->"74c5cc10-981f-670d-a61f-52e200dd0871"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"644d3879-4010-c7c0-5e97-82709e899a4f"],

Cell[TextData[{
 "For the normalized simple walk the denominator is the invariant form\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], "[", 
    RowBox[{
     RowBox[{
      StyleBox["d", "TI"], "(", 
      StyleBox["G", "TI"], ")"}], 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["a", "TI"]], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["G", "TI"], ")"}], "2"]}], "]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E_{U_N}[d(G)F_a(G)^2]"|>|>,
  ExpressionUUID->"346b97de-c0e5-0919-c49f-8333fa170c52"],
 ".  Its trace is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalTheta]", "(", 
    SuperscriptBox["N", "2"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Theta(N^2)"|>|>,
  ExpressionUUID->"ce004fce-ae0c-31b7-0e93-9a03ab3e5959"],
 " because\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[LongEqual]", 
    RowBox[{
     RowBox[{"6", " ", "N"}], "-", "\[Delta]"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "d=6N-\\delta"|>|>,
  ExpressionUUID->"cc48e7fa-0354-09e1-befe-1c1860c5bcc7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["E",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["U", "TI"], 
       StyleBox["N", "TI"]]], "\[Delta]"}], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", "1", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E_{U_N}\\delta=O(1)"|>|>,
  ExpressionUUID->"90564111-c38b-2e3d-0a3b-37d568ba699b"],
 ", and\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleVerticalBar]", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{"P", "r", "o", "j"}], "TI"], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["N", "TI"]]], 
     StyleBox["x", "TI"]}], 
    SuperscriptBox["\[DoubleVerticalBar]", "2"], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", 
     StyleBox["N", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "\\|\\operatorname{Proj}_{W_N}x\\|^2=O(N)"|>|>,
  ExpressionUUID->"05561e50-203f-bd21-a04d-b95667bd126e"],
 " deterministically.  Hence this form is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "2"], " ", 
    RowBox[{"\[CapitalTheta]", "(", "1", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\Theta(1)\\norm{a}^2"|>|>,
  ExpressionUUID->"c4a62bb1-8dbb-b208-7d68-078cd515b903"],
 " and the normalized quotient is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"9dd1e080-ed5d-8a0c-dec0-1f0a0147a01a"],
 ".  Adding the\nconstant function and applying min--max proves all three \
assertions."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"62fd361f-fe5c-803d-9185-0facf90aa314"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "\[Tilde]", 
    SubscriptBox["U", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G\\sim U_N"|>|>,
  ExpressionUUID->"c176aaa1-9a8b-e761-5e8b-1405adfd02fb"],
 ".  For every fixed ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "f626d002-1d59-df72-a0bc-0c22c91a4433"],
 ","
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[Fixed-radius labelled balls]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->
  "Theorem",ExpressionUUID->"3594ee6a-929e-2e57-18e7-c050664a420a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"|", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["B", "TI"], 
      StyleBox["R", "TI"], "lab"], "(", 
     StyleBox["G", "TI"], ")"}], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"6", 
          StyleBox["N", "TI"]}], ")"}], 
        StyleBox["R", "TI"]], 
       RowBox[{
        StyleBox["R", "TI"], "!"}]], "+", 
      RowBox[{
       SubscriptBox[
        StyleBox["O", "TI"], 
        RowBox[{
         StyleBox["P",
          FontSlant->"Plain"], ",", 
         StyleBox["R", "TI"]}]], "(", 
       SuperscriptBox[
        StyleBox["N", "TI"], 
        RowBox[{
         StyleBox["R", "TI"], "-", "1"}]], ")"}]}]}]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], "|", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["B", "TI"], 
      StyleBox["R", "TI"], "lab"], "(", 
     StyleBox["G", "TI"], ")"}], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"6", 
          StyleBox["N", "TI"]}], ")"}], 
        StyleBox["R", "TI"]], 
       RowBox[{
        StyleBox["R", "TI"], "!"}]], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         StyleBox["O", "TI"], 
         StyleBox["R", "TI"]], "(", 
        SuperscriptBox[
         StyleBox["N", "TI"], 
         RowBox[{
          StyleBox["R", "TI"], "-", "1"}]], ")"}], "."}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n |B_R^{\\rm lab}(G)|=\\frac{(6N)^R}{R!}+O_{\\mathbb P,R}(N^{R-1}),\
\n \\qquad\n \\E_{U_N}|B_R^{\\rm lab}(G)|\n =\\frac{(6N)^R}{R!}+O_R(N^{R-1}).\
\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"6dc6a71f-0eca-38e5-98df-47160058cbd3"],

Cell[TextData[{
 "The error estimate is not asserted uniformly for growing ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "6af9d8ba-8ce9-6d45-5045-a823ba2e8537"],
 "."
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"98b4beeb-f858-2ad5-230d-c774638d0e83"],

Cell[TextData[{
 "Call a raw move ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "b4b21cf7-0788-c7bd-e3d6-8b1545927565"],
 "-good when the radius-",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", " ", "R"}], "+", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(2R+2)"|>|>,
  ExpressionUUID->"0f748318-8bd5-3653-534b-ec8ab0bd899c"],
 " carrier neighbourhood of its\ncentral edge has no loop or parallel edge \
and is a tree rooted at that edge.  A\nword is separated if all of these \
neighbourhoods\nare vertex-disjoint.  Standard fixed-subgraph counting in the \
cubic\nconfiguration model ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"janson-random-graphs"],
 ButtonBox["janson-random-graphs",
  BaseStyle->"Citation",
  ButtonData->"janson-random-graphs"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"janson-random-graphs"],
 ", followed by the exact\nloop/double-edge exponential tilt\nto ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "U_N"|>|>,ExpressionUUID->
  "818bf529-2e77-d526-53c8-dfe08267183f"],
 ", preserves these fixed-radius moment bounds and shows that the\nexpected \
number of non-good raw slots is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "R"], "(", "1", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_R(1)"|>|>,
  ExpressionUUID->"63acbd58-19f5-7833-35da-40810cc0fb39"],
 ".  Once fewer than ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "ec09e169-e49c-03ca-8f30-a1f1a0e9c944"],
 " separated supports have been chosen, only\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "R"], "(", "1", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_R(1)"|>|>,
  ExpressionUUID->"f166f5d9-cafb-b893-cd9c-8b174e5c328d"],
 " of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "e34fb946-3425-67eb-1e01-633de187a9c3"],
 " next raw slots meet one of them.  Hence the expected number\nof ordered \
separated good words is"
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {
   None, None}},ExpressionUUID->"8dec7e46-b645-30b4-ea56-b748f391d4b6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"6", 
       StyleBox["N", "TI"]}], ")"}], 
     StyleBox["R", "TI"]], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["O", "TI"], 
      StyleBox["R", "TI"]], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{
       StyleBox["R", "TI"], "-", "1"}]], ")"}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n (6N)^R+O_R(N^{R-1}),\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"dbbee2d1-ee91-912f-2e9b-9736593b2efd"],

Cell["and the same estimate holds in probability.", "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"8d8e39fd-97ea-59a5-36da-c253d632a942"],

Cell[TextData[{
 "The rewrites in a separated word commute.  In the symmetric difference of \
the\nsource and endpoint edge sets, the affected neighbourhoods are distinct\n\
components; within each, the unchanged central edge is the unique diagonal.\n\
Thus the source--endpoint pair recovers the ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "ee7cdbdd-5790-29a4-0a92-97a339389b99"],
 " selected moves and their\nresolutions.  Exactly the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "!"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R!"|>|>,ExpressionUUID->
  "67d518ba-1984-e04f-3acf-a8b99a4ac826"],
 " orders of those commuting moves have the same\nendpoint.  Words with \
repeated or intersecting supports, or with a non-good\nslot, have expected \
count ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "R"], "(", 
    SuperscriptBox["N", 
     RowBox[{"R", "-", "1"}]], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_R(N^{R-1})"|>|>,
  ExpressionUUID->"24d30b1a-386a-0b8c-51eb-2158bb237b51"],
 ", because one free ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "N", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N)"|>|>,
  ExpressionUUID->"980c1909-0518-76be-57b1-372ff5d54a09"],
 " choice is\nlost.  Words of length less than ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "754ce536-92f8-ed9d-e876-31fb76a1211a"],
 " have the same lower order.  Dividing the\ngood ordered count by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "!"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R!"|>|>,ExpressionUUID->
  "8b1fc21b-c01e-c3bb-2ef4-c8be6028f965"],
 " proves the expectation estimate, and Markov's\ninequality applied to the \
exceptional-word count gives the in-probability\nform."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"420f5aa7-030d-11aa-1bed-783d19d0a61d"],

Cell["Moreover", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"727b62fe-334b-8412-f302-16105df9ab7c"],

