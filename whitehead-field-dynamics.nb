Cell[BoxData[
 RowBox[{
  RowBox[{"PacletDirectoryLoad", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<Wolfram\>\"", 
      ",", "\"\<GogFieldDynamics\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"Needs", "[", "\"\<GogFieldDynamics`\>\"", "]"}], ";", 
