        SubscriptBox[
         StyleBox["j", "TI"], "1"]}]]}], 
     SubscriptBox["|", 
      SubscriptBox[
       StyleBox["E", "TI"], "0"]]}], "2"], "\[LessEqual]", 
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["N", "TI"]], 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         StyleBox["N", "TI"], "-", "1"}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
