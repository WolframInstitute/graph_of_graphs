Cell["\<\
If the pairs are equal this is trivial.  If they are disjoint, the operators
act on disjoint coordinate blocks.  For incident pairs it suffices, after
relabeling, to compute the commutator above, which is nonzero.\
\>", "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"61aae1b3-5901-e2a7-7739-1141e47fffcb"]
}, Open  ]],

