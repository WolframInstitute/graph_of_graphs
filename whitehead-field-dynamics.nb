Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox[
     RowBox[{"lim", " ", "sup"}], 
     RowBox[{
      StyleBox["t", "TI"], "\[Rule]", "\[Infinity]"}],
     LimitsPositioning->True], 
    FractionBox["1", 
     StyleBox["t", "TI"]], "log", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["B", "TI"], "0"]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], 
   RowBox[{"\[LessEqual]", 
    RowBox[{
     FractionBox[
      StyleBox["q", "TI"], 
      StyleBox["M", "TI"]], "log", "\[Rho]"}], "<", "0."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\limsup_{t\\to\\infty}\n    \
\\frac1t\\log\\norm{B_{t-1}\\cdots B_0|_{E_0}}\n    \\le\n    \
\\frac{q}{M}\\log\\rho\n    <0.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ffeb777b-e244-3522-6d54-60eaf75c996e"],

Cell["\<\
Consequently every initial field converges exponentially to its mean.\
\>", "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"22c3afc8-cb0f-a4b6-5c62-9d0cfadda05a"],

Cell[TextData[{
 "Choose one labelled connected cubic graph ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"e3ace803-b4ea-5600-1fbf-badd79a030a3"],
 " and a spanning tree\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", "*"], "\[Subset]", 
    SuperscriptBox["G", "*"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "T^\\ast\\subset G^\\ast"|>|>,
  ExpressionUUID->"96972dc4-d4d9-9368-4907-b1130ea613c8"],
 ".  Since the labelled chain is finite and irreducible,\nfrom any state ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "x"|>|>,ExpressionUUID->
  "cc5326b3-31b9-927a-6913-c9aaefaa08c1"],
 " there is a path of Whitehead moves leading to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"a2b61134-be15-4176-6bfa-7d7bbb8881b0"],
 ".  By\nfiniteness, the length of such a path can be chosen at most ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "D"|>|>,ExpressionUUID->
  "9294b6d7-bff9-92bc-17b4-5c903e07becf"],
 " uniformly in\n",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "x"|>|>,ExpressionUUID->
  "d076528a-f6d3-290c-af9f-ef9f7517dbba"],
 ", after padding if necessary.  Once at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"ef0fcf84-aefe-800c-3b52-224b3999e90a"],
 ", for each edge of\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T^\\ast"|>|>,
  ExpressionUUID->"737db361-2440-328e-560d-3a40a4c29165"],
 " perform a chosen Whitehead move and immediately perform its inverse.\nThis \
averages every tree edge and returns the labelled carrier to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G^\\ast"|>|>,
  ExpressionUUID->"4896b0b8-2a6f-8425-0386-7dc641721939"],
 "\nafter each pair.  Let ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "300acdcd-4e57-29f0-5452-43cb3c4579ce"],
 " be a\ncommon upper bound for the total length of this ``success block''."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"006b35ba-98a6-fd3d-0cee-97343d26a8ec"],

Cell[TextData[{
 "Full support and finiteness imply that the conditional probability of \
realizing\none of these success blocks in the next ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "e57c28c1-5ad6-6cf2-571f-e09fe5635167"],
 " steps is bounded below by some\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", ">", "0"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q>0"|>|>,ExpressionUUID->
  "6247aa29-f54f-24b2-40ff-aa5cc5eb38c8"],
 ", uniformly over the current state."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"6d8b1aed-7559-5bd9-8524-01dd5e72d3c7"],

Cell[TextData[{
 "For every success block, the product of its averaging projections includes \
all\nedges of the spanning tree ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T^\\ast"|>|>,
  ExpressionUUID->"fbb005e9-3373-9ed2-0b7d-dd8b47f2de28"],
 ".  By the connected-block corollary, its\nrestriction to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "6e044b96-b8a3-5b5a-91c2-0507ae086b63"],
 " has norm strictly less than one.  There are only finitely\nmany \
success-block words of length at most ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "8aed0263-f2d4-2bf5-16f0-316102ab3b59"],
 ", so the maximum of their norms is\nsome ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "<", "1"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\rho<1"|>|>,
  ExpressionUUID->"52e02475-cdb4-045e-e4e2-3e33b570091a"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"5ae663e6-f03e-d627-f302-e3ad2f77de57"],

Cell[TextData[{
 "Now divide time into disjoint blocks of length ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "ac723b67-ce12-26ab-71cd-6d6db764da69"],
 ".  Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Y", "k"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "Y_k"|>|>,ExpressionUUID->
  "eae5d142-c1dd-b7bb-8ccb-f7e87ccc984e"],
 " be the indicator\nthat block ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "e5f810e1-6a4f-9be7-a629-e7563dcece61"],
 " is successful and put\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], "[", 
     RowBox[{
      SubscriptBox[
       StyleBox["Y", "TI"], 
       StyleBox["k", "TI"]], "|", 
      SubscriptBox[
       StyleBox["F", "TI"], 
       StyleBox[
        RowBox[{"k", "M"}], "TI"]]}], "]"}], "\[GreaterEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "p_k=\\E[Y_k\\mid\\mathcal F_{kM}]\\ge q"|>|>,
  ExpressionUUID->"7cb5f9c2-e1d9-8a40-5e2e-30b9601e820b"],
 ".  The martingale\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"k", "<", "r"}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["Y", "k"], "-", 
      SubscriptBox["p", "k"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\sum_{k<r}(Y_k-p_k)"|>|>,
  ExpressionUUID->"89dbf6e0-ef5e-b1c8-1462-9dd82bd0f75a"],
 " has bounded increments, so its strong law\n",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"williams",
  ButtonNote->"\\cite{williams"],
 ButtonBox["williams",
  BaseStyle->"Citation",
  ButtonData->"williams",
  ButtonNote->"\\cite{williams"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"williams",
  ButtonNote->"\\cite{williams"],
 ", ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"durrett",
  ButtonNote->",durrett"],
 ButtonBox["durrett",
  BaseStyle->"Citation",
  ButtonData->"durrett",
  ButtonNote->",durrett"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"durrett",
  ButtonNote->",durrett"],
 " gives"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"7433449d-44e0-5805-8327-63669b314e08"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox[
     RowBox[{"lim", " ", "inf"}], 
     RowBox[{
      StyleBox["r", "TI"], "\[Rule]", "\[Infinity]"}],
     LimitsPositioning->True], 
    FractionBox["1", 
     StyleBox["r", "TI"]], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "TI"], "<", 
       StyleBox["r", "TI"]}],
      LimitsPositioning->True], 
     SubscriptBox[
      StyleBox["Y", "TI"], 
      StyleBox["k", "TI"]]}]}], "\[GreaterEqual]", 
   RowBox[{
    StyleBox["q", "TI"], "  ", "almost", " ", 
    RowBox[{"surely", "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\liminf_{r\\to\\infty}\\frac1r\\sum_{k<r}Y_k\\ge q\n    \
\\quad\\text{almost surely}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"368ba992-acd1-7c94-71df-2451057de04f"],

Cell[TextData[{
 "Successful blocks contract by at most ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\rho"|>|>,
  ExpressionUUID->"f8c1ae88-8456-7be1-ea4c-86b886f0f828"],
 "; all other blocks have norm at\nmost one.  Hence"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"646bb462-fbc9-f097-68a6-54f4b9f193f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox[
     RowBox[{"lim", " ", "sup"}], 
     RowBox[{
      StyleBox["r", "TI"], "\[Rule]", "\[Infinity]"}],
     LimitsPositioning->True], 
    FractionBox["1", 
     StyleBox[
      RowBox[{"r", "M"}], "TI"]], "log", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox[
       RowBox[{"r", "M"}], "TI"], "-", "1"}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["B", "TI"], "0"]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], 
   RowBox[{"\[LessEqual]", 
    RowBox[{
     FractionBox[
      StyleBox["q", "TI"], 
      StyleBox["M", "TI"]], "log", 
     RowBox[{"\[Rho]", "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\limsup_{r\\to\\infty}\n    \
\\frac1{rM}\\log\\norm{B_{rM-1}\\cdots B_0|_{E_0}}\n    \\le\n    \
\\frac{q}{M}\\log\\rho.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"f2b37974-0ed8-7256-cd46-a1427aab3f6a"],

Cell[TextData[{
 "The leftover times between multiples of ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "3811467a-03a9-8ebd-2dfa-d935716e64db"],
 " contribute only norm-one factors,\nso the same limsup holds for all ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "t"|>|>,ExpressionUUID->
  "232b1177-bfe2-9e86-8f7c-2590589a9719"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
