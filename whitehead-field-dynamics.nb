     "\\[\n    \\gamma=[G]\\in\\G_N,\n    \\qquad\n    \\F_\\gamma=C^0(G).\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"4e178ad8-964e-6337-fb28-a310f7273c4d"],

