}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"25c0eb93-65b8-5533-070f-fdfeb9874c9c"],

Cell["\<\
The converse direction is governed by ordinary spectral graph theory.  Define
the edge isoperimetric constant of the current cubic graph by\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"bd45e7dd-db9b-9b10-23b3-947973870fd6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["min", 
      RowBox[{
       RowBox[{"0", "<"}], "|", 
       StyleBox["S", "TI"], "|", 
       RowBox[{"\[LessEqual]", 
        RowBox[{
         StyleBox["N", "TI"], "/", "2"}]}]}],
      LimitsPositioning->True], 
     FractionBox[
      TemplateBox[{
        RowBox[{
          SubscriptBox["\[PartialD]", 
           StyleBox["G", "TI"]], 
          StyleBox["S", "TI"]}]},
       "Abs"], 
      TemplateBox[{
        RowBox[{
          StyleBox["S", "TI"]}]},
       "Abs"]]}]}], ","}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    h(G)=\n    \\min_{0<|S|\\le N/2}\n    \\frac{|\\partial_G \
S|}{|S|},\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"19e682da-1aac-c8a2-16e4-77859b8be08f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", "S"}], 
    RowBox[{"\[PartialD]", "G"}],
    MultilineFunction->None], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\partial_G S"|>|>,
  ExpressionUUID->"73527436-4ce9-af21-f70d-c804a816b913"],
 " is the set of edge objects crossing from ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S"|>|>,ExpressionUUID->
  "2aea6647-30ea-f78f-e160-24ab16d72be5"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "c"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S^c"|>|>,ExpressionUUID->
  "f5c85142-8b6b-a0b1-8b54-56c1e814dd8d"],
 ".\nFor graphs of maximum degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3"|>|>,ExpressionUUID->
  "9ce6869c-a847-3d9d-1c26-eb78d67c0d12"],
 ", Cheeger inequalities imply, up to universal\nconstants ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"chung"],
 ButtonBox["chung",
  BaseStyle->"Citation",
  ButtonData->"chung"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"chung"],
 ","
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"7205194b-bd7e-f543-764f-8ddef8525cb4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["h", "TI"], 
    SuperscriptBox[
     RowBox[{"(", 
      StyleBox["G", "TI"], ")"}], "2"], 
    SubscriptBox[
     RowBox[{"\[LessTilde]", "\[Lambda]"}], "2"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["G", "TI"]], ")"}]}], "\[LessTilde]", 
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], "(", 
     StyleBox["G", "TI"], ")"}], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    h(G)^2 \\lesssim \\lambda_2(L_G)\\lesssim h(G).\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"76e7e25f-cfb2-7541-da9b-4320d03c7a0f"],

Cell[TextData[{
 "Thus a large sparse cut supplies a slowly contracting field direction, not \
a\nstatement that every current field contracts slowly.  The actual one-step\n\
loss is governed by the Rayleigh quotient ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"f", " ", 
     TemplateBox[{"f"},
      "Transpose"], " ", 
     SubscriptBox["L", "G"]}], 
    RowBox[{"V", "(", "f", ")"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f^TL_Gf/\\V(f)"|>|>,
  ExpressionUUID->"b9463b6a-a07c-4d40-2187-80f9ca77516c"],
 "; a field nearly\northogonal to the low mode may contract quickly.  \
Microscopic bridges can\ncoexist with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "G", ")"}], "\[CupCap]", "1"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "h(G)\\asymp1"|>|>,
  ExpressionUUID->"127b7e16-db5b-1866-102d-772964c21d5e"],
 " when all cuts separating a linear-size set have\nlinear boundary, whereas \
balanced bridges force ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "G", ")"}], "\[LongEqual]", 
    RowBox[{"O", "(", 
     FractionBox["1", "N"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "h(G)=O(1/N)"|>|>,
  ExpressionUUID->"d0f8340b-39f9-a73d-7735-e0f3a6701389"],
 ".  This is the\nprecise interface between bridge geometry and the Lyapunov \
estimate."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"d2da2713-cfb3-b34b-9ccb-bec5c23df223"],

Cell["\<\
The Rule-A stationary probability of a balanced cut of any fixed width
consequently tends to zero.  The bridged GoG bottleneck remains important for
the mixing of the base chain, but it does not bias its equilibrium carrier
marginal away from the configuration model.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"0f270fe8-86f9-b79f-491f-9285198a9b53"],

