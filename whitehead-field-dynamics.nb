 CounterIncrements->{},ExpressionUUID->"a1f649b3-8866-fef6-4772-c631375d0dc7"],

Cell[TextData[{
 "For a finite irreducible Markov chain, the ergodic theorem says that for \
every\nfunction ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\varphi"|>|>,
