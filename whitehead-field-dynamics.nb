     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox[
       RowBox[{"H", "G"}], "TI"]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\frac{c(G)}{|\\Aut_v(G)|}m_{GH}\n    =\n    \
\\frac{c(H)}{|\\Aut_v(H)|}m_{HG}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"333f5423-772e-bac8-c07b-085420de358c"],

