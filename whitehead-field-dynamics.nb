  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_e=0"|>|>,
  ExpressionUUID->"a31270dc-d394-6ba9-0b35-5a808dd29c8f"],
 " on a loop), put"
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
