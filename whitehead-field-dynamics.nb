Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["i", "TI"]], "-", 
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["j", "TI"]]}], ")"}], "2"]}], "\[LongEqual]", 
    RowBox[{
     FractionBox["3", 
      RowBox[{
       StyleBox["N", "TI"], "(", 
       RowBox[{
        RowBox[{"3", 
         StyleBox["N", "TI"]}], "-", "1"}], ")"}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["i", "TI"],
       LimitsPositioning->True], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["j", "TI"], "\[NotEqual]", 
         StyleBox["i", "TI"]}],
        LimitsPositioning->True], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["i", "TI"]], "-", 
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["j", "TI"]]}], ")"}], "2"]}]}]}], "\[LongEqual]", 
    RowBox[{
     FractionBox["6", 
      RowBox[{
       RowBox[{"3", 
        StyleBox["N", "TI"]}], "-", "1"}]], 
     RowBox[{
      StyleBox["V", "TI"], "(", 
      StyleBox["f", "TI"], ")"}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\E(f_i-f_j)^2\n =\\frac{3}{N(3N-1)}\\sum_i\\sum_{j\\ne \
i}(f_i-f_j)^2\n =\\frac{6}{3N-1}\\V(f),\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"954a3b75-843b-62a6-4e0d-927722d5b3ee"],

Cell[TextData[{
 "and one average loses half of this.  Under connected conditioning,\n\
permutation invariance makes the mean Laplacian scalar on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "f26ad92a-3f1c-fe0a-d2cf-eac43cc425be"],
 "; its trace\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", " ", "N"}], "-", 
    RowBox[{"2", " ", 
     SubscriptBox["\[ScriptL]", "N"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N-2\\ell_N"|>|>,
  ExpressionUUID->"9e45e6de-6989-71d3-3bc1-d0b5f8f6a736"],
 " determines the scalar."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"20fe9a6b-23d1-4160-62d7-c57a1e12dd85"],

Cell[TextData[{
 "Fresh independent resampling would iterate this factor and suggest norm\n\
constant ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/2"|>|>,ExpressionUUID->
  "45cdf651-e27b-bdee-13b5-28fe6a546172"],
 " on the ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N^{-1}"|>|>,
  ExpressionUUID->"9e139fe5-fad3-34f5-42db-c0cf4a48dd4d"],
 " scale.  The actual field records previously\nselected edges and is \
correlated with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "t"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G_t"|>|>,ExpressionUUID->
  "72b4e711-42e3-cd4f-4d6d-125ca1b3809e"],
 ", so the identity does not iterate\nalong a Whitehead trajectory."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"0c7e618e-07d8-fb59-c715-1981123138cc"],

Cell[TextData[{
 "Suppose a move on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=\\{i,j\\}"|>|>,
  ExpressionUUID->"9d6d654e-589a-4eca-eaee-96fca9ccd4a0"],
 " produces either raw resolution ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "\[Prime]",
    MultilineFunction->None], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G'"|>|>,ExpressionUUID->
  "8685cd22-6572-1f99-c68e-61641195366e"],
 ".  Then"
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[Resolution-independent target energy]", "Trailing" -> 
     "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"a6dc0255-083f-f784-2b40-092c66dd41de"],

Cell[BoxData[
 FormBox[
  RowBox[{
