Cell[TextData[{
 "The projected process ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "(", 
    SubscriptBox["G", "t"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L(G_t)"|>|>,
  ExpressionUUID->"7ad8707c-0919-839f-d851-e9cab2cce7a1"],
 " need not itself be Markov.  The theorem is an\nexact stationary \
Dirichlet-form identity and an upper bound, not convergence\nof the low \
spectrum to a one-dimensional birth--death chain."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"0b5c2695-811b-888e-20e5-bd364e240422"],

