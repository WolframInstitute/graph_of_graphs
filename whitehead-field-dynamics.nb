Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    RowBox[{
     RowBox[{"log", "(", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}], ")"}], "-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["N", "TI"]]}]}], ",", "    ", 
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["G", "TI"],
       LimitsPositioning->True], 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Pi]", 
         StyleBox["A", "TI"]], "(", 
        StyleBox["G", "TI"], ")"}], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         StyleBox["H", "TI"],
         LimitsPositioning->True], 
        RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox[
           RowBox[{"G", "H"}], "TI"]], "log", 
         RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox[
            RowBox[{"G", "H"}], "TI"]], "."}]}]}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n h_N=\\log(3N)-\\Delta_N,\n \\qquad\n \\Delta_N=\\frac1{3N}\\sum_G\
\\pi_A(G)\\sum_Hm_{GH}\\log m_{GH}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"0bf89f14-9372-2ee6-663c-5c3bf5dc0abb"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"1", "G"},
     "GegenbauerC2"], "\[LongEqual]", 
