       RowBox[{
        RowBox[{
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"],
          LimitsPositioning->True], 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["i", "TI"]]}], "\[LongEqual]", "0"}]}]}], "}"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
