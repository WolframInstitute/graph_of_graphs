Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox[
        StyleBox["f", "TI"], 
        RowBox[{"\[Prime]", 
         StyleBox["T", "TI"]}]], 
       SubscriptBox[
        StyleBox["L", "TI"], 
        SuperscriptBox[
         StyleBox["G", "TI"], "\[Prime]"]], 
       SuperscriptBox[
        StyleBox["f", "TI"], "\[Prime]"]}], "|", 
      StyleBox["G", "TI"]}], ",", 
     StyleBox["f", "TI"]}], "]"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["T", "TI"]], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["G", "TI"]], "-", 
      RowBox[{
       FractionBox["1", 
        StyleBox["M", "TI"]], 
       SubsuperscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["G", "TI"], "2"]}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"4", 
         StyleBox["M", "TI"]}]], 
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["G", "TI"]]}]}], ")"}], 
    RowBox[{
     StyleBox["f", "TI"], "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\E[f'^TL_{G'}f'\\mid G,f]\n =f^T\\left(L_G-\\frac1M \
L_G^2+\\frac1{4M}D_G\\right)f.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ba0e7c63-d7f1-d19b-471f-597e0399ac1d"],

