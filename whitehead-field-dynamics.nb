Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]], 
       StyleBox["f", "TI"]}], ")"}], 
     StyleBox["i", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]], 
       StyleBox["f", "TI"]}], ")"}], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["j", "TI"]]}], "2"]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]], 
       StyleBox["f", "TI"]}], ")"}], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         StyleBox["k", "TI"], "\[NotEqual]", 
         StyleBox["i", "TI"]}], ",", 
        StyleBox["j", "TI"]}], ")"}], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    (A_{ij}f)_i=(A_{ij}f)_j=\\frac{f_i+f_j}{2},\n    \\qquad\n    \
(A_{ij}f)_k=f_k\\quad(k\\neq i,j).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"5e993a62-005c-7f5b-088a-e8f87ecbc279"],

