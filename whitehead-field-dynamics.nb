  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G_t"|>|>,ExpressionUUID->
  "d28a9b8b-d43d-56d3-a7f5-0f766d3f7c4b"],
 ".  Let"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"38e93e96-aa01-f8eb-316e-f6b930b2f747"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["t", "TI"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Lambda]", "2"], "(", 
       SubscriptBox[
        StyleBox["L", "TI"], 
        SubscriptBox[
         StyleBox["G", "TI"], 
