      LimitsPositioning->True], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Pi]", 
        StyleBox["A", "TI"]], "(", 
       StyleBox["G", "TI"], ")"}], 
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["A", "TI"]], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", 
        StyleBox["H", "TI"]}], ")"}]}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n Q_A(S,T)=\\sum_{\\substack{G\\in S\\\\H\\in T}}\\pi_A(G)P_A(G,H),\
\n\\]", "Separator" -> 
