      SubscriptBox[
       StyleBox["c", "TI"], "0"]}], "}"}]}], ",", "    ", 
   RowBox[{
    SubscriptBox["\[Alpha]", 
     StyleBox["N", "TI"]], "\[LongEqual]", 
