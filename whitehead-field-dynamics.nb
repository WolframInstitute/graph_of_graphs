   "GoGDiffusionLab"},ExpressionUUID->"7a008bda-56b4-16ff-73f2-fe7b115ab322"],

Cell["\<\
The distribution is matrix evolution, not a histogram of the sampled path.  \
SetReplace is an optional path engine; exact diffusion remains matrix based.\
\>", "Caption",
 ShowCellBracket->False,
 CellMargins->{{72, 72}, {2, 18}},
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGDiffusionLabCaption"|>|>,
