 FontSlant->Plain,ExpressionUUID->"11f2e740-832b-de57-fcd2-7188ffaf325b"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m"|>|>,ExpressionUUID->
  "e34f4648-dc23-4710-3219-5fca446f5b1e"],
 " pair averages have connected union graph, and put\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "N"], "\[LongEqual]", 
