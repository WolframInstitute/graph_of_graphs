Cell[TextData[{
 "Exact double-factorial ratios give\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", 
     RowBox[{"N", ",", "k"}]], "\[LongEqual]", 
    RowBox[{"O", "(", 
     SuperscriptBox["N", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], " ", 
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}]}]], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "A_{N,k}=O(N^{-(k-1)/2})"|>|>,
  ExpressionUUID->"de25596c-add4-65bf-1c72-00ce419c6519"],
 " for each fixed odd ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "b0370aa4-0e50-ede8-a8ce-d780210c85d6"],
 ", and a uniform Stirling bound\nmakes the middle range exponentially small. \
 Consequently"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"680effc5-c074-40d7-2b33-8913d22a04d5"],

Cell[BoxData[
 FormBox[
