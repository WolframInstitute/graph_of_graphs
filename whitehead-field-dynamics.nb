     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"9674f3b6-38c8-aa3a-7e52-4d419c6b565e"],

Cell[TextData[{
 "for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "\[LongEqual]", "2"}], ",", "4", ",", "6", ",", "8",
     ",", "10", ",", "12", ",", "14", ",", "\[Ellipsis]"}], TraditionalForm]],
   "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "N=2,4,6,8,10,12,14,\\ldots"|>|>,
  ExpressionUUID->"b66fce50-6e7c-7e98-e370-3d56af4676b7"],
 ".  Thus enumeration code has a hard external\nsanity check before any field \
dynamics is studied."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"536af088-439f-c1d3-c41f-6df96889bb7c"],

Cell[TextData[{
 "The papers of Grave de Peralta--Kolpakov and Li establish substantial\n\
large-scale structure.  Grave de Peralta--Kolpakov prove that the\n\
outer-conductance of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"04a09415-ca5e-9986-e17b-b14b26b897a2"],
 " tends to zero, using the bottleneck given by\nbridged cubic graphs ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["gdp-kolpakov",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ".  Li shows that the graph of Whitehead\nmoves has increasingly many \
bounded Laplacian eigenvalues, using many local\ncycle bottlenecks ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"li"],
 ButtonBox["li",
  BaseStyle->"Citation",
  ButtonData->"li"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"li"],
 ".  These results concern ordinary functions on the\nvertex set of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"0b1d4a38-7116-016a-718d-7868d560bbd3"],
 "."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"a77749a5-11c8-04b7-dada-fb85b6972805"],

Cell[TextData[{
 "Here the moving object is different.  Over a cubic graph ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["V", "TI"], ",", 
      StyleBox["E", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G=(V,E)"|>|>,
  ExpressionUUID->"2346e618-4555-e271-56e7-6ff99b1f0b5c"],
 " we place a\nscalar field"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"9be5d606-0494-b039-1d48-c7ac33997bdd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], ":", 
    StyleBox["V", "TI"]}], "\[Rule]", 
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], "."}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    f:V\\to\\R.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"63515f17-8b6c-d035-301c-395d97ec4580"],

Cell[TextData[{
 "So the fibre over the class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma=[G]"|>|>,
  ExpressionUUID->"06599d58-5fa0-66ad-f54e-2c43afd07161"],
 " is"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"f8c749e6-5411-155f-cdfd-8a2ebf60fbba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], "\[Gamma]"], "\[LongEqual]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["C", "TI"], "0"], "(", 
    StyleBox["G", "TI"], ")"}], "\[TildeEqual]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["R",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["V", "TI"], "(", 
      StyleBox["G", "TI"], ")"}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\F_\\gamma=C^0(G)\\simeq \\R^{V(G)}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"bb2ddb45-21a4-c26d-32ba-50c67b241027"],

Cell[TextData[{
 "When a Whitehead move is performed on an edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=\\{i,j\\}"|>|>,
  ExpressionUUID->"03e85ede-1769-f560-06e0-32df4fb0b09f"],
 ", the graph changes and\nthe field is updated by"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"16c8fc41-7a1a-10a9-78f3-43923e7f0832"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["i", "TI"]], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["j", "TI"]], "\[RightTeeArrow]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["j", "TI"]]}], "2"]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["j", "TI"]]}], "2"], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    f_i,f_j\n    \\mapsto\n    \
\\frac{f_i+f_j}{2},\\frac{f_i+f_j}{2}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"36dffaa2-c22b-9bfb-6c0c-01d78cfe0841"],

Cell["\<\
Afterwards one may resettle the new graph onto a chosen representative of its
isomorphism class; this only permutes field coordinates.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c7f3f54b-9c12-700b-0024-9220651c444d"],

Cell[TextData[{
 "The field is scalar because no differential data is attached to the \
vertices\nof ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "0da4428b-b580-b186-956a-56f0ee6ab20c"],
 "; the vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\R^N"|>|>,
  ExpressionUUID->"2bac7d64-e316-ba74-172b-cd6d0cb0b2a6"],
 " is only its coordinate representation."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"8e53eda2-c94f-e015-42a7-ebc790821f20"],

Cell[TextData[{
 StyleBox["Main results.",
  FontWeight->"Bold"],
 "\n",
 "The conclusions are grouped by the state space and by the random rule."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> "\n", "BibliographyTeX" -> 
     "\\paragraph{Main results.}\nThe conclusions are grouped by the state \
space and by the random rule."|>|>,
 FontSlant->Plain,ExpressionUUID->"9e403b51-25ea-c8ba-5112-a65e5f1d0e49"],

Cell[TextData[{
 "For the carrier field, we prove the exact variance loss at each\n    \
averaged edge.  We show how to pull every settlement permutation back to\n    \
a persistent coordinate frame.  Connectedness alone bounds the top field\n    \
exponent by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"O", "(", 
     FractionBox["1", 
      SuperscriptBox["N", "5"]], ")"}], "-", 
    FractionBox[
     SuperscriptBox["\[Pi]", "2"], 
     RowBox[{"6", " ", 
      SuperscriptBox["N", "3"]}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "-\\pi^2/(6N^3)+O(N^{-5})"|>|>,
  ExpressionUUID->"eb2b69d9-7f6f-ad77-4ee6-29f2ce26839f"],
 ".  Typical expansion under stationary\n    Rule A improves the bound to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{"-", 
       RowBox[{"o", "(", "1", ")"}]}], "-", 
      RowBox[{"2", " ", 
       SqrtBox["2"]}], "+", "3"}], 
     RowBox[{"6", " ", "N"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "-(3-2\\sqrt2-o(1))/(6N)"|>|>,
  ExpressionUUID->"5145033b-626c-f2f3-af57-3b374b9a5f2e"],
 ".  On the\n    persistent labelled process, explicit averaging words give \
exact\n    finite-time consensus at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "\[LongEqual]", "2"}], ",", "4", ",", "8"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2,4,8"|>|>,
  ExpressionUUID->"f408705e-782d-88c5-8ce6-729a3e8ef751"],
 "."
}], "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "\\begin{enumerate}[leftmargin=*]\n    \\item ", 
     "Separator" -> "\n"|>|>,
 CounterAssignments->{{"ItemNumbered", 0}},
 FontSlant->Plain,ExpressionUUID->"4d633af3-94df-e2ca-0190-658a6eb0c980"],

Cell[TextData[{
 "For Li's fixed-labelled simple graph, we keep separate the walk that\n    \
chooses a distinct neighbour, the walk with a uniform ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "f3af9ec8-989b-4995-4ba7-344731478c5e"],
 "-slot clock, and\n    the walk that retains move multiplicity.  We prove \
that at least\n    ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"N", "[", 
     RowBox[{"N", "-", "3"}], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N(N-3)/2"|>|>,
  ExpressionUUID->"44e5afe9-99d3-c126-a96a-975d15d246ce"],
 " nonconstant eigenvalues of the combinatorial Laplacian stay\n    bounded, \
compute fixed-radius ball growth, and obtain linear lower bounds\n    for \
diameter and typical distance."
}], "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"610d8869-2265-302b-71ac-fcc5423733af"],

Cell[TextData[{
 "For the Rule-A chain on unlabelled classes, we prove the exact\n    \
configuration-model stationary law and show that its spectrum lies in\n    ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], ",", "1"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[-1/2,1]"|>|>,
  ExpressionUUID->"3558329d-66d3-fd82-c8fb-6175f1dfa90e"],
 ".  We compute the Dirichlet form of loop count.  We prove that the\n    \
bridged-class cut has conductance ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"o", "(", "1", ")"}], "+", "1"}], ")"}]}], 
    RowBox[{"3", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2/(3N)(1+o(1))"|>|>,
  ExpressionUUID->"c7c0a0f1-5a16-49f4-f7bd-c27306f525f8"],
 ", which gives an\n    ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "(", "N", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Omega(N)"|>|>,
  ExpressionUUID->"e02752f0-ccbd-4bc2-4c27-0b0a3d34440e"],
 " relaxation time and an explicit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "(", "N", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Omega(N)"|>|>,
  ExpressionUUID->"0ca04b4e-9821-024e-2c91-8fa17d173dbb"],
 " lower bound for\n    total-variation mixing."
}], "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c8848598-ee81-4f60-2dea-6eb65e4fd6d6"],

Cell[TextData[{
 "For Rule B on the unlabelled simple support, we assign probability\n    ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"3", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/(3N)"|>|>,
  ExpressionUUID->"9cb4b08e-5a18-6aed-bfa4-71fb9d2699ae"],
 " to every distinct nonself neighbour and assign the remaining\n    \
probability to holding.  The resulting kernel is symmetric, has uniform\n    \
stationary law, and satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]]}], "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["L", "TI"], "supp"], "/", 
     RowBox[{"(", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}], ")"}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "I-P_B=L_{\\rm supp}/(3N)"|>|>,
  ExpressionUUID->"c6ba2d77-c1d4-3518-00b4-b76a1db0afc0"],
 ".  This removes the\n    need to estimate the variable support degrees.  \
The degree-normalized walk\n    remains available as the jump chain \
conditioned on moving.  For any\n    specified full-support field lift, we \
identify all fields with zero\n    one-step variance loss by the connected \
components of the active carrier\n    edges."
}], "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "EnvironmentClose" -> 
     "\n\\end{enumerate}", "Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"a6cdb5e7-2bbb-d5ba-a93b-94cab9e39e90"],

Cell["\<\
The theoretical statements are separated below from complete finite
enumeration, conjectures, and the limited Lean verification layer.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"84a71edf-2c62-9007-d96c-11c6366ac341"]
}, Open  ]],

