  "00139992-e75e-0c3a-a2d4-651bcf49e880"],
 " grows, and at some sizes the conclusion strengthens\nto finite-time exact \
consensus."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"502e3f47-827b-6cd9-4fee-172d3d4cc631"],

Cell[TextData[{
 "Fix ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "f1c532ca-4bb6-48b9-07fd-c1c330bdaddf"],
