   RowBox[{"|", 
    SubsuperscriptBox["\[CapitalOmega]", 
     StyleBox["N", "TI"], "lab"], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], "2"], "+", 
        RowBox[{
         StyleBox["o", "TI"], "(", "1", ")"}]}], ")"}], 
      FractionBox[
       RowBox[{
