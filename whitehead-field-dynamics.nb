Cell[TextData[{
 "is the orthogonal projection onto the line ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", 
    RowBox[{
     SubscriptBox["e", "i"], "-", 
     SubscriptBox["e", "j"]}], ")"}], TraditionalForm]], "InlineFormula",
