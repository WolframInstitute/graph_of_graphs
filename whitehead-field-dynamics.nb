Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], 
    RowBox[{
     StyleBox["G", "TI"], ",", "\[Mu]"}]], "\[LongEqual]", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], "}"}], "\[Element]", 
       RowBox[{
        StyleBox["E", "TI"], "(", 
