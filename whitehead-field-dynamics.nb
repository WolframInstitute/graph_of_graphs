Cell[TextData[{
 "for all sufficiently large even ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "3bae9c46-ecdd-42d1-a108-d27f206ef1dd"],
 "."
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"ca7dc44c-e729-6fee-8541-d3700079d99b"],

Cell[TextData[{
 "Choose ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k-1"|>|>,ExpressionUUID->
  "76044569-f606-c8fb-02f7-1ceb5056a50e"],
 " distinct fixed cycle lengths.  Under the cubic configuration\nmodel, the \
corresponding cycle-count variables converge jointly to\nindependent Poisson \
variables.  Hence the centered indicators that a carrier\ncontains a cycle of \
each chosen length have norms bounded away from zero and\nan asymptotically \
nonsingular Gram matrix."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"3e97d644-4a79-daa7-840f-b96bd3131344"],

Cell[TextData[{
 "If a carrier contains a chosen ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "j"|>|>,ExpressionUUID->
  "90fc816c-09ab-26ec-ccfa-b3fb1ce79f17"],
 "-cycle, a one-step move which destroys the\nlast such cycle must be \
performed on or within bounded distance of that cycle.\nOnly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "j"], "(", "1", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_j(1)"|>|>,
  ExpressionUUID->"8cacfc3f-19de-6efb-efe2-245d9bf4c30b"],
 " of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "f3952469-a98d-a6e9-22a7-e5f28ee64e70"],
 " compressed slots can do this.  The Rule-A Dirichlet\nenergy of its \
centered indicator is therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "j"], "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_j(N^{-1})"|>|>,
  ExpressionUUID->"4f7a8594-f49b-7173-b259-1b4b3338e6d5"],
 ".  Cauchy--Schwarz\ngives the same order for cross energies.  The min--max \
principle on the span of\nthese indicators and the constant function gives \
the result."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"ff3f0b74-c8ff-a789-3488-bb298800ea1b"],

Cell["\<\
This is the normalized multiplicity-chain analogue of Li's bounded-eigenvalue
construction.  It concerns the Markov operator actually sampled by local
Rule A, rather than either simple-support Laplacian.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"efa43738-8f75-8a4a-58a0-36e0986d5e93"],

Cell["The key distinction is:", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"2e3bcb39-1ef1-7cb4-3889-d9238911f2bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"GoG", " ", "bottleneck"}], "  ", "\[NotEqual]", "  ", 
    RowBox[{"bad", " ", "field"}]}], "\[Hyphen]", 
   RowBox[{"averaging", " ", 
    RowBox[{"graph", "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\text{GoG bottleneck}\n    \\quad\\neq\\quad\n    \\text{bad \
field-averaging graph}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e362c818-ed04-aae8-5607-d2e2be415b7b"],

Cell[TextData[{
 "Grave de Peralta--Kolpakov's bridged set is a bottleneck in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"c8a2ff3a-f3d3-c2a3-a19f-a155d4a8094b"],
 " because few\nWhitehead moves leave the set of bridged graphs.  But the \
field relaxation at a\ntime ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "t"|>|>,ExpressionUUID->
  "17e5715f-5e07-b0e7-44bc-51bd3d1cdfee"],
 " is controlled by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "2"], "(", 
    SubscriptBox["L", 
     SubscriptBox["G", "t"]], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\lambda_2(L_{G_t})"|>|>,
  ExpressionUUID->"639ad37c-0516-6532-a1fb-005f43e4f31a"],
 " or by the weighted analogue\ncoming from the edge-selection rule.  A graph \
with a microscopic bridge may\nstill have a spectral gap bounded below by a \
constant.  A balanced bridge is\nbad for field averaging, because it gives a \
cut of size one separating two\nlinear-size pieces; a function constant on \
the two sides then gives\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Lambda]", "2"], "(", 
     SubscriptBox["L", "G"], ")"}], "\[LongEqual]", 
    RowBox[{"O", "(", 
     FractionBox["1", "N"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\lambda_2(L_G)=O(1/N)"|>|>,
  ExpressionUUID->"8691d46c-4154-d8de-6d68-efd69030ff00"],
 "."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"62fac88e-e702-cbf2-97f0-3bc710c54e14"],

Cell[TextData[{
 "More explicitly, if a bridge separates a set ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S"|>|>,ExpressionUUID->
  "3b16cd57-4e02-58d3-9779-ba8224fc95d0"],
 " of ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "cf8d814a-358a-1360-bd5b-f96d7e0f9bf4"],
 " vertices from its\ncomplement, the test function which is constant on ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S"|>|>,ExpressionUUID->
  "2357785e-31ee-ff89-e2ac-8ff9958d4aee"],
 " and on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "c"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S^c"|>|>,ExpressionUUID->
  "faa57932-f335-a33e-ae06-98a86ef3d037"],
 " gives"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"bc366331-ada1-30f1-16e6-12c48c056beb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", "2"], "(", 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["G", "TI"]], ")"}], "\[LessEqual]", 
   RowBox[{
    FractionBox[
     StyleBox["N", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], "(", 
      RowBox[{
       StyleBox["N", "TI"], "-", 
       StyleBox["k", "TI"]}], ")"}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\lambda_2(L_G)\n    \\le\n    \\frac{N}{k(N-k)}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"84392aac-48b8-632b-fab4-6b0b15b5ab94"],

Cell[TextData[{
 "This is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(1/N)"|>|>,
  ExpressionUUID->"23e82e91-4eb6-845e-b2f4-48f41eb0c3b3"],
 " for balanced bridges and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(1)"|>|>,
  ExpressionUUID->"9f2945c1-f639-1efe-876f-84c0e284700a"],
 " for microscopic bridges.  Thus\nbridged graphs are not uniformly bad for \
field relaxation; balanced sparse cuts\nare."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"4b64c8e6-054d-77be-9aac-69f9361bb9d3"],

Cell["\<\
The converse direction is governed by ordinary spectral graph theory.  Define
the edge isoperimetric constant of the current cubic graph by\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"1ddca5cf-f30b-2245-f6e7-30291547c151"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["min", 
      RowBox[{
       RowBox[{"0", "<"}], "|", 
       StyleBox["S", "TI"], "|", 
       RowBox[{"\[LessEqual]", 
        RowBox[{
         StyleBox["N", "TI"], "/", "2"}]}]}],
      LimitsPositioning->True], 
     FractionBox[
      TemplateBox[{
        RowBox[{
          SubscriptBox["\[PartialD]", 
           StyleBox["G", "TI"]], 
          StyleBox["S", "TI"]}]},
       "Abs"], 
      TemplateBox[{
        RowBox[{
          StyleBox["S", "TI"]}]},
       "Abs"]]}]}], ","}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    h(G)=\n    \\min_{0<|S|\\le N/2}\n    \\frac{|\\partial_G \
S|}{|S|},\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"6b4417c2-6265-d166-ca8d-2d82113233e2"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", "S"}], 
    RowBox[{"\[PartialD]", "G"}],
    MultilineFunction->None], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\partial_G S"|>|>,
  ExpressionUUID->"fd96ec39-5806-a3d0-c1f3-576f6aa75268"],
 " is the set of edge objects crossing from ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S"|>|>,ExpressionUUID->
  "b256fa6d-d8cc-398a-0395-586a219222e1"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "c"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S^c"|>|>,ExpressionUUID->
  "2ffe8fec-70f8-d0b3-b46c-05e171a64b61"],
 ".\nFor graphs of maximum degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3"|>|>,ExpressionUUID->
  "85d6caae-1b75-33ea-6c8e-2a3d01af5d01"],
 ", the combinatorial Cheeger inequalities give\nthe explicit bounds ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"chung"],
 ButtonBox["chung",
  BaseStyle->"Citation",
  ButtonData->"chung"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"chung"]
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"4abc6299-10e9-f0be-f8b5-8cef86ff6f30"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     StyleBox["h", "TI"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["G", "TI"], ")"}], "2"]}], "6"], "\[LessEqual]", 
   RowBox[{
    SubscriptBox["\[Lambda]", "2"], "(", 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["G", "TI"]], ")"}], "\[LessEqual]", 
   RowBox[{"2", 
    RowBox[{
     RowBox[{
      StyleBox["h", "TI"], "(", 
      StyleBox["G", "TI"], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\frac{h(G)^2}{6}\\le \\lambda_2(L_G)\\le 2h(G).\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ef2af0e5-f7f4-bb34-9a39-d9238b9c06e4"],

Cell[TextData[{
 "Thus a large sparse cut supplies a slowly contracting field direction, not \
a\nstatement that every current field contracts slowly.  The actual one-step\n\
loss is governed by ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"f", " ", 
     TemplateBox[{"f"},
      "Transpose"], " ", 
     SubscriptBox["L", "G"]}], 
    RowBox[{"V", "(", "f", ")"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f^TL_Gf/\\V(f)"|>|>,
  ExpressionUUID->"6b9fd29f-696a-2812-8239-ac71569fada3"],
 "; a field nearly orthogonal to an\neigenvector with small Laplacian \
eigenvalue may contract quickly.  Microscopic bridges can\ncoexist with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "G", ")"}], "\[CupCap]", "1"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "h(G)\\asymp1"|>|>,
  ExpressionUUID->"4f2b7563-67d8-8aaa-3ca7-b8894791be4f"],
 " when all cuts separating a linear-size set have\nlinear boundary, whereas \
balanced bridges force ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "G", ")"}], "\[LongEqual]", 
    RowBox[{"O", "(", 
     FractionBox["1", "N"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "h(G)=O(1/N)"|>|>,
  ExpressionUUID->"7c879d8a-cdce-3717-84ae-db29b1d55ee8"],
 ".  This is the\nprecise interface between bridge geometry and the Lyapunov \
estimate."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"fccd1e02-301f-a4c6-6eb1-a6c93b28bef9"],

Cell["\<\
The Rule-A stationary probability of a balanced cut of any fixed width
consequently tends to zero.  The bridged GoG bottleneck remains important for
the mixing of the base chain, but it does not bias its equilibrium carrier
marginal away from the configuration model.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"b11d5dcd-9ea3-5530-9893-84ec2609f34c"],

Cell["\<\
For a precisely specified Rule-A cocycle with no finite consensus word, or
along sizes for which such a word is impossible, the finite top exponent
satisfies\
\>", "Conjecture",
 CellDingbat->Cell[
   TextData[{"Conjecture ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "conjecture", "EnvironmentOpen" -> 
     "\\begin{conjecture}[Expected $1/N$ contraction scale without a killing \
word]", "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"b6457b53-a010-7e58-f028-ceb1ff92652b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"N", " ", 
    SubscriptBox["\[CapitalLambda]", "N"]}], "\[Rule]", 
   RowBox[{"-", "\[Theta]"}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    N\\Lambda_N\\to -\\theta\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"b66c1f62-1b1d-f216-7597-8b98424fb0d3"],

Cell[TextData[{
 "for some ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", ">", "0"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\theta>0"|>|>,
  ExpressionUUID->"7e37bcd4-f04b-07b1-c9d5-7f9ee9840af3"],
 ".  The value may differ from the independent reset constant\nbecause the \
evolving field and carrier are correlated.  Without the stated\n\
qualification, the conjecture is false as a finite-valued assertion at\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "\[LongEqual]", "2"}], ",", "4", ",", "8"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2,4,8"|>|>,
  ExpressionUUID->"7ad8707c-0919-839f-d851-e9cab2cce7a1"],
 ", and possibly at further powers of two."
}], "Conjecture",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{conjecture}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"0b5c2695-811b-888e-20e5-bd364e240422"]
}, Open  ]],

