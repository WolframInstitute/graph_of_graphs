 FontSlant->Plain,ExpressionUUID->"11c9f2c9-428c-bfda-67df-3bc8b9617e8a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "\[LongEqual]", 
   RowBox[{
    StyleBox["I", "TI"], "-", 
    RowBox[{
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"]], 
     SubsuperscriptBox[
      StyleBox["u", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"], 
      StyleBox["T", "TI"]]}]}], "\[LongEqual]", 
   RowBox[{
    StyleBox["I", "TI"], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], "-", 
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["j", "TI"]]}], ")"}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]]}], ")"}], 
       StyleBox["T", "TI"]], "."}]}]}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    A_{ij}=I-u_{ij}u_{ij}^T\n    =\n    \
I-\\frac12(e_i-e_j)(e_i-e_j)^T.\n\\]", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"ef5c7f0d-c57b-dc06-9403-0d1c02b05855"],

Cell[TextData[{
