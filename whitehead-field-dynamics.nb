          GogFieldDynamics`Private`$labMuted, FontFamily -> "Helvetica"], 
         Style[
         GogFieldDynamics`Private`value, 9, Bold, 
          GogFieldDynamics`Private`color, FontFamily -> "Helvetica"]}, 
        Alignment -> Left, Spacings -> 0.1], Background -> 
       Blend[{White, GogFieldDynamics`Private`color}, 0.06], FrameStyle -> 
       Directive[
         Opacity[0.28], GogFieldDynamics`Private`color], 
       FrameMargins -> {{6, 6}, {4, 4}}, ImageSize -> {56, 39}], 
     GogFieldDynamics`Private`$labGreen = RGBColor[0., 0.62, 0.45], 
     GogFieldDynamics`Private`$labPurple = RGBColor[0.57, 0.38, 0.74], 
     GogFieldDynamics`Private`labEngineLabel[
       Pattern[GogFieldDynamics`Private`trajectory, 
        Blank[Association]]] := 
     Module[{GogFieldDynamics`Private`engine = 
        Lookup[GogFieldDynamics`Private`trajectory, "Engine", "unknown"], 
        GogFieldDynamics`Private`version}, 
       GogFieldDynamics`Private`version = 
        Lookup[GogFieldDynamics`Private`trajectory, "SetReplaceVersion", 
          Missing[]]; If[
         And[GogFieldDynamics`Private`engine === "SetReplace", 
          StringQ[GogFieldDynamics`Private`version]], "SETREPLACE " <> 
         GogFieldDynamics`Private`version <> " PATH", 
         ToUpperCase[GogFieldDynamics`Private`engine] <> " PATH"]], 
     GogFieldDynamics`Private`labPathRibbon[
       Pattern[GogFieldDynamics`Private`path, 
        Blank[List]], 
       Pattern[GogFieldDynamics`Private`step, 
        Blank[Integer]]] := 
     Module[{GogFieldDynamics`Private`prefix, 
        GogFieldDynamics`Private`visible, GogFieldDynamics`Private`labels}, 
       GogFieldDynamics`Private`prefix = Take[GogFieldDynamics`Private`path, 
          Min[GogFieldDynamics`Private`step + 1, 
           Length[GogFieldDynamics`Private`path]]]; 
       GogFieldDynamics`Private`visible = 
        Take[GogFieldDynamics`Private`prefix, -Min[7, 
            Length[GogFieldDynamics`Private`prefix]]]; 
       GogFieldDynamics`Private`labels = 
        Map[GogFieldDynamics`Private`labLabel, 
          GogFieldDynamics`Private`visible]; 
       If[Length[GogFieldDynamics`Private`prefix] > 
         Length[GogFieldDynamics`Private`visible], 
         GogFieldDynamics`Private`labels = 
         Prepend[GogFieldDynamics`Private`labels, "\[Ellipsis]"]]; Row[
         Riffle[
          Map[
          Style[#, 8, Bold, GogFieldDynamics`Private`$labNavy, FontFamily -> 
            "Helvetica"]& , GogFieldDynamics`Private`labels], 
          Style[
          "  \[RightArrow]  ", 9, Bold, 
           GogFieldDynamics`Private`$labOrange]]]]}; Quiet[
     Check[
      Module[{
       GogFieldDynamics`Private`directory, 
        GogFieldDynamics`Private`localKernel}, 
       GogFieldDynamics`Private`directory = Quiet[
          Check[
           NotebookDirectory[], $Failed]]; If[
         StringQ[GogFieldDynamics`Private`directory], 
         GogFieldDynamics`Private`localKernel = 
          FileNameJoin[{
            GogFieldDynamics`Private`directory, "Wolfram", "GogFieldDynamics",
              "Kernel", "init.wl"}]; If[
           FileExistsQ[GogFieldDynamics`Private`localKernel], 
           Get[GogFieldDynamics`Private`localKernel]]; Null]; If[
         Not[
          NameQ["GogFieldDynamics`GogDiffusionState"]], 
         Needs["GogFieldDynamics`"]]; Null], Null]]),
  SynchronousInitialization->True]], "Text",
