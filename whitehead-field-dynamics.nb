Cell[TextData[{
 "In particular ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M_N"|>|>,ExpressionUUID->
  "0d401bd0-1e4f-25fb-5f99-b2df2ce28a56"],
 " is real-diagonalizable, and from every source class the\nnumber of \
concrete length-",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "t"|>|>,ExpressionUUID->
  "1a147f74-416e-1960-ea35-75d2c1598ce6"],
 " slot histories is exactly ",
