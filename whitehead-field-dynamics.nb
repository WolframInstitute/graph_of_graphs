Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["N", "TI"]], 
    RowBox[{
     StyleBox["V", "TI"], "(", 
     SuperscriptBox[
      StyleBox["x", "TI"], "0"], ")"}]}], "\[LessEqual]", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox[
       RowBox[{"i", "j"}], "TI"], "\[Element]", 
      StyleBox["T", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["i", "TI"], "0"], "-", 
       SubsuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["j", "TI"], "0"]}], ")"}], "2"]}], "\[LessEqual]", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["N", "TI"], "-", "1"}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SqrtBox[
        StyleBox["m", "TI"]]}], ")"}], "2"], 
    RowBox[{
     StyleBox["D", "TI"], "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n a_N\\V(x^0)\n \\le\\sum_{ij\\in T}(x_i^0-x_j^0)^2\n \\le2(N-1)(1+\
\\sqrt m)^2D.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"22436d0b-4054-c1d1-6477-d921548ad05e"],

Cell["\<\
Rearranging proves the one-block estimate.  Multiplying the estimates over
disjoint blocks proves the exponent bound.\
\>", "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"c66c83e0-346d-dc9e-1846-caee918aa92d"],

Cell["\<\
Thus the relevant connectivity condition is imposed on the endpoint pairs
in one persistent frame, rather than on physical source edges written in
successively changing frames.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"4fded887-3f57-0c95-0a22-42fd90a2a659"]
}, Open  ]],

