Cell[TextData[{
 "After ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "e"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_e"|>|>,ExpressionUUID->
  "7611e383-ae96-2c92-4abe-73082630380c"],
 ", the values at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "i,j"|>|>,ExpressionUUID->
  "605fc858-3a0f-ca27-f0e0-b0aee25b8bf0"],
 " agree.  A Whitehead resolution only changes\nwhich of these equal-valued \
endpoints owns each surrounding half-edge, so it\ndoes not change any \
contrast energy.  Averaging ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "e"], " ", 
    SubscriptBox["A", "e"], " ", 
    SubscriptBox["L", "G"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_eL_GA_e"|>|>,
  ExpressionUUID->"ee7d978b-3d4f-0d7c-517f-336fea3aa15f"],
 " over edge objects\nand using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "e"], 
     RowBox[{
      SubscriptBox["b", "e"], " ", 
      TemplateBox[{
        RowBox[{"(", 
          SubscriptBox["b", "e"], ")"}]},
       "Transpose"]}]}], "\[LongEqual]", 
    SubscriptBox["L", "G"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\sum_e b_eb_e^T=L_G"|>|>,
  ExpressionUUID->"e714ce9d-758c-9356-ca54-d40d91030c04"],
 " gives the matrix identity.  In a simple cubic\ngraph, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["b", "e"], " ", 
     SubscriptBox["L", "G"], " ", 
     TemplateBox[{
       RowBox[{"(", 
         SubscriptBox["b", "e"], ")"}]},
      "Transpose"]}], "\[LongEqual]", 
    RowBox[{"3", "+", "3", "+", "2"}], "\[LongEqual]", "8"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "b_e^TL_Gb_e=3+3+2=8"|>|>,
  ExpressionUUID->"875890ab-7406-1a67-e22e-6ff8bf83acf3"],
 "."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"5066a3a6-29db-d253-e547-ee3536d0531f"],

Cell[TextData[{
 "Thus, for a simple carrier and an ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "G"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L_G"|>|>,ExpressionUUID->
  "2104e9b0-89ed-87f7-4c0d-d75537d9c0a0"],
 "-eigenfield of eigenvalue ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\lambda"|>|>,
  ExpressionUUID->"e6f93af2-105b-8c42-db4e-5bd88b717d41"],
 ",\nthe expected carrier energy is multiplied by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"2", "-", "\[Lambda]"}], "M"], "+", "1"}], TraditionalForm]], 
  "InlineFormula",
