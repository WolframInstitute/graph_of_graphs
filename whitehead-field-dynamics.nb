 FontSlant->Plain,ExpressionUUID->"a841f2cd-8609-0cef-4884-513292061cdf"],

Cell[TextData[{
 "The vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "ij"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "u_{ij}"|>|>,
  ExpressionUUID->"9ccc51ee-e84f-8e21-a7a1-8d0e080b901e"],
 " is a unit normal to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "ij"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H_{ij}"|>|>,
  ExpressionUUID->"d37d931d-ea12-5416-26e0-357ddd59390c"],
 ".  Therefore\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "ij"], " ", 
    TemplateBox[{
      RowBox[{"(", 
        SubscriptBox["u", "ij"], ")"}]},
     "Transpose"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "u_{ij}u_{ij}^T"|>|>,
  ExpressionUUID->"cfc7278f-9164-ea4a-3fb3-b5e5996c3283"],
 " is the orthogonal projection onto ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["H", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"], "\[Perpendicular]"], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H_{ij}^\\perp"|>|>,
  ExpressionUUID->"854b100a-2681-5232-65f1-4fb635aef06f"],
 " and\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], "-", 
    RowBox[{
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"]], 
     SubsuperscriptBox[
      StyleBox["u", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"], 
      StyleBox["T", "TI"]]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "I-u_{ij}u_{ij}^T"|>|>,
  ExpressionUUID->"d25c6862-eb69-b0b4-71ce-e9335985ab98"],
 " is the orthogonal projection onto ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "ij"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H_{ij}"|>|>,
  ExpressionUUID->"fd7c4d24-4daf-6f4c-8463-715750f8ff1a"],
 ".  This also gives\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["A", "ij", "2"], "\[LongEqual]", 
    SubscriptBox["A", "ij"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_{ij}^2=A_{ij}"|>|>,
  ExpressionUUID->"c2a79de2-52ef-ec28-e38a-2c49149fe8f9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["I", "TI"], "-", 
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]]}], ")"}], "2"], "\[LongEqual]", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["A", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"]]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "(I-A_{ij})^2=I-A_{ij}"|>|>,
  ExpressionUUID->"1f6ab99e-c036-86e5-1024-c3f641c15b21"],
 "."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"cfe80bec-0189-2a12-a663-fd6396509de2"],

Cell[TextData[{
 "Thus neither ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "ij"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_{ij}"|>|>,
