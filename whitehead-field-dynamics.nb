Cell["\<\
A perfect matching is a commuting block of pair projections.  Two transverse \
matchings on K4 and three coordinate matchings on Q3 produce exact consensus \
in finitely many stages.\
\>", "Text",
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGConsensusText"|>|>,
