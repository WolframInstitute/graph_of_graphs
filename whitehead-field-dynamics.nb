Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["t", "TI"]], "\[LongEqual]", 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{
      StyleBox["s", "TI"], "=", "0"}], 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}],
     LimitsPositioning->True], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        SubscriptBox["\[ScriptL]", 
         StyleBox["s", "TI"]], 
        RowBox[{"3", 
         StyleBox["N", "TI"]}]]}], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    Q_t=\\prod_{s=0}^{t-1}\\left(1-\\frac{\\ell_s}{3N}\\right).\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"b5289f7b-2be4-2d50-147b-39a4dc404420"],

