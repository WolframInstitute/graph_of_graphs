Cell[TextData[{
 "With the convention\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "LS"], "\[LongEqual]", 
    RowBox[{"inf", 
     RowBox[{
      RowBox[{
       StyleBox["E", "TI"], "(", 
       RowBox[{
        StyleBox["F", "TI"], ",", 
        StyleBox["F", "TI"]}], ")"}], "/", 
      SubscriptBox[
       StyleBox[
        RowBox[{"E", "n", "t"}], "TI"], 
       SubscriptBox["\[Pi]", 
        StyleBox["A", "TI"]]]}], 
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["F", "TI"], "2"], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> 
      "\\alpha_{\\rm LS}=\\inf\\mathcal \
E(F,F)/\\operatorname{Ent}_{\\pi_A}(F^2)"|>|>,ExpressionUUID->
  "4b45c9ee-232b-344a-df0f-0d280c4c02c4"],
 ",\nalso ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "LS"], "\[LessEqual]", 
    RowBox[{
     RowBox[{"o", "(", 
      FractionBox["1", "N"], ")"}], "+", 
     FractionBox["2", 
      RowBox[{"3", " ", "N"}]]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "\\alpha_{\\rm LS}\\le2/(3N)+o(N^{-1})"|>|>,
  ExpressionUUID->"9c17af48-5e9a-0f2b-f814-73527200d138"],
 "."
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"a31bc11c-99f5-8a62-ad0d-20e0aa86428e"],

Cell[TextData[{
 "A state with ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "6b24b974-cbb7-99a6-83c9-acbcf80d16e3"],
 " loops has exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "k"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2k"|>|>,ExpressionUUID->
  "64816783-35c3-5731-cc09-10a343400751"],
 " compressed slots that destroy one\nloop.  No move changes loop count by \
more than one when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[GreaterEqual]", "4"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\ge4"|>|>,
  ExpressionUUID->"b656020d-2021-d4dc-895f-3b00594809f2"],
 ".  Detailed\nbalance supplies the reverse aggregate flow and gives the \
displayed form.\nUnder ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "A"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\pi_A"|>|>,
  ExpressionUUID->"5b55c226-41a6-1241-6f7b-a4b387c3537f"],
 ", ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L"|>|>,ExpressionUUID->
  "466d3d5a-1c5c-f8fd-da19-caf22eda5230"],
 " tends to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "Pois"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\operatorname{Pois}(1)"|>|>,
  ExpressionUUID->"72cd7eca-6aeb-c674-ebcd-bd12e4e0531c"],
 ".  Applying min--max to\nthe first ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "r"|>|>,ExpressionUUID->
  "bf366e3f-01c4-d1af-ddc2-1ed7b3d1fca2"],
 " Charlier polynomials, whose limiting immigration--death\nratios of \
Dirichlet energy to variance are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "\[Ellipsis]", ",", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1,\\ldots,r"|>|>,
  ExpressionUUID->"6cc5804e-43ec-773b-a41e-93134130c0c3"],
 ", proves the eigenvalue bound.  The\nindicator of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "\[LongEqual]", "0"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L=0"|>|>,ExpressionUUID->
  "14a92711-1751-84ba-3125-d6db24fcbb1d"],
 " proves the log-Sobolev upper bound."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c0e7bd72-40d1-06a5-80ef-3ef431f22040"],

Cell[TextData[{
 "The projected process ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "(", 
    SubscriptBox["G", "t"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L(G_t)"|>|>,
  ExpressionUUID->"97c10ee9-0842-6aac-fa14-cb4df5f93b10"],
 " need not itself be Markov.  The theorem is an\nexact stationary \
Dirichlet-form identity and an upper bound; it does not say\nthat the \
smallest eigenvalues converge to those of a one-dimensional\nbirth--death \
chain."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"926dd4c0-c01c-96b0-adfe-ba3875059878"]
}, Open  ]],

