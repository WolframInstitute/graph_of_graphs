     SubscriptBox["1", "S"], "-", 
     FractionBox["k", "N"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "f=\\one_S-(k/N)\\one"|>|>,
  ExpressionUUID->"225c865c-e272-e8a5-9fa8-bd445b0b3b0b"],
 ".  Then"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Exact cut drift and cut count]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"3a782767-2617-88c7-5fb1-accb543eb1b9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["V", "TI"], "(", 
        SuperscriptBox[
         StyleBox["f", "TI"], "\[Prime]"], ")"}], "|", 
       StyleBox["G", "TI"]}], ",", 
      StyleBox["f", "TI"]}], "]"}], 
    RowBox[{
     StyleBox["V", "TI"], "(", 
     StyleBox["f", "TI"], ")"}]], "\[LongEqual]", 
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox[
      StyleBox["b", "TI"], 
      RowBox[{"3", 
       RowBox[{
        StyleBox["k", "TI"], "(", 
        RowBox[{
         StyleBox["N", "TI"], "-", 
         StyleBox["k", "TI"]}], ")"}]}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\frac{\\E[\\V(f')\\mid G,f]}{\\V(f)}\n =1-\\frac{b}{3k(N-k)}.\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"bce60b26-cf80-fea5-811f-95bbd4745d74"],

Cell[TextData[{
 "In an unconditioned cubic configuration, the expected number of ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "009bb1b5-f8de-e22a-5ba1-80a28588f457"],
