        RowBox[{
         SubscriptBox["\[Pi]", 
          StyleBox["A", "TI"]], "(", 
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["N", "TI"]], ")"}], ",", 
        RowBox[{
         SubscriptBox["\[Pi]", 
          StyleBox["A", "TI"]], "(", 
         SubscriptBox[
          StyleBox["B", "TI"], "0"], ")"}]}], "}"}]}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\Phi_A(B_N)=\n \
\\frac{Q_A(B_N,B_0)}{\\min\\{\\pi_A(B_N),\\pi_A(B_0)\\}}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"eba3bc0c-36ec-fe0b-0bab-1d1a9e801733"],

