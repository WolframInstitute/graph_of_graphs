   RowBox[{"q", ">", "0"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q>0"|>|>,ExpressionUUID->
  "610eacaa-2729-1e3b-2332-5454e2d097f5"],
 ", uniformly over the current state."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"75fe8188-845d-cd6a-efb6-b2b89e84abff"],

Cell[TextData[{
 "For every success block, the product of its averaging projections includes \
all\nedges of the spanning tree ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "*"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T^\\ast"|>|>,
  ExpressionUUID->"9d42b486-073d-24a3-3c8b-90a24a06b320"],
 ".  By the connected-block corollary, its\nrestriction to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "05d6953c-765e-8486-8a5d-6a57a881815a"],
 " has norm strictly less than one.  There are only finitely\nmany \
success-block words of length at most ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "fc1341f7-a079-68aa-b749-7a611c1f7986"],
 ", so the maximum of their norms is\nsome ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "<", "1"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\rho<1"|>|>,
  ExpressionUUID->"362522d0-8a9b-e4cd-b41f-c8d523256613"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"8577c619-9be3-ead3-3c2b-986af8706001"],

Cell[TextData[{
 "Now divide time into disjoint blocks of length ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "22436d0b-4054-c1d1-6477-d921548ad05e"],
 ".  Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Y", "k"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "Y_k"|>|>,ExpressionUUID->
  "c66c83e0-346d-dc9e-1846-caee918aa92d"],
 " be the indicator\nthat block ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "4fded887-3f57-0c95-0a22-42fd90a2a659"],
 " is successful and put\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], "[", 
     RowBox[{
      SubscriptBox[
       StyleBox["Y", "TI"], 
       StyleBox["k", "TI"]], "|", 
      SubscriptBox[
       StyleBox["F", "TI"], 
       StyleBox[
        RowBox[{"k", "M"}], "TI"]]}], "]"}], "\[GreaterEqual]", 
    StyleBox["q", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "p_k=\\E[Y_k\\mid\\mathcal F_{kM}]\\ge q"|>|>,
  ExpressionUUID->"fe24265c-7ea3-66ef-6eb7-abad5f2b503e"],
 ".  The martingale\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"k", "<", "r"}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["Y", "k"], "-", 
      SubscriptBox["p", "k"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\sum_{k<r}(Y_k-p_k)"|>|>,
  ExpressionUUID->"6c0bf71f-bf99-4be4-7aa8-1eb209103162"],
 " has bounded increments, so its strong law\n",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"williams",
  ButtonNote->"\\cite{williams"],
 ButtonBox["williams",
  BaseStyle->"Citation",
  ButtonData->"williams",
  ButtonNote->"\\cite{williams"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"williams",
  ButtonNote->"\\cite{williams"],
 ", ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"durrett",
  ButtonNote->",durrett"],
 ButtonBox["durrett",
  BaseStyle->"Citation",
  ButtonData->"durrett",
  ButtonNote->",durrett"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"durrett",
  ButtonNote->",durrett"],
 " gives"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"0e8b0aea-c10e-ad32-741a-d4c4dbc4a1a9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox[
     RowBox[{"lim", " ", "inf"}], 
     RowBox[{
      StyleBox["r", "TI"], "\[Rule]", "\[Infinity]"}],
     LimitsPositioning->True], 
    FractionBox["1", 
     StyleBox["r", "TI"]], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "TI"], "<", 
       StyleBox["r", "TI"]}],
      LimitsPositioning->True], 
     SubscriptBox[
      StyleBox["Y", "TI"], 
      StyleBox["k", "TI"]]}]}], "\[GreaterEqual]", 
   RowBox[{
    StyleBox["q", "TI"], "  ", "almost", " ", 
    RowBox[{"surely", "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\liminf_{r\\to\\infty}\\frac1r\\sum_{k<r}Y_k\\ge q\n    \
\\quad\\text{almost surely}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"00139992-e75e-0c3a-a2d4-651bcf49e880"],

Cell[TextData[{
 "Successful blocks contract by at most ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\rho"|>|>,
  ExpressionUUID->"502e3f47-827b-6cd9-4fee-172d3d4cc631"],
 "; all other blocks have norm at\nmost one.  Hence"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"f1c532ca-4bb6-48b9-07fd-c1c330bdaddf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox[
     RowBox[{"lim", " ", "sup"}], 
     RowBox[{
      StyleBox["r", "TI"], "\[Rule]", "\[Infinity]"}],
     LimitsPositioning->True], 
    FractionBox["1", 
     StyleBox[
      RowBox[{"r", "M"}], "TI"]], "log", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     RowBox[{
      StyleBox[
       RowBox[{"r", "M"}], "TI"], "-", "1"}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["B", "TI"], "0"]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], 
   RowBox[{"\[LessEqual]", 
    RowBox[{
     FractionBox[
      StyleBox["q", "TI"], 
      StyleBox["M", "TI"]], "log", 
     RowBox[{"\[Rho]", "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\limsup_{r\\to\\infty}\n    \
\\frac1{rM}\\log\\norm{B_{rM-1}\\cdots B_0|_{E_0}}\n    \\le\n    \
\\frac{q}{M}\\log\\rho.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"42ab7241-c1db-1afa-e5c4-603b3f11707b"],

Cell[TextData[{
 "The leftover times between multiples of ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M"|>|>,ExpressionUUID->
  "148c041b-9d36-580f-4a62-bc226ada45fc"],
 " contribute only norm-one factors,\nso the same limsup holds for all ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "t"|>|>,ExpressionUUID->
  "9c9bff8a-f695-6b1d-75b1-d5be57fdb6e5"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"fb342670-7926-c507-bfe3-a045135d4db1"],

Cell[TextData[{
 "The theorem is deliberately stated on the persistent labelled lift.  For an\
\nunlabelled implementation with intermediate settlements\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SubscriptBox["\[Sigma]", "t"]], " ", 
    SubscriptBox["A", 
     RowBox[{
      SubscriptBox["i", "t"], " ", 
      SubscriptBox["j", "t"]}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "P_{\\sigma_t}A_{i_tj_t}"|>|>,
  ExpressionUUID->"9c263cc3-6e38-4556-5da0-9bca185757b3"],
 ", orthogonality of each permutation alone does not\npreserve the \
connected-block argument: cumulative settlements conjugate the\nlater \
averaging pairs.  The same proof works if the averaged pairs are pulled\nback \
to one persistent frame and those effective pairs form a connected block.\n\
Without that condition, fixed-",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "17027eb4-8296-ca70-e496-f57a90d9bf8e"],
 " consensus for an arbitrary settlement rule\nhas not been proved here."
}], "Remark",
 CellDingbat->Cell[
   TextData[{"Remark ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "remark", "EnvironmentOpen" -> "\\begin{remark}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{remark}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->
  "Theorem",ExpressionUUID->"5e3ed428-3aab-b5ab-77b6-961c4353b1b3"],

Cell[TextData[{
 "Under the hypotheses of the persistent labelled theorem, the restriction of\
\nthe field product to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "9bf46b89-2f39-bb50-6841-d5b0b61c9d45"],
 " becomes exactly zero in finite time almost surely at\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "\[LongEqual]", "2"}], ",", "4", ",", "8"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2,4,8"|>|>,
  ExpressionUUID->"9e1b540d-c909-7465-f40e-017efa0a5402"],
 ".  Thus its top exponent is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[Infinity]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "-\\infty"|>|>,
  ExpressionUUID->"a2253ddd-af81-b22d-9342-37d5b272bf6b"],
 " at these sizes."
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[Finite-time consensus at $N=2,4,8$]", "Trailing" -> "",
      "BodyIndent" -> "\n", "EnvironmentClose" -> "\n\\end{theorem}", 
     "Separator" -> "\n\n"|>|>,
 CounterIncrements->
  "Theorem",ExpressionUUID->"ffeb777b-e244-3522-6d54-60eaf75c996e"],

Cell[TextData[{
 "A Whitehead move on a carrier edge ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "22c3afc8-cb0f-a4b6-5c62-9d0cfadda05a"],
 ", immediately followed by its graph\ninverse, returns the labelled carrier \
and applies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["A", "e", "2"], "\[LongEqual]", 
    SubscriptBox["A", "e"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_e^2=A_e"|>|>,
  ExpressionUUID->"e3ace803-b4ea-5600-1fbf-badd79a030a3"],
 " to the field.\nIt therefore embeds any finite edge-average word supported \
by one carrier into\na returning Whitehead word."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {
   None, None}},ExpressionUUID->"96972dc4-d4d9-9368-4907-b1130ea613c8"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2"|>|>,ExpressionUUID->
  "cc5326b3-31b9-927a-6913-c9aaefaa08c1"],
 ", one nonloop average is consensus.  At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "4"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=4"|>|>,ExpressionUUID->
  "a2b61134-be15-4176-6bfa-7d7bbb8881b0"],
 ", take ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "4"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "K_4"|>|>,ExpressionUUID->
  "9294b6d7-bff9-92bc-17b4-5c903e07becf"],
 " and average\nthe two perfect matchings"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"d076528a-f6d3-290c-af9f-ef9f7517dbba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"12", ",", "34"}], "}"}], ",", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"13", ",", "24"}], "}"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\{12,34\\},\\qquad \\{13,24\\}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ef0fcf84-aefe-800c-3b52-224b3999e90a"],

Cell[TextData[{
 "The first round makes two equal-value pairs and the second merges them.  At\
\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "8"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=8"|>|>,ExpressionUUID->
  "737db361-2440-328e-560d-3a40a4c29165"],
 ", take the cube ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "3"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "Q_3"|>|>,ExpressionUUID->
  "4896b0b8-2a6f-8425-0386-7dc641721939"],
 " and average its three coordinate perfect matchings;\nthe equal-value \
blocks double from sizes ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1"|>|>,ExpressionUUID->
  "300acdcd-4e57-29f0-5452-43cb3c4579ce"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", ",", "4", ",", "8"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2,4,8"|>|>,
  ExpressionUUID->"006b35ba-98a6-fd3d-0cee-97343d26a8ec"],
 ".  In each case the\nproduct is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "\[LongEqual]", 
    FractionBox[
     TemplateBox[{"1"},
      "Transpose"], "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "J=N^{-1}\\one\\one^T"|>|>,
  ExpressionUUID->"e57c28c1-5ad6-6cf2-571f-e09fe5635167"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"6247aa29-f54f-24b2-40ff-aa5cc5eb38c8"],

Cell[TextData[{
 "The finite irreducible carrier chain visits the chosen carrier infinitely\n\
often.  Full support gives a fixed positive probability of following the\n\
finite killing word at each visit, so the word occurs almost surely.  Every\n\
later doubly stochastic factor fixes ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J"|>|>,ExpressionUUID->
  "6d8b1aed-7559-5bd9-8524-01dd5e72d3c7"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"fbb005e9-3373-9ed2-0b7d-dd8b47f2de28"],

Cell[TextData[{
 "A finite product of pair averages and permutations can equal ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J"|>|>,ExpressionUUID->
  "6e044b96-b8a3-5b5a-91c2-0507ae086b63"],
 " only if ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "8aed0263-f2d4-2bf5-16f0-316102ab3b59"],
 "\nis a power of two.  If ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "52e02475-cdb4-045e-e4e2-3e33b570091a"],
 " is not a power of two, then after ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "t"|>|>,ExpressionUUID->
  "5ae663e6-f03e-d627-f302-e3ad2f77de57"],
 " averaging\nsteps"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Dyadic obstruction]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CounterIncrements->
  "Theorem",ExpressionUUID->"ac723b67-ce12-26ab-71cd-6d6db764da69"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["T", "TI"], "0"]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], 
   RowBox[{"\[LongEqual]", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
      SubscriptBox[
       StyleBox["T", "TI"], "0"]}], "-", 
     StyleBox["J", "TI"]}], "\[GreaterEqual]", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       StyleBox["N", "TI"], 
       SuperscriptBox["2", 
        StyleBox["t", "TI"]]}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\norm{T_{t-1}\\cdots T_0|_{E_0}}\n    =\\norm{T_{t-1}\\cdots \
T_0-J}\n    \\ge \\frac{1}{N2^t}.\n\\]", "EnvironmentClose" -> 
     "\n\\end{proposition}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"eae5d142-c1dd-b7bb-8ccb-f7e87ccc984e"],

Cell[TextData[{
 "Every entry of the product is dyadic with denominator dividing ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "t"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2^t"|>|>,ExpressionUUID->
  "e5f810e1-6a4f-9be7-a629-e7563dcece61"],
 ".  Killing\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "7cb5f9c2-e1d9-8a40-5e2e-30b9601e820b"],
 " while fixing constants forces the full product to be ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J"|>|>,ExpressionUUID->
  "89dbf6e0-ef5e-b1c8-1462-9dd82bd0f75a"],
 ".  Its entries\n",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/N"|>|>,ExpressionUUID->
  "7433449d-44e0-5805-8327-63669b314e08"],
 " are dyadic only when ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "368ba992-acd1-7c94-71df-2451057de04f"],
 " is a power of two.  Otherwise some entry differs\nfrom ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/N"|>|>,ExpressionUUID->
  "f8c1ae88-8456-7be1-ea4c-86b886f0f828"],
 " by at least ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
