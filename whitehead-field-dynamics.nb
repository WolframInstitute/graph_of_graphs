 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"66ea038c-14f7-2edf-cb57-1be9dac7dae0"],

Cell[TextData[{
 "The theorem is deliberately stated on the persistent labelled lift.  For an\
\nunlabelled implementation with intermediate settlements\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SubscriptBox["\[Sigma]", "t"]], " ", 
    SubscriptBox["A", 
     RowBox[{
      SubscriptBox["i", "t"], " ", 
      SubscriptBox["j", "t"]}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "P_{\\sigma_t}A_{i_tj_t}"|>|>,
  ExpressionUUID->"c285946c-31ac-2421-40b4-2b4a96d13637"],
 ", orthogonality of each permutation alone does not\npreserve the \
connected-block argument: cumulative settlements conjugate the\nlater \
averaging pairs.  The same proof works if the averaged pairs are pulled\nback \
to one persistent frame and those effective pairs form a connected block.\n\
Without that condition, fixed-",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "7da3e7b8-2117-8200-0eaa-bbff9aa04a7d"],
 " consensus for an arbitrary settlement rule\nhas not been proved here."
}], "Remark",
 CellDingbat->Cell[
   TextData[{"Remark ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "remark", "EnvironmentOpen" -> "\\begin{remark}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{remark}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"221cb2bb-45ff-af8c-34d8-993bc7de49b4"],

Cell[TextData[{
 "Under the hypotheses of the persistent labelled theorem, the restriction of\
\nthe field product to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "2920320d-fe9e-cb73-aec2-16ee2b3c2bdf"],
 " becomes exactly zero in finite time almost surely at\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "\[LongEqual]", "2"}], ",", "4", ",", "8"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2,4,8"|>|>,
  ExpressionUUID->"f026d602-6818-92ce-e328-811c640d0678"],
 ".  Thus its top exponent is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[Infinity]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "-\\infty"|>|>,
  ExpressionUUID->"92e8383a-5059-d037-8449-11fb3f2962f7"],
 " at these sizes."
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[Finite-time consensus at $N=2,4,8$]", "Trailing" -> "",
      "BodyIndent" -> "\n", "EnvironmentClose" -> "\n\\end{theorem}", 
     "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"c9bdda58-7f3c-3d4e-ca97-b2be0c7252c3"],

Cell[TextData[{
 "A Whitehead move on a carrier edge ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "e79c9c87-1ea8-bb76-7663-e8216a715926"],
 ", immediately followed by its graph\ninverse, returns the labelled carrier \
and applies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["A", "e", "2"], "\[LongEqual]", 
    SubscriptBox["A", "e"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_e^2=A_e"|>|>,
  ExpressionUUID->"07d261e0-fddc-b8ef-3aec-eddcffa154b7"],
 " to the field.\nIt therefore embeds any finite edge-average word supported \
by one carrier into\na returning Whitehead word."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"01bdbc28-9632-8c7a-5970-c6791ac1fffc"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2"|>|>,ExpressionUUID->
  "c403e91a-617a-9e5e-111e-8584b30da3fd"],
 ", one nonloop average is consensus.  At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "4"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=4"|>|>,ExpressionUUID->
  "b9ee1de0-e38d-6817-d990-de091b5685cf"],
 ", take ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "4"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "K_4"|>|>,ExpressionUUID->
  "ac137ca8-b8d6-7904-4d0c-1241e585949f"],
 " and average\nthe two perfect matchings"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"99cac179-c785-239d-9eae-3b1399bc8817"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"12", ",", "34"}], "}"}], ",", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"13", ",", "24"}], "}"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\{12,34\\},\\qquad \\{13,24\\}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"2420f3f5-9741-6c23-c0d8-28b9df1fcfc7"],

Cell[TextData[{
 "The first round makes two equal-value pairs and the second merges them.  At\
\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "8"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=8"|>|>,ExpressionUUID->
  "73472bf6-967d-a9d3-f5c8-031e4cb3faa2"],
 ", take the cube ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "3"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "Q_3"|>|>,ExpressionUUID->
  "b9682ea5-4212-ee4d-f891-d6e410d62c68"],
 " and average its three coordinate perfect matchings;\nthe equal-value \
blocks double from sizes ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1"|>|>,ExpressionUUID->
  "6c929b66-9131-b1a0-919b-bab2487a776a"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", ",", "4", ",", "8"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2,4,8"|>|>,
  ExpressionUUID->"73cdf458-40c1-b44a-8849-8c6d60719179"],
 ".  In each case the\nproduct is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "\[LongEqual]", 
    FractionBox[
     TemplateBox[{"1"},
      "Transpose"], "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "J=N^{-1}\\one\\one^T"|>|>,
  ExpressionUUID->"82819538-1e1f-5a6a-0860-3e03e3b63f3c"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"56bc05dc-0b31-0a5f-75de-46833d23cdc4"],

Cell[TextData[{
 "The finite irreducible carrier chain visits the chosen carrier infinitely\n\
often.  Full support gives a fixed positive probability of following the\n\
finite killing word at each visit, so the word occurs almost surely.  Every\n\
later doubly stochastic factor fixes ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J"|>|>,ExpressionUUID->
  "0b1cd568-3162-b072-0ecb-1f60d59b494b"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"5d05296a-d64f-eda5-22c4-008ea9adc675"],

Cell[TextData[{
 "A finite product of pair averages and permutations can equal ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J"|>|>,ExpressionUUID->
  "9e157ecd-ac40-5d25-e6e7-14e8a063a334"],
 " only if ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "5448ad65-4cb3-a32c-46a4-11e3d2da16ec"],
 "\nis a power of two.  If ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "3c7f6558-ca86-509a-8e38-387e869eef2d"],
 " is not a power of two, then after ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "t"|>|>,ExpressionUUID->
  "ea79d961-defd-09d8-d160-e14a44b976cd"],
 " averaging\nsteps"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[A three-value field that cannot reach exact \
consensus]", "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"dc3cb8af-1c85-8813-e553-fbc939b5612c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["T", "TI"], "0"]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], 
   RowBox[{"\[LongEqual]", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["T", "TI"], 
       RowBox[{
        StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
      SubscriptBox[
       StyleBox["T", "TI"], "0"]}], "-", 
     StyleBox["J", "TI"]}], "\[GreaterEqual]", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       StyleBox["N", "TI"], 
       SuperscriptBox["2", 
        StyleBox["t", "TI"]]}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\norm{T_{t-1}\\cdots T_0|_{E_0}}\n    =\\norm{T_{t-1}\\cdots \
T_0-J}\n    \\ge \\frac{1}{N2^t}.\n\\]", "EnvironmentClose" -> 
     "\n\\end{proposition}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"a9d3db4e-0ff2-d42e-6830-adb3efd69167"],

Cell[TextData[{
 "Every entry of the product is dyadic with denominator dividing ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "t"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2^t"|>|>,ExpressionUUID->
  "6866d360-a3df-e4e6-1b85-5a024fafdeb2"],
 ".  Killing\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "a5a1f422-4384-9c70-de9d-16950c21a523"],
 " while fixing constants forces the full product to be ",
 Cell[BoxData[
  FormBox["J", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J"|>|>,ExpressionUUID->
  "a52349f2-23a2-ec39-7b27-c55dba742f87"],
 ".  Its entries\n",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/N"|>|>,ExpressionUUID->
  "ecab86d2-026b-f984-183d-38d6c777b884"],
 " are dyadic only when ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "f87ddc99-82ac-9caa-b5ca-a671a2a49154"],
 " is a power of two.  Otherwise some entry differs\nfrom ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/N"|>|>,ExpressionUUID->
  "9f02ac67-9e5b-531f-8e52-1469b6fb71d0"],
 " by at least ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"N", " ", 
     SuperscriptBox["2", "t"]}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/(N2^t)"|>|>,
  ExpressionUUID->"e8eb975d-f8ab-5612-fa9b-97ff74274cc5"],
 ", and the operator norm dominates every\nmatrix entry."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"3a066e98-7721-e762-b627-d570f3e4e860"],

Cell[TextData[{
 "The proof also explains why the bridged bottleneck does not automatically\n\
destroy finite-",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "bf03549c-1231-6794-88ad-9a0fa7b892f1"],
 " field relaxation.  A successful block may pass through\nbridged graphs and \
may average bridge edges.  That is fine: the block contracts\nbecause the \
list of averaged label-pairs contains a spanning tree, not because\nthe \
intermediate base graphs avoid bottlenecks."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"a229d22e-3530-8aad-9ecf-fa12de5dd721"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bounds on How Fast the Field Reaches Consensus", "Section",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"fba4a003-ef6a-55a7-bada-0bea573ba206"],

Cell["For a product of settled averaging maps, define", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"4539fd9e-72d0-da71-b332-bcdc2593b033"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalLambda]", "\[LongEqual]", 
    RowBox[{
     UnderscriptBox[
      RowBox[{"lim", " ", "sup"}], 
      RowBox[{
       StyleBox["t", "TI"], "\[Rule]", "\[Infinity]"}],
      LimitsPositioning->True], 
     FractionBox["1", 
      StyleBox["t", "TI"]], "log", 
     SubscriptBox[
      StyleBox["T", "TI"], 
      RowBox[{
       StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
     SubscriptBox[
      StyleBox["T", "TI"], "0"]}]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], "."}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\Lambda=\\limsup_{t\\to\\infty}\\frac1t\n \
\\log\\norm{T_{t-1}\\cdots T_0|_{E_0}}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"74b016a0-30da-9720-49ff-3d5fcd768f49"],

Cell[TextData[{
 "This number measures decay of the worst initial mean-zero field.  If\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "\[LessEqual]", 
    RowBox[{"-", "r"}], "<", "0"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Lambda\\le-r<0"|>|>,
  ExpressionUUID->"5d14bba2-88af-9302-e3fa-4a09bf4b2063"],
 ", then its disagreement is at most\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["r", "TI"]}], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["o", "TI"], "(", 
      StyleBox["t", "TI"], ")"}]}], ")"}], TraditionalForm]], "InlineFormula",
  
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\exp(-rt+o(t))"|>|>,
  ExpressionUUID->"716d181d-b71a-53d2-4e75-6137f2e7bf0c"],
 " times its initial size.  A more negative value means faster\nconsensus; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "\[LongEqual]", 
    RowBox[{"-", "\[Infinity]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Lambda=-\\infty"|>|>,
  ExpressionUUID->"9f7343d4-af7f-63f2-9677-1b717d54b45a"],
 " means that a finite product kills every mean-zero\nfield exactly.  This \
rate concerns the field values.  It is not the mixing time\nof the \
graph-valued Markov chain."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"a5a911a7-9c44-9371-7138-9ba413b0be7d"],

Cell[TextData[{
 "The fixed-",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "fbabb5e7-1429-ea77-ff73-2a55d564b106"],
 " theorem proves that ",
 Cell[BoxData[
  FormBox["\[CapitalLambda]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Lambda"|>|>,
  ExpressionUUID->"f96dd4c8-b520-379e-a820-3cc80ee4de97"],
 " is negative but does not give a\nuseful large-",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "9442f275-c1ab-5310-dce3-c9028860ebfb"],
 " scale.  A random local average on an expander cubic graph\nsuggests a \
bound of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["1", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "-1/N"|>|>,
  ExpressionUUID->"984c01d4-4438-d8c9-72f9-6a6b0ff9ad35"],
 "."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"9b03580f-a65b-da1f-40ea-441d4729bd88"],

Cell["\<\
There is first a bound that applies to every connected carrier trajectory; it
does not assume expansion or stationarity.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"8e9d590c-e572-e9ae-f1d1-918aef45b083"],

Cell[TextData[{
 "For every connected cubic multigraph ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "14340396-5a40-fa37-b846-9e86b593121a"],
 " on ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "a0ebf957-90a9-3484-b37b-f1b1462cc9de"],
 " vertices,"
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[A bound for every connected carrier trajectory]", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"fb2c44ca-9430-0bdd-663f-e4bbc8ec5539"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", "2"], "(", 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["G", "TI"]], ")"}], "\[GreaterEqual]", 
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["N", "TI"]], ":", 
    RowBox[{"\[LongEqual]", 
     RowBox[{"2", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"cos", "(", 
          RowBox[{"\[Pi]", "/", 
           StyleBox["N", "TI"]}], ")"}]}], ")"}], "."}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\lambda_2(L_G)\\ge\n    a_N:=2\\bigl(1-\\cos(\\pi/N)\\bigr).\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"00929f40-41fe-8c87-279b-41141f33e4c0"],

Cell["\<\
Consequently every adapted trajectory of connected carriers under \
uniform-edge
Rule A, with arbitrary settlement permutations, satisfies\
\>", "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"17b1772b-5d95-9d97-46ab-858f911e44ed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox[
     RowBox[{"lim", " ", "sup"}], 
     RowBox[{
      StyleBox["t", "TI"], "\[Rule]", "\[Infinity]"}],
     LimitsPositioning->True], 
    FractionBox["1", 
     StyleBox["t", "TI"]], "log", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["T", "TI"], "0"]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], 
   RowBox[{"\[LessEqual]", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"log", "(", 
      RowBox[{"1", "-", 
       FractionBox[
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox["N", "TI"]], 
        RowBox[{"3", 
         StyleBox["N", "TI"]}]]}], ")"}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Pi]", "2"], 
       RowBox[{"6", 
        SuperscriptBox[
         StyleBox["N", "TI"], "3"]}]]}], "+", 
     RowBox[{
      RowBox[{
       StyleBox["O", "TI"], "(", 
       SuperscriptBox[
        StyleBox["N", "TI"], 
        RowBox[{"-", "5"}]], ")"}], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\limsup_{t\\to\\infty}\\frac1t\n    \
\\log\\norm{T_{t-1}\\cdots T_0|_{E_0}}\n    \\le \
\\frac12\\log\\left(1-\\frac{a_N}{3N}\\right)\n    \
=-\\frac{\\pi^2}{6N^3}+O(N^{-5}).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"48c07e6d-2f54-5090-67a1-07d32cd12d38"],

Cell["\<\
No irreducibility, stationary initial law, or expander frequency is required.\
\
\>", "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"ec6cc905-06a4-dfb7-4e39-964c8d2d7f25"],

Cell[TextData[{
 "Delete loops and choose a spanning tree ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "T"|>|>,ExpressionUUID->
  "b7378bc6-ee0c-5abc-0220-4630611af195"],
 " of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "d74886c6-72f7-d235-4622-f359bcea0113"],
 ", retaining one edge from a\nparallel family.  Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "G"], "\[SucceedsEqual]", 
    SubscriptBox["L", "T"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L_G\\succeq L_T"|>|>,
  ExpressionUUID->"ca8761eb-05d6-0287-064b-3fdca43975cc"],
 ".  The path minimizes algebraic\nconnectivity among trees on ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "1ec6f340-2f09-c7c1-d6b6-33f7a8aaf3b8"],
 " vertices, and its gap is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"cos", "(", 
       FractionBox["\[Pi]", "N"], ")"}]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2(1-\\cos(\\pi/N))"|>|>,
  ExpressionUUID->"d38e0700-4397-d563-b1ce-c901d11ac625"],
 "."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"c8c3d1de-87ee-65ea-d16c-3de8c554283a"],

Cell["The conditional heat identity now gives", "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"2965a885-d5cd-adf2-849c-ce2a6d2db051"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], "[", 
    RowBox[{
     RowBox[{
      StyleBox["V", "TI"], "(", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       RowBox[{
        StyleBox["t", "TI"], "+", "1"}]], ")"}], "|", 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["t", "TI"]]}], "]"}], "\[LessEqual]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["N", "TI"]], 
       RowBox[{"3", 
        StyleBox["N", "TI"]}]]}], ")"}], 
    RowBox[{
     RowBox[{
      StyleBox["V", "TI"], "(", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["t", "TI"]], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n  \\E[\\V(f_{t+1})\\mid\\mathcal F_t]\n  \
\\le\\left(1-\\frac{a_N}{3N}\\right)\\V(f_t).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"d6abee0d-e2b7-bf6e-0cca-5c079b07d583"],

Cell[TextData[{
 "Settlement preserves variance.  Dividing by the deterministic geometric\n\
factor produces a nonnegative supermartingale.  Applying its almost-sure\n\
bound to a basis of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "9081c617-4104-74dd-2734-f2f7c4ab2729"],
 " gives the operator statement."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"66fe2fc2-03f0-10fa-8fee-afd048bcb9c2"],

Cell[TextData[{
 "The worst-carrier order cannot be improved from connectivity alone.  Put a\n\
loop at each endpoint of a path and give consecutive path edges alternating\n\
multiplicities ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "1", ",", "2", ",", "\[Ellipsis]", ",", "1"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1,2,1,2,\\ldots,1"|>|>,
  ExpressionUUID->"9d28320b-0e3c-63bf-2a40-490aa7e7ed41"],
 ".  This is cubic, and the linear test field\nhas the following ratio of \
Laplacian energy to squared norm:"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"0b54d2a5-be06-00b8-3a07-f8125292a27d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"18", 
      StyleBox["N", "TI"]}], "-", "24"}], 
    RowBox[{
     StyleBox["N", "TI"], "(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["N", "TI"], "2"], "-", "1"}], ")"}]], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     StyleBox["O", "TI"], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{"-", "2"}]], ")"}], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\frac{18N-24}{N(N^2-1)}=O(N^{-2}).\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"188410bd-32c8-43e8-4807-b31a98a15564"],

Cell[TextData[{
 "Thus connectedness alone gives the ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox["N", "3"]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N^{-3}"|>|>,
  ExpressionUUID->"eb09c9b1-e986-fd37-02a5-1d46f22a3543"],
 " bound, whereas typical stationary\ncarriers give the stronger ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N^{-1}"|>|>,
  ExpressionUUID->"4a73d218-cf6b-101a-42cc-39641f1c6cd1"],
 " bound.  They answer different questions."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"ad6de0c4-d799-05f5-bde1-189ed35ecd20"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["t", "TI"]], ",", 
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["t", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(G_t,f_t)"|>|>,
  ExpressionUUID->"57a22cb6-f765-43fa-372e-3255177e55b9"],
 " be a Rule A process in which, conditional on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "t"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G_t"|>|>,ExpressionUUID->
  "b2d70e30-bb6e-2fa8-4248-ca50c6a73a0f"],
 ", the averaged\nedge object is uniform among the ",
 Cell[BoxData[
