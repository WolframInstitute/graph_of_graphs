e7fafd4b5ba4"],

Cell[BoxData[
 GraphicsBox[{
   {GrayLevel[1], RectangleBox[{0, 0}, {11.4, 6.75}]}, 
   {RGBColor[0.82, 0.85, 0.88], AbsoluteThickness[
    1], {LineBox[{{1.05, 0.85}, {10.45, 0.85}}], InsetBox[
      StyleBox["1",
       StripOnInput->False,
       LineColor->RGBColor[0.37, 0.42, 0.49],
       FrontFaceColor->RGBColor[0.37, 0.42, 0.49],
       BackFaceColor->RGBColor[0.37, 0.42, 0.49],
       GraphicsColor->RGBColor[0.37, 0.42, 0.49],
       FontSize->8,
       FontColor->RGBColor[0.37, 0.42, 0.49]], {0.7, 0.85}]}, {
     LineBox[{{1.05, 1.6333333333333333`}, {10.45, 1.6333333333333333`}}], 
     InsetBox[
      StyleBox["10",
       StripOnInput->False,
       LineColor->RGBColor[0.37, 0.42, 0.49],
       FrontFaceColor->RGBColor[0.37, 0.42, 0.49],
       BackFaceColor->RGBColor[0.37, 0.42, 0.49],
       GraphicsColor->RGBColor[0.37, 0.42, 0.49],
       FontSize->8,
       FontColor->RGBColor[0.37, 0.42, 0.49]], {0.7, 1.6333333333333333}]}, {
     LineBox[{{1.05, 2.4166666666666665`}, {10.45, 2.4166666666666665`}}], 
     InsetBox[
      StyleBox["100",
       StripOnInput->False,
       LineColor->RGBColor[0.37, 0.42, 0.49],
       FrontFaceColor->RGBColor[0.37, 0.42, 0.49],
       BackFaceColor->RGBColor[0.37, 0.42, 0.49],
       GraphicsColor->RGBColor[0.37, 0.42, 0.49],
       FontSize->8,
       FontColor->RGBColor[0.37, 0.42, 0.49]], {0.7, 2.4166666666666665}]}, {
     LineBox[{{1.05, 3.2}, {10.45, 3.2}}], InsetBox[
      StyleBox["1000",
       StripOnInput->False,
       LineColor->RGBColor[0.37, 0.42, 0.49],
       FrontFaceColor->RGBColor[0.37, 0.42, 0.49],
       BackFaceColor->RGBColor[0.37, 0.42, 0.49],
       GraphicsColor->RGBColor[0.37, 0.42, 0.49],
