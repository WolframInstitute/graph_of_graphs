Cell[TextData[{
 "The minimum carrier gap over all classes is compared below with the \
universal\npath bound ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "N"], "\[LongEqual]", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"cos", "(", 
        FractionBox["\[Pi]", "N"], ")"}]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "a_N=2(1-\\cos(\\pi/N))"|>|>,
  ExpressionUUID->"89f4239e-3ff1-6ecd-714b-c846eb37e4cc"],
 "."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"7af7aa3c-20a7-2a32-9ec7-90ad9bc1cfb7"],

