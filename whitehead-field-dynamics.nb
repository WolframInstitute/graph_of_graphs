   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "\[Alpha]"], 
    SubscriptBox[
     StyleBox["b", "TI"], "\[Alpha]\[Beta]"]}], "\[LongEqual]", 
   RowBox[{
