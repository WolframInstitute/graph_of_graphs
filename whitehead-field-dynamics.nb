Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["A", "TI"]], "(", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["c", "TI"], "(", 
        StyleBox["G", "TI"], ")"}], "/"}], "|", 
      RowBox[{
       SubscriptBox[
        StyleBox[
         RowBox[{"A", "u", "t"}], "TI"], 
        StyleBox["v", "TI"]], 
       RowBox[{"(", 
        StyleBox["G", "TI"], ")"}]}], "|"}], 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         RowBox[{"[", 
          StyleBox["K", "TI"], "]"}], "\[Element]", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["N", "TI"]]}],
        LimitsPositioning->True], 
       RowBox[{
        RowBox[{
         StyleBox["c", "TI"], "(", 
         StyleBox["K", "TI"], ")"}], "/"}]}], "|", 
      RowBox[{
       SubscriptBox[
        StyleBox[
         RowBox[{"A", "u", "t"}], "TI"], 
        StyleBox["v", "TI"]], 
       RowBox[{"(", 
        StyleBox["K", "TI"], ")"}]}], "|"}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\pi_A([G])\n    =\n    \\frac{c(G)/|\\Aut_v(G)|}\n    \
{\\sum_{[K]\\in\\G_N}c(K)/|\\Aut_v(K)|}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"3ade7f81-aac6-c6af-4c40-c1013d637220"],

Cell["\<\
This is exactly the cubic configuration-model law, conditioned on
connectedness and projected to unlabelled classes.\
\>", "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"eefcbc43-946a-e41a-504b-b87b9af1655c"],

Cell[TextData[{
 "Give each labelled vertex three distinguishable half-edges.  The number of\n\
perfect matchings of these half-edges which realize a fixed labelled \
adjacency\nmultigraph ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "69d13bc6-5eda-e5d0-dc17-138c8597d1df"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c(G)"|>|>,
  ExpressionUUID->"be0920e5-933e-da87-26d0-e3af6ac7386b"],
 ": the denominator removes the two orientations of each\nloop, permutations \
of loops at a vertex, and permutations of parallel edges.\nAn unlabelled \
class has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["N", "TI"], "!"}], "/"}], "|", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{"A", "u", "t"}], "TI"], 
      StyleBox["v", "TI"]], 
     RowBox[{"(", 
      StyleBox["G", "TI"], ")"}]}], "|"}], TraditionalForm]], "InlineFormula",
  
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N!/|\\Aut_v(G)|"|>|>,
  ExpressionUUID->"378b0034-717e-254d-2e0a-e61d79e134d5"],
 " labelled adjacency realizations."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {
   None, None}},ExpressionUUID->"89b78001-94c8-5e9c-5327-c66e8f2f055d"],

Cell[TextData[{
 "On fully labelled half-edge configurations, retain the four \
endpoint-oriented\nmoves at a non-loop edge (and four duplicate holding slots \
at a loop).  Each\nmove has a unique reverse, so uniform measure on \
configurations is reversible.\nThe four oriented moves collapse in pairs to \
the two unlabelled resolutions\nrecorded by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "GH"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{GH}"|>|>,
  ExpressionUUID->"8f125ecc-9bc2-27b0-30f3-5d6031bd6dad"],
 ".  Lumping the reversible configuration chain by\nisomorphism class gives \
the displayed reciprocity identity and stationary law.\nWhitehead moves \
preserve connectedness, so restricting and conditioning on\nthe connected \
component is legitimate."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"fac15885-8a55-e906-c9dd-0c7c25796c86"],

Cell[TextData[{
 "Thus stationarity is not a free assumption, and there is no third unknown\n\
Rule-A graph distribution: its carrier marginal is the configuration model.\n\
The weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c(G)"|>|>,
  ExpressionUUID->"8be94799-89c4-70be-9922-4fd523eab559"],
 " are essential when loops and parallel edges occur.  Already\nfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2"|>|>,ExpressionUUID->
  "05b2d224-1684-2dce-a413-799e07b7ae24"],
 ", the triple-edge class and the class with one joining edge and one\nloop \
at each endpoint have equal vertex-automorphism orders but stationary\nmasses \
",
 Cell[BoxData[
  FormBox[
   FractionBox["2", "5"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2/5"|>|>,ExpressionUUID->
  "5ca5f9a6-d6e6-cb3a-242f-ecf012d5faf5"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "5"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3/5"|>|>,ExpressionUUID->
  "b596b188-57c3-a7b6-3032-19c094c1e667"],
 "."
}], "Remark",
 CellDingbat->Cell[
   TextData[{"Remark ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "remark", "EnvironmentOpen" -> "\\begin{remark}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{remark}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->
  "Theorem",ExpressionUUID->"bad600d7-0923-ec83-b394-107fba8603da"],

