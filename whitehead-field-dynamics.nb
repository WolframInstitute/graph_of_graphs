  ExpressionUUID->"56727004-1148-35fd-791d-669498f96046"],
 " number of\ndoubled vertex pairs.  Triple edges cannot occur, and exactly"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"1ad760f5-6cbd-d22d-a689-8df037ab6213"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "(", 
    StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     SuperscriptBox["6", 
      StyleBox["N", "TI"]], 
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{
        StyleBox["L", "TI"], "(", 
        StyleBox["G", "TI"], ")"}], "+", 
