Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"log", "(", 
    RowBox[{"1", "-", 
     StyleBox["x", "TI"]}], ")"}], "\[LessEqual]", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["x", "TI"]}], "    ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0", "\[LessEqual]", 
       StyleBox["x", "TI"], "<", "1"}], ")"}], "."}]}]}], 
