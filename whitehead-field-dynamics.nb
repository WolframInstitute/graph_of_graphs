  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(3N)^t"|>|>,
  ExpressionUUID->"90fc816c-09ab-26ec-ccfa-b3fb1ce79f17"],
 ".\nFurthermore the stationary entropy rate of the class-valued chain is"
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
