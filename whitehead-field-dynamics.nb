  ExpressionUUID->"ad3f52f0-a1a5-ef87-38dc-cb10207f16e6"],
 ", and let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]\[Beta]"], TraditionalForm]], "InlineFormula",
