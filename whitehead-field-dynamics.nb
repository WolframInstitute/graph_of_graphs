Cell["Carrier and base-chain spectra", "Subsection",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"10e69758-fb71-33b0-f9a7-830b24e8d4d4"],

Cell[TextData[{
 "The minimum carrier gap over all classes is compared below with the\n\
connected-graph path bound ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "N"], "\[LongEqual]", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"cos", "(", 
        FractionBox["\[Pi]", "N"], ")"}]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "a_N=2(1-\\cos(\\pi/N))"|>|>,
  ExpressionUUID->"65109ef4-da75-6a87-5247-90582ed8fcfe"],
 "."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"92901cb6-9db0-e8fc-1699-4ff6adc5f518"],

