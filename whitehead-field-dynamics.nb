    RowBox[{
     StyleBox[
      RowBox[{"S", "p", "e", "c"}], "TI"], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["A", "TI"]], ")"}]}], "\[Subset]", 
