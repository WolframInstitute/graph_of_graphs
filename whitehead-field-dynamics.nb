\\quad\\Longleftrightarrow\\quad H\\text{ is connected}.\n\\]", 
     "EnvironmentClose" -> "\n\\end{corollary}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"654a5186-151a-282e-15d8-9115fe06bea9"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H"|>|>,ExpressionUUID->
  "dbd5bb4a-908c-808e-eee8-dfc70d460c82"],
 " is disconnected, a nonzero mean-zero field constant on its components\nis \
fixed by every factor.  Conversely, if equality held for some nonzero\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[Element]", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f\\in E_0"|>|>,
  ExpressionUUID->"8e24ab76-0b90-2691-9598-c2d17d4b3855"],
 ", the lemma would force ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f"|>|>,ExpressionUUID->
  "8e7b5ec2-0c0a-9c02-a045-cb33855cd2ff"],
 " to be constant on every component of\n",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H"|>|>,ExpressionUUID->
  "4845de91-388b-6d71-56c2-1ab377195aab"],
 ".  Connectedness would make it globally constant, hence zero, a\n\
contradiction."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
