          RowBox[{"3", 
           StyleBox["N", "TI"]}], "-", "1"}], ")"}], "!!"}], 
       SuperscriptBox["6", 
        StyleBox["N", "TI"]]]}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
