Cell[TextData[{
 "The Rule-A column agrees exactly with ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{
     FractionBox[
      RowBox[{"3", " ", "N"}], "2"], "-", "1"}]], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/(3N/2-1)"|>|>,
  ExpressionUUID->"eb4764de-4a28-613c-4498-15ab2c4219e1"],
 " for every even\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LessEqual]", "14"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\le14"|>|>,
  ExpressionUUID->"61cfccab-632f-6759-d4d9-ed88c8a45c6c"],
 ".  This finite identity is a conjecture beyond the enumerated\nrange; only \
its asymptotic consequence\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "A"], "(", 
     SubscriptBox["B", "N"], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"o", "(", "1", ")"}], "+", "1"}], ")"}]}], 
     RowBox[{"3", " ", "N"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\Phi_A(B_N)=2/(3N)(1+o(1))"|>|>,
  ExpressionUUID->"a7523632-cda3-7e17-c41a-633b43bdb09f"],
 " is proved."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"6bf44767-4f09-7318-72d3-2aed0087993f"],

