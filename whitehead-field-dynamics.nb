Cell[TextData[{
 "Suppose a fixed short-cycle event ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "a7d64452-c994-0d27-43ee-50c1c217bac5"],
 " and its complement both have cardinality\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "(", 
    TemplateBox[{
      SubscriptBox["C", "N"]},
     "Abs"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Omega(|\\C_N|)"|>|>,
  ExpressionUUID->"a8c99181-e181-4ecc-39bc-960cd5e15dd7"],
 ", and all but ",
 Cell[BoxData[
  FormBox[
   RowBox[{"o", "(", 
    TemplateBox[{
      SubscriptBox["C", "N"]},
     "Abs"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "o(|\\C_N|)"|>|>,
  ExpressionUUID->"37429430-4d91-95fc-aee8-29cefd4c3536"],
 " unlabelled classes have support\ndegree at least ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "N"], "\[Rule]", "\[Infinity]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "d_N\\to\\infty"|>|>,
  ExpressionUUID->"50a6e61e-61c9-105e-a94b-fe5e4db95b11"],
 ".  Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Lambda]", "2"], "(", 
     RowBox[{
      StyleBox["I", "TI"], "-", 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["B", "TI"]]}], ")"}], "\[Rule]", "0"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\lambda_2(I-P_B)\\to0"|>|>,
  ExpressionUUID->"22b13f18-fa70-e1a0-102f-5b8da517d03f"],
 ".  More generally,\nfor a fixed ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "793a5b3a-6419-9522-35ad-2fe7325a1665"],
 ", suppose there is a family of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k-1"|>|>,ExpressionUUID->
  "85f30e90-3cc5-e155-ff84-efade1a15b56"],
 " short-cycle events whose\ncentered indicators have an asymptotically \
nonsingular class-uniform Gram\nmatrix.  If every atom of that family has \
conditional mean degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "(", "N", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Omega(N)"|>|>,
  ExpressionUUID->"ff2c3838-9bd5-9872-de9f-77dab7bb3053"],
 ",\nthen"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Conditional Rule-B low modes]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->
  "Theorem",ExpressionUUID->"f5d1af6b-213d-2f48-c4c4-f01724875944"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", 
     StyleBox["k", "TI"]], "(", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]]}], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["O", "TI"], 
      StyleBox["k", "TI"]], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{"-", "1"}]], ")"}], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n \\lambda_k(I-P_B)=O_k(N^{-1}).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"508d219d-425b-f41c-4cb3-2d8618f719c0"],

Cell["\<\
These conclusions are conditional: the stated degree hypotheses remain open.\
\>", "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"dc1f433b-a22f-ed41-817e-1763b6538eea"],

Cell[TextData[{
 "For the positive-density short-cycle feature ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "20caa46c-949a-e905-ba73-fb606807ba13"],
 ", Li's local argument gives\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["X", "TI"]], "\[LessEqual]", 
     SubscriptBox[
      StyleBox["C", "TI"], 
      StyleBox["X", "TI"]]}], "|", 
    StyleBox["X", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_X\\le C_X|X|"|>|>,
  ExpressionUUID->"01e57054-0091-5271-ab58-40380276dfa6"],
 ".  The first hypothesis makes both ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "X"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "V_X"|>|>,ExpressionUUID->
  "e984c892-aa4a-8e4f-1880-b976894f7671"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", 
    SuperscriptBox["X", "c"]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "V_{X^c}"|>|>,
  ExpressionUUID->"6b5361f3-0c05-b640-535a-b88be0c27c85"],
 "\nat least a constant times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["N", "TI"]], "|", 
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["N", "TI"]], "|"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "d_N|\\C_N|"|>|>,
  ExpressionUUID->"55b2f0ad-d9cb-41cb-bdc0-db1500efca00"],
 ", so the exact quotient is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "X"], "(", 
    FractionBox["1", 
     SubscriptBox["d", "N"]], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_X(d_N^{-1})"|>|>,
  ExpressionUUID->"2e46083c-ac35-1787-626d-4a524d3f3e3c"],
 "; min--max with the constant function gives the first claim.\nFor finitely \
many features, their centered indicators have an asymptotically\nnonsingular \
Gram matrix by hypothesis, while their\ndiagonal and cross Dirichlet energies \
are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "k"], "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_k(N^{-1})"|>|>,
  ExpressionUUID->"4f10a592-0584-250e-ab77-088189809421"],
 " after normalization.\nMin--max on their span gives the fixed-index \
assertion."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"936de2b7-ec20-9854-5a05-fd1ca5759f39"],

Cell[TextData[{
 "In particular, two-sided conditional estimates\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], "[", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["C", "TI"], "1"], "(", 
       StyleBox["G", "TI"], ")"}], "|", 
      RowBox[{
       StyleBox["G", "TI"], "\[Element]", 
       StyleBox["X", "TI"]}]}], "]"}], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", 
     StyleBox["N", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E[C_1(G)\\mid G\\in X]=O(N)"|>|>,
  ExpressionUUID->"6db4ac35-de2f-c5ae-f461-ccc74fc9a3a1"],
 " and\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], "[", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["C", "TI"], "1"], "(", 
       StyleBox["G", "TI"], ")"}], "|", 
      RowBox[{
       StyleBox["G", "TI"], "\[Element]", 
       SuperscriptBox[
        StyleBox["X", "TI"], 
        StyleBox["c", "TI"]]}]}], "]"}], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", 
     StyleBox["N", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E[C_1(G)\\mid G\\in X^c]=O(N)"|>|>,
  ExpressionUUID->"ed29feb6-a324-8823-c765-1df8b89774b7"],
 " imply the required linear mean-degree bounds\nfor that feature by the \
collision inequality and Jensen's inequality."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"3cb91104-3473-b639-33a6-dd82c406a706"],

Cell["\<\
Call a carrier edge active when at least one resolution has a nonself target.
Assume Rule B gives positive probability to every support neighbour and every
concrete lift of that transition.  Then\
\>", "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Active-edge field kernel]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->
  "Theorem",ExpressionUUID->"fabb3af8-cd00-01ca-87f7-f7f726d3b1b8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"ker", 
    SubsuperscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["G", "TI"], 
     StyleBox["B", "TI"]]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       StyleBox["f", "TI"], ":", 
       RowBox[{
        StyleBox["f", "TI"], " ", "is", " ", "constant", " ", "on", " ", 
        "every", " ", "component", " ", "of", " ", "the", " ", "active"}]}], "\[Hyphen]", 
      RowBox[{"edge", " ", "carrier"}]}], "}"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\ker L_G^B\n =\\{f:f\\text{ is constant on every component of \
the active-edge carrier}\\}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"792614b1-5d60-df6c-94bc-c3febad0d8b0"],

Cell["\<\
The weighted gap vanishes exactly when that carrier is disconnected, with
mean-zero kernel dimension one less than its component count.  The \
obstruction
is instantaneous: subsequent rewrites can change the active components.\
\>", "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"bd02c8cb-93e3-84c4-012d-073d21f6be5b"],

Cell["\<\
Under the full-support lift rule, an edge has positive averaging weight exactly
when it is active.  Since\
\>", "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {
   None, None}},ExpressionUUID->"63a9044b-c5ef-3d5f-cd5f-7b58d46a13d0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["T", "TI"]], 
     SubsuperscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["G", "TI"], 
      StyleBox["B", "TI"]], 
     StyleBox["f", "TI"]}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["e", "TI"],
      LimitsPositioning->True], 
     RowBox[{
      RowBox[{
       SubsuperscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["G", "TI"], 
        StyleBox["B", "TI"]], "(", 
       StyleBox["e", "TI"], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["j", "TI"]]}], ")"}], "2"]}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n f^TL_G^Bf=\\sum_e p_G^B(e)(f_i-f_j)^2,\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a7be578a-fc81-d26b-ac9d-61e7eda12e06"],

Cell[TextData[{
 "the quadratic form vanishes precisely when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "i"], "\[LongEqual]", 
    SubscriptBox["f", "j"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f_i=f_j"|>|>,
  ExpressionUUID->"9d828129-4ca9-3f76-dd4c-67aafd548287"],
 " along every active edge,\nwhich is equivalent to constancy on each active \
component.  Intersecting this\nkernel with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["1",
     FontSlant->"Bold"], "\[Perpendicular]"], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\one^\\perp"|>|>,
  ExpressionUUID->"c0a0aae9-5067-c1da-068b-c7b8d5c64a8c"],
 " removes one dimension."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"9571df38-4404-1283-174a-b956f1ae3f9e"],

Cell[TextData[{
 "Finally, multiplicities and self-slots do not change reachability.  Hence \
the\nsimple support has exactly the GDPK support metric and inherits its\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalTheta]", "(", 
    RowBox[{"N", " ", "N", " ", "log"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Theta(N\\log N)"|>|>,
  ExpressionUUID->"af0774c4-98d4-d7f8-abde-3ac84377d581"],
 " diameter order ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"rafi-tao"],
 ButtonBox["rafi-tao",
  BaseStyle->"Citation",
  ButtonData->"rafi-tao"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"rafi-tao"],
 ", even though its path counts\nand random-walk times differ."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"06c62f92-1059-6f5b-0b38-61280662af88"],

Cell["Complete finite enumeration", "Section",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"c0f6de4e-a794-982b-bd79-364194b2c38c"],

Cell[TextData[{
 "The finite statements in this section are computational evidence, not\n\
asymptotic theorems.  Cubic multigraphs were encoded by coloured incidence\n\
graphs and canonically labelled with nauty/Traces ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"mckay-nauty"],
 ButtonBox["mckay-nauty",
  BaseStyle->"Citation",
  ButtonData->"mckay-nauty"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"mckay-nauty"],
 ".\nEnumeration is complete through ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "14"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=14"|>|>,
  ExpressionUUID->"502d6bb3-e311-7d8e-fac4-57a6347df804"],
 ": the class counts agree with\nA005967, and every source has exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "1f54a546-2024-387a-1761-3bd16290e5c2"],
 " compressed resolution slots."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e718bf13-4b12-b713-7ffc-aa47f13017f0"],

