Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Kappa]", 
     StyleBox["e", "TI"]], "\[LongEqual]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["e", "TI"], 
      StyleBox["T", "TI"]], 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["G", "TI"]], 
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["e", "TI"]]}]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["G", "TI"]], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["e", "TI"],
      LimitsPositioning->True], 
     RowBox[{
      SubscriptBox["\[Kappa]", 
       StyleBox["e", "TI"]], 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["e", "TI"]], 
      SubsuperscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["e", "TI"], 
       StyleBox["T", "TI"]]}]}]}], ",", "    ", 
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{"3", 
       StyleBox["N", "TI"]}], "2"], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\kappa_e=b_e^TL_Gb_e,\\qquad\n D_G=\\sum_e\\kappa_e \
b_eb_e^T,\\qquad M=\\frac{3N}{2}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e33d9d04-da8a-84e8-0bf3-e65918501ca7"],

Cell["Uniform-edge Rule A therefore satisfies", "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"cf4121b9-2143-ffce-ba56-6f51471347b2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox[
        StyleBox["f", "TI"], 
        RowBox[{"\[Prime]", 
         StyleBox["T", "TI"]}]], 
       SubscriptBox[
        StyleBox["L", "TI"], 
        SuperscriptBox[
         StyleBox["G", "TI"], "\[Prime]"]], 
       SuperscriptBox[
        StyleBox["f", "TI"], "\[Prime]"]}], "|", 
      StyleBox["G", "TI"]}], ",", 
     StyleBox["f", "TI"]}], "]"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["T", "TI"]], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["G", "TI"]], "-", 
      RowBox[{
       FractionBox["1", 
        StyleBox["M", "TI"]], 
       SubsuperscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["G", "TI"], "2"]}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"4", 
         StyleBox["M", "TI"]}]], 
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["G", "TI"]]}]}], ")"}], 
    RowBox[{
     StyleBox["f", "TI"], "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\E[f'^TL_{G'}f'\\mid G,f]\n =f^T\\left(L_G-\\frac1M \
L_G^2+\\frac1{4M}D_G\\right)f.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a014d15f-d45c-4219-10a8-131128a55ef4"],

Cell[TextData[{
 "For a simple cubic carrier, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "G"], "\[LongEqual]", 
    RowBox[{"8", " ", 
     SubscriptBox["L", "G"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "D_G=8L_G"|>|>,
  ExpressionUUID->"74153b2a-4245-7758-4775-e379a3da63db"],
 "."
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"24775ff7-f013-46a2-731c-36b8eee439f5"],

Cell[TextData[{
 "After ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "e"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_e"|>|>,ExpressionUUID->
  "d5edf042-ed43-71c9-d26e-ef08cdf64943"],
 ", the values at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "i,j"|>|>,ExpressionUUID->
  "f8d07dc7-a611-93bb-ac24-ebc3a6a9f3c7"],
 " agree.  A Whitehead resolution only changes\nwhich of these equal-valued \
endpoints owns each surrounding half-edge, so it\ndoes not change any \
contrast energy.  Averaging ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "e"], " ", 
    SubscriptBox["A", "e"], " ", 
    SubscriptBox["L", "G"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_eL_GA_e"|>|>,
  ExpressionUUID->"53bd6fd4-7965-c656-e28a-a84c429d5fcf"],
 " over edge objects\nand using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "e"], 
     RowBox[{
      SubscriptBox["b", "e"], " ", 
      TemplateBox[{
        RowBox[{"(", 
          SubscriptBox["b", "e"], ")"}]},
       "Transpose"]}]}], "\[LongEqual]", 
    SubscriptBox["L", "G"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\sum_e b_eb_e^T=L_G"|>|>,
  ExpressionUUID->"852b65d3-5be6-1417-3fd1-8b89c5fa5b8e"],
 " gives the matrix identity.  In a simple cubic\ngraph, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["b", "e"], " ", 
     SubscriptBox["L", "G"], " ", 
     TemplateBox[{
       RowBox[{"(", 
         SubscriptBox["b", "e"], ")"}]},
      "Transpose"]}], "\[LongEqual]", 
    RowBox[{"3", "+", "3", "+", "2"}], "\[LongEqual]", "8"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "b_e^TL_Gb_e=3+3+2=8"|>|>,
  ExpressionUUID->"c437296d-73e9-cc55-5b2c-94d00e79f5da"],
 "."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"ecc55c71-6226-d0c7-4727-872b8491dce9"],

Cell[TextData[{
 "Thus, for a simple carrier and an ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "G"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L_G"|>|>,ExpressionUUID->
  "03b40142-f8dc-49f9-0d98-5ca51b5154a2"],
 "-eigenfield of eigenvalue ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\lambda"|>|>,
  ExpressionUUID->"51c2b385-d05f-0394-87ad-2292bff14e13"],
 ",\nthe expected carrier energy is multiplied by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"2", "-", "\[Lambda]"}], "M"], "+", "1"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1+(2-\\lambda)/M"|>|>,
  ExpressionUUID->"b2db5566-eb0d-3902-5960-014978bd4651"],
 ".  When\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "<", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\lambda<2"|>|>,
  ExpressionUUID->"b1ade660-a446-c62b-52a8-e0db11eccb09"],
 ", that energy can increase even while variance decreases; the next\nmoment \
involves ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["L", "G", "2"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L_G^2"|>|>,
  ExpressionUUID->"eba3bc0c-36ec-fe0b-0bab-1d1a9e801733"],
 " and exposes the carrier--field alignment problem."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"5c73503b-922f-e793-1ad7-f219b335f464"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["S", "TI"], "|", 
    RowBox[{"\[LongEqual]", 
     StyleBox["k", "TI"]}]}], TraditionalForm]], "InlineFormula",
