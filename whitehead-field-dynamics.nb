Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["s", "TI"],
      LimitsPositioning->True], 
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["s", "TI"]]}], "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     RowBox[{
      StyleBox["s", "TI"], "-", "1"}]]}], "\[LongEqual]", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["s", "TI"],
     LimitsPositioning->True], 
    FractionBox[
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["s", "TI"]]}]},
      "Abs"], 
     SqrtBox["2"]]}], "\[LessEqual]", 
   RowBox[{
    SqrtBox[
     StyleBox[
      RowBox[{"m", "D"}], "TI"]], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\sum_s\\norm{x^s-x^{s-1}}\n \
=\\sum_s\\frac{|d_s|}{\\sqrt2}\\le\\sqrt{mD}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"9d42b486-073d-24a3-3c8b-90a24a06b320"],

