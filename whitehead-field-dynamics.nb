Cell["\<\
Select a non-loop carrier edge.  Its four exposed half-edges admit two \
compressed Whitehead resolutions.  Before the rewrite, the two endpoint \
values are replaced by their mean.\
\>", "Text",
 TaggingRules-><|
  "GoGNotebook" -> <|"Companion" -> True, "ID" -> "GoGLocalMoveText"|>|>,
