      StyleBox["b", "TI"], 
      StyleBox["e", "TI"]]}]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["G", "TI"]], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["e", "TI"],
      LimitsPositioning->True], 
     RowBox[{
      SubscriptBox["\[Kappa]", 
       StyleBox["e", "TI"]], 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["e", "TI"]], 
      SubsuperscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["e", "TI"], 
       StyleBox["T", "TI"]]}]}]}], ",", "    ", 
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", 
