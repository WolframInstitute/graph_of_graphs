 " and a non-loop edge\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=\\{i,j\\}"|>|>,
  ExpressionUUID->"d0587979-2170-048c-e4de-cf53aa828d9b"],
 ", define the local averaging operator"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"03005cfc-d647-d8d1-03c5-349c88fb34f9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]], 
       StyleBox["f", "TI"]}], ")"}], 
     StyleBox["i", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]], 
       StyleBox["f", "TI"]}], ")"}], 
     StyleBox["j", "TI"]], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["j", "TI"]]}], "2"]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]], 
       StyleBox["f", "TI"]}], ")"}], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["k", "TI"]], "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         StyleBox["k", "TI"], "\[NotEqual]", 
         StyleBox["i", "TI"]}], ",", 
        StyleBox["j", "TI"]}], ")"}], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    (A_{ij}f)_i=(A_{ij}f)_j=\\frac{f_i+f_j}{2},\n    \\qquad\n    \
(A_{ij}f)_k=f_k\\quad(k\\neq i,j).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a1e802fb-07c8-2989-22da-e8d68000b5ef"],

Cell[TextData[{
