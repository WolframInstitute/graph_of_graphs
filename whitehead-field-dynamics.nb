Cell[TextData[{
 "The papers of Grave de Peralta--Kolpakov and Li establish substantial\n\
large-scale structure.  Grave de Peralta--Kolpakov prove that the\n\
outer-conductance of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"93eb33a3-528a-e743-606e-9c83d9c6adcb"],
 " tends to zero, using the bottleneck given by\nbridged cubic graphs ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["gdp-kolpakov",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ".  Li shows that the graph of Whitehead\nmoves has increasingly many \
bounded Laplacian eigenvalues, using many local\ncycle bottlenecks ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"li"],
 ButtonBox["li",
  BaseStyle->"Citation",
  ButtonData->"li"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"li"],
 ".  These results concern ordinary functions on the\nvertex set of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"4dc53085-2eb7-c6ea-81e2-b5a469176256"],
 "."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"b01f977c-3b93-582f-1a8e-c4a928c88b3c"],

Cell[TextData[{
 "Here the moving object is different.  Over a cubic graph ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["V", "TI"], ",", 
      StyleBox["E", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G=(V,E)"|>|>,
  ExpressionUUID->"7e6d8904-d8e6-6e70-d456-895ca2b301d6"],
 " we place a\nscalar field"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"14e1496d-dce9-2c90-7e7f-104f2092f90b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], ":", 
    StyleBox["V", "TI"]}], "\[Rule]", 
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], "."}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    f:V\\to\\R.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a447e1f2-9490-5679-343d-050a06b5bca4"],

Cell[TextData[{
 "So the fibre over the class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma=[G]"|>|>,
  ExpressionUUID->"650a0dae-a3ff-b904-f3cc-15c2b9f2a2c1"],
 " is"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a977c26f-5285-cc89-0f9a-0f883be231a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], "\[Gamma]"], "\[LongEqual]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["C", "TI"], "0"], "(", 
    StyleBox["G", "TI"], ")"}], "\[TildeEqual]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["R",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["V", "TI"], "(", 
      StyleBox["G", "TI"], ")"}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\F_\\gamma=C^0(G)\\simeq \\R^{V(G)}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"9674f3b6-38c8-aa3a-7e52-4d419c6b565e"],

Cell[TextData[{
 "When a Whitehead move is performed on an edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=\\{i,j\\}"|>|>,
  ExpressionUUID->"b66fce50-6e7c-7e98-e370-3d56af4676b7"],
 ", the graph changes and\nthe field is updated by"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"536af088-439f-c1d3-c41f-6df96889bb7c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["i", "TI"]], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["j", "TI"]], "\[RightTeeArrow]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["j", "TI"]]}], "2"]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["j", "TI"]]}], "2"], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    f_i,f_j\n    \\mapsto\n    \
\\frac{f_i+f_j}{2},\\frac{f_i+f_j}{2}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"04a09415-ca5e-9986-e17b-b14b26b897a2"],

Cell["\<\
Afterwards one may resettle the new graph onto a chosen representative of its
isomorphism class; this only permutes field coordinates.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"0b1d4a38-7116-016a-718d-7868d560bbd3"],

Cell[TextData[{
 "The field is scalar because no differential data is attached to the \
vertices\nof ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "a77749a5-11c8-04b7-dada-fb85b6972805"],
 "; the vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\R^N"|>|>,
  ExpressionUUID->"2346e618-4555-e271-56e7-6ff99b1f0b5c"],
 " is only its coordinate representation."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"9be5d606-0494-b039-1d48-c7ac33997bdd"],

Cell["\<\
\\paragraph{Contributions.}
The paper makes four groups of distinctions and deductions.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"63515f17-8b6c-d035-301c-395d97ec4580"],

Cell[TextData[{
 "For the carrier field we prove the exact heat identity, eliminate\n    \
settlements by a pulled-back-pair factorization, obtain a uniform\n    \
connectivity-only exponent bound, and prove exact finite-time consensus\n    \
at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "\[LongEqual]", "2"}], ",", "4", ",", "8"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2,4,8"|>|>,
  ExpressionUUID->"06599d58-5fa0-66ad-f54e-2c43afd07161"],
 " on the persistent labelled lift.  We also isolate the\n    carrier--field \
correlation that separates the true cocycle from an\n    independently \
refreshed configuration benchmark."
}], "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "\\begin{enumerate}[leftmargin=*]\n    \\item ", 
     "Separator" -> "\n"|>|>,
 CounterAssignments->{{
   "ItemNumbered", 0}},ExpressionUUID->"f8c749e6-5411-155f-cdfd-8a2ebf60fbba"],

Cell[TextData[{
 "For Li's fixed-labelled simple graph we separate the simple,\n    \
uniform-clock, and multiplicity walks.  We obtain asymptotic\n    ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["L", "1"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L^1"|>|>,ExpressionUUID->
  "bb2ddb45-21a4-c26d-32ba-50c67b241027"],
 "-regularity, a quadratic-dimensional space of bounded\n    combinatorial \
modes, fixed-radius ball asymptotics, and linear diameter\n    and \
typical-distance lower bounds."
}], "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"03e85ede-1769-f560-06e0-32df4fb0b09f"],

Cell["\<\
For the Grave de Peralta--Kolpakov multiplicity chain we identify
    the exact configuration-model stationary law, spectral interval, Perron
    root, loop-count Dirichlet form, sharp bridge asymptotics, and explicit
    mixing and stationary-episode lower bounds.\
\>", "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"16c8fc41-7a1a-10a9-78f3-43923e7f0832"],

Cell["\<\
For the unlabelled simple support we give exact feature Rayleigh
    quotients and collision identities, prove conditional implications of
    degree growth, and characterize the instantaneous Rule-B field kernel by
    the active-edge carrier.\
\>", "ItemNumbered",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "    \\item ", "EnvironmentClose" -> 
     "\n\\end{enumerate}", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"36dffaa2-c22b-9bfb-6c0c-01d78cfe0841"],

Cell["\<\
The theoretical statements are separated below from complete finite
enumeration, conjectures, and the limited Lean verification layer.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"c7f3f54b-9c12-700b-0024-9220651c444d"],

Cell["Whitehead Moves and the Exact Random Rule", "Section",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"0da4428b-b580-b186-956a-56f0ee6ab20c"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"u", ",", "v"}], "}"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=\\{u,v\\}"|>|>,
  ExpressionUUID->"2bac7d64-e316-ba74-172b-cd6d0cb0b2a6"],
 " be a non-loop edge of a cubic graph.  At ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "u"|>|>,ExpressionUUID->
  "8e53eda2-c94f-e015-42a7-ebc790821f20"],
 " there are exactly\ntwo other incident half-edges, call them ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "a,b"|>|>,ExpressionUUID->
  "9e403b51-25ea-c8ba-5112-a65e5f1d0e49"],
 ", and at ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "v"|>|>,ExpressionUUID->
  "eb2b69d9-7f6f-ad77-4ee6-29f2ce26839f"],
 " there are exactly two\nother incident half-edges, call them ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c,d"|>|>,ExpressionUUID->
  "5145033b-626c-f2f3-af57-3b374b9a5f2e"],
 ".  Locally the edge ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "f408705e-782d-88c5-8ce6-729a3e8ef751"],
 " sees the\npartition"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"4d633af3-94df-e2ca-0190-658a6eb0c980"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], "}"}], "|", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["d", "TI"]}], "}"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\{a,b\\}\\mid\\{c,d\\}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"f3af9ec8-989b-4995-4ba7-344731478c5e"],

Cell[TextData[{
 "A Whitehead move collapses ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "44e5afe9-99d3-c126-a96a-975d15d246ce"],
 " to a four-valent vertex and re-expands in one of\nthe two other pairings:"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"610d8869-2265-302b-71ac-fcc5423733af"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["c", "TI"]}], "}"}], "|", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["d", "TI"]}], "}"}]}], ",", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["d", "TI"]}], "}"}], "|", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["b", "TI"], ",", 
       StyleBox["c", "TI"]}], "}"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\{a,c\\}\\mid\\{b,d\\},\n    \\qquad\n    \
\\{a,d\\}\\mid\\{b,c\\}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"3558329d-66d3-fd82-c8fb-6175f1dfa90e"],

Cell[TextData[{
 "On a fixed labelled vertex set, each of these two unordered pairings has \
two\nassignments to the labelled central vertices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "u,v"|>|>,ExpressionUUID->
  "c7c0a0f1-5a16-49f4-f7bd-c27306f525f8"],
 ".  Thus there are four\nlabelled moves per non-loop edge, as in Li's \
labelled graph, but only two\nunlabelled resolution slots per edge, as in \
Grave de Peralta--Kolpakov.  For a\ncubic graph on ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "e02752f0-ccbd-4bc2-4c27-0b0a3d34440e"],
 " vertices the corresponding raw counts are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "0ca04b4e-9821-024e-2c91-8fa17d173dbb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "c8848598-ee81-4f60-2dea-6eb65e4fd6d6"],
 ".\nIf ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "9cb4b08e-5a18-6aed-bfa4-71fb9d2699ae"],
 " is a loop, we use the convention of ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["gdp-kolpakov",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ": the Whitehead\nmove is trivial.  In the half-edge model this convention \
is natural because the\npairing of half-edges is fixed and only the \
assignment of nearby half-edges to\nvertices changes; when the two endpoints \
coincide there is no reassignment."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"c6ba2d77-c1d4-3518-00b4-b76a1db0afc0"],

Cell[TextData[{
 "For the averaged field the factor of two can be compressed.  The two \
labelled\norientations of one unlabelled resolution differ by the \
transposition\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "\[LongEqual]", "uv"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\tau=(uv)"|>|>,
  ExpressionUUID->"a6cdb5e7-2bbb-d5ba-a93b-94cab9e39e90"],
 ", and"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"84a71edf-2c62-9007-d96c-11c6366ac341"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "\[Tau]"], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"u", "v"}], "TI"]]}], "\[LongEqual]", 
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"u", "v"}], "TI"]], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    P_\\tau A_{uv}=A_{uv}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"515076f8-52fe-d76e-4275-27cc8910ba55"],

Cell["\<\
With compatible settlements they therefore produce the same transported
field.  At a target with automorphisms they agree modulo a target
automorphism.  The transition table may consequently store two resolution
records per edge without losing the base-class kernel or the one-step
variance/source-Laplacian calculation.  For a full trajectory or a curvature
calculation, however, an intermediate target automorphism can change later
averages.  The compression is lossless there only after specifying coherent
settlements (or explicitly quotienting the fibre by stabilizers); otherwise
the omitted stabilizer holonomy is dynamical data.  The compression also does
not identify the two targets in the labelled simple graph and must not be \
used
for labelled ball counts.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"30e6dc08-e554-955c-5ad3-911c455643d1"],

Cell["There are two inequivalent random rules.", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"5c7547bd-87ca-8d36-4d39-179d50ad827f"],

Cell[TextData[{
 "Start from a settled representative of the unlabelled class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma=[G]"|>|>,
  ExpressionUUID->"2754d97b-fb92-41f9-4c7c-631fb7e93773"],
 ".\nChoose a labelled Whitehead move upstairs, or equivalently for this \
averaged\nfield choose one of the two compressed unlabelled resolutions of an \
edge\nobject.  Apply this move to get a labelled graph ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H"|>|>,ExpressionUUID->
  "5c78c600-1fb0-493a-5498-0ae54032b0c6"],
 ", project to the unlabelled\nclass ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["H", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\delta=[H]"|>|>,
  ExpressionUUID->"598136de-4a17-5590-cb37-1bc06ac23cb9"],
 ", and choose an isomorphism settling ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H"|>|>,ExpressionUUID->
  "5954156f-ebf7-d618-a0b5-24fbc1c7bde4"],
 " onto the chosen\nrepresentative of ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\delta"|>|>,
  ExpressionUUID->"7a10f11d-ac8a-aefd-339b-109fe27b7b7d"],
 "."
}], "Definition",
 CellDingbat->Cell[
   TextData[{"Definition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "definition", "EnvironmentOpen" -> 
     "\\begin{definition}[Rule A: local move first]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "EnvironmentClose" -> "\n\\end{definition}", 
     "Separator" -> "\n\n"|>|>,
 CounterIncrements->
  "Theorem",ExpressionUUID->"96666571-08ee-0769-7616-566cb38651f5"],

Cell[TextData[{
 "Rule A weights unlabelled transitions by concrete multiplicity.  If many\n\
different edges and resolutions lead from ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma"|>|>,
  ExpressionUUID->"cd8b35c0-bf04-cd3a-340d-cfa68872d713"],
 " to the same class ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\delta"|>|>,
  ExpressionUUID->"9f727ed5-c4df-13fe-a918-545b2dee11c2"],
 ",\nthen that edge of the unlabelled GoG is traversed more often.  This is \
the\nnatural rule if the physics is local in the current cubic graph."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"c86c1af8-dbcf-ae3b-3fb8-a3a1e9f5e671"],

Cell[TextData[{
 "Start at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[Element]", 
    SubscriptBox["\[CapitalGamma]", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma\\in\\G_N"|>|>,
  ExpressionUUID->"01ea5345-317e-f75b-6479-6e83df407dd6"],
 ", choose a neighbouring unlabelled class ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\delta"|>|>,
  ExpressionUUID->"542ee0e5-8e55-f728-5a90-b62266e0d0d5"],
 "\naccording to a rule on the quotient graph, and only afterwards choose a \
concrete\nlift of the transition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[Rule]", "\[Delta]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma\\to\\delta"|>|>,
  ExpressionUUID->"a6d845f4-3af5-814c-359c-9667e3ef3e6b"],
 "."
}], "Definition",
 CellDingbat->Cell[
   TextData[{"Definition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "definition", "EnvironmentOpen" -> 
     "\\begin{definition}[Rule B: unlabelled neighbour first]", "Trailing" -> 
     "", "BodyIndent" -> "\n", "EnvironmentClose" -> "\n\\end{definition}", 
     "Separator" -> "\n\n"|>|>,
 CounterIncrements->
  "Theorem",ExpressionUUID->"9818d529-ffbe-7f51-192d-ca5bddd6a83d"],

Cell[TextData[{
 "Rule B is a quotient-walk rule.  It is not equivalent to Rule A unless the\n\
number of concrete lifts is constant across all unlabelled neighbours.  Under\
\nRule B, the edge of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "156fc91b-89c6-a54c-98f9-fd4ba35566ab"],
 " being averaged need not be uniformly distributed among\nedge objects of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "d6dddd6c-8fb1-3f14-cc3d-a8962e7cf192"],
 ".  The expected field step is then governed by a weighted\nLaplacian rather \
than the ordinary Laplacian of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "c8aa8d0d-e935-36d4-e975-99e84b36d790"],
 "."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"92489957-03fb-a373-dc5a-30f57e189a30"],

Cell["\<\
This distinction controls both the base transition law and the field
operator.  Rule A
is local first: every formal edge/resolution slot in the current cubic graph is
equally likely, so every edge object is equally likely to be averaged.  Rule \
B
is quotient first: if ten concrete moves land in one quotient neighbour and one
concrete move lands in another, a uniform-neighbour Rule B gives those two
neighbours equal mass and then redistributes that mass over their lifts.  \
Thus a
single exceptional lift can receive much more probability under Rule B than \
it
does under Rule A.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"a4e8069d-60ce-81ed-6287-6fb7abb30913"],

Cell[TextData[{
 "For a fixed class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma=[G]"|>|>,
  ExpressionUUID->"cba5e6d2-8f60-5c97-e78b-40ce952d6ac5"],
 ", the Rule B field step is therefore recorded as\na weighted source \
Laplacian"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"2fd8ec03-8ad1-fb06-7c58-21432421cd28"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["L", "TI"], "\[Gamma]", 
     StyleBox["B", "TI"]], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["e", "TI"], "\[LongEqual]", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], "}"}]}],
      LimitsPositioning->True], 
     RowBox[{
      RowBox[{
       SubsuperscriptBox[
        StyleBox["p", "TI"], "\[Gamma]", 
        StyleBox["B", "TI"]], "(", 
       StyleBox["e", "TI"], ")"}], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["i", "TI"]], "-", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["j", "TI"]]}], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]]}], ")"}], 
       StyleBox["T", "TI"]]}]}]}], ","}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \
L_\\gamma^B=\\sum_{e=\\{i,j\\}}p_\\gamma^B(e)(e_i-e_j)(e_i-e_j)^T,\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"26b78cdd-c56a-121e-8d5a-828e82acf394"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["p", "\[Gamma]", "B"], "(", "e", ")"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "p_\\gamma^B(e)"|>|>,
  ExpressionUUID->"5cf0f9cd-b61c-ba97-3b4f-b37a45665578"],
 " is the total Rule B probability that the chosen lift\naverages edge ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "3ca20629-178f-561b-f994-4d94eb25df87"],
 ".  Rule A corresponds to the special case"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"4b2e1e63-6a76-f553-0eb9-1a63313fdf85"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["p", "TI"], "\[Gamma]", 
     StyleBox["A", "TI"]], "(", 
    StyleBox["e", "TI"], ")"}], "\[LongEqual]", 
   FractionBox["1", 
    TemplateBox[{
      RowBox[{
        StyleBox["E", "TI"], 
        RowBox[{"(", 
          StyleBox["G", "TI"], ")"}]}]},
     "Abs"]], "\[LongEqual]", 
   FractionBox["2", 
    RowBox[{"3", 
     StyleBox["N", "TI"]}]]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    p_\\gamma^A(e)=\\frac{1}{|E(G)|}=\\frac{2}{3N}\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"b98e34d0-0d60-afd2-4092-bcf59c3f3ba2"],

Cell[TextData[{
 "for every edge object.  Numerically, the right question is not simply \
whether\nthe base chains on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"0346f3d0-39e0-0bac-4511-ca46087b5ea1"],
 " differ, but whether ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["L", "\[Gamma]", "B"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L_\\gamma^B"|>|>,
  ExpressionUUID->"a1080bf7-65ca-a07a-616d-797fb0e1169f"],
 " differs\nsubstantially from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"2", " ", "N"}], ")"}], " ", 
    SubscriptBox["L", "G"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(2/3N)L_G"|>|>,
  ExpressionUUID->"9c1f5b7a-0483-dc6d-9a32-5d0c812846f7"],
 " on the states that the chain actually visits."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"ad28337e-a72d-3d7b-9c64-e508abb5c12a"],

Cell[TextData[{
 "The base graph ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"7db76a34-bb07-fb54-31d2-e2f4e0e7f67d"],
 " can stay unlabelled.  Labels on the vertices of the\ncurrent cubic graph \
are accounting coordinates for the field.  A step consists\nof choosing a \
labelled lift, applying a concrete move, and then resettling onto\nsome \
representative of the target isomorphism class.  When automorphisms are\n\
trivial, the settlement ambiguity essentially disappears once representatives\
\nare fixed.  When automorphisms are nontrivial, the ambiguity is an \
orthogonal\npermutation of the fibre, hence a gauge ambiguity rather than an \
extra\ncontraction mechanism."
}], "Remark",
 CellDingbat->Cell[
   TextData[{"Remark ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "remark", "EnvironmentOpen" -> 
     "\\begin{remark}[What labels are doing]", "Trailing" -> "", "BodyIndent" -> 
     "\n", "EnvironmentClose" -> "\n\\end{remark}", "Separator" -> "\n\n"|>|>,
 
 CounterIncrements->
  "Theorem",ExpressionUUID->"6c9cc28d-cf98-5217-1d24-0d32fd48aab0"],

Cell[TextData[{
 "For a labelled adjacency multigraph ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "5ca18e0f-f8dd-7872-7083-4c21fa717afa"],
 ", let ",
 Cell[BoxData[
