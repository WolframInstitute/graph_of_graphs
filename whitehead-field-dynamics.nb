  ExpressionUUID->"e9f51efd-49fe-c5c7-953d-09f23067eb95"],
 ".  Its centered indicator has exact Rule-B quotient"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"befda755-afb7-dc40-b193-c447710233e8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["B", "TI"]], "(", 
    StyleBox["X", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
