        StyleBox["e", "TI"], 
        StyleBox["j", "TI"]]}], ")"}], 
     StyleBox["T", "TI"]]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    I-A_{ij}=\\frac12(e_i-e_j)(e_i-e_j)^T\n\\]", 
     "Separator" -> 
