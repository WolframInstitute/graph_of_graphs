Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["Q", "TI"], 
     StyleBox["t", "TI"]], "\[LongEqual]", 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{
       StyleBox["s", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["t", "TI"], "-", "1"}],
      LimitsPositioning->True], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SubscriptBox["\[Alpha]", 
         StyleBox["N", "TI"]], 
        SubscriptBox[
         StyleBox["1",
          FontSlant->"Bold"], 
         SubscriptBox[
          StyleBox["H", "TI"], 
          StyleBox["s", "TI"]]]}]}], ")"}]}]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["t", "TI"]], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["V", "TI"], "(", 
       SubscriptBox[
        StyleBox["f", "TI"], 
        StyleBox["t", "TI"]], ")"}], 
      SubscriptBox[
