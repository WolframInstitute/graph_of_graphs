Cell[TextData[{
 "Only a crossing edge changes the two-level field, losing ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/2"|>|>,ExpressionUUID->
  "199077ed-2d70-c9e0-bd6f-f16791e05bf3"],
 " unit of\nvariance; divide the expected loss ",
 Cell[BoxData[
  FormBox[
   FractionBox["b", 
    RowBox[{"3", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b/(3N)"|>|>,
  ExpressionUUID->"cf74196d-7712-383d-f253-a82d858516ed"],
 " by ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"k", "(", 
     RowBox[{"N", "-", "k"}], ")"}], "N"], TraditionalForm]], "InlineFormula",
  
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k(N-k)/N"|>|>,
  ExpressionUUID->"4cbbf754-ee30-d2c0-3a14-b570dabf8f7c"],
 ".  For the count,\nchoose the ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b"|>|>,ExpressionUUID->
  "4595f7f5-142f-d0e5-0e32-6257ad698d2d"],
 " crossing stubs on both sides, match them bijectively, and pair\nthe \
remaining stubs internally.  Stirling's formula shows that the logarithm\nof \
this probability is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"o", "(", "N", ")"}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", "N", " ", 
     RowBox[{"H", "(", 
      FractionBox["k", "N"], ")"}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "-NH(k/N)/2+o(N)"|>|>,
  ExpressionUUID->"46ffe999-08ac-3a3a-d795-1626ca0bfd5d"],
 " uniformly on the displayed\nbalanced range."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"9bd5b0bd-429c-3121-eab9-cedf04d73880"]
}, Open  ]],

