Cell["\<\
The selected carrier edge determines four boundary half-edges.  The two \
alternative pairings are the two compressed Whitehead resolutions.\
\>", "Caption",
 ShowCellBracket->False,
 CellMargins->{{84, 84}, {2, 18}},
 TaggingRules-><|
  "MathNotebook" -> <|"Suppressed" -> "True"|>, 
   "GoGNotebook" -> <|
    "PresentationOnly" -> True, "ID" -> "GoGWhiteheadMoveCaption"|>|>,
 FontSlant->Plain,
 FontColor->RGBColor[0.37, 0.42, 0.49],
 CellTags->{
  "GoGNotebookVisual", 
   "GoGWhiteheadMoveCaption"},ExpressionUUID->"7060365f-41ad-1892-64e2-\
41282808487e"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"u", ",", "v"}], "}"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=\\{u,v\\}"|>|>,
  ExpressionUUID->"5c7547bd-87ca-8d36-4d39-179d50ad827f"],
 " be a non-loop edge of a cubic graph.  At ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "u"|>|>,ExpressionUUID->
  "2754d97b-fb92-41f9-4c7c-631fb7e93773"],
 " there are exactly\ntwo other incident half-edges, call them ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "a,b"|>|>,ExpressionUUID->
  "5c78c600-1fb0-493a-5498-0ae54032b0c6"],
 ", and at ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "v"|>|>,ExpressionUUID->
  "598136de-4a17-5590-cb37-1bc06ac23cb9"],
 " there are exactly two\nother incident half-edges, call them ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c,d"|>|>,ExpressionUUID->
  "5954156f-ebf7-d618-a0b5-24fbc1c7bde4"],
 ".  Locally the edge ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "7a10f11d-ac8a-aefd-339b-109fe27b7b7d"],
 " sees the\npartition"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"96666571-08ee-0769-7616-566cb38651f5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], "}"}], "|", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["d", "TI"]}], "}"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    \\{a,b\\}\\mid\\{c,d\\}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"cd8b35c0-bf04-cd3a-340d-cfa68872d713"],

Cell[TextData[{
 "A Whitehead move collapses ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "9f727ed5-c4df-13fe-a918-545b2dee11c2"],
 " to a four-valent vertex and re-expands in one of\nthe two other pairings:"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c86c1af8-dbcf-ae3b-3fb8-a3a1e9f5e671"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["c", "TI"]}], "}"}], "|", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["d", "TI"]}], "}"}]}], ",", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["d", "TI"]}], "}"}], "|", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["b", "TI"], ",", 
       StyleBox["c", "TI"]}], "}"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\{a,c\\}\\mid\\{b,d\\},\n    \\qquad\n    \
\\{a,d\\}\\mid\\{b,c\\}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"01ea5345-317e-f75b-6479-6e83df407dd6"],

Cell[TextData[{
 "On a fixed labelled vertex set, each of these two unordered pairings has \
two\nassignments to the labelled central vertices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "u,v"|>|>,ExpressionUUID->
  "542ee0e5-8e55-f728-5a90-b62266e0d0d5"],
 ".  Thus there are four\nlabelled moves per non-loop edge, as in Li's \
labelled graph, but only two\nunlabelled resolution slots per edge, as in \
Grave de Peralta--Kolpakov.  For a\ncubic graph on ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "a6d845f4-3af5-814c-359c-9667e3ef3e6b"],
 " vertices the corresponding raw counts are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "9818d529-ffbe-7f51-192d-ca5bddd6a83d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "156fc91b-89c6-a54c-98f9-fd4ba35566ab"],
 ".\nIf ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "d6dddd6c-8fb1-3f14-cc3d-a8962e7cf192"],
 " is a loop, we use the convention of ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["gdp-kolpakov",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"gdp-kolpakov"],
 ": the Whitehead\nmove is trivial.  In the half-edge model this convention \
is natural because the\npairing of half-edges is fixed and only the \
assignment of nearby half-edges to\nvertices changes; when the two endpoints \
coincide there is no reassignment."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c8aa8d0d-e935-36d4-e975-99e84b36d790"],

Cell[TextData[{
 "For the averaged field the factor of two can be compressed.  The two \
labelled\norientations of one unlabelled resolution differ by the \
transposition\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "\[LongEqual]", "uv"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\tau=(uv)"|>|>,
  ExpressionUUID->"92489957-03fb-a373-dc5a-30f57e189a30"],
 ", and"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"a4e8069d-60ce-81ed-6287-6fb7abb30913"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "\[Tau]"], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"u", "v"}], "TI"]]}], "\[LongEqual]", 
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"u", "v"}], "TI"]], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    P_\\tau A_{uv}=A_{uv}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"cba5e6d2-8f60-5c97-e78b-40ce952d6ac5"],

Cell["\<\
With compatible settlements they therefore produce the same transported
field.  At a target with automorphisms they agree modulo a target
automorphism.  The transition table may consequently store two resolution
records per edge without losing the base-class kernel or the one-step
variance/source-Laplacian calculation.  For a full trajectory or a curvature
calculation, however, an intermediate target automorphism can change later
averages.  The compression is lossless there only after specifying coherent
settlements (or explicitly quotienting the fibre by stabilizers); otherwise
the omitted stabilizer holonomy is dynamical data.  The compression also does
not identify the two targets in the labelled simple graph and must not be \
used
for labelled ball counts.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"2fd8ec03-8ad1-fb06-7c58-21432421cd28"],

Cell["There are two inequivalent random rules.", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"26b78cdd-c56a-121e-8d5a-828e82acf394"],

Cell[TextData[{
 "Start from a settled representative of the unlabelled class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma=[G]"|>|>,
  ExpressionUUID->"5cf0f9cd-b61c-ba97-3b4f-b37a45665578"],
 ".\nChoose a labelled Whitehead move upstairs, or equivalently for this \
averaged\nfield choose one of the two compressed unlabelled resolutions of an \
edge\nobject.  Apply this move to get a labelled graph ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H"|>|>,ExpressionUUID->
  "3ca20629-178f-561b-f994-4d94eb25df87"],
 ", project to the unlabelled\nclass ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["H", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\delta=[H]"|>|>,
  ExpressionUUID->"4b2e1e63-6a76-f553-0eb9-1a63313fdf85"],
 ", and choose an isomorphism settling ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H"|>|>,ExpressionUUID->
  "b98e34d0-0d60-afd2-4092-bcf59c3f3ba2"],
 " onto the chosen\nrepresentative of ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\delta"|>|>,
  ExpressionUUID->"0346f3d0-39e0-0bac-4511-ca46087b5ea1"],
 "."
}], "Definition",
 CellDingbat->Cell[
   TextData[{"Definition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "definition", "EnvironmentOpen" -> 
     "\\begin{definition}[Rule A: local move first]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "EnvironmentClose" -> "\n\\end{definition}", 
     "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"a1080bf7-65ca-a07a-616d-797fb0e1169f"],

Cell[TextData[{
 "Rule A weights unlabelled transitions by concrete multiplicity.  If many\n\
different edges and resolutions lead from ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma"|>|>,
  ExpressionUUID->"9c1f5b7a-0483-dc6d-9a32-5d0c812846f7"],
 " to the same class ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\delta"|>|>,
  ExpressionUUID->"ad28337e-a72d-3d7b-9c64-e508abb5c12a"],
 ",\nthen that edge of the unlabelled GoG is traversed more often.  This is \
the\nnatural rule if the physics is local in the current cubic graph."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"7db76a34-bb07-fb54-31d2-e2f4e0e7f67d"],

Cell[TextData[{
 "Start at an unlabelled class ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "6c9cc28d-cf98-5217-1d24-0d32fd48aab0"],
 ".  For every distinct nonself class ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "H"|>|>,ExpressionUUID->
  "5ca18e0f-f8dd-7872-7083-4c21fa717afa"],
 " that\ncan be reached by at least one Rule-A slot, assign one of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "f8e0288b-52c6-cd0b-c037-7563e0058b4e"],
 " clock ticks\nto the transition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "\[Rule]", "H"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G\\to H"|>|>,
  ExpressionUUID->"d6d3f2d3-4517-3c94-68f2-3dbc5fb1042f"],
 ".  Assign the remaining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", " ", "N"}], "-", 
    RowBox[{"q", "(", "G", ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N-q(G)"|>|>,
  ExpressionUUID->"11b45614-09d9-1325-86a4-74e7201f13e4"],
 " ticks to holding\nat ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "d8f21264-1f27-5896-ff35-76af5ee5b200"],
 ", where"
}], "Definition",
 CellDingbat->Cell[
   TextData[{"Definition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "definition", "EnvironmentOpen" -> 
     "\\begin{definition}[Rule B: fixed support clock]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"180f2257-e67f-5b6c-5f6a-78de2002cb6e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["q", "TI"], "(", 
    StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{"#", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["H", "TI"], "\[NotEqual]", 
       RowBox[{
        StyleBox["G", "TI"], ":", 
        RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox[
           RowBox[{"G", "H"}], "TI"]], ">", "0"}]}]}], "}"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n q(G)=\\#\\{H\\ne G:m_{GH}>0\\}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ae2a0148-f793-100e-b795-f70d1b3b89f5"],

Cell["Thus", "Definition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"cd4a907c-8ce7-52c4-c2b3-dd2fd2c37b87"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]], "(", 
     RowBox[{
      StyleBox["G", "TI"], ",", 
      StyleBox["H", "TI"]}], ")"}], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}]], "  ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        StyleBox["H", "TI"], "\[NotEqual]", 
        StyleBox["G", "TI"]}], ",", " ", 
       RowBox[{
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox[
          RowBox[{"G", "H"}], "TI"]], ">", "0"}]}], ")"}]}]}], ",", "    ", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]], "(", 
     RowBox[{
      StyleBox["G", "TI"], ",", 
      StyleBox["G", "TI"]}], ")"}], "\[LongEqual]", 
    RowBox[{"1", "-", 
     RowBox[{
      FractionBox[
       RowBox[{
        StyleBox["q", "TI"], "(", 
        StyleBox["G", "TI"], ")"}], 
       RowBox[{"3", 
        StyleBox["N", "TI"]}]], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n P_B(G,H)=\\frac1{3N}\\quad(H\\ne G,\\ m_{GH}>0),\n \\qquad\n \
P_B(G,G)=1-\\frac{q(G)}{3N}.\n\\]", "EnvironmentClose" -> 
     "\n\\end{definition}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"5440c79a-8e3a-3b0a-2ad7-41288c9c48c0"],

Cell[TextData[{
 "The support is undirected, so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "B"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "P_B"|>|>,ExpressionUUID->
  "1f946922-7438-5979-e434-253789cd54ff"],
 " is symmetric and the uniform law on\nunlabelled classes is stationary.  \
Moreover"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"304384ce-0ad7-d10d-e2f0-4d98e8f6bc08"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["I", "TI"], "-", 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["B", "TI"]]}], "\[LongEqual]", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], 
    RowBox[{
     SubscriptBox[
      StyleBox["L", "TI"], "supp"], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n I-P_B=\\frac1{3N}L_{\\rm supp}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e057a211-8793-2782-5d57-46e55c203599"],

Cell[TextData[{
 "This fixed clock removes the variable-degree normalization from the Rule-B\n\
spectrum.  The walk that chooses one of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)"|>|>,
  ExpressionUUID->"f8aff41f-2706-ee87-1e9d-176dc8eb7b0c"],
 " neighbours uniformly is the\njump chain obtained by conditioning Rule B on \
leaving ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "333f5423-772e-bac8-c07b-085420de358c"],
 ":"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"aee7243b-5b06-1205-e09b-34b13c167659"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["B", "TI"]], "(", 
    RowBox[{
     StyleBox["G", "TI"], ",", 
     StyleBox["H", "TI"]}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      StyleBox["q", "TI"], "(", 
      StyleBox["G", "TI"], ")"}]], "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        StyleBox["H", "TI"], "\[NotEqual]", 
        StyleBox["G", "TI"]}], ",", " ", 
       RowBox[{
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox[
          RowBox[{"G", "H"}], "TI"]], ">", "0"}]}], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n J_B(G,H)=\\frac1{q(G)}\\quad(H\\ne G,\\ m_{GH}>0).\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"86d749c9-5421-bf4c-feb3-7548ac0e062e"],

Cell[TextData[{
 "It has stationary mass proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)"|>|>,
  ExpressionUUID->"71594046-27fa-561b-5f14-d5a3ea2f9c2a"],
 ".  We keep ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "B"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J_B"|>|>,ExpressionUUID->
  "3ade7f81-aac6-c6af-4c40-c1013d637220"],
 " as a named\ncomparison chain, but it is not the default Rule-B clock."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"eefcbc43-946a-e41a-504b-b87b9af1655c"],

Cell[TextData[{
 "Rule B still requires a second choice before it transports a field.  A tick\
\nlabelled by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "\[Rule]", "H"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G\\to H"|>|>,
  ExpressionUUID->"69d13bc6-5eda-e5d0-dc17-138c8597d1df"],
 " specifies the target class but not which concrete edge and\nresolution \
above that transition is used.  A holding tick leaves both carrier\nand field \
unchanged.  Under a non-holding Rule-B tick, the edge of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "be0920e5-933e-da87-26d0-e3af6ac7386b"],
 " being\naveraged need not be uniform among the edge objects of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "378b0034-717e-254d-2e0a-e61d79e134d5"],
 ".  Its expected field\nstep is therefore governed by a weighted Laplacian \
rather than the ordinary\nLaplacian of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "89b78001-94c8-5e9c-5327-c66e8f2f055d"],
 "."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"8f125ecc-9bc2-27b0-30f3-5d6031bd6dad"],

Cell["\<\
This distinction controls both the base transition law and the field
operator.  Rule A is local first: every formal edge-resolution slot in the
current cubic graph is equally likely, so every edge object is equally likely
to be averaged.  Rule B retains only one tick for each distinct target.  If ten
Rule-A slots land in one quotient neighbour and one slot lands in another,
Rule B gives each target one tick and converts the other nine ticks into
holding.  A lift rule then distributes a target's single tick among its
concrete realizations.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"fac15885-8a55-e906-c9dd-0c7c25796c86"],

Cell[TextData[{
 "For a fixed class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[LongEqual]", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\gamma=[G]"|>|>,
  ExpressionUUID->"8be94799-89c4-70be-9922-4fd523eab559"],
 ", the Rule B field step is therefore recorded as\na weighted source \
Laplacian"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"05b2d224-1684-2dce-a413-799e07b7ae24"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["L", "TI"], "\[Gamma]", 
     StyleBox["B", "TI"]], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["e", "TI"], "\[LongEqual]", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], "}"}]}],
      LimitsPositioning->True], 
     RowBox[{
      RowBox[{
       SubsuperscriptBox[
        StyleBox["p", "TI"], "\[Gamma]", 
        StyleBox["B", "TI"]], "(", 
       StyleBox["e", "TI"], ")"}], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["i", "TI"]], "-", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["j", "TI"]]}], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]]}], ")"}], 
       StyleBox["T", "TI"]]}]}]}], ","}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \
L_\\gamma^B=\\sum_{e=\\{i,j\\}}p_\\gamma^B(e)(e_i-e_j)(e_i-e_j)^T,\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"5ca5f9a6-d6e6-cb3a-242f-ecf012d5faf5"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["p", "\[Gamma]", "B"], "(", "e", ")"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "p_\\gamma^B(e)"|>|>,
  ExpressionUUID->"b596b188-57c3-a7b6-3032-19c094c1e667"],
 " is the total Rule B probability that the chosen lift\naverages edge ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "bad600d7-0923-ec83-b394-107fba8603da"],
 ".  Rule A corresponds to the special case"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"35d0710d-58af-7ec6-11c8-e1fe81b8edda"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["p", "TI"], "\[Gamma]", 
     StyleBox["A", "TI"]], "(", 
    StyleBox["e", "TI"], ")"}], "\[LongEqual]", 
   FractionBox["1", 
    TemplateBox[{
      RowBox[{
        StyleBox["E", "TI"], 
        RowBox[{"(", 
          StyleBox["G", "TI"], ")"}]}]},
     "Abs"]], "\[LongEqual]", 
   FractionBox["2", 
    RowBox[{"3", 
     StyleBox["N", "TI"]}]]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    p_\\gamma^A(e)=\\frac{1}{|E(G)|}=\\frac{2}{3N}\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"03b68e45-09d4-27d9-2b6e-d41b6c8841fc"],

Cell[TextData[{
 "for every edge object.  Numerically, the right question is not simply \
whether\nthe base chains on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"607c0626-96a6-f984-23c5-c528af6f8c7d"],
 " differ, but whether ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["L", "\[Gamma]", "B"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L_\\gamma^B"|>|>,
  ExpressionUUID->"96026ff5-2a56-b3e2-f0fb-0422d15458ad"],
 " differs\nsubstantially from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"2", " ", "N"}], ")"}], " ", 
    SubscriptBox["L", "G"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(2/3N)L_G"|>|>,
  ExpressionUUID->"5e993a62-005c-7f5b-088a-e8f87ecbc279"],
 " on the states that the chain actually visits."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"7c36c1dd-b004-0348-0b18-e978b44ee13a"],

Cell[TextData[{
 "The base graph ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\G_N"|>|>,
  ExpressionUUID->"7e52d3ef-dbd8-4da5-1fb3-3574fd376000"],
 " can stay unlabelled.  Labels on the vertices of the\ncurrent cubic graph \
are accounting coordinates for the field.  A step consists\nof choosing a \
labelled lift, applying a concrete move, and then resettling onto\nsome \
representative of the target isomorphism class.  When automorphisms are\n\
trivial, the settlement ambiguity essentially disappears once representatives\
\nare fixed.  When automorphisms are nontrivial, the ambiguity is an \
orthogonal\npermutation of the fibre, hence a gauge ambiguity rather than an \
extra\ncontraction mechanism."
}], "Remark",
 CellDingbat->Cell[
   TextData[{"Remark ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "remark", "EnvironmentOpen" -> 
     "\\begin{remark}[What labels are doing]", "Trailing" -> "", "BodyIndent" -> 
     "\n", "EnvironmentClose" -> "\n\\end{remark}", "Separator" -> "\n\n"|>|>,
 
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"92555e34-9691-4b1c-25c4-9a5b6e8e77a9"],

Cell[TextData[{
 "For a labelled adjacency multigraph ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "3a67e7a7-0e52-ac57-824b-28dba55f8ca9"],
 ", let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "ii"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{ii}"|>|>,
  ExpressionUUID->"07620147-3597-50d1-fda2-d530a1bf1bb4"],
 " be the number of loops at\n",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "i"|>|>,ExpressionUUID->
  "760bf1f1-b7ef-d46f-aeb5-5278438fbf3e"],
 ", let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "ij"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{ij}"|>|>,
  ExpressionUUID->"db51c96e-581d-7ae6-b2de-b6dc2af8e2b5"],
 " be the number of edges between ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "<", "j"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "i<j"|>|>,ExpressionUUID->
  "40a425c0-cfd6-f346-99b9-f1fda3290736"],
 ", and put"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Configuration-model stationary law of Rule A]", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"b65d848b-844f-225c-2222-f7816e438948"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "(", 
    StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"3", "!"}], ")"}], 
      StyleBox["N", "TI"]], 
     RowBox[{
      UnderscriptBox["\[Product]", 
       StyleBox["i", "TI"],
       LimitsPositioning->True], 
      RowBox[{
       SuperscriptBox["2", 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox[
          RowBox[{"i", "i"}], "TI"]]], 
       RowBox[{
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox[
          RowBox[{"i", "i"}], "TI"]], "!"}], 
       RowBox[{
        UnderscriptBox["\[Product]", 
         RowBox[{
          StyleBox["i", "TI"], "<", 
          StyleBox["j", "TI"]}],
         LimitsPositioning->True], 
        RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox[
           RowBox[{"i", "j"}], "TI"]], "!"}]}]}]}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    c(G)=\n    \\frac{(3!)^N}\n    \
{\\prod_i2^{m_{ii}}m_{ii}!\\prod_{i<j}m_{ij}!}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"7305b380-056c-a2fa-daf2-daa6670937ba"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", 
    SubscriptBox["Aut", "v"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Aut_v(G)"|>|>,
  ExpressionUUID->"11baecb6-6993-cc2b-b407-e4d9667c0853"],
 " denote the vertex-permutation automorphism group.  If\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "GH"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{GH}"|>|>,
  ExpressionUUID->"8124da2c-dabe-9d0e-45ae-7e64b6790491"],
 " is the number of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "baf7368c-bdcd-8154-e997-c54dad6e3c81"],
 " compressed Grave\nde Peralta--Kolpakov slots from a representative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["G", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[G]"|>|>,ExpressionUUID->
  "89c0a324-96e4-4ce3-8573-1461763e7a73"],
 " to the class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["H", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[H]"|>|>,ExpressionUUID->
  "25835500-3335-e07c-68ff-5a81c9ced928"],
 ",\nthen"
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"0748e369-77c7-3b4b-d476-18b3740cfe94"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["c", "TI"], "(", 
      StyleBox["G", "TI"], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          RowBox[{
            StyleBox["A", "TI"], 
            StyleBox["u", "TI"], 
            StyleBox["t", "TI"]}], 
          StyleBox["v", "TI"]], 
         RowBox[{"(", 
           StyleBox["G", "TI"], ")"}]}]},
      "Abs"]], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox[
      RowBox[{"G", "H"}], "TI"]]}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["c", "TI"], "(", 
      StyleBox["H", "TI"], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          RowBox[{
            StyleBox["A", "TI"], 
            StyleBox["u", "TI"], 
            StyleBox["t", "TI"]}], 
          StyleBox["v", "TI"]], 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}]}]},
      "Abs"]], 
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox[
       RowBox[{"H", "G"}], "TI"]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\frac{c(G)}{|\\Aut_v(G)|}m_{GH}\n    =\n    \
\\frac{c(H)}{|\\Aut_v(H)|}m_{HG}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ee4da5eb-dc14-f8ec-ae98-ac32441b833f"],

Cell["Consequently the Rule-A class chain", "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"a376f0fc-e6fb-1221-f003-2a9120485a94"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["A", "TI"]], "(", 
    RowBox[{
     RowBox[{"[", 
      StyleBox["G", "TI"], "]"}], ",", 
     RowBox[{"[", 
      StyleBox["H", "TI"], "]"}]}], ")"}], "\[LongEqual]", 
   FractionBox[
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox[
      RowBox[{"G", "H"}], "TI"]], 
    RowBox[{"3", 
     StyleBox["N", "TI"]}]]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    P_A([G],[H])=\\frac{m_{GH}}{3N}\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a2a69ae6-6275-26e6-ecbc-a62aba576169"],

Cell["is reversible with stationary law", "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"32db8ab7-1686-eac4-c040-979f58bfd075"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["A", "TI"]], "(", 
    RowBox[{"[", 
     StyleBox["G", "TI"], "]"}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["c", "TI"], "(", 
        StyleBox["G", "TI"], ")"}], "/"}], "|", 
      RowBox[{
       SubscriptBox[
        StyleBox[
         RowBox[{"A", "u", "t"}], "TI"], 
        StyleBox["v", "TI"]], 
       RowBox[{"(", 
        StyleBox["G", "TI"], ")"}]}], "|"}], 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         RowBox[{"[", 
          StyleBox["K", "TI"], "]"}], "\[Element]", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["N", "TI"]]}],
        LimitsPositioning->True], 
       RowBox[{
        RowBox[{
         StyleBox["c", "TI"], "(", 
         StyleBox["K", "TI"], ")"}], "/"}]}], "|", 
      RowBox[{
       SubscriptBox[
        StyleBox[
         RowBox[{"A", "u", "t"}], "TI"], 
        StyleBox["v", "TI"]], 
       RowBox[{"(", 
        StyleBox["K", "TI"], ")"}]}], "|"}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\pi_A([G])\n    =\n    \\frac{c(G)/|\\Aut_v(G)|}\n    \
{\\sum_{[K]\\in\\G_N}c(K)/|\\Aut_v(K)|}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"dbd89d29-8e6f-e5e4-3227-2d3ec64500e9"],

Cell["\<\
This is exactly the cubic configuration-model law, conditioned on
connectedness and projected to unlabelled classes.\
\>", "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"bbe89d73-d7bd-41b5-f4b6-30d0037eff11"],

Cell[TextData[{
 "Give each labelled vertex three distinguishable half-edges.  The number of\n\
perfect matchings of these half-edges which realize a fixed labelled \
adjacency\nmultigraph ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "cc53e300-904a-11b0-31a1-fb254da73439"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c(G)"|>|>,
  ExpressionUUID->"8fbabd28-4964-436d-0b1c-264bb36222b8"],
 ": the denominator removes the two orientations of each\nloop, permutations \
of loops at a vertex, and permutations of parallel edges.\nAn unlabelled \
class has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["N", "TI"], "!"}], "/"}], "|", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{"A", "u", "t"}], "TI"], 
      StyleBox["v", "TI"]], 
     RowBox[{"(", 
      StyleBox["G", "TI"], ")"}]}], "|"}], TraditionalForm]], "InlineFormula",
  
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N!/|\\Aut_v(G)|"|>|>,
  ExpressionUUID->"a2fc1cf5-ee9a-1c36-8811-c51130855a6f"],
 " labelled adjacency realizations."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"372b6e2c-47ab-9381-8a57-ec19a70bceef"],

Cell[TextData[{
 "On fully labelled half-edge configurations, retain the four \
endpoint-oriented\nmoves at a non-loop edge (and four duplicate holding slots \
at a loop).  Each\nmove has a unique reverse, so uniform measure on \
configurations is reversible.\nThe four oriented moves collapse in pairs to \
the two unlabelled resolutions\nrecorded by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "GH"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{GH}"|>|>,
  ExpressionUUID->"413927bb-3310-eabc-4bca-a9fba9e6cb7c"],
 ".  Lumping the reversible configuration chain by\nisomorphism class gives \
the displayed reciprocity identity and stationary law.\nWhitehead moves \
preserve connectedness, so restricting and conditioning on\nthe connected \
component is legitimate."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"141d8a75-417e-4bfe-395d-ce3870fe7477"],

Cell[TextData[{
 "Thus stationarity is not a free assumption, and there is no third unknown\n\
Rule-A graph distribution: its carrier marginal is the configuration model.\n\
The weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "c(G)"|>|>,
  ExpressionUUID->"d715c0b1-9152-c2e0-27a6-f00c3032f209"],
 " are essential when loops and parallel edges occur.  Already\nfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2"|>|>,ExpressionUUID->
  "993e5ada-0449-0199-ccdf-deff7c1e503c"],
 ", the triple-edge class and the class with one joining edge and one\nloop \
at each endpoint have equal vertex-automorphism orders but stationary\nmasses \
",
 Cell[BoxData[
  FormBox[
   FractionBox["2", "5"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "2/5"|>|>,ExpressionUUID->
  "53d4bb4d-136e-ca9d-d19f-c668c7147536"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "5"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3/5"|>|>,ExpressionUUID->
  "2dced683-95b3-5f1e-99a8-07fad83686f2"],
 "."
}], "Remark",
 CellDingbat->Cell[
   TextData[{"Remark ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Plain", FontSlant -> 
   "Italic"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "remark", "EnvironmentOpen" -> "\\begin{remark}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{remark}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"b63d4ea1-7748-c858-c09b-cddd881a07df"]
}, Open  ]],

