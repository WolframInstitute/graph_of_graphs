   SubscriptBox["m", "ii"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{ii}"|>|>,
  ExpressionUUID->"f8e0288b-52c6-cd0b-c037-7563e0058b4e"],
 " be the number of loops at\n",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "i"|>|>,ExpressionUUID->
  "d6d3f2d3-4517-3c94-68f2-3dbc5fb1042f"],
 ", let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "ij"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{ij}"|>|>,
  ExpressionUUID->"11b45614-09d9-1325-86a4-74e7201f13e4"],
 " be the number of edges between ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "<", "j"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "i<j"|>|>,ExpressionUUID->
  "d8f21264-1f27-5896-ff35-76af5ee5b200"],
 ", and put"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Configuration-model stationary law of Rule A]", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->
  "Theorem",ExpressionUUID->"180f2257-e67f-5b6c-5f6a-78de2002cb6e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "(", 
    StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"3", "!"}], ")"}], 
      StyleBox["N", "TI"]], 
     RowBox[{
      UnderscriptBox["\[Product]", 
       StyleBox["i", "TI"],
       LimitsPositioning->True], 
      RowBox[{
       SuperscriptBox["2", 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox[
          RowBox[{"i", "i"}], "TI"]]], 
       RowBox[{
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox[
          RowBox[{"i", "i"}], "TI"]], "!"}], 
       RowBox[{
        UnderscriptBox["\[Product]", 
         RowBox[{
          StyleBox["i", "TI"], "<", 
          StyleBox["j", "TI"]}],
         LimitsPositioning->True], 
        RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox[
           RowBox[{"i", "j"}], "TI"]], "!"}]}]}]}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    c(G)=\n    \\frac{(3!)^N}\n    \
{\\prod_i2^{m_{ii}}m_{ii}!\\prod_{i<j}m_{ij}!}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ae2a0148-f793-100e-b795-f70d1b3b89f5"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", 
    SubscriptBox["Aut", "v"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Aut_v(G)"|>|>,
  ExpressionUUID->"cd4a907c-8ce7-52c4-c2b3-dd2fd2c37b87"],
 " denote the vertex-permutation automorphism group.  If\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "GH"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{GH}"|>|>,
  ExpressionUUID->"5440c79a-8e3a-3b0a-2ad7-41288c9c48c0"],
 " is the number of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "1f946922-7438-5979-e434-253789cd54ff"],
 " compressed Grave\nde Peralta--Kolpakov slots from a representative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["G", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[G]"|>|>,ExpressionUUID->
  "304384ce-0ad7-d10d-e2f0-4d98e8f6bc08"],
 " to the class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["H", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[H]"|>|>,ExpressionUUID->
  "e057a211-8793-2782-5d57-46e55c203599"],
 ",\nthen"
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"f8aff41f-2706-ee87-1e9d-176dc8eb7b0c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["c", "TI"], "(", 
      StyleBox["G", "TI"], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          RowBox[{
            StyleBox["A", "TI"], 
            StyleBox["u", "TI"], 
            StyleBox["t", "TI"]}], 
          StyleBox["v", "TI"]], 
