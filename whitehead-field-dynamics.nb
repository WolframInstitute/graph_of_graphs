Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["Q", "TI"], 
      StyleBox["A", "TI"]], "(", 
     RowBox[{
      StyleBox["S", "TI"], ",", 
      StyleBox["T", "TI"]}], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       RowBox[{
        StyleBox["G", "TI"], "\[Element]", 
        StyleBox["S", "TI"]}], "\n", 
       RowBox[{
        StyleBox["H", "TI"], "\[Element]", 
