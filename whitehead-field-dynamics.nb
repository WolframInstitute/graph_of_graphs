Cell[TextData[{
 "The sizes shown are not yet in the asymptotic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"6", " ", "N"}], "-", 
    RowBox[{"O", "(", "1", ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N-O(1)"|>|>,
  ExpressionUUID->"c3c12d33-1dbf-af68-9940-e374b85fe23a"],
 " regime, but the\nratios increase monotonically over this range.  Exact \
rational arithmetic\nalso verifies the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "4"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "K_4"|>|>,ExpressionUUID->
  "6f4e738b-8fff-ec5d-ae86-615c22ac5aaf"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "3"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "Q_3"|>|>,ExpressionUUID->
  "5195a537-d23a-6bfe-ae46-890b6d897473"],
 " consensus products, and direct evaluation\nof the resolution-independent \
energy identity on sampled transitions agrees\nto machine precision."
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"a2b1b817-9eda-aca2-2048-c380e7d5d21a"],

Cell["\<\
\\paragraph{Reproducibility.}
The script \\path{gog_generate.py} constructs the canonical class and
transition tables.  The reported multiplicity/support spectra and bridge
statistics are produced by \\path{gog_edge_model_experiments.py};
\\path{gog_support_feature_analysis.py} evaluates short-cycle and Rule-B
diagnostics, and \\path{gog_ball_growth.py} samples support balls.
Labelled-degree and automorphism checks are implemented in
\\path{gog_degree_diagnostics.py}.  Exact commands, conventions, and
numerical limitations are recorded in \\path{docs/computation.rst}.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"12ea9c86-f1f4-4e04-7899-e76c6a031ecd"],

Cell["Lean Verification Boundary", "Section",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"94dc6674-7583-1235-4f59-8f7a070e05cc"],

Cell["\<\
A self-contained Lean~4 project in \\texttt{lean/} kernel-checks the exact
finite algebra that is actually formalized.  It uses exact rational \
arithmetic
and the standard library only; the project source contains no \
\\texttt{sorry},
\\texttt{admit}, or project-declared \\texttt{axiom}.  Representative
\\texttt{#print axioms} checks report only Lean's foundational principles
\\texttt{propext}, \\texttt{Classical.choice}, and \\texttt{Quot.sound}.  The
checked declarations include:\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"dd9ec33b-cc94-f8a5-243d-b042ea9f2270"],

Cell[TextData[{
 "the coordinate definition of pair averaging, symmetry, affine and\n    \
centering covariance, preservation of the selected-pair sum, idempotence,\n   \
 and the exact squared-norm/variance drop ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "i"], "-", 
       SubscriptBox["x", "j"]}], ")"}], "2"]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(x_i-x_j)^2/2"|>|>,
  ExpressionUUID->"975c2411-e9f6-94b6-d5bf-647f2230e055"],
 " with an arbitrary\n    unchanged remainder;"
}], "Item",
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentOpen" -> "\\begin{itemize}[leftmargin=*]\n    \\item ", 
     "Separator" -> "\n"|>|>,
 CounterAssignments->{{
   "Item", 0}},ExpressionUUID->"7ec1d3fc-484d-a52f-7064-1fb3be8c6b74"],

Cell["commutation of averages on disjoint pairs;", "Item",
 TaggingRules-><|
