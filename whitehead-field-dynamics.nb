 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {
   None, None}},ExpressionUUID->"5e858793-5caa-f1c0-1212-2f91da172c32"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["i", "TI"]], "-", 
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["j", "TI"]]}], ")"}], "2"]}], "\[LongEqual]", 
    RowBox[{
     FractionBox["3", 
      RowBox[{
       StyleBox["N", "TI"], "(", 
       RowBox[{
        RowBox[{"3", 
         StyleBox["N", "TI"]}], "-", "1"}], ")"}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["i", "TI"],
       LimitsPositioning->True], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["j", "TI"], "\[NotEqual]", 
         StyleBox["i", "TI"]}],
        LimitsPositioning->True], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["i", "TI"]], "-", 
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["j", "TI"]]}], ")"}], "2"]}]}]}], "\[LongEqual]", 
    RowBox[{
     FractionBox["6", 
      RowBox[{
       RowBox[{"3", 
        StyleBox["N", "TI"]}], "-", "1"}]], 
     RowBox[{
      StyleBox["V", "TI"], "(", 
      StyleBox["f", "TI"], ")"}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\E(f_i-f_j)^2\n =\\frac{3}{N(3N-1)}\\sum_i\\sum_{j\\ne \
i}(f_i-f_j)^2\n =\\frac{6}{3N-1}\\V(f),\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"167e6d6a-0017-e658-4be1-11c1e65d5bb4"],

Cell[TextData[{
 "and one average loses half of this.  Under connected conditioning,\n\
permutation invariance makes the mean Laplacian scalar on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "E_0"|>|>,ExpressionUUID->
  "76c63a20-fb3a-55eb-6992-3c7099260143"],
 "; its trace\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", " ", "N"}], "-", 
