Cell[BoxData[
 FormBox[
  RowBox[{"0", "\[LessEqual]", 
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["N", "TI"]], "\[LessEqual]", 
   RowBox[{
    FractionBox["2", 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], 
    SubscriptBox[
