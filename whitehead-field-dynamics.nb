Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["V", "TI"], "(", 
       SuperscriptBox[
        StyleBox["f", "TI"], "\[Prime]"], ")"}], "|", 
      StyleBox["G", "TI"]}], ",", 
     StyleBox["f", "TI"]}], "]"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], "(", 
     StyleBox["f", "TI"], ")"}], "-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "|", 
       RowBox[{
        StyleBox["E", "TI"], "(", 
        StyleBox["G", "TI"], ")"}], "|"}]], 
     SuperscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["T", "TI"]], 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["G", "TI"]], 
     StyleBox["f", "TI"]}]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], "(", 
     StyleBox["f", "TI"], ")"}], "-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}]], 
     SuperscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["T", "TI"]], 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["G", "TI"]], 
     RowBox[{
      StyleBox["f", "TI"], "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\E[\\V(f')\\mid G,f]\n    =\n    \
\\V(f)-\\frac{1}{2|E(G)|}f^TL_Gf\n    =\n    \\V(f)-\\frac{1}{3N}f^TL_Gf.\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"88a7c96f-e1ea-cf80-a6a3-51618995f9de"],

