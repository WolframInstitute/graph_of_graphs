Cell[TextData[{
 "The orbit partition is strongly lumpable for the labelled simple-neighbour\n\
walk, with transition ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["b", "\[Alpha]\[Beta]"], 
    SubscriptBox["d", "\[Alpha]"]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}/d_\\alpha"|>|>,
  ExpressionUUID->"45f6921f-d57c-0aef-2d1f-faa7641148f2"],
 " and stationary mass\nproportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "\[Alpha]"], " ", 
    SubscriptBox["s", "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "s_\\alpha d_\\alpha"|>|>,
  ExpressionUUID->"a22a7e7a-4ab4-b424-d3a3-272b908ba4e2"],
 ".  The uniform-clock walk lumps with\noff-diagonal and diagonal \
transitions"
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"8c3e576f-b915-65bb-074f-28959859ee90"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["P", "TI"], "_"], 
      StyleBox["U", "TI"]], "(", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], ")"}], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["b", "TI"], "\[Alpha]\[Beta]"], 
      RowBox[{"6", 
       StyleBox["N", "TI"]}]], "  ", 
     RowBox[{"(", 
      RowBox[{"\[Beta]", "\[NotEqual]", "\[Alpha]"}], ")"}]}]}], ",", "    ", 
   
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["P", "TI"], "_"], 
      StyleBox["U", "TI"]], "(", 
     RowBox[{"\[Alpha]", ",", "\[Alpha]"}], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      RowBox[{"6", 
       StyleBox["N", "TI"]}], "-", 
      SubscriptBox[
       StyleBox["d", "TI"], "\[Alpha]"], "+", 
      SubscriptBox[
       StyleBox["b", "TI"], "\[Alpha]\[Alpha]"]}], 
     RowBox[{"6", 
      StyleBox["N", "TI"]}]]}], ","}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\overline P_U(\\alpha,\\beta)=\\frac{b_{\\alpha\\beta}}{6N}\n \
\\quad(\\beta\\ne\\alpha),\\qquad\n \\overline P_U(\\alpha,\\alpha)\n \
=\\frac{6N-d_\\alpha+b_{\\alpha\\alpha}}{6N},\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"8c472673-8eac-03f4-9aa7-47739f3a98ce"],

Cell[TextData[{
 "and stationary mass proportional to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "s_\\alpha"|>|>,
  ExpressionUUID->"fa293a8d-60c5-b52d-61d0-7231d2d87107"],
 ".  The unlabelled simple support records only whether\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "\[Alpha]\[Beta]"], ">", "0"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}>0"|>|>,
  ExpressionUUID->"3fa77350-7f03-c185-58fb-afd49006327e"],
 " and is not, in general, either Markov quotient."
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"2dd436b9-7e91-7104-b82b-ea5268aa8f97"],

Cell[TextData[{
 "The symmetric group acts transitively on every orbit and by automorphisms \
of\nthe labelled simple graph, so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]\[Beta]"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}"|>|>,
  ExpressionUUID->"6512c1a0-68cb-f2a3-6a9c-abed75710124"],
 " is representative-independent.\nDouble-counting labelled edges between the \
two orbits gives reciprocity.\nSumming its rows gives the stated lumped \
transition and stationary laws.\nDiscarding the values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]\[Beta]"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}"|>|>,
  ExpressionUUID->"95cc1b37-e29a-434f-e56e-e6f19bbb0761"],
 " retains reachability but not these\nprobabilities."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"a0039c64-8d50-3a15-96b7-a165830691a9"],

Cell["The unlabelled simple support", "Subsection",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"85bdd6ff-ed74-e339-db61-72fce6e2a390"],

Cell[TextData[{
 "Reciprocity makes the support undirected.  With\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"q", "(", "G", ")"}], "\[LongEqual]", 
    RowBox[{"#1", " ", 
     RowBox[{"{", 
      RowBox[{"H", "\[NotEqual]", 
       RowBox[{"(", 
        RowBox[{"G", ":", 
         RowBox[{
          SubscriptBox["m", "GH"], ">", "0"}]}], ")"}]}], "}"}]}]}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "q(G)=\\#\\{H\\ne G:m_{GH}>0\\}"|>|>,
  ExpressionUUID->"a8b515ca-bab7-a1c8-325e-5136bc462480"],
 ", simple-neighbour Rule B has"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a7559312-0fb3-fd88-a3a3-1905d0227339"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]], "(", 
     RowBox[{
      StyleBox["G", "TI"], ",", 
      StyleBox["H", "TI"]}], ")"}], "\[LongEqual]", 
    FractionBox["1", 
     RowBox[{
      StyleBox["q", "TI"], "(", 
      StyleBox["G", "TI"], ")"}]]}], ",", "    ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Pi]", 
      StyleBox["B", "TI"]], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["q", "TI"], "(", 
       StyleBox["G", "TI"], ")"}], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["K", "TI"],
        LimitsPositioning->True], 
       RowBox[{
        StyleBox["q", "TI"], "(", 
        StyleBox["K", "TI"], ")"}]}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n P_B(G,H)=\\frac1{q(G)},\\qquad\n \
\\pi_B(G)=\\frac{q(G)}{\\sum_Kq(K)}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"d1cd5037-47a1-a131-1dee-bab3de3d23ee"],

Cell["Condition Rule A on a nonself move and put", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"c25878f7-86e7-df22-4939-8e0b16448ea5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "+"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["H", "TI"], "\[NotEqual]", 
       StyleBox["G", "TI"]}],
      LimitsPositioning->True], 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox[
       RowBox[{"G", "H"}], "TI"]]}]}], ",", "    ", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox[
      StyleBox["C", "TI"], "1", "+"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["H", "TI"], "\[NotEqual]", 
       StyleBox["G", "TI"]}],
      LimitsPositioning->True], 
     RowBox[{
      TemplateBox[{
        SubscriptBox[
         StyleBox["m", "TI"], 
         RowBox[{
           StyleBox["G", "TI"], 
           StyleBox["H", "TI"]}]], "2"},
       "Binomial"], "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n M_+(G)=\\sum_{H\\ne G}m_{GH},\\qquad\n C_1^+(G)=\\sum_{H\\ne \
G}\\binom{m_{GH}}2.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"aab3d696-3a71-04fb-1f17-1af8739dfa67"],

Cell["\<\
Then the discrepancy from a uniform support neighbour is exactly\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"1a449be9-5614-b97c-7481-897d5e68de5e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Chi]", "2"], "(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox["p", "A"], ")"}], "+"], "\[DoubleVerticalBar]", 
     SubscriptBox["p", "B"]}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"q", "(", "G", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            SubscriptBox["C", "1"], ")"}], "+"], "\[InvisibleApplication]", 
          RowBox[{"(", "G", ")"}]}]}], "+", 
        RowBox[{
         SubscriptBox["M", "+"], "(", "G", ")"}]}], ")"}]}], 
     RowBox[{
      SuperscriptBox["G", "2"], " ", 
      SubscriptBox["M", "+"]}]], "-", "1.`"}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\chi^2(p_A^+\\Vert p_B)\n \
=\\frac{q(G)(M_+(G)+2C_1^+(G))}{M_+(G)^2}-1.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"d65979ad-1bf6-b0f5-8154-909858b6da1a"],

Cell["\<\
Thus the collision statistic controls both support degree and row-law
discrepancy.\
\>", "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"d886680c-6c6c-0fa1-efd2-eca3e9a96a50"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"1", "G"},
     "GegenbauerC2"], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", "H"], 
     TemplateBox[{
       SubscriptBox["m", 
        RowBox[{"G", " ", "H"}]], "2"},
      "Binomial"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "C_1(G)=\\sum_H\\binom{m_{GH}}2"|>|>,
  ExpressionUUID->"905fe2f2-292f-dbca-c765-7620147be21b"],
 " includes the self target, Cauchy--Schwarz\nalso gives the exact \
deterministic lower bound"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> 
     "\n"|>|>,ExpressionUUID->"3326f007-ff86-bc52-bc9f-beedbe96c998"],

Cell[BoxData[
 FormBox[
