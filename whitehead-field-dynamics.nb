Cell[TextData[{
 "The Rule-A column agrees exactly with ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{
     FractionBox[
      RowBox[{"3", " ", "N"}], "2"], "-", "1"}]], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1/(3N/2-1)"|>|>,
  ExpressionUUID->"3c1d9055-4f8b-2495-6dd4-33302b40dcfe"],
 " for every even\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LessEqual]", "14"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\le14"|>|>,
  ExpressionUUID->"eae08db4-6870-da7f-3d3d-0ff2bab8157a"],
 ".  This finite identity is a conjecture beyond the enumerated\nrange; only \
its asymptotic consequence\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "A"], "(", 
     SubscriptBox["B", "N"], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"o", "(", "1", ")"}], "+", "1"}], ")"}]}], 
     RowBox[{"3", " ", "N"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\Phi_A(B_N)=2/(3N)(1+o(1))"|>|>,
  ExpressionUUID->"d58e79d8-902f-c7f5-ec7a-5b6f4db284e6"],
 " is proved."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c99cba28-5f41-40d8-28ae-037f1247f81d"],

