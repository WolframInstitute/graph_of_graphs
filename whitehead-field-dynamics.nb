Cell[TextData[{
 "The number of vertices of this GoG is not an unknown experimental count.  \
If\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", 
    RowBox[{"2", " ", "n"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2n"|>|>,
  ExpressionUUID->"b01f977c-3b93-582f-1a8e-c4a928c88b3c"],
 ", then"
}], "Text",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Separator" -> "\n", "BibliographyTeX" -> 
     "}\nThe number of vertices of this GoG is not an unknown experimental \
count.  If\n$N=2n$, then"|>|>,
 FontSlant->Plain,ExpressionUUID->"7e6d8904-d8e6-6e70-d456-895ca2b301d6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"|", 
    RowBox[{
     StyleBox["V", "TI"], "(", 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox["N", "TI"]], ")"}], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{
      StyleBox["a", "TI"], "(", 
      StyleBox["n", "TI"], ")"}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
