Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", "2"], "(", 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["G", "TI"]], ")"}], "\[GreaterEqual]", 
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["N", "TI"]], ":", 
    RowBox[{"\[LongEqual]", 
     RowBox[{"2", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"cos", "(", 
          RowBox[{"\[Pi]", "/", 
           StyleBox["N", "TI"]}], ")"}]}], ")"}], "."}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\lambda_2(L_G)\\ge\n    a_N:=2\\bigl(1-\\cos(\\pi/N)\\bigr).\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e79c9c87-1ea8-bb76-7663-e8216a715926"],

Cell["\<\
Consequently every adapted trajectory of connected carriers under \
uniform-edge
Rule A, with arbitrary settlement permutations, satisfies\
\>", "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},ExpressionUUID->"07d261e0-fddc-b8ef-3aec-eddcffa154b7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox[
     RowBox[{"lim", " ", "sup"}], 
     RowBox[{
      StyleBox["t", "TI"], "\[Rule]", "\[Infinity]"}],
     LimitsPositioning->True], 
    FractionBox["1", 
     StyleBox["t", "TI"]], "log", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["T", "TI"], "0"]}], 
   SubscriptBox["|", 
    SubscriptBox[
     StyleBox["E", "TI"], "0"]], 
   RowBox[{"\[LessEqual]", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"log", "(", 
      RowBox[{"1", "-", 
       FractionBox[
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox["N", "TI"]], 
        RowBox[{"3", 
         StyleBox["N", "TI"]}]]}], ")"}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Pi]", "2"], 
       RowBox[{"6", 
        SuperscriptBox[
         StyleBox["N", "TI"], "3"]}]]}], "+", 
     RowBox[{
      RowBox[{
       StyleBox["O", "TI"], "(", 
       SuperscriptBox[
        StyleBox["N", "TI"], 
        RowBox[{"-", "5"}]], ")"}], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\limsup_{t\\to\\infty}\\frac1t\n    \
\\log\\norm{T_{t-1}\\cdots T_0|_{E_0}}\n    \\le \
\\frac12\\log\\left(1-\\frac{a_N}{3N}\\right)\n    \
=-\\frac{\\pi^2}{6N^3}+O(N^{-5}).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"01bdbc28-9632-8c7a-5970-c6791ac1fffc"],

Cell["\<\
No irreducibility, stationary initial law, or expander frequency is required.\
\
\>", "Theorem",
