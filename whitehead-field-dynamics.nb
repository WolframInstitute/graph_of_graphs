    StyleBox["E",
     FontSlant->"Plain"], "[", 
    RowBox[{
     RowBox[{
      StyleBox["V", "TI"], "(", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       RowBox[{
        StyleBox["t", "TI"], "+", "1"}]], ")"}], "|", 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["t", "TI"]]}], "]"}], "\[LessEqual]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       SubscriptBox["\[ScriptL]", 
        StyleBox["t", "TI"]], 
       RowBox[{"3", 
        StyleBox["N", "TI"]}]]}], ")"}], 
    RowBox[{
     RowBox[{
      StyleBox["V", "TI"], "(", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["t", "TI"]], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\E[\\V(f_{t+1})\\mid\\mathcal F_t]\n    \\le\n    \
\\left(1-\\frac{\\ell_t}{3N}\\right)\\V(f_t).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e9a31390-a413-58b2-fd11-37726cad4cdd"],

Cell[TextData[{
 "The factor is positive because the Laplacian eigenvalues of a cubic \
multigraph\nlie in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "6"}], "]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[0,6]"|>|>,
  ExpressionUUID->"a6dfe341-6b82-36cc-33a6-b3377aba6082"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", " ", "N"}], ">", "6"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N>6"|>|>,
  ExpressionUUID->"cd7ff874-4001-221e-c346-e4c627645135"],
 ".  (At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LongEqual]", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=2"|>|>,ExpressionUUID->
  "9dae948b-ebf2-5931-e5aa-32d3d766b9b8"],
 ", a zero factor means one-step consensus\nand can be handled separately.)  \
Define"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"d2da9589-ad86-02dc-de4f-bcaff19d0977"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["t", "TI"]], "\[LongEqual]", 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{
      StyleBox["s", "TI"], "=", "0"}], 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}],
     LimitsPositioning->True], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        SubscriptBox["\[ScriptL]", 
         StyleBox["s", "TI"]], 
        RowBox[{"3", 
         StyleBox["N", "TI"]}]]}], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    Q_t=\\prod_{s=0}^{t-1}\\left(1-\\frac{\\ell_s}{3N}\\right).\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"85a83c86-84c5-5613-6c42-a0bb14741d9a"],

Cell[TextData[{
 "As before, ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"V", "(", 
     SubscriptBox["f", "t"], ")"}], 
    SubscriptBox["Q", "t"]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\V(f_t)/Q_t"|>|>,
  ExpressionUUID->"c544f58b-8a31-dbe5-0932-0c8bc968dcb1"],
 " is a nonnegative supermartingale.  This gives the\nfirst displayed bound.  \
The second follows from"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"fb690521-13b9-cf87-2749-385b4451819c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"log", "(", 
    RowBox[{"1", "-", 
     StyleBox["x", "TI"]}], ")"}], "\[LessEqual]", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["x", "TI"]}], "    ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0", "\[LessEqual]", 
       StyleBox["x", "TI"], "<", "1"}], ")"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\log(1-x)\\le -x\n    \\qquad (0\\le x<1).\n\\]", 
     "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"83507fe4-f346-7d4d-37cb-8a7710e54b0d"],

Cell["\<\
This gives precise meaning to saying that the current graph is an expander on
average.  What is needed is not stationarity itself, but a pathwise lower
bound on the time average of the cubic-graph spectral gap seen by the moving
field.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c4b6875b-f171-db1d-2259-7c1ad695a818"],

Cell[TextData[{
 "Suppose the graph component is a finite irreducible Markov chain with\n\
stationary law ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\pi_N"|>|>,
  ExpressionUUID->"e7323b6d-2a0b-4cce-7eee-07e466451d2c"],
 ".  If"
}], "Corollary",
 CellDingbat->Cell[
   TextData[{"Corollary ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "corollary", "EnvironmentOpen" -> 
     "\\begin{corollary}[Stationary law as one source of good frequency]", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"ba0e7c63-d7f1-d19b-471f-597e0399ac1d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Pi]", 
      StyleBox["N", "TI"]], 
     RowBox[{"{", 
      RowBox[{
       StyleBox["G", "TI"], ":", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Lambda]", "2"], "(", 
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["G", "TI"]], ")"}], "\[GreaterEqual]", 
        SubscriptBox[
         StyleBox["c", "TI"], "0"]}]}], "}"}]}], "\[GreaterEqual]", 
    RowBox[{"1", "-", 
     SubscriptBox["\[Epsilon]", 
      StyleBox["N", "TI"]]}]}], ","}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\pi_N\\{G:\\lambda_2(L_G)\\ge c_0\\}\\ge 1-\\varepsilon_N,\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"dfd1d3d8-f804-9a38-7402-db33afc71709"],

Cell[TextData[{
 "then the theorem applies with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[LongEqual]", 
    RowBox[{"1", "-", 
     SubscriptBox["\[Epsilon]", "N"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "p=1-\\varepsilon_N"|>|>,
  ExpressionUUID->"d24c6cfc-92e4-204e-9a0d-1fa1ea6b020f"],
 ", for every initial graph."
}], "Corollary",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{corollary}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"7611e383-ae96-2c92-4abe-73082630380c"],

Cell[TextData[{
 "For a finite irreducible Markov chain, the ergodic theorem says that for \
every\nfunction ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\varphi"|>|>,
  ExpressionUUID->"605fc858-3a0f-ca27-f0e0-b0aee25b8bf0"],
 " on the state space,"
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"ee7d978b-3d4f-0d7c-517f-336fea3aa15f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["1", 
     StyleBox["t", "TI"]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["s", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["t", "TI"], "-", "1"}],
      LimitsPositioning->True], 
     RowBox[{"\[CurlyPhi]", "(", 
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["s", "TI"]], ")"}]}]}], "\[Rule]", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["G", "TI"],
     LimitsPositioning->True], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Pi]", 
       StyleBox["N", "TI"]], "(", 
      StyleBox["G", "TI"], ")"}], 
     RowBox[{"\[CurlyPhi]", "(", 
      StyleBox["G", "TI"], ")"}], "  ", "almost", " ", 
     RowBox[{"surely", "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\frac1t\\sum_{s=0}^{t-1}\\varphi(G_s)\n    \\to\n    \
\\sum_G\\pi_N(G)\\varphi(G)\n    \\quad\\text{almost surely}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"e714ce9d-758c-9356-ca54-d40d91030c04"],

Cell["Apply this to the indicator of the good set.", "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"875890ab-7406-1a67-e22e-6ff8bf83acf3"],

Cell["\<\
For concrete Rule A, the preceding stationary law is not abstract: it is the
cubic configuration model conditioned on connectedness.  Spectral typicality
can therefore be imported from the matching model itself rather than posed as
a new property of an unknown stationary law.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"5066a3a6-29db-d253-e547-ee3536d0531f"],

Cell["\<\
This corollary is not the only route.  Stationarity is convenient, but the
Lyapunov theorem only needs a pathwise lower frequency of good graphs.  A
statement such as ``the graph is an expander on average'' is not by itself
enough unless it implies such a frequency or a comparable supermartingale
inequality.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"2104e9b0-89ed-87f7-4c0d-d75537d9c0a0"],

Cell[TextData[{
 "The Jensen/log heuristic is consistent with the supermartingale proof.  \
Whenever\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", 
     SubscriptBox["f", "t"], ")"}], ">", "0"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\V(f_t)>0"|>|>,
  ExpressionUUID->"e6f93af2-105b-8c42-db4e-5bd88b717d41"],
 ","
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"3e4ca148-1ed8-bae7-a80e-44d77d27b0ba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["E",
     FontSlant->"Plain"], "[", 
    RowBox[{
     RowBox[{"log", 
      FractionBox[
       RowBox[{
        StyleBox["V", "TI"], "(", 
        SubscriptBox[
         StyleBox["f", "TI"], 
         RowBox[{
          StyleBox["t", "TI"], "+", "1"}]], ")"}], 
       RowBox[{
        StyleBox["V", "TI"], "(", 
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["t", "TI"]], ")"}]]}], " ", "|", " ", 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["t", "TI"]]}], "]"}], "\[LessEqual]", 
   RowBox[{"log", 
    RowBox[{
     RowBox[{
      StyleBox["E",
       FontSlant->"Plain"], "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         StyleBox["V", "TI"], "(", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          RowBox[{
           StyleBox["t", "TI"], "+", "1"}]], ")"}], 
        RowBox[{
         StyleBox["V", "TI"], "(", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["t", "TI"]], ")"}]], " ", "|", " ", 
       SubscriptBox[
        StyleBox["F", "TI"], 
        StyleBox["t", "TI"]]}], "]"}], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\E\\left[\n        \\log\\frac{\\V(f_{t+1})}{\\V(f_t)}\n      \
  \\,\\middle|\\,\\mathcal F_t\n    \\right]\n    \\le\n    \\log\n    \
\\E\\left[\n        \\frac{\\V(f_{t+1})}{\\V(f_t)}\n        \
\\,\\middle|\\,\\mathcal F_t\n    \\right].\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"77a2eb9c-1810-8e36-3d52-d22c33b2ba9b"],

Cell[TextData[{
 "On a good graph this is at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", "(", 
    RowBox[{"1", "-", 
     FractionBox[
      SubscriptBox["c", "0"], 
      RowBox[{"3", " ", "N"}]]}], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\log(1-c_0/(3N))"|>|>,
  ExpressionUUID->"d165ec8a-7af0-df1c-4025-06eb9a3ed9f0"],
 ".  The supermartingale\nargument is stronger because it converts \
conditional expected contraction into\nan almost-sure pathwise upper bound."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"8bed4e21-6895-3ed4-0bcb-96892c6e1cda"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exact One-Step Identities Beyond Variance", "Section",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"423e5e06-e3ed-c65c-bb75-0957d4403fe3"],

Cell["\<\
The configuration marginal gives a useful reset benchmark, but it must not be
mistaken for the correlated trajectory law.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"ea28ca69-7fcd-2fb6-b470-38986b004276"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "78382d7c-de2d-2ca4-a8c9-1eaa97a8dda4"],
 " be an unconditioned cubic configuration, let ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e"|>|>,ExpressionUUID->
  "140e92cb-5172-5ef9-cf5d-b5d2d30af7ca"],
 " be a uniform matched\nedge object, and let a deterministic mean-zero ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f"|>|>,ExpressionUUID->
  "5b12b97a-0ecb-c9d3-0191-13345eee62c7"],
 " be independent of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "01fedb9e-871c-29b1-f672-8e30b55da112"],
 ".\nThen exactly"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Independent configuration reset]", "Trailing" -> 
     "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"5b1e206c-cb2c-2dc1-598a-e6486e02b380"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["V", "TI"], "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["A", "TI"], 
