Cell[TextData[{
 "For a class set ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "3995be99-fed5-2294-c883-b3740e5ca834"],
 ", let ",
