     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"bbc9660f-8804-8f31-5161-1540c3f0d0cd"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "e"], "\[LongEqual]", 
