Cell[TextData[{
 "Detailed balance symmetrizes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "A"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "P_A"|>|>,ExpressionUUID->
  "77136b3a-3729-d74c-909c-34c3c8b59532"],
 ".  Upstairs, freeze a central nonloop edge\nand the four surrounding \
labelled stubs.  Their six two--two assignments form\nthe Johnson graph ",
 Cell[BoxData[
  FormBox[
   RowBox[{"J", "(", 
    RowBox[{"4", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "J(4,2)"|>|>,
  ExpressionUUID->"af40d574-04a3-82a8-2c7e-90faf27479f2"],
 ", whose normalized adjacency spectrum is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}]}], "}"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\{1,0,-1/2\\}"|>|>,
  ExpressionUUID->"fa9e54c4-fa19-0116-9a93-5d8438a4d95e"],
 ".  A loop gives the identity.  Averaging these local kernels and\n\
restricting to class-invariant functions proves the spectral interval.  The\n\
row sum of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "M_N"|>|>,ExpressionUUID->
  "e7b68786-d855-54e8-4da5-b79023d18ba7"],
 " is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "c5aee699-bce7-8b53-efc4-6b77a2ed278a"],
 ", proving the Perron and history claims.  The\nentropy formula follows by \
expanding the entropy of the row probabilities\n",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["m", "GH"], 
    RowBox[{"3", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m_{GH}/(3N)"|>|>,
  ExpressionUUID->"14ef64a5-572f-a618-90d4-5928e91b95ec"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Delta_N"|>|>,
  ExpressionUUID->"f297dfd4-d08a-b292-03a3-c38f8736b196"],
 " is precisely the conditional entropy of the chosen\nslot given source and \
target classes.  Finally,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"m", " ", "m", " ", "log"}], "\[LessEqual]", 
    RowBox[{"m", "(", 
     RowBox[{"m", "-", "1"}], ")"}], "\[LongEqual]", 
    RowBox[{"2", " ", 
     TemplateBox[{"m", "2"},
      "Binomial"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "m\\log m\\le m(m-1)=2\\binom m2"|>|>,
  ExpressionUUID->"1eed4365-a0af-5992-d44b-767f0f85f607"],
 " for every positive integer ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "m"|>|>,ExpressionUUID->
  "67f6b4ca-73a8-4494-5cf7-6aaaa2681497"],
 ", which proves\nthe collision bound."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c5f7a233-298d-0751-4c2f-2b5e6e1401a7"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[GreaterEqual]", "4"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\ge4"|>|>,
  ExpressionUUID->"42e36d6e-5026-809a-9190-1c7bb72baa76"],
 ", let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L(G)"|>|>,
  ExpressionUUID->"44708385-b1e9-e9f3-70a2-f0131593074e"],
 " be the number of carrier loops and\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Mu]", "N"], "(", "k", ")"}], "\[LongEqual]", 
    RowBox[{
     SubscriptBox["\[Pi]", "A"], " ", 
     RowBox[{"{", 
      RowBox[{"L", "\[LongEqual]", "k"}], "}"}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\mu_N(k)=\\pi_A\\{L=k\\}"|>|>,
  ExpressionUUID->"56727004-1148-35fd-791d-669498f96046"],
 ".  Then for every function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f"|>|>,ExpressionUUID->
  "1ad760f5-6cbd-d22d-a689-8df037ab6213"],
 " on the nonnegative\nintegers,"
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[Exact loop-count Dirichlet form]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"fa9867e0-7f20-267d-cc81-6aa441e44696"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["A", "TI"]], "(", 
    RowBox[{
     RowBox[{
      StyleBox["f", "TI"], "(", 
      StyleBox["L", "TI"], ")"}], ",", 
     RowBox[{
      StyleBox["f", "TI"], "(", 
      StyleBox["L", "TI"], ")"}]}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox["2", 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "TI"], "\[GreaterEqual]", "1"}],
      LimitsPositioning->True], 
     RowBox[{
      StyleBox["k", "TI"], 
      RowBox[{
       SubscriptBox["\[Mu]", 
        StyleBox["N", "TI"]], "(", 
       StyleBox["k", "TI"], ")"}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           StyleBox["f", "TI"], "(", 
           StyleBox["k", "TI"], ")"}], "-", 
          RowBox[{
           StyleBox["f", "TI"], "(", 
           RowBox[{
            StyleBox["k", "TI"], "-", "1"}], ")"}]}], ")"}], "2"], 
       "."}]}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\mathcal E_A(f(L),f(L))\n =\\frac{2}{3N}\\sum_{k\\ge1}k\\mu_N(k)\
\n       \\bigl(f(k)-f(k-1)\\bigr)^2.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"d5014831-ed49-dc3e-ad3b-8fd70180f2f7"],

