Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPhi]", 
     StyleBox["A", "TI"]], "(", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["N", "TI"]], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"3", 
       RowBox[{
        StyleBox["N", "TI"], "/", "2"}]}], "-", "1"}]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n \\Phi_A(B_N)=\\frac1{3N/2-1}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"d0f8340b-39f9-a73d-7735-e0f3a6701389"],

Cell[TextData[{
 "Equivalently, if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "C_0"|>|>,ExpressionUUID->
  "d2da2713-cfb3-b34b-9ccb-bec5c23df223"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "C_1"|>|>,ExpressionUUID->
  "0f270fe8-86f9-b79f-491f-9285198a9b53"],
 " denote the total half-edge configuration\nweights of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "0"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_0"|>|>,ExpressionUUID->
  "1fcc4cce-6661-281a-a1e3-700ac4c8ffac"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "1"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B_1"|>|>,ExpressionUUID->
  "6127d99d-bd07-a98b-d9c4-b575469010f1"],
 ", respectively, then\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["C", "1"], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", "N"}], "2"], "-", "1"}], ")"}]}], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SubscriptBox["C", "0"], " ", 
     RowBox[{"(", 
      RowBox[{"3", " ", "N"}], ")"}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "(3N/2-1)C_1=(3N/2)C_0"|>|>,
  ExpressionUUID->"8fdb25c2-b6ca-33f1-f7e7-256c9865969a"],
 ".  This identity has been verified only for\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[LessEqual]", "14"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\le14"|>|>,
  ExpressionUUID->"0c55d686-1078-8256-4769-f6f98dcd2d75"],
 "; the preceding proposition proves only its asymptotic consequence."
}], "Conjecture",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{conjecture}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"8ee0e5bd-d28f-6fc0-7be0-bb0f25f49390"],

Cell["\<\
This is a genuine reversible Markov-conductance consequence.  It is distinct
from GDPK's directed outer-conductance, whose volume is cardinality times the
constant outgoing slot count.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"533c8ef1-f3dd-76fd-d1cc-8c9908ebde2f"],

Cell[TextData[{
 "For every fixed ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "3f2f0fb4-63cd-6757-f2e6-246a2927b6d7"],
 ", the ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "0cfe9e67-2416-7461-bc7e-801ae47b3cc3"],
 "th eigenvalue of the reversible normalized\nRule-A Laplacian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], "-", 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["A", "TI"]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "I-P_A"|>|>,
  ExpressionUUID->"729e6a65-3c90-1beb-fac7-8f6c0a5a6d4e"],
 " satisfies"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Increasingly many vanishing Rule-A eigenvalues]", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"ea6b87a3-6017-f93a-3ab1-2dbeadc18c11"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", 
     StyleBox["k", "TI"]], "(", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["A", "TI"]]}], ")"}], "\[LessEqual]", 
