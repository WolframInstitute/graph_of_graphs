Cell[TextData[{
 "For fixed-clock Rule B, the active weights sum to ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"q", "(", "G", ")"}], 
    RowBox[{"3", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)/(3N)"|>|>,
  ExpressionUUID->"6c5b9079-cb51-e8bf-34fd-4f3f3fc7a009"],
 "; the other\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    FractionBox[
     RowBox[{"q", "(", "G", ")"}], 
     RowBox[{"3", " ", "N"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "1-q(G)/(3N)"|>|>,
  ExpressionUUID->"f2ca1e29-f9c6-e55e-c9b3-9e5d47dedcf3"],
 " of the probability is holding.  Thus Rule B replaces the\nordinary carrier \
Laplacian by a source-dependent weighted Laplacian."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"9505e991-2bb0-c86e-2afa-2a38ce4b7895"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Field Bundle and Gauge", "Section",
 TaggingRules-><|
