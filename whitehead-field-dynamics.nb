Cell[TextData[{
 "The canonical fixed-clock Rule-B eigenvalues are obtained by dividing the \
last\nrow in each block by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3N"|>|>,ExpressionUUID->
  "4a06760e-6e32-999d-75f9-386e1832b189"],
 ".  Its second eigenvalues at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "\[LongEqual]", "8"}], ",", "10", ",", "12", ",", 
    "14"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N=8,10,12,14"|>|>,
  ExpressionUUID->"43d1722d-3679-06ab-dc93-b8e0b964cbfc"],
 " are\napproximately ",
 Cell[BoxData[
  FormBox[
   RowBox[{".0128", ",", ".0102", ",", ".0093", ",", ".0079"}], 
   TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> ".0128,.0102,.0093,.0079"|>|>,
  ExpressionUUID->"98e55aa4-5296-5b27-2284-066fc2d3d86b"],
 ".  These finite values do not prove a\nmatching lower bound for the support \
Laplacian."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"e44349e0-2e21-8c0e-769b-5d5d2775852c"]
}, Open  ]],

