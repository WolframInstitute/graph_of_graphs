Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["f", "TI"], "_"], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", 
      StyleBox["N", "TI"]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["k", "TI"], "=", "1"}], 
       StyleBox["N", "TI"],
       LimitsPositioning->True], 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["k", "TI"]]}]}]}], ",", "    ", 
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], "(", 
     StyleBox["f", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "TI"], "=", "1"}], 
      StyleBox["N", "TI"],
      LimitsPositioning->True], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["k", "TI"]], "-", 
        OverscriptBox[
         StyleBox["f", "TI"], "_"]}], ")"}], "2"]}], "\[LongEqual]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["f", "TI"], "-", 
       RowBox[{
        OverscriptBox[
         StyleBox["f", "TI"], "_"], 
        StyleBox["1",
         FontSlant->"Bold"]}]}], "2"], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\bar f=\\frac1N\\sum_{k=1}^N f_k,\n    \\qquad\n    \
\\V(f)=\\sum_{k=1}^N(f_k-\\bar f)^2\n    =\n    \\norm{f-\\bar f\\one}^2.\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"629694e1-dafa-59f1-5d96-3464ff5d702e"],

Cell["\<\
The constants are the consensus subspace.  The variance is the squared distance
from this subspace.\
\>", "Text",
