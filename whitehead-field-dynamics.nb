Cell[TextData[{
 "A move can cross from the bridged to the bridgeless side only by acting on \
the\nunique bridge.  Conversely, let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "\[LongEqual]", "uv"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "e=uv"|>|>,
  ExpressionUUID->"c610d2a7-d8ca-7f65-d7a1-ef15c2f92009"],
 " be the unique bridge and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A,C"|>|>,ExpressionUUID->
  "178eb754-cf76-f11b-b22a-26fe3450ed1a"],
 " be\nthe two components of ",
