Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["N", "TI"], 
      StyleBox["k", "TI"]},
     "Binomial"], 
    FractionBox[
     RowBox[{
      TemplateBox[{
        RowBox[{"3", 
          StyleBox["k", "TI"]}], 
        StyleBox["b", "TI"]},
       "Binomial"], 
      TemplateBox[{
        RowBox[{"3", "(", 
          RowBox[{
            StyleBox["N", "TI"], "-", 
            StyleBox["k", "TI"]}], ")"}], 
        StyleBox["b", "TI"]},
       "Binomial"], 
      RowBox[{
       StyleBox["b", "TI"], "!"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", 
          StyleBox["k", "TI"]}], "-", 
         StyleBox["b", "TI"], "-", "1"}], ")"}], "!!"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{
            StyleBox["N", "TI"], "-", 
            StyleBox["k", "TI"]}], ")"}]}], "-", 
         StyleBox["b", "TI"], "-", "1"}], ")"}], "!!"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", 
         StyleBox["N", "TI"]}], "-", "1"}], ")"}], "!!"}]]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\binom Nk\n \\frac{\\binom{3k}{b}\\binom{3(N-k)}{b}b!\n \
(3k-b-1)!!(3(N-k)-b-1)!!}{(3N-1)!!},\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"c610d2a7-d8ca-7f65-d7a1-ef15c2f92009"],

Cell[TextData[{
 "when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", " ", "k"}], "-", "b"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "3k-b"|>|>,
  ExpressionUUID->"178eb754-cf76-f11b-b22a-26fe3450ed1a"],
 " is even, and zero otherwise.  For fixed ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "B"|>|>,ExpressionUUID->
  "c3ed7c66-d1ca-7106-dcd9-4ac0f3de9116"],
 " and\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", ">", "0"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\varepsilon>0"|>|>,
  ExpressionUUID->"145a9c0d-fe65-f3dc-6d72-b17a7cf20f41"],
 ", the probability of a cut satisfying"
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"409ad32c-fb26-8349-b38a-4780d9a7a81f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Epsilon]", 
