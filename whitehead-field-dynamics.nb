Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["I", "TI"], "-", 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], "\[LongEqual]", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], "-", 
