Cell["\<\
One local operation produces four related but inequivalent objects: the \
carrier field, a fixed-labelled move graph, the multiplicity chain, and the \
simple-support chain.\
\>", "Caption",
 ShowCellBracket->False,
 CellMargins->{{72, 72}, {2, 18}},
