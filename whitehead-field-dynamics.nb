Cell[TextData[{
 "Each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", 
    RowBox[{
     SubscriptBox["i", "s"], " ", 
     SubscriptBox["j", "s"]}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_{i_sj_s}"|>|>,
  ExpressionUUID->"1b8b3af1-efd5-a107-63f6-91f8e89e01ef"],
 " is an orthogonal projection, so norms can only decrease at\neach step.  \
Equality at the end forces equality at every intermediate step.\nFor the step \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "ij"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "A_{ij}"|>|>,
  ExpressionUUID->"c400f87b-a4bd-1289-e4be-562943bb930a"],
 ", equality in the projection identity is exactly\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "i"], "\[LongEqual]", 
    SubscriptBox["f", "j"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f_i=f_j"|>|>,
  ExpressionUUID->"fc6ba255-79b9-d249-e799-a08bf39feab3"],
 " for the vector before that step.  Since previous projections do not\n\
increase norm, the same conclusion propagates along the equality chain."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
