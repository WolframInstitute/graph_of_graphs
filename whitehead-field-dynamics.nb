Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]], ")"}], ":", 
       RowBox[{
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"j", "i"}], "TI"]]}]}], ",", " ", 
      RowBox[{
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox[
         RowBox[{"i", "i"}], "TI"]], "\[LongEqual]", "0"}], ",", " ", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{
          StyleBox["j", "TI"], "\[NotEqual]", 
          StyleBox["i", "TI"]}],
         LimitsPositioning->True], 
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]]}], "\[LongEqual]", "0"}]}], "}"}]}], ",",
    "    ", 
   RowBox[{
    RowBox[{"dim", 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["N", "TI"]]}], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      StyleBox["N", "TI"], "(", 
      RowBox[{
       StyleBox["N", "TI"], "-", "3"}], ")"}], "2"]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n W_N=\\left\\{(a_{ij}):a_{ij}=a_{ji},\\ a_{ii}=0,\\\n              \
   \\sum_{j\\ne i}a_{ij}=0\\right\\},\n \\qquad \\dim W_N=\\frac{N(N-3)}2,\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"dbbee2d1-ee91-912f-2e9b-9736593b2efd"],

Cell[TextData[{
 "put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["F", "a"], "(", "G", ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "<", "j"}]], 
     RowBox[{
      SubscriptBox["a", "ij"], " ", 
      RowBox[{
       SubscriptBox["m", "ij"], "(", "G", ")"}]}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "F_a(G)=\\sum_{i<j}a_{ij}m_{ij}(G)"|>|>,
  ExpressionUUID->"8d8e39fd-97ea-59a5-36da-c253d632a942"],
 ".  There is an absolute ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "C"|>|>,ExpressionUUID->
  "ee7cdbdd-5790-29a4-0a92-97a339389b99"],
 " such that,\nfor all sufficiently large even ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "67d518ba-1984-e04f-3acf-a8b99a4ac826"],
 ","
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"24d30b1a-386a-0b8c-51eb-2158bb237b51"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", 
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["N", "TI"], "(", 
        RowBox[{
         StyleBox["N", "TI"], "-", "3"}], ")"}], "/", "2"}], "+", "1"}]], "(", 
    RowBox[{
     StyleBox["L", "TI"], "(", 
     RowBox[{
      SubscriptBox["\[CapitalGamma]", "lab"], "(", 
      StyleBox["N", "TI"], ")"}], ")"}], ")"}], "\[LessEqual]", 
   RowBox[{
    StyleBox["C", "TI"], "."}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\lambda_{N(N-3)/2+1}\\bigl(L(\\Gamma_{\\rm lab}(N))\\bigr)\\le \
C.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"980c1909-0518-76be-57b1-372ff5d54a09"],

Cell[TextData[{
 "The same number of nonconstant modes have eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"754ce536-92f8-ed9d-e876-31fb76a1211a"],
 " for the\nuniform-clock and normalized simple-neighbour operators."
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"8b1fc21b-c01e-c3bb-2ef4-c8be6028f965"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N"|>|>,ExpressionUUID->
  "420f5aa7-030d-11aa-1bed-783d19d0a61d"],
 " row-sum equations have full rank, which gives the displayed dimension,\n\
and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "727b62fe-334b-8412-f302-16105df9ab7c"],
 " is the irreducible ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      StyleBox["N", "TI"], "-", "2"}], ",", "2"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "[N-2,2]"|>|>,
  ExpressionUUID->"940acdff-05a9-2478-b0a9-62d5c28384cf"],
 " representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S_N"|>|>,ExpressionUUID->
  "2788b07e-ed41-7cd5-032c-e5e71655d023"],
 ".  Both the\nuniform covariance of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "a"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "F_a"|>|>,ExpressionUUID->
  "450d2d8d-2f08-1ceb-c1ff-0dee9e10eb83"],
 " and its simple-edge Dirichlet form are\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "S_N"|>|>,ExpressionUUID->
  "b3549bc2-7dfb-b19c-fe99-b734d6cd3a08"],
 "-invariant, so Schur's lemma makes each a scalar form on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "08200878-64c2-c524-88d3-73314d4392ab"],
 "."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"ad3f52f0-a1a5-ef87-38dc-cb10207f16e6"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "(", "G", ")"}], "\[LongEqual]", 
    SubscriptBox[
     RowBox[{
      SubscriptBox["m", "ij"], "(", "G", ")"}], 
     RowBox[{"i", "<", "j"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "x(G)=(m_{ij}(G))_{i<j}"|>|>,
  ExpressionUUID->"873514e8-066f-22b8-719e-944842aa777c"],
 ".  The trace of the covariance form on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "a7c2d135-1ea9-c2d8-a2a1-b7e26243ea40"],
 " is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], "\[DoubleVerticalBar]", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{"P", "r", "o", "j"}], "TI"], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["N", "TI"]]], 
     RowBox[{
      StyleBox["x", "TI"], "(", 
      StyleBox["G", "TI"], ")"}]}], 
    SuperscriptBox["\[DoubleVerticalBar]", "2"]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "\\E_{U_N}\\|\\operatorname{Proj}_{W_N}x(G)\\|^2"|>|>,
  ExpressionUUID->"3ad53d8d-0d96-0f96-af81-322c003ec198"],
 ".  Since\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "<", "j"}]], 
     SubsuperscriptBox["m", "ij", "2"]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"O", "(", 
      RowBox[{"D", "+", "L"}], ")"}], "+", 
     FractionBox[
      RowBox[{"3", " ", "N"}], "2"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\sum_{i<j}m_{ij}^2=3N/2+O(L+D)"|>|>,
  ExpressionUUID->"fcf5aafc-3880-dd67-0ebd-3dcd9f867ab1"],
 " in expectation, while the trivial and\nstandard projections have bounded \
expected squared norm, division by\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["W", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\dim W_N"|>|>,
  ExpressionUUID->"3916a433-e917-dcb5-ce55-78f88c185812"],
 " gives"
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"45f6921f-d57c-0aef-2d1f-faa7641148f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], 
    SubsuperscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["a", "TI"], "2"]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["3", 
       StyleBox["N", "TI"]], "+", 
      RowBox[{
       StyleBox["O", "TI"], "(", 
       SuperscriptBox[
        StyleBox["N", "TI"], 
        RowBox[{"-", "2"}]], ")"}]}], ")"}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\E_{U_N}F_a^2=\\left(\\frac3N+O(N^{-2})\\right)\\norm{a}^2.\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a22a7e7a-4ab4-b424-d3a3-272b908ba4e2"],

Cell[TextData[{
 "Each raw move changes only four pair coordinates.  Summing the resulting\n\
squared increments over slots and taking the trace on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "W_N"|>|>,ExpressionUUID->
  "8c3e576f-b915-65bb-074f-28959859ee90"],
 " gives simple-edge\nDirichlet energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "2"], " ", 
    RowBox[{"O", "(", 
     FractionBox["1", "N"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})\\norm{a}^2"|>|>,
  ExpressionUUID->"8c472673-8eac-03f4-9aa7-47739f3a98ce"],
 "; invariance again makes the same bound\nuniform over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[Element]", 
    SubscriptBox["W", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "a\\in W_N"|>|>,
  ExpressionUUID->"fa293a8d-60c5-b52d-61d0-7231d2d87107"],
 ".  Its quotient by the covariance is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(1)"|>|>,
  ExpressionUUID->"3fa77350-7f03-c185-58fb-afd49006327e"],
 ", while the\nuniform-clock normalization contributes an additional factor \
",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"6", " ", "N"}]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(6N)^{-1}"|>|>,
  ExpressionUUID->"2dd436b9-7e91-7104-b82b-ea5268aa8f97"],
 "."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"6512c1a0-68cb-f2a3-6a9c-abed75710124"],

Cell[TextData[{
 "For the normalized simple walk the denominator is the invariant form\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], "[", 
    RowBox[{
     RowBox[{
      StyleBox["d", "TI"], "(", 
      StyleBox["G", "TI"], ")"}], 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["a", "TI"]], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["G", "TI"], ")"}], "2"]}], "]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E_{U_N}[d(G)F_a(G)^2]"|>|>,
  ExpressionUUID->"95cc1b37-e29a-434f-e56e-e6f19bbb0761"],
 ".  Its trace is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalTheta]", "(", 
    SuperscriptBox["N", "2"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Theta(N^2)"|>|>,
  ExpressionUUID->"a0039c64-8d50-3a15-96b7-a165830691a9"],
 " because\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[LongEqual]", 
    RowBox[{
     RowBox[{"6", " ", "N"}], "-", "\[Delta]"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "d=6N-\\delta"|>|>,
  ExpressionUUID->"85bdd6ff-ed74-e339-db61-72fce6e2a390"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["E",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["U", "TI"], 
       StyleBox["N", "TI"]]], "\[Delta]"}], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", "1", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E_{U_N}\\delta=O(1)"|>|>,
  ExpressionUUID->"a8b515ca-bab7-a1c8-325e-5136bc462480"],
 ", and\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleVerticalBar]", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{"P", "r", "o", "j"}], "TI"], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["N", "TI"]]], 
     StyleBox["x", "TI"]}], 
    SuperscriptBox["\[DoubleVerticalBar]", "2"], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", 
     StyleBox["N", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "\\|\\operatorname{Proj}_{W_N}x\\|^2=O(N)"|>|>,
  ExpressionUUID->"a7559312-0fb3-fd88-a3a3-1905d0227339"],
 " deterministically.  Hence this form is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "2"], " ", 
    RowBox[{"\[CapitalTheta]", "(", "1", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\Theta(1)\\norm{a}^2"|>|>,
  ExpressionUUID->"d1cd5037-47a1-a131-1dee-bab3de3d23ee"],
 " and the normalized quotient is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"c25878f7-86e7-df22-4939-8e0b16448ea5"],
 ".  Adding the\nconstant function and applying min--max proves all three \
assertions."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"aab3d696-3a71-04fb-1f17-1af8739dfa67"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "\[Tilde]", 
    SubscriptBox["U", "N"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G\\sim U_N"|>|>,
  ExpressionUUID->"1a449be9-5614-b97c-7481-897d5e68de5e"],
 ".  For every fixed ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "d65979ad-1bf6-b0f5-8154-909858b6da1a"],
 ","
}], "Theorem",
 CellDingbat->Cell[
   TextData[{"Theorem ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "theorem", "EnvironmentOpen" -> 
     "\\begin{theorem}[Fixed-radius labelled balls]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"d886680c-6c6c-0fa1-efd2-eca3e9a96a50"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"|", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["B", "TI"], 
      StyleBox["R", "TI"], "lab"], "(", 
     StyleBox["G", "TI"], ")"}], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"6", 
          StyleBox["N", "TI"]}], ")"}], 
        StyleBox["R", "TI"]], 
       RowBox[{
        StyleBox["R", "TI"], "!"}]], "+", 
      RowBox[{
       SubscriptBox[
        StyleBox["O", "TI"], 
        RowBox[{
         StyleBox["P",
          FontSlant->"Plain"], ",", 
         StyleBox["R", "TI"]}]], "(", 
       SuperscriptBox[
        StyleBox["N", "TI"], 
        RowBox[{
         StyleBox["R", "TI"], "-", "1"}]], ")"}]}]}]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["N", "TI"]]], "|", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["B", "TI"], 
      StyleBox["R", "TI"], "lab"], "(", 
     StyleBox["G", "TI"], ")"}], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"6", 
          StyleBox["N", "TI"]}], ")"}], 
        StyleBox["R", "TI"]], 
       RowBox[{
        StyleBox["R", "TI"], "!"}]], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         StyleBox["O", "TI"], 
         StyleBox["R", "TI"]], "(", 
        SuperscriptBox[
         StyleBox["N", "TI"], 
         RowBox[{
          StyleBox["R", "TI"], "-", "1"}]], ")"}], "."}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n |B_R^{\\rm lab}(G)|=\\frac{(6N)^R}{R!}+O_{\\mathbb P,R}(N^{R-1}),\
\n \\qquad\n \\E_{U_N}|B_R^{\\rm lab}(G)|\n =\\frac{(6N)^R}{R!}+O_R(N^{R-1}).\
\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"905fe2f2-292f-dbca-c765-7620147be21b"],

Cell[TextData[{
 "The error estimate is not asserted uniformly for growing ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "3326f007-ff86-bc52-bc9f-beedbe96c998"],
 "."
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{theorem}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"ea42c942-15d4-37bc-120f-e6a8843d03c2"],

Cell[TextData[{
 "Call a raw move ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "16bde720-c296-aa17-1251-e795a1604154"],
 "-good when the radius-",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", " ", "R"}], "+", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(2R+2)"|>|>,
  ExpressionUUID->"d05c9794-2f2d-0dc2-9566-d60f7c95bacd"],
 " carrier neighbourhood of its\ncentral edge has no loop or parallel edge \
and is a tree rooted at that edge.  A\nword is separated if all of these \
neighbourhoods\nare vertex-disjoint.  Standard fixed-subgraph counting in the \
cubic\nconfiguration model ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"janson-random-graphs"],
 ButtonBox["janson-random-graphs",
  BaseStyle->"Citation",
  ButtonData->"janson-random-graphs"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"janson-random-graphs"],
 ", followed by the exact\nloop/double-edge exponential tilt\nto ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "U_N"|>|>,ExpressionUUID->
  "fee3573e-7c1f-cba2-f889-67973eb42149"],
 ", preserves these fixed-radius moment bounds and shows that the\nexpected \
number of non-good raw slots is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "R"], "(", "1", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_R(1)"|>|>,
  ExpressionUUID->"3995be99-fed5-2294-c883-b3740e5ca834"],
 ".  Once fewer than ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "654b4b20-040d-8eba-a404-3da71942d1f4"],
 " separated supports have been chosen, only\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "R"], "(", "1", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_R(1)"|>|>,
  ExpressionUUID->"e9f51efd-49fe-c5c7-953d-09f23067eb95"],
 " of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "befda755-afb7-dc40-b193-c447710233e8"],
 " next raw slots meet one of them.  Hence the expected number\nof ordered \
separated good words is"
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"0fe478b1-bbb1-3be5-bafb-c12ac5d4f1d9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"6", 
       StyleBox["N", "TI"]}], ")"}], 
     StyleBox["R", "TI"]], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["O", "TI"], 
      StyleBox["R", "TI"]], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{
       StyleBox["R", "TI"], "-", "1"}]], ")"}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n (6N)^R+O_R(N^{R-1}),\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a7d64452-c994-0d27-43ee-50c1c217bac5"],

Cell["and the same estimate holds in probability.", "Proof",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"a8c99181-e181-4ecc-39bc-960cd5e15dd7"],

Cell[TextData[{
 "The rewrites in a separated word commute.  In the symmetric difference of \
the\nsource and endpoint edge sets, the affected neighbourhoods are distinct\n\
components; within each, the unchanged central edge is the unique diagonal.\n\
Thus the source--endpoint pair recovers the ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "37429430-4d91-95fc-aee8-29cefd4c3536"],
 " selected moves and their\nresolutions.  Exactly the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "!"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R!"|>|>,ExpressionUUID->
  "50a6e61e-61c9-105e-a94b-fe5e4db95b11"],
 " orders of those commuting moves have the same\nendpoint.  Words with \
repeated or intersecting supports, or with a non-good\nslot, have expected \
count ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "R"], "(", 
    SuperscriptBox["N", 
     RowBox[{"R", "-", "1"}]], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_R(N^{R-1})"|>|>,
  ExpressionUUID->"22b13f18-fa70-e1a0-102f-5b8da517d03f"],
 ", because one free ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "N", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N)"|>|>,
  ExpressionUUID->"793a5b3a-6419-9522-35ad-2fe7325a1665"],
 " choice is\nlost.  Words of length less than ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R"|>|>,ExpressionUUID->
  "85f30e90-3cc5-e155-ff84-efade1a15b56"],
 " have the same lower order.  Dividing the\ngood ordered count by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "!"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R!"|>|>,ExpressionUUID->
  "ff2c3838-9bd5-9872-de9f-77dab7bb3053"],
 " proves the expectation estimate, and Markov's\ninequality applied to the \
exceptional-word count gives the in-probability\nform."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"f5d1af6b-213d-2f48-c4c4-f01724875944"],

Cell["Moreover", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"508d219d-425b-f41c-4cb3-2d8618f719c0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"|", 
    SubsuperscriptBox["\[CapitalOmega]", 
     StyleBox["N", "TI"], "lab"], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], "2"], "+", 
        RowBox[{
         StyleBox["o", "TI"], "(", "1", ")"}]}], ")"}], 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", 
           StyleBox["N", "TI"]}], "-", "1"}], ")"}], "!!"}], 
       SuperscriptBox["6", 
        StyleBox["N", "TI"]]]}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n |\\Omega_N^{\\rm lab}|=(e^2+o(1))\\frac{(3N-1)!!}{6^N},\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"dc1f433b-a22f-ed41-817e-1763b6538eea"],

Cell[TextData[{
 "so maximum degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "20caa46c-949a-e905-ba73-fb606807ba13"],
 " implies\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"diam", " ", 
     RowBox[{
      SubscriptBox["\[CapitalGamma]", "lab"], "(", "N", ")"}]}], "\[GreaterEqual]", 
    RowBox[{"N", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["3", "2"], "-", 
       RowBox[{"o", "(", "1", ")"}]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|
     "SourceTeX" -> "\\diam\\Gamma_{\\rm lab}(N)\\ge(3/2-o(1))N"|>|>,
  ExpressionUUID->"01e57054-0091-5271-ab58-40380276dfa6"],
 ", and the same lower bound holds for\nthe distance between two uniform \
labelled states with high probability."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"e984c892-aa4a-8e4f-1880-b976894f7671"],

Cell[TextData[{
 "For an unlabelled class ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\alpha"|>|>,
  ExpressionUUID->"6b5361f3-0c05-b640-535a-b88be0c27c85"],
 ", put\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["s", "TI"], "\[Alpha]"], "\[LongEqual]", 
     RowBox[{
      RowBox[{
       StyleBox["N", "TI"], "!"}], "/"}]}], "|", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{"A", "u", "t"}], "TI"], 
      StyleBox["v", "TI"]], 
     RowBox[{"(", "\[Alpha]", ")"}]}], "|"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "s_\\alpha=N!/|\\Aut_v(\\alpha)|"|>|>,
  ExpressionUUID->"55b2f0ad-d9cb-41cb-bdc0-db1500efca00"],
 ", and let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]\[Beta]"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}"|>|>,
  ExpressionUUID->"2e46083c-ac35-1787-626d-4a524d3f3e3c"],
 " be the number of\nlabelled simple neighbours of one representative of ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\alpha"|>|>,
  ExpressionUUID->"4f10a592-0584-250e-ab77-088189809421"],
 " lying in orbit\n",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\beta"|>|>,
  ExpressionUUID->"936de2b7-ec20-9854-5a05-fd1ca5759f39"],
 ".  Then"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[Exact orbit quotient]", "Trailing" -> "", 
     "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"6db4ac35-de2f-c5ae-f461-ccc74fc9a3a1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "\[Alpha]"], 
    SubscriptBox[
     StyleBox["b", "TI"], "\[Alpha]\[Beta]"]}], "\[LongEqual]", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "\[Beta]"], 
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], "\[Beta]\[Alpha]"], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n s_\\alpha b_{\\alpha\\beta}=s_\\beta b_{\\beta\\alpha}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ed29feb6-a324-8823-c765-1df8b89774b7"],

Cell[TextData[{
 "The orbit partition is strongly lumpable for the labelled simple-neighbour\n\
walk, with transition ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["b", "\[Alpha]\[Beta]"], 
    SubscriptBox["d", "\[Alpha]"]], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}/d_\\alpha"|>|>,
  ExpressionUUID->"3cb91104-3473-b639-33a6-dd82c406a706"],
 " and stationary mass\nproportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "\[Alpha]"], " ", 
    SubscriptBox["s", "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "s_\\alpha d_\\alpha"|>|>,
  ExpressionUUID->"fabb3af8-cd00-01ca-87f7-f7f726d3b1b8"],
 ".  The uniform-clock walk lumps with\noff-diagonal and diagonal \
transitions"
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"792614b1-5d60-df6c-94bc-c3febad0d8b0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["P", "TI"], "_"], 
      StyleBox["U", "TI"]], "(", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], ")"}], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["b", "TI"], "\[Alpha]\[Beta]"], 
      RowBox[{"6", 
       StyleBox["N", "TI"]}]], "  ", 
     RowBox[{"(", 
      RowBox[{"\[Beta]", "\[NotEqual]", "\[Alpha]"}], ")"}]}]}], ",", "    ", 
   
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["P", "TI"], "_"], 
      StyleBox["U", "TI"]], "(", 
     RowBox[{"\[Alpha]", ",", "\[Alpha]"}], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      RowBox[{"6", 
       StyleBox["N", "TI"]}], "-", 
      SubscriptBox[
       StyleBox["d", "TI"], "\[Alpha]"], "+", 
      SubscriptBox[
       StyleBox["b", "TI"], "\[Alpha]\[Alpha]"]}], 
     RowBox[{"6", 
      StyleBox["N", "TI"]}]]}], ","}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\overline P_U(\\alpha,\\beta)=\\frac{b_{\\alpha\\beta}}{6N}\n \
\\quad(\\beta\\ne\\alpha),\\qquad\n \\overline P_U(\\alpha,\\alpha)\n \
=\\frac{6N-d_\\alpha+b_{\\alpha\\alpha}}{6N},\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"bd02c8cb-93e3-84c4-012d-073d21f6be5b"],

Cell[TextData[{
 "and stationary mass proportional to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "s_\\alpha"|>|>,
  ExpressionUUID->"63a9044b-c5ef-3d5f-cd5f-7b58d46a13d0"],
 ".  The unlabelled simple support records only whether\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "\[Alpha]\[Beta]"], ">", "0"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}>0"|>|>,
  ExpressionUUID->"a7be578a-fc81-d26b-ac9d-61e7eda12e06"],
 " and is not, in general, either Markov quotient."
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"9d828129-4ca9-3f76-dd4c-67aafd548287"],

Cell[TextData[{
 "The symmetric group acts transitively on every orbit and by automorphisms \
of\nthe labelled simple graph, so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]\[Beta]"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}"|>|>,
  ExpressionUUID->"c0a0aae9-5067-c1da-068b-c7b8d5c64a8c"],
 " is representative-independent.\nDouble-counting labelled edges between the \
two orbits gives reciprocity.\nSumming its rows gives the stated lumped \
transition and stationary laws.\nDiscarding the values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "\[Alpha]\[Beta]"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_{\\alpha\\beta}"|>|>,
  ExpressionUUID->"9571df38-4404-1283-174a-b956f1ae3f9e"],
 " retains reachability but not these\nprobabilities."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "EnvironmentClose" -> 
     "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"af0774c4-98d4-d7f8-abde-3ac84377d581"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The unlabelled simple support", "Subsection",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Indent" -> "", "Trailing" -> "", "Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"06c62f92-1059-6f5b-0b38-61280662af88"],

Cell[TextData[{
 "Reciprocity makes the support undirected.  Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "supp"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L_{\\rm supp}"|>|>,
  ExpressionUUID->"c0f6de4e-a794-982b-bd79-364194b2c38c"],
 " be its\ncombinatorial Laplacian and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)"|>|>,
  ExpressionUUID->"502d6bb3-e311-7d8e-fac4-57a6347df804"],
 " be the number of distinct nonself\nneighbours of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "G"|>|>,ExpressionUUID->
  "1f54a546-2024-387a-1761-3bd16290e5c2"],
 ".  Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"q", "(", "G", ")"}], "\[LessEqual]", 
    RowBox[{"3", " ", "N"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)\\le3N"|>|>,
  ExpressionUUID->"e718bf13-4b12-b713-7ffc-aa47f13017f0"],
 ", the fixed-clock kernel"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"2bb9acb9-5613-90a6-7392-cc6d5e01205a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["B", "TI"]], "\[LongEqual]", 
   RowBox[{
    StyleBox["I", "TI"], "-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}]], 
     SubscriptBox[
      StyleBox["L", "TI"], "supp"]}]}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n P_B=I-\\frac1{3N}L_{\\rm supp}\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"4bc35d73-be53-7e37-795b-5d5c923431ae"],

Cell[TextData[{
 "is stochastic.  It is symmetric, so its stationary law is uniform on the\n\
unlabelled classes.  Its eigenvalues are related to those of the unnormalized\
\nsupport Laplacian without any estimate of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)"|>|>,
  ExpressionUUID->"3f330aff-6c2f-c8d2-dfd0-ac9156b2aaa6"],
 ":"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"8c3f0e5a-19d6-94ab-9218-2967d13c074a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", 
     StyleBox["k", "TI"]], "(", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]]}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox["\[Lambda]", 
       StyleBox["k", "TI"]], "(", 
      SubscriptBox[
       StyleBox["L", "TI"], "supp"], ")"}], 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], "."}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\lambda_k(I-P_B)=\\frac{\\lambda_k(L_{\\rm supp})}{3N}.\n\\]", 
     "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"f22236b3-b985-a905-1999-722bc18621a6"],

Cell["\<\
Conditioning this fixed-clock chain on making a nonself move gives the jump
chain\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"e837f59d-e434-467e-8d46-890e990b8001"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["B", "TI"]], "(", 
     RowBox[{
      StyleBox["G", "TI"], ",", 
      StyleBox["H", "TI"]}], ")"}], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       StyleBox["q", "TI"], "(", 
       StyleBox["G", "TI"], ")"}]], "  ", "when", " ", 
     StyleBox["H", "TI"]}], "\[NotEqual]", 
    RowBox[{
     StyleBox["G", "TI"], " ", "and", " ", 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox[
       RowBox[{"G", "H"}], "TI"]]}], ">", "0"}], ",", "    ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Pi]", 
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["B", "TI"]]], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["q", "TI"], "(", 
       StyleBox["G", "TI"], ")"}], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["K", "TI"],
        LimitsPositioning->True], 
       RowBox[{
        StyleBox["q", "TI"], "(", 
        StyleBox["K", "TI"], ")"}]}]], "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n J_B(G,H)=\\frac1{q(G)}\n \\quad\\text{when }H\\ne G\\text{ and \
}m_{GH}>0,\n \\qquad\n \\pi_{J_B}(G)=\\frac{q(G)}{\\sum_Kq(K)}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"0439748f-2f24-2974-9d12-5364273936f4"],

Cell[TextData[{
 "The jump chain traverses the same paths but deletes the state-dependent \
holding\ntimes.  Its spectrum and mixing time need not agree with those of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "B"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "P_B"|>|>,ExpressionUUID->
  "9235e6c2-5a1f-047f-cb86-0ff6e7df00a6"],
 "."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"83d5ebd4-0438-66c3-b726-ca93337ba511"],

Cell["\<\
The repeated-target count remains useful for comparing the jump chain with
Rule A.  Put\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"4910f1f7-1d76-7f7b-3f3d-c31cc8f54434"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], "+"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["H", "TI"], "\[NotEqual]", 
       StyleBox["G", "TI"]}],
      LimitsPositioning->True], 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox[
       RowBox[{"G", "H"}], "TI"]]}]}], ",", "    ", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox[
      StyleBox["C", "TI"], "1", "+"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["H", "TI"], "\[NotEqual]", 
       StyleBox["G", "TI"]}],
      LimitsPositioning->True], 
     RowBox[{
      TemplateBox[{
        SubscriptBox[
         StyleBox["m", "TI"], 
         RowBox[{
           StyleBox["G", "TI"], 
           StyleBox["H", "TI"]}]], "2"},
       "Binomial"], "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n M_+(G)=\\sum_{H\\ne G}m_{GH},\\qquad\n C_1^+(G)=\\sum_{H\\ne \
G}\\binom{m_{GH}}2.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"a820800b-a187-e3ab-0287-074e53c09cf2"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox["C", "1"], ")"}], "+"], "\[InvisibleApplication]", 
    RowBox[{"(", "G", ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "C_1^+(G)"|>|>,
  ExpressionUUID->"d64f4346-6455-f149-ff14-ec1fe2802ef3"],
 " is the number of unordered pairs of distinct nonself Rule-A\nslots that \
have the same target class.  If Rule A is conditioned on making a\nnonself \
move, its row differs from the Rule-B jump row by exactly"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"b11d243d-d0b8-8602-6eb0-9d806e4a84ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Chi]", "2"], "(", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["A", "TI"], "+"], "\[DoubleVerticalBar]", 
     RowBox[{
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["B", "TI"]], "(", 
      RowBox[{
       StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}]}], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       StyleBox["q", "TI"], "(", 
       StyleBox["G", "TI"], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "+"], "(", 
         StyleBox["G", "TI"], ")"}], "+", 
        RowBox[{"2", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["C", "TI"], "1", "+"], "(", 
          StyleBox["G", "TI"], ")"}]}]}], ")"}]}], 
     RowBox[{
      SubscriptBox[
       StyleBox["M", "TI"], "+"], 
      SuperscriptBox[
       RowBox[{"(", 
        StyleBox["G", "TI"], ")"}], "2"]}]], "-", "1."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\chi^2(p_A^+\\Vert J_B(G,\\cdot))\n \
=\\frac{q(G)(M_+(G)+2C_1^+(G))}{M_+(G)^2}-1.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"56b7fe75-95c4-599d-436a-e27e3132e9ac"],

Cell["\<\
This equation says concretely what is lost when repeated Rule-A targets are
collapsed: the discrepancy is determined by the number of pairs of slots that
collide at the same target.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"82e432b8-1aaf-7947-edd1-1ed2f7343851"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"1", "G"},
     "GegenbauerC2"], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", "H"], 
     TemplateBox[{
       SubscriptBox["m", 
        RowBox[{"G", " ", "H"}]], "2"},
      "Binomial"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "C_1(G)=\\sum_H\\binom{m_{GH}}2"|>|>,
  ExpressionUUID->"60432606-bfb0-fd1b-8af9-eb6771924ba6"],
 " includes the self target, Cauchy--Schwarz\nalso gives the exact \
deterministic lower bound"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"cafde8bd-08ad-df88-67b1-f9d6f36fb13a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"q", "(", "G", ")"}], "\[GreaterEqual]", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"3", " ", "N"}], ")"}], "2"], 
     RowBox[{
      RowBox[{"2", " ", 
       TemplateBox[{"1", "G"},
        "GegenbauerC2"]}], "+", 
      RowBox[{"3", " ", "N"}]}]], "-", "1.`"}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n q(G)\\ge\n \\frac{(3N)^2}{3N+2C_1(G)}-1.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"678eb09d-652e-20dd-ef7d-261db42db620"],

Cell[TextData[{
 "Indeed, at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"q", "(", "G", ")"}], "+", "1"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)+1"|>|>,
  ExpressionUUID->"debe686c-c8d8-9a60-c6a8-13cbe8f9663c"],
 " targets, including the self target, have positive\nmultiplicity, while"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"44152b79-8cd8-7d4a-9471-c66ed1a5be0a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["H", "TI"],
     LimitsPositioning->True], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     StyleBox[
      RowBox[{"G", "H"}], "TI"], "2"]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{"3", 
     StyleBox["N", "TI"]}], "+", 
    RowBox[{"2", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["C", "TI"], "1"], "(", 
       StyleBox["G", "TI"], ")"}], "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n \\sum_Hm_{GH}^2=3N+2C_1(G).\n\\]", "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"c77f57a1-3f01-53fc-e99b-72d1039d90c5"],

Cell[TextData[{
 "For a set ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "d48d0e5e-cb00-12ac-2bf3-10ab72d078fd"],
 " of unlabelled classes, let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "X"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_X"|>|>,ExpressionUUID->
  "ab55dbaf-74e2-dd65-afb7-de2b02dfb360"],
 " be the number of undirected\nsupport edges with one endpoint in ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "b2a13604-623d-849c-aa81-8a86e467a307"],
 " and the other in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", "c"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X^c"|>|>,ExpressionUUID->
  "392e7ca0-633e-a2e2-588a-7dbeaaa7ad08"],
 ".  The centered\nmembership function of ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "b771c1af-ed19-5fb5-d397-5e7b4e6853fd"],
 " has the following exact quotient under the\nfixed-clock Rule B:"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"8ad7d0fe-2448-801b-6047-f646bf4e9f1f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["B", "TI"]], "(", 
    StyleBox["X", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["X", "TI"]], 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        TemplateBox[{
          RowBox[{
            StyleBox["X", "TI"]}]},
         "Abs"]], "+", 
       FractionBox["1", 
        TemplateBox[{
          RowBox[{
            SuperscriptBox[
             StyleBox["X", "TI"], 
             StyleBox["c", "TI"]]}]},
         "Abs"]]}], ")"}], "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n R_B(X)=\\frac{b_X}{3N}\n \
\\left(\\frac1{|X|}+\\frac1{|X^c|}\\right).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"c256fc61-eaf7-3eff-aabd-c6f8651815b1"],

Cell[TextData[{
 "There is no degree in this formula.  In comparison, the jump-chain quotient\
\ncontains the degree volumes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "X"], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"G", "\[Element]", "X"}]], 
     RowBox[{"q", "(", "G", ")"}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "V_X=\\sum_{G\\in X}q(G)"|>|>,
  ExpressionUUID->"08f6c0cb-1902-8611-b5c6-4ac5df3fcef6"],
 ":"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"4a73f424-2b60-21cc-b3af-4c26f61297ac"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["B", "TI"]]], "(", 
    StyleBox["X", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["X", "TI"]], "(", 
     RowBox[{
      FractionBox["1", 
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox["X", "TI"]]], "+", 
      FractionBox["1", 
       SubscriptBox[
        StyleBox["V", "TI"], 
        SuperscriptBox[
         StyleBox["X", "TI"], 
         StyleBox["c", "TI"]]]]}], ")"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n R_{J_B}(X)=b_X\\left(\\frac1{V_X}+\\frac1{V_{X^c}}\\right).\n\\]",
      "Separator" -> 
     "\n\n"|>|>,ExpressionUUID->"fa2c7b7c-3545-194e-fc24-71f9c383945a"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "2fb658c5-a3fc-9c04-f694-66d376fe9a07"],
 " be a class property determined by the presence of a fixed short cycle.\n\
Assume both ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X"|>|>,ExpressionUUID->
  "e9e2a45c-ec56-eb41-62c4-f5dbb0f50880"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", "c"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "X^c"|>|>,ExpressionUUID->
  "c4a4ce0d-89a3-8a1e-db75-1b9cf1bfdfcc"],
 " contain at least a fixed positive proportion of all\nunlabelled classes as \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "\[Rule]", "\[Infinity]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N\\to\\infty"|>|>,
  ExpressionUUID->"30723c4c-4fb8-5b90-83be-6395a5bcbba1"],
 ".  Then"
}], "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[What short-cycle cuts imply for fixed-clock Rule \
B]", "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"7c0bd5b6-75d6-2aab-e1a6-ab06147ee2c7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", "2"], "(", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]]}], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     StyleBox["O", "TI"], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{"-", "1"}]], ")"}], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n \\lambda_2(I-P_B)=O(N^{-1}).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"690fefcc-fe34-f648-2acd-056934731c85"],

Cell[TextData[{
 "More generally, fix ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k"|>|>,ExpressionUUID->
  "d6735c8c-c925-f321-a076-c0098c226ee6"],
 ".  Suppose ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k-1"|>|>,ExpressionUUID->
  "3b373b41-f829-8399-47fe-e97b6fb47920"],
 " such class properties have centered\nmembership functions whose \
class-uniform Gram matrix stays nonsingular.  Then"
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"21902956-8d2e-e691-ec1c-deb4a16cf031"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Lambda]", 
     StyleBox["k", "TI"]], "(", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["B", "TI"]]}], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["O", "TI"], 
      StyleBox["k", "TI"]], "(", 
     SuperscriptBox[
      StyleBox["N", "TI"], 
      RowBox[{"-", "1"}]], ")"}], "."}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n \\lambda_k(I-P_B)=O_k(N^{-1}).\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"f5846c54-a054-a512-e4bf-7983f89d4d3a"],

Cell[TextData[{
 "These conclusions require the stated class-count assumptions, but no \
estimate\nof the support degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "(", "G", ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "q(G)"|>|>,
  ExpressionUUID->"895574fe-b3d3-0090-e52a-b3fc1c8ddcb3"],
 "."
}], "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"84cb6b49-c9a5-a761-df02-e4ad631b873b"],

Cell[TextData[{
 "Li's local argument gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["X", "TI"]], "\[LessEqual]", 
     SubscriptBox[
      StyleBox["C", "TI"], 
      StyleBox["X", "TI"]]}], "|", 
    StyleBox["X", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "b_X\\le C_X|X|"|>|>,
  ExpressionUUID->"6342ae64-2e5b-f4e5-2e6a-bef35f3f269d"],
 ": only a bounded number of moves near\na fixed short cycle can destroy the \
last cycle of that length.  The positive\nclass proportions and the displayed \
formula for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "B"], "(", "X", ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R_B(X)"|>|>,
  ExpressionUUID->"78301458-e7b3-313f-5d90-95cd8dd7f6de"],
 " therefore give\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["R", "B"], "(", "X", ")"}], "\[LongEqual]", 
    RowBox[{
     SubscriptBox["O", "X"], "(", 
     FractionBox["1", "N"], ")"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "R_B(X)=O_X(N^{-1})"|>|>,
  ExpressionUUID->"27e849ba-aa2e-f11c-d56f-500c5226c33d"],
 ".  The min--max principle applied to the constant function\nand the \
centered membership function gives the first conclusion."
}], "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"aed287de-8b57-8041-a7cf-64572d7030ee"],

Cell[TextData[{
 "For finitely many class properties, the same boundary argument bounds every\
\ndiagonal and cross Dirichlet form by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["O", "k"], "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O_k(N^{-1})"|>|>,
  ExpressionUUID->"5e29982b-6320-1c84-01c3-4f4322cf68ba"],
 " after class-uniform\nnormalization.  The assumed lower bound on the Gram \
matrix prevents a\nnonconstant linear combination from having vanishing \
variance.  Applying\nmin--max to their span gives the second conclusion."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"54e11012-46db-fdfe-c3ae-d18d4e8f2b1a"],

Cell["\<\
The unresolved input is now explicit: one must count unlabelled classes with
and without the chosen short cycles.  The previous formulation also required
linear lower bounds on the mean support degrees inside every class set.  The
fixed clock removes that unnecessary requirement.\
\>", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"3d105bb0-9db2-0467-db8f-95fa6b646e7d"],

Cell["\<\
Call a carrier edge active when at least one resolution has a nonself target.
Assume Rule B gives positive probability to every support neighbour and every
concrete lift of that transition.  Then\
\>", "Proposition",
 CellDingbat->Cell[
   TextData[{"Proposition ", 
     CounterBox["Theorem"], "."}], FontWeight -> "Bold", FontSlant -> "Plain"],
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proposition", "EnvironmentOpen" -> 
     "\\begin{proposition}[When a Rule-B step has zero field contraction]", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 CounterIncrements->"Theorem",
 FontSlant->Plain,ExpressionUUID->"45c0ef29-1f6d-dd1b-cddc-648647aa338a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"ker", 
    SubsuperscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["G", "TI"], 
     StyleBox["B", "TI"]]}], "\[LongEqual]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       StyleBox["f", "TI"], ":", 
       RowBox[{
        StyleBox["f", "TI"], " ", "is", " ", "constant", " ", "on", " ", 
        "every", " ", "component", " ", "of", " ", "the", " ", "active"}]}], "\[Hyphen]", 
      RowBox[{"edge", " ", "carrier"}]}], "}"}], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\ker L_G^B\n =\\{f:f\\text{ is constant on every component of \
the active-edge carrier}\\}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"89f4239e-3ff1-6ecd-714b-c846eb37e4cc"],

Cell["\<\
The weighted gap is zero exactly when that carrier is disconnected, with
mean-zero kernel dimension one less than its component count.  This is a
statement about the current step.  A later rewrite can change the active
components and restore contraction.\
\>", "Proposition",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proposition}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"7af7aa3c-20a7-2a32-9ec7-90ad9bc1cfb7"],

Cell["\<\
Under the full-support lift rule, an edge has positive averaging weight exactly
when it is active.  Since\
\>", "Proof",
 TaggingRules-><|
  "MathNotebook" -> <|
    "Environment" -> "proof", "EnvironmentOpen" -> "\\begin{proof}", 
     "Trailing" -> "", "BodyIndent" -> "\n", "Separator" -> "\n"|>|>,
 CellFrameLabels->{{None, None}, {None, None}},
 FontSlant->Plain,ExpressionUUID->"f6bd681d-2b53-886a-bccc-58d4c1e24fda"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["f", "TI"], 
      StyleBox["T", "TI"]], 
     SubsuperscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["G", "TI"], 
      StyleBox["B", "TI"]], 
     StyleBox["f", "TI"]}], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["e", "TI"],
      LimitsPositioning->True], 
     RowBox[{
      RowBox[{
       SubsuperscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["G", "TI"], 
        StyleBox["B", "TI"]], "(", 
       StyleBox["e", "TI"], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["j", "TI"]]}], ")"}], "2"]}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n f^TL_G^Bf=\\sum_e p_G^B(e)(f_i-f_j)^2,\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"b6f4bc3a-cd3c-081d-0957-b804a5239635"],

Cell[TextData[{
 "the quadratic form vanishes precisely when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "i"], "\[LongEqual]", 
    SubscriptBox["f", "j"]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "f_i=f_j"|>|>,
  ExpressionUUID->"b9eb354a-b7c4-bb61-fe3e-2ba4440b926e"],
 " along every active edge,\nwhich is equivalent to constancy on each active \
component.  Intersecting this\nkernel with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["1",
     FontSlant->"Bold"], "\[Perpendicular]"], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\one^\\perp"|>|>,
  ExpressionUUID->"a6155bc2-2368-1c23-4108-9d03859132ba"],
 " removes one dimension."
}], "Proof",
 CellDingbat->None,
 TaggingRules-><|
  "MathNotebook" -> <|
    "EnvironmentClose" -> "\n\\end{proof}", "Separator" -> "\n\n"|>|>,
 CounterIncrements->{},
 FontSlant->Plain,ExpressionUUID->"6c00db6b-ccd6-e6fe-31e1-690aefd544ff"],

Cell[TextData[{
 "Finally, multiplicities and self-slots do not change reachability.  Hence \
the\nsimple support has exactly the GDPK support metric and inherits its\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalTheta]", "(", 
    RowBox[{"N", " ", "N", " ", "log"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "\\Theta(N\\log N)"|>|>,
  ExpressionUUID->"468a9667-8ef4-707e-0194-5b1f107c8f79"],
 " diameter order ",
 ButtonBox["[",
  BaseStyle->"Citation",
  ButtonData->"rafi-tao"],
 ButtonBox["rafi-tao",
  BaseStyle->"Citation",
  ButtonData->"rafi-tao"],
 ButtonBox["]",
  BaseStyle->"Citation",
  ButtonData->"rafi-tao"],
 ", even though its path counts\nand random-walk times differ."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"fd30d5ba-0145-8230-6a39-e27f710cdeee"]
}, Open  ]]
}, Open  ]],

