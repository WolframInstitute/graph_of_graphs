  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    L_G=\\sum_{\\{i,j\\}\\in E(G),\\,i\\neq j}\n    \
(e_i-e_j)(e_i-e_j)^T.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"839528f2-b6ce-856d-3c41-b9dd10c1eb65"],

Cell[TextData[{
 "Loops contribute zero to this sum.  Parallel edges are counted with\n\
multiplicity.  If an edge object is chosen uniformly from all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{
     StyleBox["E", "TI"], "(", 
     StyleBox["G", "TI"], ")"}], "|", 
    RowBox[{"\[LongEqual]", 
     RowBox[{"3", 
      RowBox[{
       StyleBox["N", "TI"], "/", "2"}]}]}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "|E(G)|=3N/2"|>|>,
  ExpressionUUID->"83fff51e-6fa9-c80b-cc6e-44a955cbc7c0"],
 "\nedge objects, then"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c2b36fac-8539-4482-9ec0-0d90f1932304"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontSlant->"Plain"], "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox[
         StyleBox["A", "TI"], 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]], 
        StyleBox["f", "TI"]}], "|", 
       StyleBox["G", "TI"]}], ",", 
      StyleBox["f", "TI"]}], "]"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       StyleBox["I", "TI"], "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "|", 
          RowBox[{
           StyleBox["E", "TI"], "(", 
           StyleBox["G", "TI"], ")"}], "|"}]], 
        SubscriptBox[
         StyleBox["L", "TI"], 
         StyleBox["G", "TI"]]}]}], ")"}], 
     StyleBox["f", "TI"]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       StyleBox["I", "TI"], "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"3", 
          StyleBox["N", "TI"]}]], 
        SubscriptBox[
         StyleBox["L", "TI"], 
         StyleBox["G", "TI"]]}]}], ")"}], 
     StyleBox["f", "TI"]}]}], ","}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\E[A_{ij}f\\mid G,f]\n    =\n    \
\\left(I-\\frac{1}{2|E(G)|}L_G\\right)f\n    =\n    \\left(I-\\frac{1}{3N}L_G\
\\right)f,\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"cbbdca7f-3aec-5090-02ec-001adffab844"],

Cell["and", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
