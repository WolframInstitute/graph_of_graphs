Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    RowBox[{
     RowBox[{"log", "(", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}], ")"}], "-", 
     SubscriptBox["\[CapitalDelta]", 
      StyleBox["N", "TI"]]}]}], ",", "    ", 
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     StyleBox["N", "TI"]], "\[LongEqual]", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"3", 
       StyleBox["N", "TI"]}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["G", "TI"],
       LimitsPositioning->True], 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Pi]", 
         StyleBox["A", "TI"]], "(", 
        StyleBox["G", "TI"], ")"}], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         StyleBox["H", "TI"],
         LimitsPositioning->True], 
        RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox[
           RowBox[{"G", "H"}], "TI"]], "log", 
         RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox[
            RowBox[{"G", "H"}], "TI"]], "."}]}]}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n h_N=\\log(3N)-\\Delta_N,\n \\qquad\n \\Delta_N=\\frac1{3N}\\sum_G\
\\pi_A(G)\\sum_Hm_{GH}\\log m_{GH}.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"f3952469-a98d-a6e9-22a7-e5f28ee64e70"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"1", "G"},
     "GegenbauerC2"], "\[LongEqual]", 
    RowBox[{
     UnderscriptBox["\[Sum]", "H"], 
     TemplateBox[{
       SubscriptBox["m", 
        RowBox[{"G", " ", "H"}]], "2"},
      "Binomial"]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "C_1(G)=\\sum_H\\binom{m_{GH}}2"|>|>,
  ExpressionUUID->"4f7a8594-f49b-7173-b259-1b4b3338e6d5"],
 ", then"
}], "Theorem",
 CellDingbat->None,
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 CounterIncrements->{},ExpressionUUID->"ff3f0b74-c8ff-a789-3488-bb298800ea1b"],

Cell[BoxData[
 FormBox[
  RowBox[{"0", "\[LessEqual]", 
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["N", "TI"]], "\[LessEqual]", 
   RowBox[{
    FractionBox["2", 
     RowBox[{"3", 
      StyleBox["N", "TI"]}]], 
    SubscriptBox[
     StyleBox["E",
      FontSlant->"Plain"], 
     SubscriptBox["\[Pi]", 
      StyleBox["A", "TI"]]], 
    RowBox[{
     RowBox[{
      SubscriptBox[
