Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["1", 
     StyleBox["t", "TI"]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["s", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["t", "TI"], "-", "1"}],
      LimitsPositioning->True], 
     RowBox[{"\[CurlyPhi]", "(", 
      SubscriptBox[
       StyleBox["G", "TI"], 
       StyleBox["s", "TI"]], ")"}]}]}], "\[Rule]", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["G", "TI"],
     LimitsPositioning->True], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Pi]", 
       StyleBox["N", "TI"]], "(", 
      StyleBox["G", "TI"], ")"}], 
     RowBox[{"\[CurlyPhi]", "(", 
      StyleBox["G", "TI"], ")"}], "  ", "almost", " ", 
     RowBox[{"surely", "."}]}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n    \\frac1t\\sum_{s=0}^{t-1}\\varphi(G_s)\n    \\to\n    \
\\sum_G\\pi_N(G)\\varphi(G)\n    \\quad\\text{almost surely}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"b8c0a6ef-5d90-aba4-ed05-01c498c2989b"],

Cell["Apply this to the indicator of the good set.", "Proof",
 CellDingbat->None,
