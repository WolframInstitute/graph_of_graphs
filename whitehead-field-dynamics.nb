 FontSlant->Plain,ExpressionUUID->"008035f9-237b-10b6-ce4b-1cfbcb2f1d0b"],

Cell[TextData[{
 "For connected ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", ">", "2"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "N>2"|>|>,ExpressionUUID->
  "93eb0d94-0c56-2c21-295f-64843e435200"],
 ", put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["L", "TI"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "L(G)="|>|>,
  ExpressionUUID->"d8edb4a5-39ed-4593-4c8d-e5e0f571cf8e"],
 " number of loops and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["D", "TI"], "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]"}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "D(G)="|>|>,
  ExpressionUUID->"c642bdbe-1c44-200e-91b3-3f9d3b1cb815"],
 " number of\ndoubled vertex pairs.  Triple edges cannot occur, and exactly"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"4cf42350-d2c4-784c-a871-c9e99dd45d58"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "(", 
    StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    FractionBox[
     SuperscriptBox["6", 
      StyleBox["N", "TI"]], 
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{
        StyleBox["L", "TI"], "(", 
        StyleBox["G", "TI"], ")"}], "+", 
       RowBox[{
        StyleBox["D", "TI"], "(", 
        StyleBox["G", "TI"], ")"}]}]]], "."}]}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> "\\[\n    c(G)=\\frac{6^N}{2^{L(G)+D(G)}}.\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"74c5cc10-981f-670d-a61f-52e200dd0871"],

Cell[TextData[{
 "Under the slot law, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["L", "TI"], ",", 
     StyleBox["D", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "(L,D)"|>|>,
  ExpressionUUID->"644d3879-4010-c7c0-5e97-82709e899a4f"],
 " tends to two independent\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "Pois"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\operatorname{Pois}(1)"|>|>,
  ExpressionUUID->"346b97de-c0e5-0919-c49f-8333fa170c52"],
 " variables; exponential tilting shows that under the\nuniform adjacency law \
it tends to two independent\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "Pois"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\operatorname{Pois}(2)"|>|>,
  ExpressionUUID->"ce004fce-ae0c-31b7-0e93-9a03ab3e5959"],
 " variables.  Hence"
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"cc48e7fa-0354-09e1-befe-1c1860c5bcc7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{
      SubscriptBox["\[Pi]", "slot"], "-", 
      SubscriptBox[
       StyleBox["U", "TI"], 
       StyleBox["N", "TI"]]}], "TV"], "\[LongRightArrow]", 
    SubscriptBox[
     RowBox[{
      RowBox[{
       StyleBox[
        RowBox[{"P", "o", "i", "s"}], "TI"], 
       SuperscriptBox[
        RowBox[{"(", "1", ")"}], 
        RowBox[{"\[CircleTimes]", "2"}]]}], "-", 
      RowBox[{
       StyleBox[
        RowBox[{"P", "o", "i", "s"}], "TI"], 
       SuperscriptBox[
        RowBox[{"(", "2", ")"}], 
        RowBox[{"\[CircleTimes]", "2"}]]}]}], "TV"]}], "\[LongEqual]", 
   RowBox[{"0.4385731106", 
    RowBox[{"\[Ellipsis]", "."}]}]}], TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\norm{\\pi_{\\rm slot}-U_N}_{\\rm TV}\n \\longrightarrow\n \
\\norm{\\operatorname{Pois}(1)^{\\otimes2}\n       -\\operatorname{Pois}(2)^{\
\\otimes2}}_{\\rm TV}\n =0.4385731106\\ldots.\n\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"90564111-c38b-2e3d-0a3b-37d568ba699b"],

Cell[TextData[{
 "Li's good-edge estimate gives the stronger statement\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["E",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["U", "TI"], 
       StyleBox["N", "TI"]]], "\[Delta]"}], "\[LongEqual]", 
    RowBox[{
     StyleBox["O", "TI"], "(", "1", ")"}]}], TraditionalForm]], 
  "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "\\E_{U_N}\\delta=O(1)"|>|>,
  ExpressionUUID->"05561e50-203f-bd21-a04d-b95667bd126e"],
 ", and therefore the simple-neighbour stationary law is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"c4a62bb1-8dbb-b208-7d68-078cd515b903"],
 " in total variation from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "N"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "U_N"|>|>,ExpressionUUID->
  "9dd1e080-ed5d-8a0c-dec0-1f0a0147a01a"],
 ".  Thus the two natural labelled\nwalks remain order-one apart even though \
their rows are typically\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    FractionBox["1", "N"], ")"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "O(N^{-1})"|>|>,
  ExpressionUUID->"62fd361f-fe5c-803d-9185-0facf90aa314"],
 " apart."
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"c176aaa1-9a8b-e761-5e8b-1405adfd02fb"],

Cell[TextData[{
 "More precisely, let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["U", "TI"]], "\[LongEqual]", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     RowBox[{
      RowBox[{
       StyleBox["L", "TI"], "(", 
       SubscriptBox["\[CapitalGamma]", "lab"], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"6", 
        StyleBox["N", "TI"]}], ")"}]}]}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "P_U=I-L(\\Gamma_{\\rm lab})/(6N)"|>|>,
  ExpressionUUID->"f626d002-1d59-df72-a0bc-0c22c91a4433"],
 ", let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "simp"], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "P_{\\rm simp}"|>|>,
  ExpressionUUID->"3594ee6a-929e-2e57-18e7-c050664a420a"],
 " be\nthe simple-neighbour kernel, and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "[", 
    RowBox[{"G", ",", "H"}], "]"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "K(G,H)"|>|>,
  ExpressionUUID->"6dc6a71f-0eca-38e5-98df-47160058cbd3"],
 " be the multiplicity among the\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", " ", "N"}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "6N"|>|>,ExpressionUUID->
  "6af9d8ba-8ce9-6d45-5045-a823ba2e8537"],
 " labelled slots.  Put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "slot"], "(", 
     RowBox[{"G", ",", "H"}], ")"}], "\[LongEqual]", 
    FractionBox[
     RowBox[{"K", "[", 
      RowBox[{"G", ",", "H"}], "]"}], 
     RowBox[{"6", " ", "N"}]]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|
   "MathNotebook" -> <|"SourceTeX" -> "P_{\\rm slot}(G,H)=K(G,H)/(6N)"|>|>,
  ExpressionUUID->"98b4beeb-f858-2ad5-230d-c774638d0e83"],
 ".  With\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["k", "0"], "(", "G", ")"}], "\[LongEqual]", 
    RowBox[{"K", "[", 
     RowBox[{"G", ",", "G"}], "]"}]}], TraditionalForm]], "InlineFormula",
  TaggingRules-><|"MathNotebook" -> <|"SourceTeX" -> "k_0(G)=K(G,G)"|>|>,
  ExpressionUUID->"b4b21cf7-0788-c7bd-e3d6-8b1545927565"],
 ","
}], "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"0f748318-8bd5-3653-534b-ec8ab0bd899c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]", "(", 
     StyleBox["G", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["k", "TI"], "0"], "(", 
      StyleBox["G", "TI"], ")"}], "+", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["H", "TI"], "\[NotEqual]", 
        RowBox[{
         StyleBox["G", "TI"], ":", 
         RowBox[{
          RowBox[{
           StyleBox["K", "TI"], "(", 
           RowBox[{
            StyleBox["G", "TI"], ",", 
            StyleBox["H", "TI"]}], ")"}], ">", "0"}]}]}],
       LimitsPositioning->True], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         StyleBox["K", "TI"], "(", 
         RowBox[{
          StyleBox["G", "TI"], ",", 
          StyleBox["H", "TI"]}], ")"}], "-", "1"}], ")"}]}]}]}], ","}], 
  TraditionalForm]], "DisplayFormula",
 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\delta(G)=k_0(G)+\\sum_{H\\ne G:K(G,H)>0}(K(G,H)-1),\n\\]", 
     "Separator" -> 
     "\n"|>|>,ExpressionUUID->"818bf529-2e77-d526-53c8-dfe08267183f"],

Cell["and direct summation gives", "Text",
 TaggingRules-><|"MathNotebook" -> <|"Separator" -> "\n"|>|>,
 FontSlant->Plain,ExpressionUUID->"63acbd58-19f5-7833-35da-40810cc0fb39"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], "simp"], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}], "-", 
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["U", "TI"]], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}]}], "TV"], "\[LongEqual]", 
    FractionBox[
     RowBox[{"\[Delta]", "(", 
      StyleBox["G", "TI"], ")"}], 
     RowBox[{"6", 
      StyleBox["N", "TI"]}]]}], ",", "    ", 
   RowBox[{
    SubscriptBox[
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], "slot"], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}], "-", 
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["U", "TI"]], "(", 
       RowBox[{
        StyleBox["G", "TI"], ",", "\[CenterDot]"}], ")"}]}], "TV"], "\[LessEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Delta]", "(", 
       StyleBox["G", "TI"], ")"}], 
      RowBox[{"6", 
       StyleBox["N", "TI"]}]], "."}]}]}], TraditionalForm]], "DisplayFormula",\

 TaggingRules-><|
  "MathNotebook" -> <|
    "SourceTeX" -> 
     "\\[\n \\norm{P_{\\rm simp}(G,\\cdot)-P_U(G,\\cdot)}_{\\rm TV}\n   \
=\\frac{\\delta(G)}{6N},\\qquad\n \\norm{P_{\\rm \
slot}(G,\\cdot)-P_U(G,\\cdot)}_{\\rm TV}\n   \\le\\frac{\\delta(G)}{6N}.\n\
\\]", "Separator" -> 
     "\n"|>|>,ExpressionUUID->"ec09e169-e49c-03ca-8f30-a1f1a0e9c944"],

