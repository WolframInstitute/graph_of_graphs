Cell["\<\
The sum and therefore the mean are unchanged. Applied to the centered field, \
the identity is an exact Lyapunov law.\
\>", "Text",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|"ID" -> "VarianceIntro", "Generated" -> True|>|>,
