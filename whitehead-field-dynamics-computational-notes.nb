  Cell["What is being computed", "Section", TaggingRules -> 
    <|"GoGComputationalNotes" -> <|"ID" -> "SectionObjects", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "SectionObjects"}, ExpressionUUID -> 
    "5a5e9180-8090-0838-1778-454ba08f47cc"], Cell["A cubic multigraph is a \
graph in which every vertex has degree three; loops count twice toward the \
degree, and parallel edges are allowed. A graph type is an isomorphism class \
obtained after vertex labels are forgotten. The graph of graphs (GoG) has one \
vertex for each connected graph type and joins two types when one Whitehead \
move relates them. Such a move selects a carrier edge, meaning a specific \
edge in a chosen representative, collapses it, and chooses one of the two \
other pairings of the four exposed half-edges. A field f in R^N travels with \
the graph; on a carrier with endpoints i and j, those values are replaced by \
their common mean.", "Text", TaggingRules -> 
    <|"GoGComputationalNotes" -> <|"ID" -> "ObjectsIntro", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "ObjectsIntro"}, ExpressionUUID -> 
    "e6943ffd-ca02-03f9-6657-e220bc35e090", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], 
  Cell[BoxData[FormBox[RowBox[{RowBox[{"(", SubscriptBox["f", "i"], ",", 
         SubscriptBox["f", "j"], ")"}], "\[LongRightArrow]", 
       RowBox[{"(", FractionBox[RowBox[{SubscriptBox["f", "i"], "+", 
            SubscriptBox["f", "j"]}], "2"], ",", FractionBox[
          RowBox[{SubscriptBox["f", "i"], "+", SubscriptBox["f", "j"]}], 
          "2"], ")"}]}], TraditionalForm]], "DisplayFormula", 
   TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "FieldUpdateFormula", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "FieldUpdateFormula"}, 
   ExpressionUUID -> "9cc502c1-0ba5-f321-7112-0289d20fb07c", 
   ShowCellBracket -> False, TextAlignment -> Center, FontSize -> 15], 
  Cell["Three computational objects must be kept separate.", "Text", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "ObjectsListIntro", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "ObjectsListIntro"}, ExpressionUUID -> 
    "16881b76-a257-711c-598d-17fdaeb7fac8", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], Cell["The carrier field uses the concrete \
selected edge. After an unlabelled move, a settlement permutation is the \
relabelling that identifies the result with the stored representative of its \
graph type; the same permutation is applied to the field coordinates.", 
   "ItemNumbered", TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "ObjectCarrier", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "ObjectCarrier"}, 
   ExpressionUUID -> "96640e76-8c7c-3fb2-3d45-6d5ad55fb3f5", FontSize -> 12], 
  Cell["Rule A keeps every local outcome slot after labels are forgotten. A \
cubic graph has 3N/2 edges and two resolutions per edge, hence 3N slots. \
Different slots leading to the same type retain their multiplicity. A slot \
returning to the current type is a holding event.", "ItemNumbered", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "ObjectRuleA", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "ObjectRuleA"}, ExpressionUUID -> 
    "bb43c14b-97ec-4744-9ff2-68a3688e620f", FontSize -> 12], 
  Cell["Rule B gives one of the 3N equally weighted slots to each different \
adjacent graph type and assigns every unused slot to staying put. Its jump \
chain, called BJump in the code, is the conditional chain given that the \
graph type changes; removing the holds changes path probabilities and elapsed \
time.", "ItemNumbered", TaggingRules -> 
    <|"GoGComputationalNotes" -> <|"ID" -> "ObjectRuleB", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "ObjectRuleB"}, ExpressionUUID -> 
    "f3667e76-2339-dedf-1b39-ee490e6c2e88", FontSize -> 12], 
  Cell["The local package contains every graph type, every one-move \
connection, and the exact transition counts for N=2,4,6,8. The N=8 model \
already has 71 states; larger data sets can be generated separately.", 
   "Text", TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "ObjectsBoundary", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "ObjectsBoundary"}, 
   ExpressionUUID -> "6f835564-e174-9118-9abf-acc258354430", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], Cell["The graph of graphs", "Section", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "SectionVisualMap", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "SectionVisualMap"}, ExpressionUUID -> 
    "8abc9dad-6384-9a30-691b-38ebc0e260b0"], Cell["A GoG vertex represents an \
entire graph type, not one vertex of the underlying cubic multigraph. The \
small N=4 atlas makes this distinction visible: its five GoG vertices are \
shown together with the five cubic multigraphs they represent.", "Text", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "VisualMapIntro", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "VisualMapIntro"}, ExpressionUUID -> 
    "650e708c-193d-6dc1-2e6c-41b437809161", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], 
