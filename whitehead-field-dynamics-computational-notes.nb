Cell[CellGroupData[{

Cell["What is being computed", "Section",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "SectionObjects", "Generated" -> True|>|>,
 CellTags->{
  "GoGComputationalNotes", 
   "SectionObjects"},ExpressionUUID->"16881b76-a257-711c-598d-17fdaeb7fac8"],

Cell["\<\
The state space consists of isomorphism classes of connected cubic \
multigraphs on an even number N of vertices; loops and parallel edges are \
allowed. A Whitehead move selects a carrier edge, collapses it, and chooses \
one of the two other pairings of the four exposed half-edges. A scalar field \
f in R^N is carried along with the graph. If the selected edge has endpoints \
i and j, their values are replaced by their common mean.\
\>", "Text",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|"ID" -> "ObjectsIntro", "Generated" -> True|>|>,
 LineSpacing->{1.15, 2},
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "ObjectsIntro"},ExpressionUUID->"96640e76-8c7c-3fb2-3d45-6d5ad55fb3f5"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["f", "i"], ",", 
      SubscriptBox["f", "j"]}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["f", "i"], "+", 
         SubscriptBox["f", "j"]}], ")"}]}], ",", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["f", "i"], "+", 
         SubscriptBox["f", "j"]}], ")"}]}]}], "}"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 ShowCellBracket->False,
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "FieldUpdateFormula", "Generated" -> True|>|>,
 TextAlignment->Center,
 FontSize->15,
 CellTags->{
  "GoGComputationalNotes", 
   "FieldUpdateFormula"},ExpressionUUID->"f5c10e52-e82f-d31f-e27b-\
430ef128516b"],

Cell["Three computational objects must be kept separate.", "Text",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "ObjectsListIntro", "Generated" -> True|>|>,
 LineSpacing->{1.15, 2},
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "ObjectsListIntro"},ExpressionUUID->"bb43c14b-97ec-4744-9ff2-68a3688e620f"],

Cell["\<\
The carrier field uses a concrete edge and, after an unlabelled move, a \
settlement permutation for its coordinates.\
\>", "ItemNumbered",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|"ID" -> "ObjectCarrier", "Generated" -> True|>|>,
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "ObjectCarrier"},ExpressionUUID->"f3667e76-2339-dedf-1b39-ee490e6c2e88"],

Cell["\<\
Rule A is the quotient chain that retains all 3N compressed resolution slots, \
including multiplicity and holding slots.\
\>", "ItemNumbered",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|"ID" -> "ObjectRuleA", "Generated" -> True|>|>,
 
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "ObjectRuleA"},ExpressionUUID->"6f835564-e174-9118-9abf-acc258354430"],

Cell["\<\
Fixed-clock Rule B gives one of the same 3N ticks to each distinct nonself \
quotient neighbour and turns unused ticks into holds. BJump is Rule B \
conditioned on moving and is a different chain.\
\>", "ItemNumbered",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|"ID" -> "ObjectRuleB", "Generated" -> True|>|>,
 
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "ObjectRuleB"},ExpressionUUID->"8abc9dad-6384-9a30-691b-38ebc0e260b0"],

Cell["\<\
The interactive laboratory in whitehead-field-dynamics.nb bundles complete \
quotient data only for N=2,4,6. Larger finite tables come from the Python \
enumeration pipeline and are not part of the compact notebook resource.\
\>", "Text",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "ObjectsBoundary", "Generated" -> True|>|>,
