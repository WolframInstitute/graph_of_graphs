      {{RowBox[{SubscriptBox["p", "t"], "=", SuperscriptBox[
           SubscriptBox["e", RowBox[{"G", "1"}]], "T"], SuperscriptBox["P", 
           "t"]}]}, {RowBox[{SubscriptBox["p", RowBox[{"t", "+", "1"}]], "=", 
          SubscriptBox["p", "t"], "P", ",", UnderscriptBox["\[Sum]", 
           RowBox[{"g", "\[Element]", SubscriptBox["\[ScriptCapitalG]", 
              "4"]}]], RowBox[{SubscriptBox["p", "t"], "(", "g", ")"}], "=", 
          "1"}]}}, GridBoxAlignment -> {"Columns" -> {{Center}}}, 
      GridBoxSpacings -> {"Rows" -> {{0.7}}}], TraditionalForm]], 
   "DisplayFormula", TaggingRules -> <|"GoGComputationalNotes" -> 
