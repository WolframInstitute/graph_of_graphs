   FontSize -> 16, CellMargins -> {{48, 48}, {2, 8}}], 
  Cell["Alexander Kolpakov  \[CenterDot]  September 2026", "Text", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "Byline", 
