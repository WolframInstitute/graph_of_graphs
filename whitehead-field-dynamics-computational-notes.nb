   RowBox[{"First", "[", 
    RowBox[{"NullSpace", "[", 
     RowBox[{
      TemplateBox[{"pA"},
       "Transpose"], "-", 
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{"Length", "[", "pA", "]"}], "]"}]}], "]"}], "]"}]}], ";", 
  FractionBox["piA", 
   RowBox[{"Total", "[", "piA", "]"}]]}]], "Input",
