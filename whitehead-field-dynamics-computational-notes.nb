     GeneratedCell -> True, CellAutoOverwrite -> True]}, Open], 
  Cell["The distribution is nonuniform because graph types with different \
numbers of labelled realizations receive different weights. Treating Rule A \
as uniform on graph types would change the process.", "Text", 
   TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "StationaryMeaning", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "StationaryMeaning"}, 
   ExpressionUUID -> "ae79dd22-c8a3-d802-edd8-b0b0fea64a04", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], Cell["Rule B assigns weight 1/(3N) to each \
adjacent graph type and puts the unused probability on the diagonal. Its \
support graph keeps one edge whenever a nonself move is possible and discards \
all multiplicities; L_supp below is the Laplacian of that simple graph.", 
   "Text", TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "RuleBIntro", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "RuleBIntro"}, 
   ExpressionUUID -> "5a59dca9-d7e5-67c8-a2bd-a325008cbc7e", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], 
  Cell[BoxData[FormBox[GridBox[
      {{RowBox[{RowBox[{SubscriptBox["P", "B"], "(", "g", ",", "h", ")"}], 
          "=", FractionBox["1", RowBox[{"3", "N"}]], ",", 
          RowBox[{"g", "\[Tilde]", "h"}], ",", RowBox[{"g", "\[NotEqual]", 
            "h"}]}]}, {RowBox[{RowBox[{SubscriptBox["P", "B"], "(", "g", ",", 
            "g", ")"}], "=", "1", "-", FractionBox[
           RowBox[{"deg", "(", "g", ")"}], RowBox[{"3", "N"}]]}]}, 
       {RowBox[{"I", "-", SubscriptBox["P", "B"], "=", 
          FractionBox[SubscriptBox["L", "supp"], RowBox[{"3", "N"}]]}]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, 
      GridBoxSpacings -> {"Rows" -> {{0.7}}}], TraditionalForm]], 
