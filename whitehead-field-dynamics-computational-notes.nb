Cell["\<\
Pair averages on disjoint edges commute, so a perfect matching is one block. \
Two matching layers on K4 and three coordinate matchings on Q3 give exact \
finite consensus.\
\>", "Text",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "ConsensusIntro", "Generated" -> True|>|>,
 LineSpacing->{1.15, 2},
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "ConsensusIntro"},ExpressionUUID->"338065fe-8bd6-5a53-51ec-8511e28139c4"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SubscriptBox["J", "4"], "\[LongEqual]", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       FractionBox["1", "4"], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "\[And]", 
    RowBox[{
     SubscriptBox["J", "8"], "\[LongEqual]", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       FractionBox["1", "8"], ",", 
       RowBox[{"{", 
        RowBox[{"8", ",", "8"}], "}"}]}], "]"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 ShowCellBracket->False,
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "ConsensusFormula", "Generated" -> True|>|>,
