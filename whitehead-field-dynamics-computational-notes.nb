Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y"}], "]"}], ";", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"x", "+", "y"}], "2"], ")"}], "2"]}]}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}]}], "]"}]}]], "Input",
 CellFrame->True,
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "pair-lossInput", "Generated" -> True|>|>,
 InitializationCell->False,
 CellFrameMargins->{{9, 9}, {8, 8}},
 CellFrameStyle->Directive[
   RGBColor[0.82, 0.85, 0.88], 
   AbsoluteThickness[1]],
 FontSize->11,
 Background->RGBColor[0.965, 0.975, 0.985],
 CellTags->{
  "GoGComputationalNotes", 
   "pair-lossInput"},ExpressionUUID->"362a8e51-7b51-7436-024f-f5b9a009de4a"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x", "-", "y"}], ")"}], "2"]}]], "Output",
 CellFrame->True,
 TaggingRules-><|
