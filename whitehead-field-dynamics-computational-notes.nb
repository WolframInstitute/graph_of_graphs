  "GoGComputationalNotes", 
   "ConsensusFormula"},ExpressionUUID->"76a9e2f7-b970-46b7-4d38-d021e12ae473"],

Cell[TextData[{
 StyleBox["MATHEMATICA CELLS: ",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0.45, 0.7]],
 "matching products"
}], "Text",
 ShowCellBracket->False,
 CellMargins->{{48, 48}, {12, 3}},
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "matching-productsHeading", "Generated" -> True|>|>,
 TextAlignment->Center,
 FontSize->10,
 FontColor->RGBColor[0.37, 0.42, 0.49],
 CellTags->{
  "GoGComputationalNotes", 
   "matching-productsHeading"},ExpressionUUID->"60cfc059-fb44-7d82-0261-\
4c2d8bf38a3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"matching", "[", 
    RowBox[{"n_", ",", "edges_"}], "]"}], ":=", 
   RowBox[{"Dot", "@@", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"pairAverage", "[", 
        RowBox[{"n", ",", "#1"}], "]"}], "&"}], ")"}], "/@", "edges"}]}]}], ";", 
  RowBox[{"k4Word", "=", 
   RowBox[{
    RowBox[{"matching", "[", 
     RowBox[{"4", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"matching", "[", 
     RowBox[{"4", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{"q3Word", "=", 
   RowBox[{
    RowBox[{"matching", "[", 
     RowBox[{"8", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "8"}], "}"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"matching", "[", 
     RowBox[{"8", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "8"}], "}"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"matching", "[", 
     RowBox[{"8", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}]}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"k4Word", "===", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       FractionBox["1", "4"], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"q3Word", "===", 
     RowBox[{"ConstantArray", "[", 
