  Cell["All five classes are reachable by time four, but the mass is far from \
the stationary vector. From the same starting point, Rule B retains much more \
probability at G1 because it more often stays in place.", "Text", 
   TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "DiffusionComparisonIntro", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "DiffusionComparisonIntro"}, 
