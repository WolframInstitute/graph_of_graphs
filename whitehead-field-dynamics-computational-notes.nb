                  "[", "repo", "]"}]}], "||", RowBox[{"!", RowBox[
                 {"DirectoryQ", "[", RowBox[{"FileNameJoin", "[", RowBox[
                     {"{", RowBox[{"repo", ",", "\"Wolfram\"", ",", 
                        "\"GogFieldDynamics\""}], "}"}], "]"}], "]"}]}]}], 
            ",", RowBox[{"repo", "=", RowBox[{"Directory", "[", "]"}]}]}], 
          "]"}], ";", RowBox[{"PacletDirectoryLoad", "[", 
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"repo", ",", 
                "\"Wolfram\"", ",", "\"GogFieldDynamics\""}], "}"}], "]"}], 
          "]"}], ";", RowBox[{"Needs", "[", "\"GogFieldDynamics`\"", "]"}], 
