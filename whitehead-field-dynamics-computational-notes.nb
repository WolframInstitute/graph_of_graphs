Cell[CellGroupData[{

Cell["The local averaging calculation", "Section",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "SectionLocalAverage", "Generated" -> True|>|>,
 CellTags->{
  "GoGComputationalNotes", 
   "SectionLocalAverage"},ExpressionUUID->"f803b24c-75d6-1c7c-7f7d-\
5586bff19f47"],

Cell["\<\
For a non-loop pair {i,j}, the averaging matrix is the orthogonal projection \
onto the hyperplane f_i=f_j.\
\>", "Text",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|"ID" -> "AverageIntro", "Generated" -> True|>|>,
 LineSpacing->{1.15, 2},
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "AverageIntro"},ExpressionUUID->"63cd1b71-0e92-3114-41c0-d0c70f5913d6"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["A", 
     RowBox[{"i", ",", "j"}]], "\[LongEqual]", 
    RowBox[{
     SubscriptBox["identity", "n"], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["e", "i"], "-", 
        SubscriptBox["e", "j"]}], ")"}], " ", 
      TemplateBox[{
        RowBox[{
          SubscriptBox["e", "i"], "-", 
          SubscriptBox["e", "j"]}], "T"},
       "Superscript"]}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 ShowCellBracket->False,
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "AverageMatrixFormula", "Generated" -> True|>|>,
 TextAlignment->Center,
 FontSize->15,
 CellTags->{
  "GoGComputationalNotes", 
   "AverageMatrixFormula"},ExpressionUUID->"c042d5a1-7668-f20f-fc27-\
809a72232769"],

Cell["\<\
It is symmetric, idempotent, and fixes the all-ones vector. The \
two-coordinate energy calculation can be checked without constructing the \
whole matrix.\
\>", "Text",
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "AverageProperties", "Generated" -> True|>|>,
 LineSpacing->{1.15, 2},
 FontSize->12,
 CellTags->{
  "GoGComputationalNotes", 
   "AverageProperties"},ExpressionUUID->"a9e79bb6-57e5-b3b7-2cf5-\
ea3d1dd88b05"],

Cell[TextData[{
 StyleBox["MATHEMATICA CELLS: ",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0.45, 0.7]],
