  Cell["Every row sums to 3N=12. Dividing the count matrix by 12 gives the \
exact Rule-A transition matrix. It is not symmetric.", "Text", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "RuleAMatrixText", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "RuleAMatrixText"}, ExpressionUUID -> 
    "cf6ebdbe-4352-c18c-a5ce-c8268f7f405d", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], 
