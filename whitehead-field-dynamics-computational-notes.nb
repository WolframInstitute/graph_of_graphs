   TextAlignment -> Left, FontColor -> RGBColor[0.37, 0.42, 0.49], 
   FontSize -> 10, CellMargins -> {{48, 48}, {2, 18}}], 
  Cell["This notebook accompanies \
whitehead-field-dynamics-computational-notes.tex. It contains the exact \
calculations used in that note, together with drawings of the graph-of-graphs \
models, an interactive view of the cubic multigraph represented by each \
state, and an exact 71-state diffusion calculation. Proofs remain in the full \
LaTeX manuscript.", "Text", TaggingRules -> 
    <|"GoGComputationalNotes" -> <|"ID" -> "Abstract", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "Abstract"}, ExpressionUUID -> "637bfb47-a8b7-4d84-e256-763e733c6166", 
   FontSize -> 12, LineSpacing -> {1.15, 2}], Cell["Start here", "Section", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "SectionSetup", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "SectionSetup"}, ExpressionUUID -> 
    "e4581535-6516-b3cc-6985-1541b5e473d5"], Cell["Keep this file in the \
repository root and choose Evaluation > Evaluate Notebook. The first cell \
loads the local GogFieldDynamics package; no global installation is needed. \
SetReplace is optional.", "Text", TaggingRules -> 
    <|"GoGComputationalNotes" -> <|"ID" -> "SetupGuide", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "SetupGuide"}, ExpressionUUID -> "46d8de8c-c466-768e-ac8c-bf59592516b9", 
   FontSize -> 12, LineSpacing -> {1.15, 2}], 
  Cell[TextData[{StyleBox["Load the companion package", FontWeight -> "Bold", 
      FontColor -> RGBColor[0.075, 0.13, 0.22]]}], "Text", 
   TaggingRules -> <|"GoGComputationalNotes" -> <|"ID" -> "setupHeading", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "setupHeading"}, ExpressionUUID -> 
    "4486bec3-2f90-a083-58e6-7be0232ea799", ShowCellBracket -> False, 
   CellMargins -> {{48, 48}, {14, 4}}, TextAlignment -> Left, 
   FontSize -> 11], CellGroupData[
   {Cell[BoxData[RowBox[{RowBox[{"repo", "=", RowBox[{"Quiet", "[", 
            RowBox[{"Check", "[", RowBox[{RowBox[{"NotebookDirectory", "[", 
                  "]"}], ",", "$Failed"}], "]"}], "]"}]}], ";", 
