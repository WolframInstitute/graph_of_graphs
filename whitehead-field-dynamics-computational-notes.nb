Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pairAverage", "[", 
    RowBox[{"n_", ",", 
     RowBox[{"{", 
      RowBox[{"i_", ",", "j_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "i"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"j", ",", "i"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"j", ",", "j"}], "}"}], "\[Rule]", 
        FractionBox["1", "2"]}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{"a", "=", 
   RowBox[{"pairAverage", "[", 
    RowBox[{"4", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"SymmetricMatrixQ", "[", "a", "]"}], ",", 
    RowBox[{
     RowBox[{"a", ".", "a"}], "===", "a"}], ",", 
    RowBox[{
     RowBox[{"a", ".", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"1", ",", "4"}], "]"}]}], "===", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", "4"}], "]"}]}]}], "}"}]}]], "Input",
 CellFrame->True,
