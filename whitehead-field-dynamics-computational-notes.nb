Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"V", "(", 
     RowBox[{
      SubscriptBox["A", 
       RowBox[{"i", ",", "j"}]], " ", "f"}], ")"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"V", "(", "f", ")"}], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["f", "i"], "-", 
         SubscriptBox["f", "j"]}], ")"}], "2"]}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
