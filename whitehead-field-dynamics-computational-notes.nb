 FontColor->RGBColor[0.37, 0.42, 0.49],
 CellTags->{
  "GoGComputationalNotes", 
   "self-testHeading"},ExpressionUUID->"3ee6cc00-fea2-74d8-da1b-67130fe8845d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"miniNotebookChecks", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<PacletLoaded\>\"", "\[Rule]", 
      RowBox[{"NameQ", "[", "\"\<GogFieldDynamics`GogSmallModel\>\"", "]"}]}],
      ",", 
     RowBox[{"\"\<AvailableSizes\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"GogAvailableSizes", "[", "]"}], "===", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4", ",", "6"}], "}"}]}]}], ",", 
     RowBox[{"\"\<ModelsValidate\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"GogValidateSmallModels", "[", "]"}], "[", "\"\<Valid\>\"", 
        "]"}], "]"}]}], ",", 
     RowBox[{"\"\<PairLoss\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          SuperscriptBox["x", "2"], "+", 
          SuperscriptBox["y", "2"], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"x", "+", "y"}], "2"], ")"}], "2"]}]}], ",", 
         RowBox[{"Assumptions", "\[Rule]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "\[Element]", 
           TemplateBox[{},
            "Reals"]}]}]}], "]"}], "===", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}], "2"]}]}]}], ",", 
     RowBox[{"\"\<Projection\>\"", "\[Rule]", 
      RowBox[{"And", "@@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SymmetricMatrixQ", "[", "a", "]"}], ",", 
         RowBox[{
          RowBox[{"a", ".", "a"}], "===", "a"}], ",", 
         RowBox[{
          RowBox[{"a", ".", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", "4"}], "]"}]}], "===", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", "4"}], "]"}]}]}], "}"}]}]}], ",", 
     RowBox[{"\"\<RuleARowSums\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"Total", "/@", 
        RowBox[{"GogTransitionCounts", "[", 
         RowBox[{"4", ",", "\"\<A\>\""}], "]"}]}], "===", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"12", ",", "5"}], "]"}]}]}], ",", 
     RowBox[{"\"\<RuleBUniform\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"SymmetricMatrixQ", "[", "pB", "]"}], "&&", 
       RowBox[{
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           FractionBox["1", "5"], ",", "5"}], "]"}], ".", "pB"}], "===", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          FractionBox["1", "5"], ",", "5"}], "]"}]}]}]}], ",", 
     RowBox[{"\"\<DiffusionMass\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", "p4A", "]"}], "===", "1"}], "&&", 
       RowBox[{
        RowBox[{"Total", "[", "p4B", "]"}], "===", "1"}]}]}], ",", 
     RowBox[{"\"\<SeededTrajectory\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"GogRandomTrajectory", "[", 
        RowBox[{"4", ",", "\"\<A\>\"", ",", "1", ",", "12", ",", "2026"}], 
        "]"}], "===", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", "3", ",", "1", ",", "3", ",", "3", ",", "3", ",", "3", ",", 
         "5", ",", "3", ",", "1", ",", "2", ",", "2", ",", "1"}], "}"}]}]}], ",", 
     RowBox[{"\"\<FiniteConsensus\>\"", "\[Rule]", 
      RowBox[{
       RowBox[{"k4Word", "===", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          FractionBox["1", "4"], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "&&", 
       RowBox[{"q3Word", "===", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          FractionBox["1", "8"], ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "8"}], "}"}]}], "]"}]}]}]}]}], "]"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<AllTestsPassed\>\"", "\[Rule]", 
     RowBox[{"And", "@@", 
      RowBox[{"Values", "[", "miniNotebookChecks", "]"}]}]}], ",", 
    RowBox[{"\"\<Checks\>\"", "\[Rule]", "miniNotebookChecks"}]}], 
   "]"}]}]], "Input",
 CellFrame->True,
 TaggingRules-><|
  "GoGComputationalNotes" -> <|
    "ID" -> "self-testInput", "Generated" -> True|>|>,
 InitializationCell->False,
 CellFrameMargins->{{9, 9}, {8, 8}},
 CellFrameStyle->Directive[
   RGBColor[0.82, 0.85, 0.88], 
   AbsoluteThickness[1]],
 FontSize->11,
 Background->RGBColor[0.965, 0.975, 0.985],
 CellTags->{
  "GoGComputationalNotes", 
   "self-testInput"},ExpressionUUID->"618e848a-76c4-ca69-5ded-1638040f17c1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"AllTestsPassed\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Checks\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"PacletLoaded\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"AvailableSizes\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"ModelsValidate\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"PairLoss\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"Projection\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"RuleARowSums\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"RuleBUniform\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"DiffusionMass\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"SeededTrajectory\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"FiniteConsensus\"\>", "\[Rule]", "True"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
