  CellGroupData[
   {Cell[BoxData[RowBox[{RowBox[{RowBox[{"matching", "[", 
            RowBox[{"n_", ",", "edges_"}], "]"}], ":=", 
          RowBox[{"Dot", "@@", RowBox[{RowBox[{"(", RowBox[
                 {RowBox[{"pairAverage", "[", RowBox[{"n", ",", "#1"}], 
                    "]"}], "&"}], ")"}], "/@", "edges"}]}]}], ";", 
        RowBox[{"k4Product", "=", RowBox[{RowBox[{"matching", "[", 
              RowBox[{"4", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                       {"1", ",", "3"}], "}"}], ",", RowBox[{"{", RowBox[
                       {"2", ",", "4"}], "}"}]}], "}"}]}], "]"}], ".", 
            RowBox[{"matching", "[", RowBox[{"4", ",", RowBox[{"{", 
                  RowBox[{RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], 
              "]"}]}]}], ";", RowBox[{"q3Product", "=", 
          RowBox[{RowBox[{"matching", "[", RowBox[{"8", ",", RowBox[
                 {"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "5"}], "}"}], 
                    ",", RowBox[{"{", RowBox[{"2", ",", "6"}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"3", ",", "7"}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"4", ",", "8"}], "}"}]}], "}"}]}], 
              "]"}], ".", RowBox[{"matching", "[", RowBox[{"8", ",", 
                RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "3"}], 
                      "}"}], ",", RowBox[{"{", RowBox[{"2", ",", "4"}], 
                      "}"}], ",", RowBox[{"{", RowBox[{"5", ",", "7"}], 
                      "}"}], ",", RowBox[{"{", RowBox[{"6", ",", "8"}], 
                      "}"}]}], "}"}]}], "]"}], ".", RowBox[{"matching", "[", 
              RowBox[{"8", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                       {"1", ",", "2"}], "}"}], ",", RowBox[{"{", RowBox[
                       {"3", ",", "4"}], "}"}], ",", RowBox[{"{", RowBox[
                       {"5", ",", "6"}], "}"}], ",", RowBox[{"{", RowBox[
                       {"7", ",", "8"}], "}"}]}], "}"}]}], "]"}]}]}], ";", 
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"\"K4 reaches exact consensus\"", "\[Rule]", 
              RowBox[{"k4Product", "===", RowBox[{"ConstantArray", "[", 
                  RowBox[{FractionBox["1", "4"], ",", RowBox[{"{", RowBox[
