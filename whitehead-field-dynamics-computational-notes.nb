  Cell["The path visits 27 different graph types. Its 13 repeated consecutive \
labels are holding steps, and the fixed seed makes the sample reproducible.", 
   "Caption", TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "PathCaption", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "PathCaption"}, 
   ExpressionUUID -> "48ff44f4-0094-46d4-6478-05b91fc74bad", 
   FontColor -> RGBColor[0.37, 0.42, 0.49], 
   CellMargins -> {{72, 72}, {3, 14}}, ShowCellBracket -> False], 
  Cell["Finite-time consensus", "Section", TaggingRules -> 
    <|"GoGComputationalNotes" -> <|"ID" -> "SectionConsensus", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "SectionConsensus"}, ExpressionUUID -> 
    "61838f1d-3a2c-af52-3199-a51fdac4a552"], Cell["Consensus means that every \
field coordinate equals the arithmetic mean of the initial field. Finite-time \
consensus means this happens after a finite product of pair-averaging \
matrices, equivalently that the product equals J_N. A perfect matching is a \
set of disjoint pairs covering all N coordinates. For such a matching, M \
denotes the product of its commuting pair averages; successive products act \
from right to left.", "Text", TaggingRules -> 
    <|"GoGComputationalNotes" -> <|"ID" -> "ConsensusIntro", 
       "Generated" -> True|>|>, CellTags -> {"GoGComputationalNotes", 
     "ConsensusIntro"}, ExpressionUUID -> 
    "2b56c6f7-fbda-9eea-6238-425a5d79b1f8", FontSize -> 12, 
   LineSpacing -> {1.15, 2}], 
  Cell[BoxData[FormBox[GridBox[
      {{RowBox[{SubscriptBox["J", "N"], "=", FractionBox["1", "N"], 
          SubscriptBox[StyleBox["1", FontWeight -> "Bold"], "N"], 
          SuperscriptBox[SubscriptBox[StyleBox["1", FontWeight -> "Bold"], 
            "N"], "T"]}]}, {RowBox[{SubscriptBox["J", "N"], "f", "=", 
          OverscriptBox["f", "_"], SubscriptBox[StyleBox["1", 
            FontWeight -> "Bold"], "N"]}]}, 
       {RowBox[{SubscriptBox["M", RowBox[{"13", "|", "24"}]], "=", 
          SubscriptBox["A", "13"], SubscriptBox["A", "24"]}]}, 
       {RowBox[{SubscriptBox["M", RowBox[{"13", "|", "24"}]], 
          SubscriptBox["M", RowBox[{"12", "|", "34"}]], "=", 
          SubscriptBox["J", "4"]}]}, 
       {RowBox[{SubscriptBox["M", RowBox[{"15", "|", "26", "|", "37", "|", 
             "48"}]], SubscriptBox["M", RowBox[{"13", "|", "24", "|", "57", 
             "|", "68"}]], SubscriptBox["M", RowBox[{"12", "|", "34", "|", 
             "56", "|", "78"}]], "=", SubscriptBox["J", "8"]}]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, 
      GridBoxSpacings -> {"Rows" -> {{0.75}}}], TraditionalForm]], 
   "DisplayFormula", TaggingRules -> <|"GoGComputationalNotes" -> 
      <|"ID" -> "ConsensusFormula", "Generated" -> True|>|>, 
   CellTags -> {"GoGComputationalNotes", "ConsensusFormula"}, 
   ExpressionUUID -> "cc5e79e0-eff6-085c-8086-2db668e61201", 
   ShowCellBracket -> False, TextAlignment -> Center, FontSize -> 15], 
